---
import { MAIN_PHONE, getPartnerProviders, formatSpeed, formatPrice } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';

const partners = getPartnerProviders();
---

<!-- AI Chat Widget -->
<div id="ai-chat" class="ai-chat">
  <!-- Toggle Button -->
  <button id="ai-chat-toggle" class="ai-chat-toggle" aria-label="Open chat assistant">
    <svg id="chat-icon-open" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
    </svg>
    <svg id="chat-icon-close" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
    <span class="ai-chat-badge" id="chat-badge">1</span>
  </button>

  <!-- Chat Window -->
  <div id="ai-chat-window" class="ai-chat-window" style="display:none;">
    <div class="ai-chat-header">
      <div class="ai-chat-header-info">
        <div class="ai-chat-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </div>
        <div>
          <strong style="font-size:var(--text-sm);">Internet Advisor</strong>
          <span style="display:block;font-size:var(--text-xs);color:var(--brand-green);">● Online</span>
        </div>
      </div>
      <button id="ai-chat-close" class="ai-chat-close" aria-label="Close chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div id="ai-chat-messages" class="ai-chat-messages"></div>

    <div id="ai-chat-options" class="ai-chat-options"></div>

    <div class="ai-chat-footer">
      <input type="text" id="ai-chat-input" class="ai-chat-input" placeholder="Type a message..." autocomplete="off" />
      <button id="ai-chat-send" class="ai-chat-send" aria-label="Send message">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Provider data for chat engine -->
<script id="chat-provider-data" type="application/json" set:html={JSON.stringify(partners.map(p => ({
  id: p.id, name: p.name, slug: p.slug,
  types: p.types, rating: p.rating,
  minPrice: Math.min(...p.plans.map(pl => pl.promoPrice || pl.price)),
  maxSpeed: Math.max(...p.plans.map(pl => pl.speed)),
  plans: p.plans.map(pl => ({ name: pl.name, speed: pl.speed, price: pl.promoPrice || pl.price })),
  coverage: p.coverage, phone: p.phone,
  pros: p.pros.slice(0, 3),
})))} />

<script define:vars={{ mainPhone: MAIN_PHONE }}>
(function() {
  const PHONE = mainPhone;
  const providers = JSON.parse(document.getElementById('chat-provider-data').textContent);

  // DOM elements
  const toggle = document.getElementById('ai-chat-toggle');
  const window_ = document.getElementById('ai-chat-window');
  const closeBtn = document.getElementById('ai-chat-close');
  const messages = document.getElementById('ai-chat-messages');
  const options = document.getElementById('ai-chat-options');
  const input = document.getElementById('ai-chat-input');
  const sendBtn = document.getElementById('ai-chat-send');
  const badge = document.getElementById('chat-badge');
  const iconOpen = document.getElementById('chat-icon-open');
  const iconClose = document.getElementById('chat-icon-close');

  let isOpen = false;
  let started = false;
  let answers = {};

  // ── Conversion-first chat flow ──────────────────────────────────────
  // Principle: Bill interrogation first → savings hook → ZIP → use-case → result
  // 3 questions max before a strong CTA. Short path, high urgency.
  // ────────────────────────────────────────────────────────────────────

  const flow = {
    start: {
      messages: [
        "Quick question — what are you paying for internet each month?",
        "I'll tell you right away if you're overpaying."
      ],
      options: [
        { label: "Under $40/mo", value: 40, next: "bill_low" },
        { label: "$40–$65/mo", value: 65, next: "bill_mid" },
        { label: "$66–$85/mo", value: 85, next: "bill_high" },
        { label: "$86+ — I think I'm overpaying", value: 120, next: "bill_very_high" },
      ],
      extra: `<a href="tel:${PHONE.replace(/[^0-9+]/g,'')}" style="display:block;text-align:center;margin-top:8px;font-size:12px;color:var(--brand-green);">Skip — talk to a live expert now →</a>`
    },
    bill_low: {
      messages: ["That's actually decent! Still, plans keep changing — let's see if there's something better in your area. What's your ZIP?"],
      input: true,
      validate: (v) => /^\d{5}$/.test(v.trim()),
      errorMsg: "Please enter your 5-digit ZIP code.",
      process: (v) => { answers.zip = v.trim(); answers.bill = 40; },
      next: "usage"
    },
    bill_mid: {
      messages: ["You might be overpaying by $10–20/mo. We've helped thousands of customers find lower rates. What's your ZIP code?"],
      input: true,
      validate: (v) => /^\d{5}$/.test(v.trim()),
      errorMsg: "Please enter your 5-digit ZIP code.",
      process: (v) => { answers.zip = v.trim(); answers.bill = 65; },
      next: "usage"
    },
    bill_high: {
      messages: ["$66–85/mo is above average. Most people in similar areas pay $35–55/mo for better speeds. Enter your ZIP — I'll show you what you qualify for:"],
      input: true,
      validate: (v) => /^\d{5}$/.test(v.trim()),
      errorMsg: "Please enter your 5-digit ZIP code.",
      process: (v) => { answers.zip = v.trim(); answers.bill = 85; },
      next: "usage"
    },
    bill_very_high: {
      messages: ["$86+/mo is significantly above average. We typically save people in that range $30–50/mo by switching. What's your ZIP code?"],
      input: true,
      validate: (v) => /^\d{5}$/.test(v.trim()),
      errorMsg: "Please enter your 5-digit ZIP code.",
      process: (v) => { answers.zip = v.trim(); answers.bill = 120; },
      next: "usage"
    },
    usage: {
      messages: ["Last one — what's internet mainly used for at your place?"],
      options: [
        { label: "Streaming & casual browsing", value: "streaming", next: "results" },
        { label: "Gaming or working from home", value: "gaming", next: "results" },
        { label: "Everything — smart home, multiple people", value: "power", next: "results" },
      ]
    },
    results: {
      messages: ["Analyzing your area..."],
      compute: true,
    }
  };

  function toggleChat() {
    isOpen = !isOpen;
    window_.style.display = isOpen ? 'flex' : 'none';
    iconOpen.style.display = isOpen ? 'none' : 'block';
    iconClose.style.display = isOpen ? 'block' : 'none';
    badge.style.display = 'none';

    if (!started) {
      started = true;
      setTimeout(() => runStep('start'), 400);
    }
  }

  function addMessage(text, isUser) {
    const div = document.createElement('div');
    div.className = `ai-msg ${isUser ? 'ai-msg-user' : 'ai-msg-bot'}`;
    div.innerHTML = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function addTyping() {
    const div = document.createElement('div');
    div.className = 'ai-msg ai-msg-bot ai-typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  function removeTyping() {
    const el = messages.querySelector('.ai-typing');
    if (el) el.remove();
  }

  function showOptions(opts) {
    options.innerHTML = '';
    opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'ai-option-btn';
      btn.textContent = opt.label;
      btn.addEventListener('click', () => {
        addMessage(opt.label, true);
        options.innerHTML = '';
        if (opt.value !== undefined) {
          if (opt.value === 'price' || opt.value === 'speed' || opt.value === 'reliability' || opt.value === 'nocontract') {
            answers.priority = opt.value;
          } else if (typeof opt.value === 'number' && opt.next === 'usage') {
            answers.household = opt.value;
          } else if (typeof opt.value === 'number' && opt.next === 'budget') {
            answers.usage = opt.value;
          } else if (typeof opt.value === 'number' && opt.next === 'results') {
            answers.budget = opt.value;
          } else if (typeof opt.value === 'number' && opt.next === 'zip') {
            answers.targetSpeed = opt.value;
          }
        }
        if (opt.next) {
          setTimeout(() => runStep(opt.next), 500);
        }
      });
      options.appendChild(btn);
    });
  }

  function getRecommendedSpeed() {
    const h = answers.household || 1;
    const u = answers.usage || 'streaming';
    const speeds = { streaming: 100, gaming: 300, power: 500 };
    return speeds[u] || 100;
  }

  function getSavingsEstimate() {
    const bill = answers.bill || 0;
    if (bill <= 40) return 0;
    const avg = 45; // avg competitive price
    return Math.max(0, bill - avg);
  }

  function computeResults() {
    const recSpeed = getRecommendedSpeed();
    // Score based on speed match + rating + price (no hard budget filter)
    let scored = providers.map(p => {
      let score = 0;
      const cheapest = [...p.plans].sort((a, b) => a.price - b.price)[0];
      if (cheapest.speed >= recSpeed) score += 30;
      else if (cheapest.speed >= recSpeed * 0.5) score += 15;
      score += (p.rating / 5) * 25;
      if (cheapest.price <= 55) score += 20;
      else if (cheapest.price <= 70) score += 10;
      if (p.types.includes('fiber')) score += 8;
      return { ...p, score, bestPlan: cheapest };
    });
    scored.sort((a, b) => b.score - a.score);
    return scored.slice(0, 3);
  }

  async function runStep(stepId) {
    const step = flow[stepId];
    if (!step) return;

    for (let i = 0; i < step.messages.length; i++) {
      addTyping();
      await delay(650 + Math.random() * 350);
      removeTyping();
      addMessage(step.messages[i], false);
    }

    // Show savings badge inline after bill steps
    const savingsSteps = ['bill_mid', 'bill_high', 'bill_very_high'];
    if (savingsSteps.includes(stepId)) {
      const est = getSavingsEstimate();
      if (est > 0) {
        await delay(300);
        addMessage(
          `<div style="background:rgba(0,213,132,0.12);border:1px solid rgba(0,213,132,0.35);border-radius:10px;padding:10px 14px;text-align:center;">
            <div style="font-size:22px;font-weight:800;color:#00d584;">Save ~$${est}/mo</div>
            <div style="font-size:12px;color:#9ca3af;margin-top:2px;">Estimated based on your current bill</div>
          </div>`,
          false
        );
      }
    }

    if (step.compute) {
      addTyping();
      await delay(1400);
      removeTyping();
      const results = computeResults();
      showResults(results);
      return;
    }

    if (step.extra) {
      const el = document.createElement('div');
      el.innerHTML = step.extra;
      messages.appendChild(el);
      messages.scrollTop = messages.scrollHeight;
    }

    if (step.options) {
      showOptions(step.options);
    }

    if (step.input) {
      input.disabled = false;
      input.focus();
      input.dataset.step = stepId;
    } else {
      input.disabled = true;
    }
  }

  function showResults(results) {
    const savings = getSavingsEstimate();
    if (savings > 0) {
      addMessage(
        `<div style="background:rgba(0,213,132,0.12);border:1px solid rgba(0,213,132,0.35);border-radius:10px;padding:10px 14px;text-align:center;margin-bottom:4px;">
          <div style="font-size:13px;font-weight:700;color:#00d584;">Potential savings: ~$${savings}/mo ($${savings * 12}/yr)</div>
        </div>`,
        false
      );
    }

    addMessage("Here are the best options in your area:", false);

    results.forEach((p, i) => {
      const medal = ['#1', '#2', '#3'][i];
      const telHref = `tel:${p.phone.replace(/[^0-9+]/g, '')}`;
      addMessage(
        `<div style="border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:12px;margin-bottom:4px;background:#1a2336;">
          <div style="font-weight:800;font-size:14px;margin-bottom:4px;color:#e8eaf0;">${medal} ${p.name}</div>
          <div style="font-size:12px;color:#9ca3af;margin-bottom:8px;">
            Up to ${p.bestPlan.speed} Mbps &middot; <strong style="color:#e8eaf0;">$${p.bestPlan.price}/mo</strong> &middot; ⭐ ${p.rating}/5
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;">
            <a href="#get-connected" data-signup-provider="${p.slug}" class="ai-order-cta" style="display:block;background:linear-gradient(135deg,#00d584,#1aff9f);color:#003d1a;text-align:center;padding:9px 4px;border-radius:8px;font-size:13px;font-weight:800;text-decoration:none;">Order Online — ${p.name} →</a>
            <a href="${telHref}" style="display:block;text-align:center;padding:5px 4px;font-size:11px;color:#6b7280;text-decoration:none;">📞 Or call: ${p.phone}</a>
          </div>
        </div>`,
        false
      );
    });

    addMessage("These rates are time-sensitive. Locking in now can save you more.", false);

    options.innerHTML = `
      <button class="ai-option-btn" id="ai-restart" style="font-size:12px;color:#9ca3af;background:#111827;border-color:rgba(255,255,255,0.06);">Start over</button>
    `;
    document.getElementById('ai-restart')?.addEventListener('click', () => {
      messages.innerHTML = '';
      options.innerHTML = '';
      answers = {};
      runStep('start');
    });

    // Wire up "Order Online" links inside chat to trigger SignUpForm
    messages.querySelectorAll('.ai-order-cta').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.dataset.signupProvider;
        // Close chat
        isOpen = false;
        window_.style.display = 'none';
        iconOpen.style.display = '';
        iconClose.style.display = 'none';
        // Trigger signup modal
        const modal = document.getElementById('signup-modal');
        if (modal) {
          modal.classList.add('open');
          document.body.style.overflow = 'hidden';
          if (slug) {
            const sel = document.getElementById('su-provider');
            if (sel) {
              sel.value = slug;
              sel.dispatchEvent(new Event('change'));
            }
          }
        } else {
          // Fallback: scroll to anchor
          window.location.href = '#get-connected';
        }
      });
    });
  }

  // ── NLP-lite intent detection ──────────────────────────────────────
  function detectIntent(text) {
    const t = text.toLowerCase().trim();
    const zipMatch = t.match(/\b(\d{5})\b/);
    if (zipMatch) return { type: 'zip', zip: zipMatch[1] };
    // Provider name mentions
    for (const p of providers) {
      if (t.includes(p.name.toLowerCase())) return { type: 'provider', name: p.name };
    }
    if (/cheap|affordable|low.?cost|budget|inexpensive|discount|save/.test(t)) return { type: 'cheap' };
    if (/fast|fiber|gig|gigabit|1000\s?mbps|high.?speed/.test(t)) return { type: 'speed' };
    if (/gaming|game|ps5|xbox|twitch|lag|ping/.test(t)) return { type: 'gaming' };
    if (/streaming|netflix|hulu|youtube|4k|disney/.test(t)) return { type: 'streaming' };
    if (/work.?from.?home|wfh|zoom|video.?call|remote/.test(t)) return { type: 'wfh' };
    if (/cancel|switch|change provider|leave|drop|alternative/.test(t)) return { type: 'switch' };
    if (/rural|satellite|wireless|5g|no.?cable/.test(t)) return { type: 'rural' };
    if (/compare|vs\.?|versus|difference|better|which is/.test(t)) return { type: 'compare' };
    if (/price|cost|how much|pay|bill|monthly|rate|fee/.test(t)) return { type: 'price' };
    if (/no.?contract|month.?to.?month|commitment|lock.*in/.test(t)) return { type: 'contract' };
    if (/bundle|tv|cable|phone|package|combo/.test(t)) return { type: 'bundle' };
    if (/order|sign.?up|get started|enroll|apply/.test(t)) return { type: 'order' };
    if (/hi\b|hello|hey\b|good morning|good afternoon|sup\b/.test(t)) return { type: 'greeting' };
    return { type: 'question' };
  }

  function respondToIntent(intent) {
    const fastest = [...providers].sort((a, b) => b.maxSpeed - a.maxSpeed).slice(0, 3);
    const cheapest = [...providers].sort((a, b) => a.minPrice - b.minPrice).slice(0, 3);
    switch (intent.type) {
      case 'greeting':
        return "Hey! I'm your internet advisor. I can help you find the best plan in your area, compare providers, check pricing, and get you signed up in minutes. What are you looking for today?";
      case 'price':
        return `Here are our lowest starting prices right now:<br><br>${cheapest.map(p => `<strong>${p.name}</strong> — from $${p.minPrice}/mo`).join('<br>')}<br><br>Enter your ZIP code and I'll confirm exact pricing at your address.`;
      case 'speed':
        return `Top picks for speed:<br><br>${fastest.map(p => `<strong>${p.name}</strong> — up to ${p.maxSpeed} Mbps`).join('<br>')}<br><br>Fiber plans offer the fastest, most reliable speeds. Want to check availability at your address?`;
      case 'cheap':
        return `Most affordable options right now:<br><br>${cheapest.map(p => `<strong>${p.name}</strong> — from $${p.minPrice}/mo`).join('<br>')}<br><br>Pricing varies by location. What's your ZIP code?`;
      case 'gaming':
        const gamingPs = providers.filter(p => p.maxSpeed >= 300 || p.types.includes('fiber')).slice(0, 3);
        return `For gaming you need low latency and 300+ Mbps. Best options:<br><br>${(gamingPs.length ? gamingPs : fastest).map(p => `<strong>${p.name}</strong> — up to ${p.maxSpeed} Mbps`).join('<br>')}<br><br>Fiber is ideal — near-zero lag ping. Enter your ZIP to check fiber availability.`;
      case 'streaming':
        const streamPs = providers.filter(p => p.maxSpeed >= 100).slice(0, 3);
        return `For 4K streaming, 100+ Mbps is ideal. Top picks:<br><br>${(streamPs.length ? streamPs : fastest).map(p => `<strong>${p.name}</strong> — from $${p.minPrice}/mo`).join('<br>')}<br><br>What's your ZIP code? I'll find the best plan for your area.`;
      case 'wfh':
        const wfhPs = providers.filter(p => p.maxSpeed >= 200 || p.types.includes('fiber')).slice(0, 3);
        return `Working from home needs reliable upload speeds. Best picks:<br><br>${(wfhPs.length ? wfhPs : fastest).map(p => `<strong>${p.name}</strong> — up to ${p.maxSpeed} Mbps`).join('<br>')}<br><br>Fiber gives you symmetrical upload/download — crucial for video calls. Enter your ZIP to check availability.`;
      case 'switch':
        return `Switching is easier than you think! We check all providers at your address, compare side by side, and help you order in minutes. Most providers offer <strong>no-contract plans</strong> now. What's your current bill? I can check if you're overpaying.`;
      case 'rural':
        const ruralPs = providers.filter(p => p.types.includes('satellite') || p.types.includes('fixed-wireless')).slice(0, 2);
        return ruralPs.length
          ? `For rural areas, top options include:<br><br>${ruralPs.map(p => `<strong>${p.name}</strong> — ${p.types.join(', ')}`).join('<br>')}<br><br>Some rural areas now have fiber or fixed wireless. Enter your ZIP to check.`
          : `Coverage in rural areas depends on your exact address. Enter your ZIP and I'll check every available option — including satellite and fixed wireless.`;
      case 'compare':
        return `I can compare any providers you're considering! Enter your ZIP code and I'll show a side-by-side breakdown of everything available at your address — speeds, pricing, and ratings.`;
      case 'contract':
        return `Great news — most major providers now offer month-to-month plans with no early termination fees. Enter your ZIP and I'll highlight the no-contract options available in your area.`;
      case 'bundle':
        return `Bundles can save you $20–50/mo vs. separate services. Most major providers offer internet + TV + phone combos. Enter your ZIP and I'll show bundle pricing in your area.`;
      case 'order':
        return `Ready to get started? It only takes about 3 minutes:<br><br>1. Tell me your ZIP code<br>2. Pick your speed & provider<br>3. Fill out the short order form<br><br>What's your ZIP code?`;
      case 'zip':
        answers.zip = intent.zip;
        return `Got it — checking providers for <strong>${intent.zip}</strong>. What's your main use for the internet?`;
      case 'provider': {
        const prov = providers.find(p => p.name.toLowerCase() === intent.name.toLowerCase());
        if (prov) return `<strong>${prov.name}</strong> is one of our recommended providers!<br><br>Starting from $${prov.minPrice}/mo · Up to ${prov.maxSpeed} Mbps · ⭐ ${prov.rating}/5<br><br>What's your ZIP code? I'll confirm ${prov.name} availability at your address.`;
        return "I can check all available providers at your address. What's your ZIP code?";
      }
      default:
        return "I'm here to help you find the perfect internet plan! I can check providers at your address, compare speeds and prices, or answer questions. What would you like to know?";
    }
  }
  // ─────────────────────────────────────────────────────────────────────

  function handleSend() {
    const val = input.value.trim();
    if (!val) return;

    const stepId = input.dataset.step;
    const step = flow[stepId];

    // Active guided input step — validate and process through flow
    if (step) {
      if (step.validate && !step.validate(val)) {
        addMessage(val, true);
        addMessage(step.errorMsg, false);
        input.value = '';
        return;
      }
      addMessage(val, true);
      input.value = '';
      input.disabled = true;
      input.dataset.step = '';
      if (step.process) step.process(val);
      if (step.next) setTimeout(() => runStep(step.next), 500);
      return;
    }

    // Free-form text — use NLP intent detection
    addMessage(val, true);
    input.value = '';
    const intent = detectIntent(val);

    // If a ZIP was entered as free text, pre-fill and continue flow
    if (intent.type === 'zip' && !answers.zip) {
      answers.zip = intent.zip;
      (async () => {
        const t = addTyping();
        await delay(700);
        removeTyping();
        addMessage(`Got it — <strong>${intent.zip}</strong>! Last question:`, false);
        await delay(300);
        runStep('usage');
      })();
      return;
    }

    (async () => {
      const t = addTyping();
      await delay(750 + Math.random() * 400);
      removeTyping();
      addMessage(respondToIntent(intent), false);

      // Offer a ZIP prompt after helpful responses
      const needsZip = ['price','speed','cheap','gaming','streaming','wfh','switch','rural','compare','contract','bundle','order','zip','question'];
      if (needsZip.includes(intent.type) && !answers.zip) {
        await delay(350);
        options.innerHTML = '';
        const btn = document.createElement('button');
        btn.className = 'ai-option-btn';
        btn.textContent = 'Check plans at my address →';
        btn.addEventListener('click', () => { options.innerHTML = ''; runStep('start'); });
        options.appendChild(btn);
      } else if (intent.type === 'zip' && answers.zip) {
        await delay(350);
        runStep('usage');
      }
    })();
  }

  function delay(ms) {
    return new Promise(r => setTimeout(r, ms));
  }

  // Event listeners
  toggle.addEventListener('click', toggleChat);
  closeBtn.addEventListener('click', toggleChat);
  sendBtn.addEventListener('click', handleSend);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSend();
  });

  // Auto-show badge after delay
  setTimeout(() => {
    if (!isOpen) badge.style.display = 'flex';
  }, 3000);
})();
</script>

