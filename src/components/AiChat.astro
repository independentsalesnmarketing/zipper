---
import { getPartnerProviders, getMinPrice, getMaxSpeed } from '@lib/providers';

const partners = getPartnerProviders().map(p => ({
  slug: p.slug,
  name: p.name,
  logo: p.logo,
  phone: p.phone,
  types: p.types,
  rating: p.rating,
  reviewCount: p.reviewCount,
  coverage: p.coverage,
  minPrice: getMinPrice(p),
  maxSpeed: getMaxSpeed(p),
  plans: p.plans.map(pl => ({
    name: pl.name,
    speed: pl.speed,
    uploadSpeed: pl.uploadSpeed,
    price: pl.promoPrice || pl.price,
    regularPrice: pl.price,
    contract: pl.contract,
    dataCap: pl.dataCap,
    features: pl.features,
  })),
}));
---

<!-- AI Chat Widget — Gemini 2.5 Flash powered -->
<div id="ai-chat" class="ai-chat">
  <button id="ai-chat-toggle" class="ai-chat-toggle" aria-label="Chat with Internet Advisor">
    <svg id="chat-icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    <svg id="chat-icon-close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span class="ai-chat-badge" id="chat-badge">1</span>
  </button>

  <div id="ai-chat-window" class="ai-chat-window" style="display:none;">
    <div class="ai-chat-header">
      <div class="ai-chat-header-info">
        <div class="ai-chat-avatar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4v1a4 4 0 01-8 0V6a4 4 0 014-4z"/><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/></svg>
        </div>
        <div>
          <strong class="ai-hdr-title">Internet Advisor</strong>
          <span class="ai-chat-status"><span class="ai-status-dot"></span> AI-Powered</span>
        </div>
      </div>
      <button id="ai-chat-close" class="ai-chat-close" aria-label="Close chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div id="ai-chat-messages" class="ai-chat-messages"></div>

    <div id="ai-chat-suggestions" class="ai-chat-suggestions"></div>

    <form id="ai-chat-form" class="ai-chat-footer" autocomplete="off">
      <input type="text" id="ai-chat-input" class="ai-chat-input" placeholder="Ask about plans, speeds, pricing..." />
      <button type="submit" id="ai-chat-send" class="ai-chat-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>

<script id="ai-chat-data" type="application/json" set:html={JSON.stringify(partners)} />

<script>
(function(){
  /* ── Config ───────────────────────────────────────────────────── */
  const GEMINI_KEY = import.meta.env.PUBLIC_GEMINI_KEY;
  const GEMINI_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_KEY}`;

  const partners = JSON.parse(document.getElementById('ai-chat-data').textContent);

  /* Broad-coverage providers not in ZIP files — always available as secondary */
  const BROAD_COVERAGE_SLUGS = ['att-air', 'earthlink'];
  const broadCoverageProviders = partners.filter(p => BROAD_COVERAGE_SLUGS.includes(p.slug));

  /* ── ZIP coverage cache ──────────────────────────────────────── */
  let zipCoverageData = null;
  let zipDataLoading = null;

  async function loadZipCoverage(){
    if(zipCoverageData) return zipCoverageData;
    if(zipDataLoading) return zipDataLoading;
    zipDataLoading = fetch('/data/zip-coverage.json')
      .then(r => r.ok ? r.json() : null)
      .catch(() => null)
      .then(d => { zipCoverageData = d; return d; });
    return zipDataLoading;
  }

  /* Look up confirmed providers for a ZIP from local data */
  function lookupZipLocal(zip){
    if(!zipCoverageData || !zipCoverageData[zip]) return [];
    return zipCoverageData[zip]; // [{id, fiber, tier?, region?}, ...]
  }

  /* Build provider context for a ZIP with AT&T Air/EarthLink logic */
  function buildZipContext(zip){
    const confirmed = lookupZipLocal(zip);
    const confirmedIds = confirmed.map(e => e.id);
    const confirmedPartners = partners.filter(p => confirmedIds.includes(p.slug));
    const count = confirmedPartners.length;

    let primary = [];
    let secondary = [];

    if(count === 0){
      // No confirmed — show AT&T Air + EarthLink as primary, plus top 2 general partners
      primary = broadCoverageProviders;
      secondary = partners
        .filter(p => !BROAD_COVERAGE_SLUGS.includes(p.slug))
        .sort((a,b) => a.minPrice - b.minPrice)
        .slice(0, 2);
    } else if(count <= 2){
      // Few confirmed — show confirmed as primary, AT&T Air + EarthLink prominently
      primary = confirmedPartners;
      secondary = broadCoverageProviders;
    } else if(count <= 4){
      // Moderate — confirmed primary, AT&T Air + EarthLink mentioned as alternatives
      primary = confirmedPartners;
      secondary = broadCoverageProviders;
    } else {
      // Many confirmed (5+) — just show confirmed, skip broad coverage
      primary = confirmedPartners;
      secondary = [];
    }

    // Build summary
    const fiberIds = confirmed.filter(e => e.fiber).map(e => e.id);
    let summary = `ZIP ${zip} coverage results:\n`;
    summary += `Confirmed providers (${count}): ${confirmedPartners.map(p => `${p.name}${fiberIds.includes(p.slug) ? ' (fiber)' : ''}`).join(', ') || 'None in our database'}\n`;

    if(primary.length){
      summary += `\nRecommend these as PRIMARY options:\n`;
      primary.forEach(p => {
        const topPlan = p.plans[0];
        summary += `• ${p.name}: from $${p.minPrice}/mo, up to ${p.maxSpeed} Mbps\n`;
      });
    }
    if(secondary.length){
      summary += `\n${count <= 2 ? 'Also STRONGLY recommend' : count <= 4 ? 'Also available' : 'Additionally available'} in this area:\n`;
      secondary.forEach(p => {
        summary += `• ${p.name}: from $${p.minPrice}/mo, up to ${p.maxSpeed} Mbps${BROAD_COVERAGE_SLUGS.includes(p.slug) ? ' (broad nationwide coverage)' : ''}\n`;
      });
    }

    summary += `\nShow specific plan recommendations with [[ORDER:slug:Plan Name]] and/or [[PLAN:...]] cards. Focus on the PRIMARY providers first.`;

    return { confirmed, confirmedPartners, primary, secondary, summary, count };
  }

  /* ── DOM refs ─────────────────────────────────────────────────── */
  const toggle = document.getElementById('ai-chat-toggle');
  const chatWin = document.getElementById('ai-chat-window');
  const closeBtn = document.getElementById('ai-chat-close');
  const msgArea = document.getElementById('ai-chat-messages');
  const suggestions = document.getElementById('ai-chat-suggestions');
  const form = document.getElementById('ai-chat-form');
  const input = document.getElementById('ai-chat-input');
  const badge = document.getElementById('chat-badge');
  const iconOpen = document.getElementById('chat-icon-open');
  const iconClose = document.getElementById('chat-icon-close');

  let isOpen = false;
  let started = false;
  let sending = false;
  let lastZipSearched = null;

  const history = [];

  /* ── System instruction ─────────────────────────────────────── */
  const systemInstruction = `You are a friendly, knowledgeable internet broadband advisor for Internet4All.com. Your goal is to help users find the best internet plan and get them signed up.

CONTEXT — Partner providers (you can recommend and sign users up for these):
${partners.map(p => `• ${p.name} (${p.slug}): ${p.types.join(', ')} | Rating: ${p.rating}/5 | From $${p.minPrice}/mo | Up to ${p.maxSpeed} Mbps | Plans: ${p.plans.map(pl => `${pl.name}: ${pl.speed}Mbps↓/${pl.uploadSpeed || '?'}Mbps↑ $${pl.price}/mo${pl.contract !== 'None' ? ' ('+pl.contract+' contract)' : ' (no contract)'}${pl.dataCap !== 'Unlimited' ? ' '+pl.dataCap+' cap' : ''}`).join('; ')}`).join('\n')}

CAPABILITIES:
1. When the user provides a ZIP code, the system automatically looks up which providers serve that area and provides you the results. You do NOT need to add any special markers — just reply naturally with recommendations based on the context provided.
2. When recommending a specific plan, include an order button using this exact format: [[ORDER:provider-slug:Plan Name]] — this renders as a clickable sign-up button.
3. When showing plan comparisons, use this format for each plan card:
[[PLAN:provider-slug|Plan Name|speed_down|speed_up|price|contract|data_cap]]

CONVERSATION RULES:
- Keep responses concise (2-4 sentences typical, longer for comparisons).
- Always ask for the user's ZIP code early so you can give location-specific results.
- Focus on driving conversions — recommend plans, highlight savings, create urgency.
- Use plain text formatting. Use ** for bold. Structure comparisons clearly.
- If a user seems ready to order, proactively show [[ORDER:slug:Plan Name]] buttons.
- When comparing plans, present no more than 3-4 options to avoid overwhelming the user.
- If you don't know something specific, say so honestly rather than making it up.
- Mention that Internet4All helps users save an average of $20-30/mo by comparing all options.
- Do not use markdown headers (#). Keep it conversational.`;

  /* ── Helpers ──────────────────────────────────────────────────── */
  function delay(ms){ return new Promise(r=>setTimeout(r,ms)); }
  function escHtml(s){ const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
  function scrollBottom(){ msgArea.scrollTop = msgArea.scrollHeight; }

  /* ── Render message ──────────────────────────────────────────── */
  function addMsg(html, role){
    const div = document.createElement('div');
    div.className = `ai-msg ${role==='user'?'ai-msg-user':'ai-msg-bot'}`;
    div.innerHTML = html;
    msgArea.appendChild(div);
    scrollBottom();
    div.querySelectorAll('.ai-order-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        openSignup(btn.dataset.slug, btn.dataset.plan);
      });
    });
  }

  function addTyping(){
    const div = document.createElement('div');
    div.className = 'ai-msg ai-msg-bot ai-typing';
    div.id = 'ai-typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    msgArea.appendChild(div);
    scrollBottom();
  }
  function removeTyping(){ document.getElementById('ai-typing')?.remove(); }

  /* ── Parse Gemini response ────────────────────────────────────── */
  function parseResponse(text){
    let html = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/\n/g, '<br>');

    html = html.replace(/\[\[ORDER:([a-z0-9-]+):(.+?)\]\]/g, (_, slug, plan) => {
      const p = partners.find(x=>x.slug===slug);
      const label = p ? p.name : plan;
      return `<button class="ai-order-btn" data-slug="${escHtml(slug)}" data-plan="${escHtml(plan)}">Sign Up for ${escHtml(label)} — ${escHtml(plan)} →</button>`;
    });

    html = html.replace(/\[\[PLAN:([a-z0-9-]+)\|(.+?)\|(\d+)\|([^\|]*)\|([^\|]+)\|([^\|]*)\|([^\]]*)\]\]/g,
      (_, slug, name, down, up, price, contract, cap) => {
        const p = partners.find(x=>x.slug===slug);
        const pName = p ? p.name : slug;
        return `<div class="ai-plan-card">
          <div class="ai-plan-provider">${escHtml(pName)}</div>
          <div class="ai-plan-name">${escHtml(name)}</div>
          <div class="ai-plan-stats">
            <span>${down} Mbps ↓${up ? ' / '+up+' Mbps ↑' : ''}</span>
            <span class="ai-plan-price">$${escHtml(price)}/mo</span>
          </div>
          <div class="ai-plan-meta">${contract && contract !== 'None' ? contract+' contract' : 'No contract'} · ${cap && cap !== 'Unlimited' ? cap : 'Unlimited data'}</div>
          <button class="ai-order-btn" data-slug="${escHtml(slug)}" data-plan="${escHtml(name)}">Get This Plan →</button>
        </div>`;
      }
    );

    // Clean stray markers
    html = html.replace(/\[\[LOOKUP_ZIP:\d{5}\]\]/g, '');
    return html;
  }

  /* ── Open signup modal pre-filled ────────────────────────────── */
  function openSignup(slug, planName){
    isOpen = false;
    chatWin.style.display = 'none';
    iconOpen.style.display = ''; iconClose.style.display = 'none';
    const modal = document.getElementById('signup-modal');
    if(modal){
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      const sel = document.getElementById('su-provider');
      if(sel && slug){
        sel.value = slug;
        sel.dispatchEvent(new Event('change'));
        setTimeout(()=>{
          const planSel = document.getElementById('su-plan');
          if(planSel && planName){
            for(const opt of planSel.options){
              if(opt.textContent.includes(planName)){
                planSel.value = opt.value;
                planSel.dispatchEvent(new Event('change'));
                break;
              }
            }
          }
        }, 200);
      }
    }
  }

  /* ── Show suggestions ────────────────────────────────────────── */
  function showSuggestions(items){
    suggestions.innerHTML = '';
    items.forEach(text => {
      const btn = document.createElement('button');
      btn.className = 'ai-suggestion';
      btn.textContent = text;
      btn.addEventListener('click', ()=>{
        suggestions.innerHTML = '';
        sendMessage(text);
      });
      suggestions.appendChild(btn);
    });
  }

  /* ── Call Gemini 2.5 Flash ───────────────────────────────────── */
  async function callGemini(userText){
    history.push({ role: 'user', parts: [{ text: userText }] });
    const body = {
      system_instruction: { parts: [{ text: systemInstruction }] },
      contents: history,
      generationConfig: { temperature: 0.7, topP: 0.9, maxOutputTokens: 800 },
      safetySettings: [
        { category: 'HARM_CATEGORY_HARASSMENT', threshold: 'BLOCK_ONLY_HIGH' },
        { category: 'HARM_CATEGORY_HATE_SPEECH', threshold: 'BLOCK_ONLY_HIGH' },
        { category: 'HARM_CATEGORY_SEXUALLY_EXPLICIT', threshold: 'BLOCK_ONLY_HIGH' },
        { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_ONLY_HIGH' },
      ]
    };
    const res = await fetch(GEMINI_URL, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body), signal: AbortSignal.timeout(15000),
    });
    if(!res.ok) throw new Error(`Gemini API error ${res.status}`);
    const data = await res.json();
    const text = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
    if(text) history.push({ role: 'model', parts: [{ text }] });
    return text;
  }

  /* ── Main send handler ───────────────────────────────────────── */
  async function sendMessage(text){
    if(sending || !text.trim()) return;
    sending = true;
    const userText = text.trim();

    addMsg(escHtml(userText), 'user');
    suggestions.innerHTML = '';
    input.value = '';
    input.disabled = true;
    addTyping();

    try {
      // Check if user provided a ZIP code
      const zipMatch = userText.match(/\b(\d{5})\b/);
      let response;

      if(zipMatch){
        const zip = zipMatch[1];
        lastZipSearched = zip;

        // Load ZIP coverage data (cached)
        await loadZipCoverage();
        const ctx = buildZipContext(zip);

        // Build enriched message with ZIP context for Gemini
        const enrichedMsg = `${userText}\n\n[System context — provider availability for ZIP ${zip}:\n${ctx.summary}]`;
        response = await callGemini(enrichedMsg);
      } else {
        response = await callGemini(userText);
      }

      removeTyping();
      addMsg(parseResponse(response), 'model');
      showFollowUps(userText, response);

    } catch(e){
      removeTyping();
      console.error('Chat error:', e);
      addMsg(getFallbackResponse(userText), 'model');
      showSuggestions(['Check plans at my ZIP', 'Show cheapest plans', 'Compare fastest providers']);
    }

    sending = false;
    input.disabled = false;
    input.focus();
  }

  /* ── Follow-up suggestions ───────────────────────────────────── */
  function showFollowUps(userText, response){
    const t = userText.toLowerCase();
    const hasZip = /\b\d{5}\b/.test(t);
    const items = [];
    if(!hasZip && !lastZipSearched)
      items.push('Check plans at my ZIP code');
    if(/cheap|price|afford|budget|cost/.test(t))
      items.push('Show no-contract options');
    else if(/fast|speed|fiber|gig/.test(t))
      items.push('Which is cheapest?');
    else if(hasZip)
      items.push('Compare all plans', 'Show cheapest option');
    if(items.length < 2) items.push('Help me choose a plan');
    if(items.length < 3) items.push("I'm ready to sign up");
    showSuggestions(items.slice(0,3));
  }

  /* ── Local fallback when API fails ────────────────────────────── */
  function getFallbackResponse(userText){
    const t = userText.toLowerCase();
    const sorted = [...partners].sort((a,b)=>a.minPrice - b.minPrice);
    const fastest = [...partners].sort((a,b)=>b.maxSpeed - a.maxSpeed);

    if(/\b\d{5}\b/.test(t)){
      const zip = t.match(/\b(\d{5})\b/)[1];
      const ctx = buildZipContext(zip);
      const show = ctx.primary.length ? ctx.primary : sorted;
      return `Here are the top providers for <strong>${zip}</strong>:<br><br>${show.slice(0,3).map(p =>
        `<div class="ai-plan-card">
          <div class="ai-plan-provider">${p.name}</div>
          <div class="ai-plan-stats"><span>Up to ${p.maxSpeed} Mbps</span><span class="ai-plan-price">From $${p.minPrice}/mo</span></div>
          <button class="ai-order-btn" data-slug="${p.slug}" data-plan="${p.plans[0].name}">Sign Up →</button>
        </div>`).join('')}${ctx.secondary.length ? '<br>Also available: ' + ctx.secondary.map(p => `<strong>${p.name}</strong> from $${p.minPrice}/mo`).join(', ') : ''}`;
    }
    if(/cheap|afford|budget|low.?cost|price/.test(t)){
      return `Here are our most affordable plans:<br><br>${sorted.slice(0,3).map(p =>
        `<div class="ai-plan-card">
          <div class="ai-plan-provider">${p.name}</div>
          <div class="ai-plan-stats"><span>Up to ${p.maxSpeed} Mbps</span><span class="ai-plan-price">From $${p.minPrice}/mo</span></div>
          <button class="ai-order-btn" data-slug="${p.slug}" data-plan="${p.plans[0].name}">Get Started →</button>
        </div>`).join('')}<br>Tell me your ZIP code for exact availability!`;
    }
    if(/fast|speed|fiber|gig/.test(t)){
      return `Top picks for speed:<br><br>${fastest.slice(0,3).map(p =>
        `<div class="ai-plan-card">
          <div class="ai-plan-provider">${p.name}</div>
          <div class="ai-plan-stats"><span>Up to ${p.maxSpeed} Mbps</span><span class="ai-plan-price">From $${p.minPrice}/mo</span></div>
          <button class="ai-order-btn" data-slug="${p.slug}" data-plan="${p.plans[0].name}">Get Started →</button>
        </div>`).join('')}<br>Enter your ZIP and I'll confirm availability.`;
    }
    return `I can help you find the perfect internet plan! Here are our top-rated providers:<br><br>${sorted.slice(0,3).map(p =>
      `<strong>${p.name}</strong> — from $${p.minPrice}/mo, up to ${p.maxSpeed} Mbps`).join('<br>')}<br><br>Tell me your ZIP code and what you use the internet for, and I'll find the best match!`;
  }

  /* ── Toggle chat open/close ──────────────────────────────────── */
  function openChat(){
    isOpen = true;
    chatWin.style.display = 'flex';
    iconOpen.style.display = 'none';
    iconClose.style.display = 'block';
    badge.style.display = 'none';
    if(!started){
      started = true;
      loadZipCoverage(); // Pre-load ZIP data
      greet();
    }
    input.focus();
  }

  function closeChat(){
    isOpen = false;
    chatWin.style.display = 'none';
    iconOpen.style.display = 'block';
    iconClose.style.display = 'none';
  }

  async function greet(){
    addTyping();
    await delay(600);
    removeTyping();
    addMsg("Hi! I'm your AI-powered internet advisor. I can help you find the best plan, compare providers, and get you signed up in minutes.<br><br>What can I help you with today?", 'model');
    history.push({ role: 'model', parts: [{ text: "Hi! I'm your AI-powered internet advisor. I can help you find the best plan, compare providers, and get you signed up in minutes. What can I help you with today?" }] });
    showSuggestions([
      "What's available at my address?",
      "Show me the cheapest plans",
      "I need fast internet for gaming",
    ]);
  }

  /* ── Events ──────────────────────────────────────────────────── */
  toggle.addEventListener('click', ()=> isOpen ? closeChat() : openChat());
  closeBtn.addEventListener('click', closeChat);
  form.addEventListener('submit', e => {
    e.preventDefault();
    sendMessage(input.value);
  });

  setTimeout(()=>{ if(!isOpen) badge.style.display = 'flex'; }, 3000);
})();
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════
     AI Chat — fully isolated dark theme. All colors explicit with
     !important to override any global CSS variable cascade.
     ═══════════════════════════════════════════════════════════════ */

  .ai-chat {
    position: fixed;
    bottom: 80px;
    right: 20px;
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Nuclear reset — prevent ANY global color/font bleed into chat window */
  .ai-chat-window,
  .ai-chat-window *,
  .ai-chat-window *::before,
  .ai-chat-window *::after {
    --text-primary: #e0e4ee !important;
    --text-secondary: #9ca3af !important;
    --text-tertiary: #6b7280 !important;
    color: #e0e4ee !important;
    border-color: rgba(255,255,255,0.08) !important;
  }

  /* ── Toggle button ──────────────────────────────────────────── */
  .ai-chat-toggle {
    width: 60px; height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    color: #fff !important;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 24px rgba(102,126,234,0.45);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(.34,1.56,.64,1), box-shadow 0.25s;
    position: relative; border: none;
  }
  .ai-chat-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 10px 36px rgba(102,126,234,0.55);
  }
  .ai-chat-badge {
    position: absolute; top: -3px; right: -3px;
    width: 20px; height: 20px; border-radius: 50%;
    background: #ef4444 !important; color: #fff !important;
    font-size: 11px; font-weight: 700;
    display: none; align-items: center; justify-content: center;
    border: 2px solid #111827 !important;
  }

  /* ── Window ─────────────────────────────────────────────────── */
  .ai-chat-window {
    position: absolute; bottom: 72px; right: 0;
    width: 400px; max-height: 580px;
    background: #0f1629 !important;
    border: 1px solid rgba(255,255,255,0.08) !important;
    border-radius: 20px;
    display: flex; flex-direction: column; overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px rgba(102,126,234,0.15);
    animation: chatSlideUp 0.3s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes chatSlideUp {
    from { opacity:0; transform: translateY(12px) scale(0.96); }
