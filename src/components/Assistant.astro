---
import { getPartnerProviders, getMinPrice, getMaxSpeed } from '@lib/providers';

const partners = getPartnerProviders().map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  logo: p.logo,
  types: p.types,
  rating: p.rating,
  reviewCount: p.reviewCount,
  coverage: p.coverage,
  minPrice: getMinPrice(p),
  maxSpeed: getMaxSpeed(p),
  plans: p.plans.map((pl) => ({
    name: pl.name,
    speed: pl.speed,
    uploadSpeed: pl.uploadSpeed,
    price: pl.promoPrice || pl.price,
    regularPrice: pl.price,
    contract: pl.contract,
    dataCap: pl.dataCap,
    features: pl.features,
  })),
}));
---

<div id="ast" class="ast">
  <button id="ast-btn" class="ast-btn" aria-label="Chat with Internet Advisor">
    <svg id="ast-ico-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    <svg id="ast-ico-x" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span class="ast-badge" id="ast-badge">1</span>
  </button>

  <div id="ast-panel" class="ast-panel" style="display:none">
    <div class="ast-hdr">
      <div class="ast-hdr-row">
        <div class="ast-hdr-left">
          <div class="ast-avatar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4v1a4 4 0 01-8 0V6a4 4 0 014-4z"/><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/></svg>
          </div>
          <div>
            <strong class="ast-name">Internet Advisor</strong>
            <span class="ast-online"><span class="ast-dot-on"></span> Live Chat</span>
          </div>
        </div>
        <button id="ast-x" class="ast-x-btn" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div id="ast-msgs-chat" class="ast-msgs"></div>

    <form id="ast-form" class="ast-form" autocomplete="off">
      <input type="text" id="ast-inp" class="ast-inp" placeholder="Ask about plans, speeds, pricing..." />
      <button type="submit" class="ast-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>

<script id="ast-data" type="application/json" set:html={JSON.stringify(partners)} />

<script>
(function () {
  const GEMINI_KEY = import.meta.env.PUBLIC_GEMINI_KEY;
  const GEMINI_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_KEY}`;
  const partners = JSON.parse(document.getElementById('ast-data').textContent);

  const BROAD_SLUGS = ['att-air', 'earthlink'];
  const broadProviders = partners.filter((p) => BROAD_SLUGS.includes(p.slug));

  const nameToSlug = {};
  partners.forEach((p) => {
    nameToSlug[p.name.toLowerCase()] = p.slug;
    if (p.slug === 'att-fiber') nameToSlug['at&t'] = p.slug;
    if (p.slug === 'att-air') nameToSlug['at&t air'] = p.slug;
    if (p.slug === 'tmobile-fiber') nameToSlug['t-mobile'] = p.slug;
    if (p.slug === 'tmobile-5g') nameToSlug['t-mobile 5g'] = p.slug;
  });

  let zipData = null;
  let zipLoading = null;
  let _pendingMsg = null;

  async function loadZipCoverage() {
    if (zipData) return zipData;
    if (zipLoading) return zipLoading;
    zipLoading = fetch('/data/zip-coverage.json')
      .then((r) => (r.ok ? r.json() : null))
      .catch(() => null)
      .then((d) => {
        zipData = d;
        return d;
      });
    return zipLoading;
  }

  function buildZipContext(zip) {
    const confirmed = (zipData && zipData[zip]) || [];
    const covIds = confirmed.map((e) => e.id);
    const matched = partners.filter((p) => covIds.includes(p.slug) || covIds.includes(p.id));
    const count = matched.length;
    let primary = [];
    let secondary = [];

    if (count === 0) {
      primary = broadProviders;
      secondary = partners
        .filter((p) => !BROAD_SLUGS.includes(p.slug))
        .sort((a, b) => a.minPrice - b.minPrice)
        .slice(0, 2);
    } else if (count <= 4) {
      primary = matched;
      secondary = broadProviders;
    } else {
      primary = matched;
    }

    return { providers: [...primary, ...secondary] };
  }

  const btn = document.getElementById('ast-btn');
  const icoOpen = document.getElementById('ast-ico-open');
  const icoX = document.getElementById('ast-ico-x');
  const badge = document.getElementById('ast-badge');
  const panel = document.getElementById('ast-panel');
  const closeBtn = document.getElementById('ast-x');
  const chatMsgs = document.getElementById('ast-msgs-chat');
  const chatForm = document.getElementById('ast-form');
  const chatInput = document.getElementById('ast-inp');

  let isOpen = false;
  let hasGreeted = false;
  let sending = false;
  let lastZip = null;
  let lastZipProviders = [];
  let collectedData = {};
  const chatHistory = [];

  const sysInstruction = `You are a friendly internet advisor at Internet-4-All.com. Talk like a real person, warm and helpful.

PROVIDERS YOU CAN RECOMMEND (never recommend any others):
${partners.map((p) => `- ${p.name} (slug: ${p.slug}) | ${p.types.join('/')} | From $${p.minPrice}/mo | Up to ${p.maxSpeed} Mbps`).join('\n')}

If a [SYSTEM] block provides ZIP coverage data, only recommend the providers listed there.

RULES:
- Keep responses short and natural.
- Lean toward fastest and best plans unless user asks for cheapest.
- Use [[SHOW:slug1|slug2|slug3]] whenever recommending providers.
- Do not quote pricing in narrative text.
- End with a short CTA to tap Order Now.

TAGS:
[[SHOW:slug1|slug2|slug3]]
[[PLAN:slug|Name|speed|upload|price|contract|cap]]
[[ORDER:slug:Plan Name]]
[[DATA:field:value]]
[[READY_TO_ORDER:slug:Plan Name]]`;

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function scroll() {
    chatMsgs.scrollTop = chatMsgs.scrollHeight;
  }

  function bindOrderBtns(container) {
    container.querySelectorAll('.ast-order-btn').forEach((b) => {
      if (b.dataset.bound === '1') return;
      b.dataset.bound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        openSignup(b.dataset.slug, b.dataset.plan);
      });
    });

    container.querySelectorAll('.ast-provider-card[data-slug]').forEach((card) => {
      if (card.dataset.bound === '1') return;
      card.dataset.bound = '1';
      card.addEventListener('click', (e) => {
        if (e.target.closest('.ast-order-btn')) return;
        openSignup(card.dataset.slug, card.dataset.plan);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        openSignup(card.dataset.slug, card.dataset.plan);
      });
    });
  }

  function addMsg(html, role, animate = false) {
    const div = document.createElement('div');
    div.className = `ast-msg ${role === 'user' ? 'ast-msg-user' : 'ast-msg-bot'}`;
    chatMsgs.appendChild(div);
    scroll();

    if (role !== 'user' && animate) {
      typewrite(div, html);
      return;
    }

    div.innerHTML = html;
    bindOrderBtns(div);
    scroll();
  }

  function typewrite(el, html) {
    const tokens = [];
    let i = 0;
    while (i < html.length) {
      if (html[i] === '<') {
        const end = html.indexOf('>', i);
        if (end === -1) {
          tokens.push(html.slice(i));
          i = html.length;
        } else {
          tokens.push(html.slice(i, end + 1));
          i = end + 1;
        }
      } else {
        let j = i;
        while (j < html.length && html[j] !== '<') j++;
        const chunk = html.slice(i, j);
        for (let k = 0; k < chunk.length; k += 3) tokens.push(chunk.slice(k, k + 3));
        i = j;
      }
    }

    let buf = '';
    let idx = 0;

    function step() {
      if (idx >= tokens.length) {
        el.innerHTML = buf;
        bindOrderBtns(el);
        scroll();
        return;
      }
      buf += tokens[idx++];
      el.innerHTML = buf;
      scroll();
      setTimeout(step, 12);
    }

    setTimeout(step, 80);
  }

  function addTyping() {
    const d = document.createElement('div');
    d.className = 'ast-msg ast-msg-bot ast-typing';
    d.id = 'ast-typing';
    d.innerHTML = '<span></span><span></span><span></span>';
    chatMsgs.appendChild(d);
    scroll();
  }

  function removeTyping() {
    document.getElementById('ast-typing')?.remove();
  }

  function rankProviders(list) {
    return [...list].sort((a, b) => {
      if ((b.maxSpeed || 0) !== (a.maxSpeed || 0)) return (b.maxSpeed || 0) - (a.maxSpeed || 0);
      return (a.minPrice || 0) - (b.minPrice || 0);
    });
  }

  function formatBandwidth(value) {
    const n = Number(value) || 0;
    if (!n) return 'N/A';
    if (n >= 1000) {
      const gig = n / 1000;
      const shown = Number.isInteger(gig) ? String(gig) : gig.toFixed(1).replace(/\.0$/, '');
      return `${shown} Gig`;
    }
    return `${n} MB`;
  }

  function buildProviderGrid(slugs) {
    const provs = slugs
      .map((s) => partners.find((x) => x.slug === s.trim()))
      .filter(Boolean)
      .slice(0, 3);
    if (!provs.length) return '';

    let html = '<div class="ast-provider-grid">';
    rankProviders(provs).forEach((p) => {
      const plans = p.plans || [];
      const topPlan = plans[0] || { name: 'Best Plan' };
      const minPrice = plans.length ? Math.min(...plans.map((pl) => pl.price)) : null;
      const maxSpeed = plans.length ? Math.max(...plans.map((pl) => pl.speed)) : null;
      const startingLine =
        minPrice != null
          ? `Starting at <strong class="ast-prov-start-price">$${minPrice}<small>/mo</small></strong>${
              maxSpeed ? `<br><span class="ast-prov-start-speed">Up to ${formatBandwidth(maxSpeed)}</span>` : ''
            }`
          : '';

      html += `<div class="ast-provider-card" data-slug="${esc(p.slug)}" data-plan="${esc(topPlan.name)}" role="button" tabindex="0" aria-label="Order from ${esc(p.name)}">
        <div class="ast-prov-hdr">
          <div class="ast-prov-logo-wrap">
            ${
              p.logo
                ? `<img src="${esc(p.logo)}" alt="${esc(p.name)}" class="ast-prov-logo">`
                : `<span class="ast-prov-logo-fallback">${esc(p.name.charAt(0))}</span>`
            }
          </div>
          <span class="ast-prov-name" title="${esc(p.name)}">${esc(p.name)}</span>
        </div>
        ${startingLine ? `<div class="ast-prov-starting">${startingLine}</div>` : ''}
        <button class="ast-order-btn ast-prov-cta" data-slug="${esc(p.slug)}" data-plan="${esc(topPlan.name)}">Order Now <span class="ast-order-icon">&#x2192;</span></button>
      </div>`;
    });
    html += '</div>';
    return html;
  }

  function buildZipResultReply(zip, providerList) {
    const ranked = rankProviders(providerList || []).slice(0, 3);
    if (!ranked.length) return 'Share your ZIP code and I will pull available providers for your address.';
    const names = ranked.map((p) => p.name).join(', ');
    const slugs = ranked.map((p) => p.slug).join('|');
    return `In ${zip}, providers available include ${names}. Choose one below and tap Order Now to continue.\n[[SHOW:${slugs}]]`;
  }

  function parseResponse(text) {
    let gridHtml = '';
    text = text.replace(/\[\[SHOW:([^\]]+)\]\]/g, (_, slugList) => {
      gridHtml = buildProviderGrid(slugList.split('|'));
      return '';
    });

    let h = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');

    h = h.replace(/\[\[ORDER:([a-z0-9-]+):(.+?)\]\]/g, (_, slug, plan) => {
      return `<button class="ast-order-btn" data-slug="${esc(slug)}" data-plan="${esc(plan)}"><span class="ast-order-icon">&#x2192;</span> Order ${esc(plan)}</button>`;
    });

    h = h.replace(/\[\[PLAN:([a-z0-9-]+)\|(.+?)\|(\d+)\|([^\|]*)\|([^\|]+)\|([^\|]*)\|([^\]]*)\]\]/g, (_, slug, name, down, up, price, contract, cap) => {
      const p = partners.find((x) => x.slug === slug);
      return `<div class="ast-plan-card">
        <div class="ast-plan-hdr"><span class="ast-plan-provider">${esc(p ? p.name : slug)}</span><span class="ast-plan-price">$${esc(price)}<small>/mo</small></span></div>
        <div class="ast-plan-name">${esc(name)}</div>
        <div class="ast-plan-speed">${formatBandwidth(down)} down${up ? ' / ' + formatBandwidth(up) + ' up' : ''}</div>
        <div class="ast-plan-meta">${contract && contract !== 'None' ? contract : 'No contract'} - ${cap && cap !== 'Unlimited' ? cap : 'Unlimited'}</div>
        <button class="ast-order-btn" data-slug="${esc(slug)}" data-plan="${esc(name)}"><span class="ast-order-icon">&#x2192;</span> Order Now</button>
      </div>`;
    });

    h = h.replace(/\[\[DATA:\w+:.+?\]\]/g, '');
    h = h.replace(/\[\[READY_TO_ORDER:.+?\]\]/g, '');
    h = h.replace(/\[\[LOOKUP_ZIP:\d{5}\]\]/g, '');

    return (h.trim() ? h : '') + gridHtml;
  }

  function openSignup(slug) {
    close();
    const modal = document.getElementById('signup-modal');
    if (!modal) return;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    const sel = document.getElementById('su-provider');
    if (sel && slug) {
      sel.value = slug;
      sel.dispatchEvent(new Event('change'));
    }

    setTimeout(() => {
      const nameParts = (collectedData.name || '').split(' ');
      const preset = {
        'su-fname': nameParts[0] || '',
        'su-lname': nameParts.slice(1).join(' ') || '',
        'su-email': collectedData.email,
        'su-address': collectedData.address,
        'su-city': collectedData.city,
        'su-state': collectedData.state,
        'su-zip': collectedData.zip,
      };
      Object.entries(preset).forEach(([id, val]) => {
        if (!val) return;
        const el = document.getElementById(id);
        if (el) el.value = val;
      });
    }, 250);
  }

  function clearSuggestions() {
    chatMsgs.querySelectorAll('.ast-sug-row').forEach((el) => el.remove());
  }

  async function callGemini(text) {
    chatHistory.push({ role: 'user', parts: [{ text }] });
    const res = await fetch(GEMINI_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        system_instruction: { parts: [{ text: sysInstruction }] },
        contents: chatHistory,
        generationConfig: { temperature: 0.6, topP: 0.9, maxOutputTokens: 1800 },
        safetySettings: [
          { category: 'HARM_CATEGORY_HARASSMENT', threshold: 'BLOCK_ONLY_HIGH' },
          { category: 'HARM_CATEGORY_HATE_SPEECH', threshold: 'BLOCK_ONLY_HIGH' },
          { category: 'HARM_CATEGORY_SEXUALLY_EXPLICIT', threshold: 'BLOCK_ONLY_HIGH' },
          { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_ONLY_HIGH' },
        ],
      }),
      signal: AbortSignal.timeout(15000),
    });

    if (!res.ok) throw new Error(`Gemini ${res.status}`);
    const data = await res.json();
    const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
    if (reply) chatHistory.push({ role: 'model', parts: [{ text: reply }] });
    return reply;
  }

  function getFallback(text) {
    const t = text.toLowerCase();
    const sorted = [...partners].sort((a, b) => b.maxSpeed - a.maxSpeed);
    const zipProviders = lastZipProviders.length ? lastZipProviders : sorted;

    if (/\b\d{5}\b/.test(t)) {
      return `Here are the top providers for your area:<br><br>${buildProviderGrid(zipProviders.slice(0, 3).map((p) => p.slug))}`;
    }
    if (/cheap|afford|budget|price/.test(t)) {
      const byPrice = [...zipProviders].sort((a, b) => a.minPrice - b.minPrice);
      return `Here are the most affordable options:<br><br>${buildProviderGrid(byPrice.slice(0, 3).map((p) => p.slug))}`;
    }
    if (/fast|speed|fiber|gig/.test(t)) {
      const bySpeed = [...zipProviders].sort((a, b) => b.maxSpeed - a.maxSpeed);
      return `Top picks for fast internet:<br><br>${buildProviderGrid(bySpeed.slice(0, 3).map((p) => p.slug))}`;
    }
    return `I can help find the right plan. Share your ZIP code and I will pull what is available in your area.<br><br>${buildProviderGrid(sorted.slice(0, 3).map((p) => p.slug))}`;
  }

  async function send(text) {
    if (sending || !text.trim()) return;
    sending = true;

    const userText = text.trim();
    addMsg(esc(userText), 'user');
    clearSuggestions();
    chatInput.value = '';
    chatInput.disabled = true;
    addTyping();

    try {
      let reply = '';
      let geminiOk = false;

      const zipMatch = userText.match(/\b(\d{5})\b/);
      if (zipMatch) {
        lastZip = zipMatch[1];
        await loadZipCoverage();
        const ctx = buildZipContext(lastZip);
        lastZipProviders = rankProviders(ctx.providers || []);
        reply = buildZipResultReply(lastZip, lastZipProviders);
        chatHistory.push({ role: 'model', parts: [{ text: reply }] });
        geminiOk = true;
      }

      if (!geminiOk) {
        reply = await callGemini(userText);
      }

      if (lastZipProviders.length && !/\[\[(SHOW|PLAN):/i.test(reply)) {
        const fallbackSlugs = rankProviders(lastZipProviders)
          .slice(0, 3)
          .map((p) => p.slug)
          .join('|');
        if (fallbackSlugs) reply = `${reply.trim()}\n[[SHOW:${fallbackSlugs}]]`;
      }

      for (const m of reply.matchAll(/\[\[DATA:(\w+):(.+?)\]\]/g)) {
        collectedData[m[1]] = m[2];
      }

      const orderMatch = reply.match(/\[\[READY_TO_ORDER:([a-z0-9-]+):(.+?)\]\]/);
      if (orderMatch) {
        reply = reply.replace(/\[\[READY_TO_ORDER:.+?\]\]/, '').trim();
        removeTyping();
        if (reply) addMsg(parseResponse(reply), 'bot', false);
        openSignup(orderMatch[1], orderMatch[2]);
        sending = false;
        chatInput.disabled = false;
        return;
      }

      removeTyping();
      addMsg(parseResponse(reply), 'bot', true);
    } catch (e) {
      console.error('Assistant error:', e);
      removeTyping();
      addMsg(getFallback(userText), 'bot', false);
    }

    sending = false;
    chatInput.disabled = false;
    chatInput.focus();
  }

  async function greet() {
    const greetings = [
      'Hi there. I can help you find the fastest internet plans in your area. What ZIP code should I check?',
      'Hey. I can help you find the right internet plan. Share your ZIP code and I will pull your options.',
      'Hi and welcome. Let me find the best internet options in your area. What is your ZIP code?',
    ];

    const msg = greetings[Math.floor(Math.random() * greetings.length)];
    chatHistory.push({ role: 'model', parts: [{ text: msg }] });

    const connectDiv = document.createElement('div');
    connectDiv.className = 'ast-msg ast-msg-system';
    connectDiv.textContent = 'Connecting you to a live agent...';
    chatMsgs.appendChild(connectDiv);
    scroll();

    await new Promise((r) => setTimeout(r, 900));
    addTyping();
    await new Promise((r) => setTimeout(r, 700));
    removeTyping();
    connectDiv.remove();
    addMsg(msg, 'bot');

    if (_pendingMsg) {
      const queued = _pendingMsg;
      _pendingMsg = null;
      await new Promise((r) => setTimeout(r, 450));
      send(queued);
    }
  }

  // Widget is hidden until explicitly triggered
  const astRoot = document.getElementById('ast');
  if (astRoot) astRoot.style.display = 'none';

  function open() {
    if (astRoot) astRoot.style.display = '';
    isOpen = true;
    panel.style.display = 'flex';
    icoOpen.style.display = 'none';
    icoX.style.display = 'block';
    badge.style.display = 'none';

    if (!hasGreeted) {
      hasGreeted = true;
      loadZipCoverage();
      greet();
    } else {
      chatInput.focus();
    }
  }

  function close() {
    isOpen = false;
    panel.style.display = 'none';
    icoOpen.style.display = 'block';
    icoX.style.display = 'none';
    // Re-hide the floating button — user must re-trigger from nav
    if (astRoot) astRoot.style.display = 'none';
  }

  btn.addEventListener('click', () => {
    if (isOpen) close();
    else open();
  });
  closeBtn.addEventListener('click', close);
  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    send(chatInput.value);
  });

  window.openAssistant = function (initialMsg) {
    if (initialMsg && typeof initialMsg === 'string' && !hasGreeted) {
      _pendingMsg = initialMsg.trim();
    }
    open();
  };
})();
</script>

<style is:global>
  .ast {
    position: fixed;
    bottom: 80px;
    right: 20px;
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .ast-panel,
  .ast-panel *,
  .ast-panel *::before,
  .ast-panel *::after {
    color: #e0e4ee !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    box-sizing: border-box;
  }

  .ast-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2) !important;
    color: #fff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(102, 126, 234, 0.45);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s;
    position: relative;
    border: none;
  }

  .ast-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 10px 36px rgba(102, 126, 234, 0.55);
  }

  .ast-btn svg {
    color: #fff !important;
  }

  .ast-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 20px;
    height: 20px;
