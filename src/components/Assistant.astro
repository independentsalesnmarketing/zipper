---
import { getPartnerProviders, getMinPrice, getMaxSpeed } from '@lib/providers';

const partners = getPartnerProviders().map(p => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  logo: p.logo,
  phone: p.phone,
  types: p.types,
  rating: p.rating,
  reviewCount: p.reviewCount,
  coverage: p.coverage,
  minPrice: getMinPrice(p),
  maxSpeed: getMaxSpeed(p),
  plans: p.plans.map(pl => ({
    name: pl.name,
    speed: pl.speed,
    uploadSpeed: pl.uploadSpeed,
    price: pl.promoPrice || pl.price,
    regularPrice: pl.price,
    contract: pl.contract,
    dataCap: pl.dataCap,
    features: pl.features,
  })),
}));
---

<!-- Unified Internet Advisor — Chat + Talk in one widget -->
<div id="ast" class="ast">
  <button id="ast-btn" class="ast-btn" aria-label="Chat with Internet Advisor">
    <svg id="ast-ico-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    <svg id="ast-ico-x" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span class="ast-badge" id="ast-badge">1</span>
  </button>

  <div id="ast-panel" class="ast-panel" style="display:none">
    <div class="ast-hdr">
      <div class="ast-hdr-row">
        <div class="ast-hdr-left">
          <div class="ast-avatar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4v1a4 4 0 01-8 0V6a4 4 0 014-4z"/><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/></svg>
          </div>
          <div>
            <strong class="ast-name">Internet Advisor</strong>
            <span class="ast-online"><span class="ast-dot-on"></span> Live Chat</span>
          </div>
        </div>
        <button id="ast-x" class="ast-x-btn" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="ast-tabs" id="ast-tabs">
