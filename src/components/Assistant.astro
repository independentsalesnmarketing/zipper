</div>

<script id="ast-data" type="application/json" set:html={JSON.stringify(partners)} />

<script>
(function(){
  /* ── Config ─────────────────────────────────────────────────── */
  const GEMINI_KEY = 'AIzaSyBMJ6NqtVAhhjZa19hD_yFuRvm_ag8pFcE';
  const GEMINI_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_KEY}`;
  const TTS_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${GEMINI_KEY}`;
  const partners = JSON.parse(document.getElementById('ast-data').textContent);

  const BROAD_SLUGS = ['att-air', 'earthlink'];
  const broadProviders = partners.filter(p => BROAD_SLUGS.includes(p.slug));

  /* Build name→slug lookup for auto-CTA injection */
  const nameToSlug = {};
  partners.forEach(p => {
    nameToSlug[p.name.toLowerCase()] = p.slug;
    /* common short names */
    if(p.slug === 'att-fiber') nameToSlug['at&t'] = p.slug;
    if(p.slug === 'att-air') nameToSlug['at&t air'] = p.slug;
    if(p.slug === 'tmobile-fiber') nameToSlug['t-mobile'] = p.slug;
    if(p.slug === 'tmobile-5g') nameToSlug['t-mobile 5g'] = p.slug;
  });

  /* ── ZIP Coverage ───────────────────────────────────────────── */
  let zipData = null, zipLoading = null;

  async function loadZipCoverage(){
    if(zipData) return zipData;
    if(zipLoading) return zipLoading;
    zipLoading = fetch('/data/zip-coverage.json').then(r => r.ok ? r.json() : null).catch(() => null).then(d => { zipData = d; return d; });
    return zipLoading;
  }

  function buildZipContext(zip){
    const confirmed = (zipData && zipData[zip]) || [];
    const covIds = confirmed.map(e => e.id);
    /* Match by BOTH id and slug — zip-coverage stores provider id (e.g. 'tmobile', 'att')
       while partners have slug (e.g. 'tmobile-fiber', 'att-fiber'). Must check both. */
    const matched = partners.filter(p => covIds.includes(p.slug) || covIds.includes(p.id));
    const count = matched.length;
    let primary = [], secondary = [];

    if(count === 0){
      primary = broadProviders;
      secondary = partners.filter(p => !BROAD_SLUGS.includes(p.slug)).sort((a,b) => a.minPrice - b.minPrice).slice(0,2);
    } else if(count <= 2){
      primary = matched; secondary = broadProviders;
    } else if(count <= 4){
      primary = matched; secondary = broadProviders;
    } else {
      primary = matched;
    }

    const fiberIds = confirmed.filter(e => e.fiber).map(e => e.id);
    const allRec = [...primary, ...secondary];
    let s = `ZIP ${zip} — VERIFIED providers (ONLY recommend these, never others):\n`;
    s += `Confirmed (${count}): ${matched.map(p => `${p.name} (${p.slug})${fiberIds.includes(p.id) || fiberIds.includes(p.slug) ? ' [FIBER]' : ''}`).join(', ') || 'none in our database'}.\n`;
    if(primary.length){
      s += `PRIMARY (recommend first):\n`;
      primary.forEach(p => {
        const best = p.plans[0];
        s += `• ${p.name} (${p.slug}): from $${p.minPrice}/mo, up to ${p.maxSpeed}Mbps — top plan: ${best.name} ${best.speed}Mbps $${best.price}/mo\n`;
      });
    }
    if(secondary.length){
      s += `SECONDARY (also available):\n`;
      secondary.forEach(p => { s += `• ${p.name} (${p.slug}): from $${p.minPrice}/mo, up to ${p.maxSpeed}Mbps\n`; });
    }
    s += `\nWhen responding in [chat] mode, use [[SHOW:slug1|slug2|slug3]] to display the provider cards (use the exact slugs from the list above, up to 3). Never mention providers in text without also showing their cards. Never recommend any provider not listed here.`;
    return { text: s, providers: allRec };
  }

  /* ── DOM Refs ───────────────────────────────────────────────── */
  const btn       = document.getElementById('ast-btn');
  const icoOpen   = document.getElementById('ast-ico-open');
  const icoX      = document.getElementById('ast-ico-x');
  const badge     = document.getElementById('ast-badge');
  const panel     = document.getElementById('ast-panel');
  const closeBtn  = document.getElementById('ast-x');
  const tabs      = document.getElementById('ast-tabs');
  const vbar      = document.getElementById('ast-vbar');
  const vdot      = document.getElementById('ast-vdot');
  const vtxt      = document.getElementById('ast-vtxt');
  const msgs      = document.getElementById('ast-msgs');
  /* sug is now rendered inline inside #ast-msgs, not a fixed element */
  const chatForm  = document.getElementById('ast-form');
  const chatInput = document.getElementById('ast-inp');
  const vctrl     = document.getElementById('ast-vctrl');
  const micBtn    = document.getElementById('ast-mic');
  const vform     = document.getElementById('ast-vform');
  const vinp      = document.getElementById('ast-vinp');

  /* ── State ──────────────────────────────────────────────────── */
  let mode = 'chat';
  let isOpen = false;
  let hasGreeted = false;
  let sending = false;
  let isSpeaking = false;
  let isListening = false;
  let recognition = null;
  let audioCtx = null;      /* TTS playback context (24kHz Gemini audio) */
  let vadAudioCtx = null;   /* Mic analysis context (device-native sample rate) */
  let currentSource = null;
  let speakGen = 0;
  let pendingMicMsg = null; /* live transcription bubble while user is speaking */
  let lastZip = null;
  let lastZipProviders = [];
  let collectedData = {};
  const history = [];

  /* ── System Instruction ─────────────────────────────────────── */
  const sysInstruction = `You are a friendly internet advisor at Internet4All.com. Talk like a real person — warm, helpful, and to the point. Never sound like a bot or a script.

PROVIDERS YOU CAN RECOMMEND (never recommend any others):
${partners.map(p => `• ${p.name} (slug: ${p.slug}) | ${p.types.join('/')} | From $${p.minPrice}/mo | Up to ${p.maxSpeed} Mbps | Plans: ${p.plans.map(pl => `${pl.name} ${pl.speed}Mbps $${pl.price}/mo`).join('; ')}`).join('\n')}

If a [SYSTEM] block provides ZIP coverage data, only recommend the providers listed there.

HOW TO TALK:
- Skip filler like "Great question!" or "Absolutely!" — just answer naturally.
- Lean toward the fastest/best plans first. Only bring up budget options when someone asks.
- Keep your text brief — 1 or 2 casual sentences — then use [[SHOW:]] to display the cards. The cards do the heavy lifting.
- When a user provides a ZIP code, immediately return available providers in that same response and include [[SHOW:...]].
- In narrative text, name providers but do not quote pricing. Pricing belongs on cards only.
- This is conversion-focused: guide users to tap Order Now and start signup.
- Always finish your full sentence before adding any tags.
- Never use your own knowledge of provider availability — only use what's given to you.

TAGS — use these in [chat] mode only:
  [[SHOW:slug1|slug2|slug3]] — display provider cards with all plans (use whenever recommending providers, up to 3 slugs)
  [[PLAN:slug|Name|speed|upload|price|contract|cap]] — highlight a single specific plan
  [[ORDER:slug:Plan Name]] — direct "order this plan" CTA
  [[DATA:field:value]] — silently log: name, zip, email, phone, address, city, state, installDate
  [[READY_TO_ORDER:slug:Plan Name]] — open signup form when ready

In [voice] mode: speak naturally in 1-2 sentences. No tags whatsoever.

EXAMPLES:
  User gives ZIP → "Here's what's available in your area:" [[SHOW:altafiber|spectrum|earthlink]]
  "what do you recommend?" → "For most households I'd go with the gig plan — fastest and most reliable." [[SHOW:altafiber|att-fiber]]
  "what's the cheapest?" → "Here are the most affordable options:" [[SHOW:spectrum|earthlink|att-air]]
  "tell me about the plans" → "Here's a breakdown of what's in your area:" [[SHOW:altafiber|spectrum|earthlink]]`;

  /* ── Helpers ────────────────────────────────────────────────── */
  function esc(s){ const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function scroll(){ msgs.scrollTop = msgs.scrollHeight; }

  /* Pre-create AudioContext on first user gesture */
  function ensureAudioCtx(){
    if(!audioCtx){
      try { audioCtx = new AudioContext({ sampleRate: 24000 }); } catch(e){}
    }
  }

  function ensureVadAudioCtx(){
    if(!vadAudioCtx){
      try { vadAudioCtx = new AudioContext(); } catch(e){}
    }
  }

  /* Set animated orb state: 'listening' | 'thinking' | 'speaking' | '' */
  function setOrbState(state){
    const orb = document.getElementById('ast-vorb');
    if(!orb) return;
    orb.classList.remove('listening','speaking','thinking');
    if(state) orb.classList.add(state);
  }

  /* ── Messages ───────────────────────────────────────────────── */
  function bindOrderBtns(container){
    container.querySelectorAll('.ast-order-btn').forEach(b => {
      if(b.dataset.bound === '1') return;
      b.dataset.bound = '1';
      b.addEventListener('click', e => { e.preventDefault(); openSignup(b.dataset.slug, b.dataset.plan); });
    });

    container.querySelectorAll('.ast-provider-card[data-slug]').forEach(card => {
      if(card.dataset.bound === '1') return;
      card.dataset.bound = '1';
      card.addEventListener('click', e => {
        if(e.target.closest('.ast-order-btn')) return;
        openSignup(card.dataset.slug, card.dataset.plan);
      });
      card.addEventListener('keydown', e => {
        if(e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        openSignup(card.dataset.slug, card.dataset.plan);
      });
    });
  }

  function addMsg(html, role, animate = false){
    const div = document.createElement('div');
    div.className = `ast-msg ${role === 'user' ? 'ast-msg-user' : 'ast-msg-bot'}`;
    msgs.appendChild(div);
    scroll();

    if(role !== 'user' && animate){
      typewrite(div, html);
    } else {
      div.innerHTML = html;
      bindOrderBtns(div);
      scroll();
    }
  }

  /* Typewriter effect — streams HTML token by token */
  function typewrite(el, html){
    /* Split html into tokens: tags and text runs */
    const tokens = [];
    let i = 0;
    while(i < html.length){
      if(html[i] === '<'){
        const end = html.indexOf('>', i);
        if(end === -1){ tokens.push(html.slice(i)); i = html.length; }
        else { tokens.push(html.slice(i, end+1)); i = end+1; }
      } else {
        let j = i;
        while(j < html.length && html[j] !== '<') j++;
        /* chunk visible text into small bursts */
        const chunk = html.slice(i, j);
        for(let k = 0; k < chunk.length; k += 3){
          tokens.push(chunk.slice(k, k+3));
        }
        i = j;
      }
    }

    let buf = '';
    let idx = 0;
    const delay = 12; /* ms per token burst — feels natural */

    function step(){
      if(idx >= tokens.length){
        el.innerHTML = buf;
        bindOrderBtns(el);
        scroll();
        return;
      }
      buf += tokens[idx++];
      el.innerHTML = buf;
      scroll();
      setTimeout(step, delay);
    }
    setTimeout(step, 80);
  }

  function addTyping(){
    const d = document.createElement('div');
    d.className = 'ast-msg ast-msg-bot ast-typing'; d.id = 'ast-typing';
    d.innerHTML = '<span></span><span></span><span></span>';
    msgs.appendChild(d); scroll();
  }
  function removeTyping(){ document.getElementById('ast-typing')?.remove(); }

  /* ── Parse Gemini response → HTML ───────────────────────────── */
  function rankProviders(list){
    return [...list].sort((a, b) => {
      if((b.maxSpeed || 0) !== (a.maxSpeed || 0)) return (b.maxSpeed || 0) - (a.maxSpeed || 0);
      return (a.minPrice || 0) - (b.minPrice || 0);
    });
  }

  function buildProviderGrid(slugs){
    const provs = slugs
      .map(s => partners.find(x => x.slug === s.trim()))
      .filter(Boolean)
      .slice(0, 3);
    if(!provs.length) return '';
    let html = '<div class="ast-provider-grid">';
    rankProviders(provs).forEach(p => {
      const plans = (p.plans || []).slice(0, 3);
      const topPlan = plans[0] || { name: 'Best Plan' };
      html += `<div class="ast-provider-card" data-slug="${esc(p.slug)}" data-plan="${esc(topPlan.name)}" role="button" tabindex="0" aria-label="Order from ${esc(p.name)}">
        <div class="ast-prov-hdr">
          ${p.logo ? `<img src="${esc(p.logo)}" alt="${esc(p.name)}" class="ast-prov-logo">` : ''}
          <span class="ast-prov-name">${esc(p.name)}</span>
        </div>
        <div class="ast-prov-plans">`;
      plans.forEach(pl => {
        html += `<div class="ast-prov-plan-row">
          <span class="ast-prov-plan-name">${esc(pl.name)}</span>
          <span class="ast-prov-plan-speed">${pl.download || ''}${pl.download ? ' Mbps' : ''}</span>
          <span class="ast-prov-plan-price">$${esc(String(pl.price))}<small>/mo</small></span>
        </div>`;
      });
      html += `</div>
        <button class="ast-order-btn ast-prov-cta" data-slug="${esc(p.slug)}" data-plan="${esc(topPlan.name)}">
          Order Now <span class="ast-order-icon">&#x2192;</span>
        </button>
      </div>`;
    });
    html += '</div>';
    return html;
  }

  function buildZipResultReply(zip, providerList){
    const ranked = rankProviders(providerList || []).slice(0, 3);
    if(!ranked.length) return `I can help with that. Share your ZIP code and I will pull available providers for your address.`;
    const names = ranked.map(p => p.name).join(', ');
    const slugs = ranked.map(p => p.slug).join('|');
    return `In ${zip}, providers available include ${names}. Choose one below and tap Order Now to continue to signup.\n[[SHOW:${slugs}]]`;
  }

  function parseResponse(text){
    /* Strip [[SHOW:]] from text first — render it separately after */
    let gridHtml = '';
    text = text.replace(/\[\[SHOW:([^\]]+)\]\]/g, (_, slugList) => {
      gridHtml = buildProviderGrid(slugList.split('|'));
      return '';
    });

    let h = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');

    h = h.replace(/\[\[ORDER:([a-z0-9-]+):(.+?)\]\]/g, (_, slug, plan) => {
      return `<button class="ast-order-btn" data-slug="${esc(slug)}" data-plan="${esc(plan)}"><span class="ast-order-icon">&#x2192;</span> Order ${esc(plan)}</button>`;
    });

    h = h.replace(/\[\[PLAN:([a-z0-9-]+)\|(.+?)\|(\d+)\|([^\|]*)\|([^\|]+)\|([^\|]*)\|([^\]]*)\]\]/g,
      (_, slug, name, down, up, price, contract, cap) => {
        const p = partners.find(x => x.slug === slug);
        return `<div class="ast-plan-card">
          <div class="ast-plan-hdr"><span class="ast-plan-provider">${esc(p ? p.name : slug)}</span><span class="ast-plan-price">$${esc(price)}<small>/mo</small></span></div>
          <div class="ast-plan-name">${esc(name)}</div>
          <div class="ast-plan-speed">${down} Mbps${up ? ' ↓ / '+up+' Mbps ↑' : ''}</div>
          <div class="ast-plan-meta">${contract && contract !== 'None' ? contract : 'No contract'} · ${cap && cap !== 'Unlimited' ? cap : 'Unlimited'}</div>
          <button class="ast-order-btn" data-slug="${esc(slug)}" data-plan="${esc(name)}"><span class="ast-order-icon">&#x2192;</span> Order Now</button>
        </div>`;
      }
    );

    h = h.replace(/\[\[DATA:\w+:.+?\]\]/g, '');
    h = h.replace(/\[\[READY_TO_ORDER:.+?\]\]/g, '');
    h = h.replace(/\[\[LOOKUP_ZIP:\d{5}\]\]/g, '');

    /* Append provider grid after text */
    return (h.trim() ? h : '') + gridHtml;
  }

  /* Detect which partner providers are mentioned in the response text */
  function detectMentionedProviders(text){
    const lower = text.toLowerCase();
    const found = [];
    const seen = new Set();
    partners.forEach(p => {
      if(seen.has(p.slug)) return;
      const pName = p.name.toLowerCase();
      if(lower.includes(pName)){
        found.push(p); seen.add(p.slug);
      }
    });
    return found.slice(0, 4);
  }

  function getSpokenText(text){
    return text
      .replace(/\[\[SHOW:[^\]]+\]\]/g, '')
      .replace(/\[\[ORDER:.+?\]\]/g, '')
      .replace(/\[\[PLAN:.+?\]\]/g, '')
      .replace(/\[\[DATA:\w+:.+?\]\]/g, '')
      .replace(/\[\[READY_TO_ORDER:.+?\]\]/g, '')
      .replace(/\*\*(.+?)\*\*/g, '$1')
      .replace(/\n+/g, ' ')
      .trim();
  }

  /* ── Open SignUpForm ────────────────────────────────────────── */
  function openSignup(slug, planName){
    close();
    const modal = document.getElementById('signup-modal');
    if(!modal) return;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    const sel = document.getElementById('su-provider');
    if(sel && slug){ sel.value = slug; sel.dispatchEvent(new Event('change')); }
    setTimeout(() => {
      const ps = document.getElementById('su-plan');
      if(ps && planName){
        for(const o of ps.options){ if(o.textContent.includes(planName)){ ps.value = o.value; ps.dispatchEvent(new Event('change')); break; } }
      }
      for(const [id, val] of Object.entries({
        'su-name': collectedData.name, 'su-email': collectedData.email,
        'su-phone': collectedData.phone, 'su-address': collectedData.address,
        'su-city': collectedData.city, 'su-state': collectedData.state, 'su-zip': collectedData.zip,
      })){
        if(val){ const el = document.getElementById(id); if(el) el.value = val; }
      }
    }, 250);
  }

  /* ── Suggestions (rendered inline in message stream) ─────── */
  function clearSuggestions(){
    msgs.querySelectorAll('.ast-sug-row').forEach(el => el.remove());
  }

  function showSuggestions(){ /* no-op — chip suggestions removed */ }
  function showFollowUps(){ /* no-op — chip suggestions removed */ }

  /* ── Gemini API ─────────────────────────────────────────────── */
  async function callGemini(text){
    history.push({ role: 'user', parts: [{ text }] });
    const res = await fetch(GEMINI_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        system_instruction: { parts: [{ text: sysInstruction }] },
        contents: history,
        generationConfig: { temperature: 0.6, topP: 0.9, maxOutputTokens: 1800 },
        safetySettings: [
          { category: 'HARM_CATEGORY_HARASSMENT', threshold: 'BLOCK_ONLY_HIGH' },
          { category: 'HARM_CATEGORY_HATE_SPEECH', threshold: 'BLOCK_ONLY_HIGH' },
          { category: 'HARM_CATEGORY_SEXUALLY_EXPLICIT', threshold: 'BLOCK_ONLY_HIGH' },
          { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_ONLY_HIGH' },
        ]
      }),
      signal: AbortSignal.timeout(15000),
    });
    if(!res.ok) throw new Error(`Gemini ${res.status}`);
    const data = await res.json();
    const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
    if(reply) history.push({ role: 'model', parts: [{ text: reply }] });
    return reply;
  }

  /* ── Speech Recognition — cross-browser ────────────────────── */
  /* Strategy: Use native SpeechRecognition where available (Chrome, Edge, Safari).
     For Firefox and others, use MediaRecorder to capture mic audio then Gemini to
     transcribe it (Gemini accepts audio natively). This gives us full cross-browser
     voice support without any third-party STT service. */

  let micStream = null;
  let mediaRecorder = null;
  let audioChunks = [];
  let useNativeSTT = !!(window.SpeechRecognition || window.webkitSpeechRecognition);

  function initRecognition(){
    if(useNativeSTT) return initNativeRecognition();
    /* For browsers without SpeechRecognition (Firefox), return a shim
       that uses MediaRecorder. The actual recording logic is in startRecording()/stopRecording(). */
    return { _fallback: true };
  }

  function initNativeRecognition(){
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if(!SR) return null;
    const r = new SR();
    r.continuous = true; r.interimResults = true; r.lang = 'en-US';

    let lastInterimText = '';

    /* ── Dual VAD system ─────────────────────────────────────────
       1. Audio-level VAD: uses a SEPARATE AudioContext at the device's
          native sample rate (not the 24kHz TTS context) so the
          AnalyserNode actually gets mic data. Detects when audio
          energy drops below threshold after speech.
       2. Transcript-change timer: tracks when the interim transcript
          text STOPS CHANGING. If the same text persists for the
          silence duration, the user has stopped talking. This works
          even if the AnalyserNode fails for any reason.
       Whichever fires first wins and calls r.stop().
       ─────────────────────────────────────────────────────────── */
    let vadCtx = null;       /* separate AudioContext at native sample rate */
    let vadSourceNode = null;
    let vadAnalyser = null;
    let vadRaf = null;
    let vadSilenceTimer = null;
    let vadHadSpeech = false;
    let textChangeTimer = null; /* transcript-change timer */
    let lastSeenText = '';      /* last transcript text we saw */
    let gotAnyInterim = false;  /* have we seen any speech at all? */
    const SILENCE_MS = 1800;    /* 1.8s of silence → stop */
    const VAD_THRESHOLD = 6;    /* RMS energy threshold (0-255 scale) */

    function startVAD(){
      vadHadSpeech = false; gotAnyInterim = false;
      lastSeenText = '';
      clearTimeout(vadSilenceTimer); vadSilenceTimer = null;
      clearTimeout(textChangeTimer); textChangeTimer = null;

      /* Audio-level VAD: use a separate AudioContext at DEFAULT sample rate
         so the AnalyserNode reads the mic correctly (the 24kHz TTS context
         causes zero-energy readings on most browsers). */
      requestMic().then(stream => {
        if(!stream || !isListening) return;
        try {
          if(!vadCtx) vadCtx = new AudioContext(); /* default sample rate: 44100/48000 */
          if(vadCtx.state === 'suspended') vadCtx.resume();
          vadAnalyser = vadCtx.createAnalyser();
          vadAnalyser.fftSize = 512;
          vadSourceNode = vadCtx.createMediaStreamSource(stream);
          vadSourceNode.connect(vadAnalyser);

          const buf = new Uint8Array(vadAnalyser.frequencyBinCount);
          const tick = () => {
            if(!isListening) return;
            vadAnalyser.getByteFrequencyData(buf);
            let sum = 0;
            for(let i = 0; i < buf.length; i++) sum += buf[i];
            const rms = sum / buf.length;

            if(rms > VAD_THRESHOLD){
              vadHadSpeech = true;
              clearTimeout(vadSilenceTimer); vadSilenceTimer = null;
            } else if(vadHadSpeech && !vadSilenceTimer){
              /* Speech → silence transition: start countdown */
              vadSilenceTimer = setTimeout(() => {
                vadSilenceTimer = null;
                if(isListening){ try { r.stop(); } catch(e){} }
              }, SILENCE_MS);
            }
            vadRaf = requestAnimationFrame(tick);
          };
          vadRaf = requestAnimationFrame(tick);
        } catch(e){ /* Audio VAD setup failed — transcript timer is backup */ }
      }).catch(() => {});
    }

    function stopVAD(){
      clearTimeout(vadSilenceTimer); vadSilenceTimer = null;
      clearTimeout(textChangeTimer); textChangeTimer = null;
      cancelAnimationFrame(vadRaf);
      vadHadSpeech = false; gotAnyInterim = false; lastSeenText = '';
      if(vadSourceNode){ try { vadSourceNode.disconnect(); } catch(e){} vadSourceNode = null; }
    }

    /* Reset the transcript-change timer. Called on every onresult.
       If the transcript doesn't change for SILENCE_MS, assume user stopped. */
    function resetTextTimer(currentText){
      clearTimeout(textChangeTimer);
      if(!gotAnyInterim) return; /* don't start timer until user has spoken */
      textChangeTimer = setTimeout(() => {
        textChangeTimer = null;
        /* Transcript hasn't changed — user has stopped speaking */
        if(isListening){ try { r.stop(); } catch(e){} }
      }, SILENCE_MS);
    }

    r.onstart = () => {
      isListening = true;
      lastInterimText = '';
      micBtn.classList.add('ast-mic-on');
      setOrbState('listening');
      setVoiceStatus('listen', '');
      setMicHint('Speak now…');
      if(pendingMicMsg){ pendingMicMsg.remove(); pendingMicMsg = null; }
      startVAD();
    };

    r.onresult = (e) => {
      let interim = '', final = '';
      for(let i = e.resultIndex; i < e.results.length; i++){
        if(e.results[i].isFinal) final += e.results[i][0].transcript;
        else interim += e.results[i][0].transcript;
      }
      const liveText = final || interim;
      if(interim){ lastInterimText = interim; gotAnyInterim = true; }

      if(liveText){
        if(!pendingMicMsg){
          pendingMicMsg = document.createElement('div');
          pendingMicMsg.className = 'ast-msg ast-msg-user ast-msg-pending';
          msgs.appendChild(pendingMicMsg);
        }
        pendingMicMsg.textContent = liveText;
        msgs.scrollTop = msgs.scrollHeight;
      }

      if(final){
        stopVAD();
        lastInterimText = '';
        if(pendingMicMsg){ pendingMicMsg.remove(); pendingMicMsg = null; }
        const tr = document.getElementById('ast-vtranscript');
        if(tr) tr.textContent = '';
        try { r.stop(); } catch(e2){}
        send(final.trim());
      } else if(interim){
        /* Always run transcript-change timer as backup VAD */
        resetTextTimer(interim);
      }
    };

    r.onerror = (e) => {
      stopVAD();
      isListening = false;
      micBtn.classList.remove('ast-mic-on');
      setOrbState('');
      if(pendingMicMsg){ pendingMicMsg.remove(); pendingMicMsg = null; }
      if(e.error === 'no-speech'){
        setVoiceStatus('listen', '');
        setMicHint('Tap the mic and speak');
        /* Auto-restart in talk mode */
        if(mode === 'talk' && isOpen && !isSpeaking && !sending){
          setTimeout(() => {
            if(mode === 'talk' && isOpen && !isListening && !isSpeaking && !sending){
              try { r.start(); } catch(e2){}
            }
          }, 400);
        }
      }
      else if(e.error === 'not-allowed') setVoiceStatus('idle', 'Mic access denied — type below');
      else if(e.error !== 'aborted') setVoiceStatus('idle', 'Tap microphone to speak');
    };

    r.onend = () => {
      stopVAD();
      isListening = false;
      micBtn.classList.remove('ast-mic-on');
      if(!isSpeaking && !sending) setOrbState('');
      if(!sending && lastInterimText.trim()){
        const fallback = lastInterimText.trim();
        lastInterimText = '';
        if(pendingMicMsg){ pendingMicMsg.remove(); pendingMicMsg = null; }
        send(fallback);
      } else {
        lastInterimText = '';
        if(pendingMicMsg){ pendingMicMsg.remove(); pendingMicMsg = null; }
        /* Auto-restart listening in talk mode if nothing was sent */
        if(mode === 'talk' && isOpen && !isSpeaking && !sending){
          setTimeout(() => {
            if(mode === 'talk' && isOpen && !isListening && !isSpeaking && !sending){
              try { r.start(); } catch(e2){}
            }
          }, 400);
        }
      }
    };
    return r;
  }

  /* ── MediaRecorder fallback for Firefox / non-Chrome ─────── */
  async function requestMic(){
    if(micStream) return micStream;
    try {
      micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      return micStream;
    } catch(e){
      setVoiceStatus('idle', 'Mic access denied — type below');
      return null;
    }
  }

  let vadTimer = null;       /* silence timeout handle */
  let mediaVadRaf = null;    /* requestAnimationFrame handle for Firefox VAD loop */
  let mediaVadSource = null; /* MediaStreamAudioSourceNode for Firefox VAD */
  const VAD_SILENCE_MS = 900; /* shorter silence threshold for snappier turn-taking */

  function cleanupMediaVad(){
    clearTimeout(vadTimer); vadTimer = null;
    cancelAnimationFrame(mediaVadRaf); mediaVadRaf = null;
    if(mediaVadSource){ try { mediaVadSource.disconnect(); } catch(e){} mediaVadSource = null; }
  }

  async function startRecording(){
    const stream = await requestMic();
    if(!stream) return false;
    audioChunks = [];
    try {
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm;codecs=opus' });
    } catch {
      try { mediaRecorder = new MediaRecorder(stream); } catch(e2){ return false; }
    }
    mediaRecorder.ondataavailable = (e) => { if(e.data.size > 0) audioChunks.push(e.data); };
    mediaRecorder.start(100);
    isListening = true;
    micBtn.classList.add('ast-mic-on');
    setOrbState('listening');
    setVoiceStatus('listen', '');
    setMicHint('Speak now…');

    /* Firefox path: time-domain VAD on a separate native-sample-rate AudioContext */
    cleanupMediaVad();
    try {
      ensureVadAudioCtx();
      if(vadAudioCtx && vadAudioCtx.state === 'suspended') await vadAudioCtx.resume();
      const analyser = vadAudioCtx.createAnalyser();
      analyser.fftSize = 1024;
      analyser.smoothingTimeConstant = 0.12;
      mediaVadSource = vadAudioCtx.createMediaStreamSource(stream);
      mediaVadSource.connect(analyser);

      const buf = new Uint8Array(analyser.fftSize);
      let speechFrames = 0;
      let noiseFloor = 0.004; /* adaptive ambient noise estimate */

      const tick = () => {
        if(!isListening){ cleanupMediaVad(); return; }

        analyser.getByteTimeDomainData(buf);
        let sumSq = 0;
        for(let i = 0; i < buf.length; i++){
          const centered = (buf[i] - 128) / 128;
          sumSq += centered * centered;
        }
        const rms = Math.sqrt(sumSq / buf.length);

        /* Update ambient noise estimate only during low-energy windows. */
        if(speechFrames < 3 || rms < 0.02){
          noiseFloor = (noiseFloor * 0.92) + (rms * 0.08);
        }
        const startThreshold = Math.max(noiseFloor * 2.2, 0.008);
        const stopThreshold = Math.max(noiseFloor * 1.6, 0.006);

        if(rms > startThreshold){
          speechFrames = Math.min(speechFrames + 1, 999);
          clearTimeout(vadTimer); vadTimer = null;
        } else if(speechFrames >= 3 && rms < stopThreshold && !vadTimer){
          vadTimer = setTimeout(() => {
            vadTimer = null;
            if(isListening) stopListeningAndTranscribe();
          }, VAD_SILENCE_MS);
        }

        mediaVadRaf = requestAnimationFrame(tick);
      };

      mediaVadRaf = requestAnimationFrame(tick);
    } catch(e){
      /* If VAD setup fails, user can still end turn manually with mic tap */
    }

    return true;
  }

  async function stopRecording(){
    cleanupMediaVad();
    if(!mediaRecorder || mediaRecorder.state === 'inactive') return '';
    return new Promise(resolve => {
      mediaRecorder.onstop = async () => {
        isListening = false;
        micBtn.classList.remove('ast-mic-on');
        setOrbState('thinking');
        setVoiceStatus('think', 'Transcribing...');
        const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
        audioChunks = [];
        if(blob.size < 1000){ setOrbState(''); setVoiceStatus('idle', 'Tap mic to speak'); resolve(''); return; }
        /* Send audio to Gemini for transcription */
        try {
          const buf = await blob.arrayBuffer();
          const b64 = btoa(String.fromCharCode(...new Uint8Array(buf)));
          const res = await fetch(GEMINI_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ role: 'user', parts: [
                { inlineData: { mimeType: mediaRecorder.mimeType || 'audio/webm', data: b64 } },
                { text: 'Transcribe this audio exactly. Return ONLY the spoken words, nothing else. No quotes, no labels, no extra text.' }
              ]}],
              generationConfig: { temperature: 0, maxOutputTokens: 500 },
            }),
            signal: AbortSignal.timeout(15000),
          });
          if(!res.ok) throw new Error('Transcription failed');
          const data = await res.json();
          const transcript = (data?.candidates?.[0]?.content?.parts?.[0]?.text || '').trim();
          resolve(transcript);
        } catch(e){
          console.warn('Gemini transcription failed:', e);
          setOrbState(''); setVoiceStatus('idle', 'Could not transcribe — tap mic to retry');
          resolve('');
        }
      };
      mediaRecorder.stop();
    });
  }

  /* Unified start/stop that works with both native and fallback */
  function startListening(){
    if(isListening) return;
    if(recognition && !recognition._fallback){
      try { recognition.start(); } catch(e){ setVoiceStatus('idle', 'Tap mic to speak'); }
    } else {
      startRecording();
    }
  }

  async function stopListeningAndTranscribe(){
    if(recognition && !recognition._fallback){
      if(isListening) recognition.stop();
      return; /* native handles send() in onresult */
    }
    const transcript = await stopRecording();
    const tr = document.getElementById('ast-vtranscript');
    if(tr) tr.textContent = '';
    if(transcript) send(transcript);
    else { setOrbState(''); setVoiceStatus('idle', 'Tap mic to speak'); }
  }

  /* ── Gemini TTS — real AI voice ─────────────────────────────── */
  async function speak(text, { onStart } = {}){  /* onStart fires when audio actually begins playing */
    if(!text) return;
    const myGen = ++speakGen;
    /* Stop any active mic before TTS — avoids feedback and interference */
    if(isListening){
      if(recognition && !recognition._fallback){ try { recognition.stop(); } catch(e){} }
      else if(mediaRecorder && mediaRecorder.state !== 'inactive'){ try { mediaRecorder.stop(); } catch(e){} }
      isListening = false; micBtn.classList.remove('ast-mic-on');
    }
    isSpeaking = true;
    setVoiceStatus('speak', 'Speaking...');
    setOrbState('speaking');

    /* Preprocess ZIP codes for digit-by-digit pronunciation: 90210 → "9 0 2 1 0" */
    text = text.replace(/\b(\d{5})\b/g, (m) => m.split('').join(' '));

    try {
      ensureAudioCtx();

      const res = await fetch(TTS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ role: 'user', parts: [{ text: `Say naturally, like a friendly phone advisor helping someone pick an internet plan: ${text}` }] }],
          generationConfig: {
            responseModalities: ['AUDIO'],
            speechConfig: {
              voiceConfig: {
                prebuiltVoiceConfig: { voiceName: 'Sulafat' }
              }
            }
          }
        }),
        signal: AbortSignal.timeout(25000),
      });

      if(myGen !== speakGen) return; /* aborted by new speak/stop */
      if(!res.ok) throw new Error(`TTS ${res.status}`);
      const data = await res.json();
      if(myGen !== speakGen) return;
      const part = data?.candidates?.[0]?.content?.parts?.[0];
      const audioB64 = part?.inlineData?.data || part?.inline_data?.data;
      if(!audioB64) throw new Error('No audio in response');

      const raw = atob(audioB64);
      const bytes = new Uint8Array(raw.length);
      for(let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);

      if(audioCtx && audioCtx.state === 'suspended') await audioCtx.resume();

      const samples = bytes.length / 2;
      if(samples < 1) throw new Error('Empty audio');
      const buffer = audioCtx.createBuffer(1, samples, 24000);
      const channel = buffer.getChannelData(0);
      const view = new DataView(bytes.buffer);
      for(let i = 0; i < samples; i++) channel[i] = view.getInt16(i * 2, true) / 32768;

      if(myGen !== speakGen) return;
      await new Promise(resolve => {
        if(currentSource){ try { currentSource.stop(); } catch(e){} }
        const source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.connect(audioCtx.destination);
        source.onended = resolve;
        /* Fire onStart synchronously right before audio plays — text and voice in sync */
        try { if(onStart) onStart(); } catch(e){}
        source.start();
        currentSource = source;
      });
    } catch(e){
      console.warn('Gemini TTS unavailable:', e.message);
    }

    if(myGen !== speakGen) return; /* aborted — don't touch state */
    isSpeaking = false;
    currentSource = null;
    setOrbState('');

    /* Auto-listen after speaking in Talk mode */
    if(mode === 'talk' && isOpen && recognition){
      setVoiceStatus('listen', '');
      setMicHint('Tap the mic and speak');
      setTimeout(() => {
        if(mode === 'talk' && isOpen && !isSpeaking && !isListening && !sending){
          startListening();
        }
      }, 400);
    } else if(mode === 'talk' && isOpen){
      setVoiceStatus('idle', '');
      setMicHint('Tap the mic and speak');
    }
  }

  function stopSpeaking(){
    speakGen++; /* invalidate any running speak() */
    if(currentSource){ try { currentSource.stop(); } catch(e){} currentSource = null; }
    isSpeaking = false;
    setOrbState('');
  }

  /* ── Voice status bar ───────────────────────────────────────── */
  function setVoiceStatus(state, text){
    vtxt.textContent = text;
    vdot.className = 'ast-vbar-dot ast-vdot-' + state;
  }

  function setMicHint(text){
    const el = document.getElementById('ast-mic-hint');
    if(el) el.textContent = text;
  }

  /* ── Send message ───────────────────────────────────────────── */
  async function send(text){
    if(sending || !text.trim()) return;
    sending = true;
    stopSpeaking(); /* interrupt any current TTS so new message can proceed */
    const userText = text.trim();
    addMsg(esc(userText), 'user');
    clearSuggestions();
    chatInput.value = ''; vinp.value = '';
    chatInput.disabled = true;
    addTyping();
    if(mode === 'talk') setVoiceStatus('think', 'Thinking...');
    if(mode === 'talk') setOrbState('thinking');

    let reply = '';
    let geminiOk = false;

    try {
      const modeTag = mode === 'talk' ? '[voice] ' : '[chat] ';
      let geminiText = modeTag + userText;

      const zipMatch = userText.match(/\b(\d{5})\b/);
      if(zipMatch){
        lastZip = zipMatch[1];
        await loadZipCoverage();
        const ctx = buildZipContext(zipMatch[1]);
        lastZipProviders = rankProviders(ctx.providers || []);
        reply = buildZipResultReply(lastZip, lastZipProviders);
        history.push({ role: 'model', parts: [{ text: reply }] });
        geminiOk = true;
      }

      if(!geminiOk){
        reply = await callGemini(geminiText);
        geminiOk = true;
      }

      if(mode === 'chat' && lastZipProviders.length && !/\[\[(SHOW|PLAN):/i.test(reply)){
        const fallbackSlugs = rankProviders(lastZipProviders).slice(0, 3).map(p => p.slug).join('|');
        if(fallbackSlugs) reply = `${reply.trim()}\n[[SHOW:${fallbackSlugs}]]`;
      }

      /* Extract [[DATA:field:value]] silently */
      for(const m of reply.matchAll(/\[\[DATA:(\w+):(.+?)\]\]/g)) collectedData[m[1]] = m[2];

      /* Check for [[READY_TO_ORDER:slug:plan]] */
      const orderMatch = reply.match(/\[\[READY_TO_ORDER:([a-z0-9-]+):(.+?)\]\]/);
      if(orderMatch){
        reply = reply.replace(/\[\[READY_TO_ORDER:.+?\]\]/, '').trim();
        setOrbState('');
        removeTyping();
        if(reply) addMsg(parseResponse(reply), 'bot', false);
        /* TTS for order confirmation — separate try/catch */
        if(mode === 'talk' && reply){
          try { await speak(getSpokenText(reply)); } catch(e){}
        }
        openSignup(orderMatch[1], orderMatch[2]);
        sending = false; chatInput.disabled = false;
        return;
      }

      setOrbState('');
      if(mode === 'chat'){
        removeTyping();
        addMsg(parseResponse(reply), 'bot', true);
      } else {
        /* Talk mode: typing indicator stays until audio starts */
      }

    } catch(e){
      console.error('Assistant error:', e);
      setOrbState('');
      removeTyping();
      addMsg(getFallback(userText), 'bot', false);
    }

    /* Release sending lock BEFORE TTS so buttons/input work during voice playback */
    sending = false;
    chatInput.disabled = false;
    if(mode === 'chat') chatInput.focus();

    /* Talk mode: show text in sync with audio via onStart — no 7-second gap */
    if(mode === 'talk' && geminiOk && reply){
      const displayHtml = parseResponse(reply);
      let shown = false;
      const showReply = () => { if(!shown){ shown = true; removeTyping(); addMsg(displayHtml, 'bot', false); } };
      speak(getSpokenText(reply), { onStart: showReply })
        .then(showReply)   /* Ensure shown after speak resolves (covers TTS failure) */
        .catch(showReply);
    } else if(mode === 'talk' && isOpen && !geminiOk){
      setVoiceStatus('idle', '');
      setMicHint('Tap the mic and speak');
    }
  }

  /* ── Fallback response (when API fails) ─────────────────────── */
  function getFallback(text){
    const t = text.toLowerCase();
    const sorted = [...partners].sort((a,b) => b.maxSpeed - a.maxSpeed);
    const zipProviders = lastZipProviders.length ? lastZipProviders : sorted;

    const card = (p) => buildProviderGrid([p.slug]);

    if(/\b\d{5}\b/.test(t)){
      return `Here are the top providers for your area:<br><br>${buildProviderGrid(zipProviders.slice(0,3).map(p => p.slug))}`;
    }
    if(/cheap|afford|budget|price/.test(t)){
      const byPrice = [...zipProviders].sort((a,b) => a.minPrice - b.minPrice);
      return `Here are the most affordable options I have:<br><br>${buildProviderGrid(byPrice.slice(0,3).map(p => p.slug))}`;
    }
    if(/fast|speed|fiber|gig/.test(t)){
      const bySpeed = [...zipProviders].sort((a,b) => b.maxSpeed - a.maxSpeed);
      return `Top picks for fast internet:<br><br>${buildProviderGrid(bySpeed.slice(0,3).map(p => p.slug))}`;
    }
    return `I can help find the right plan. Share your ZIP code and I’ll pull up what’s available in your area. Here are some top providers to start:<br><br>${buildProviderGrid(sorted.slice(0,3).map(p => p.slug))}`;
  }

  /* ── Mode switching ─────────────────────────────────────────── */
  function switchMode(newMode){
    if(mode === newMode) return;
    if(mode === 'talk'){
      stopSpeaking();
      if(isListening){
        if(recognition && !recognition._fallback && recognition.abort) recognition.abort();
        else if(mediaRecorder && mediaRecorder.state !== 'inactive') try { mediaRecorder.stop(); } catch(e){}
        isListening = false; micBtn.classList.remove('ast-mic-on');
      }
    }
    mode = newMode;

    tabs.querySelectorAll('.ast-tab').forEach(t => {
      t.classList.toggle('ast-tab-on', t.dataset.mode === newMode);
    });

    if(newMode === 'chat'){
      chatForm.style.display = 'flex';
      vctrl.style.display = 'none';
      vbar.style.display = 'none';
      chatInput.focus();
    } else {
      chatForm.style.display = 'none';
      vctrl.style.display = 'flex';
      vbar.style.display = 'flex';
      if(!recognition) recognition = initRecognition();
      ensureAudioCtx();
      setVoiceStatus('think', 'Connecting you to a live agent…');
      setMicHint('');
      /* Request mic for audio-level VAD + auto-start listening */
      if(recognition && !recognition._fallback){
        requestMic().then(() => {
          setVoiceStatus('listen', '');
          setMicHint('Tap the mic and speak');
          if(!isListening && !isSpeaking && !sending){
            setTimeout(() => { startListening(); }, 300);
          }
        });
      } else if(recognition && recognition._fallback){
        setVoiceStatus('idle', '');
        setMicHint('Requesting mic access…');
        requestMic().then(stream => {
          if(stream){
            setVoiceStatus('listen', '');
            setMicHint('Tap the mic and speak');
            if(!isListening && !isSpeaking && !sending){
              setTimeout(() => { startListening(); }, 300);
            }
          }
        });
      } else {
        setVoiceStatus('idle', 'Voice not supported — type below');
      }
    }
  }

  /* ── Open / Close ───────────────────────────────────────────── */
  function open(targetMode){
    isOpen = true;
    panel.style.display = 'flex';
    icoOpen.style.display = 'none';
    icoX.style.display = 'block';
    badge.style.display = 'none';
    ensureAudioCtx();

    if(targetMode && targetMode !== mode) switchMode(targetMode);

    if(!hasGreeted){
      hasGreeted = true;
      loadZipCoverage();
      greet();
    } else if(mode === 'chat'){
      chatInput.focus();
    }
  }

  function close(){
    isOpen = false;
    panel.style.display = 'none';
    icoOpen.style.display = 'block';
    icoX.style.display = 'none';
    stopSpeaking();
    if(isListening){
      if(recognition && !recognition._fallback && recognition.abort) recognition.abort();
      else if(mediaRecorder && mediaRecorder.state !== 'inactive') try { mediaRecorder.stop(); } catch(e){}
      isListening = false; micBtn.classList.remove('ast-mic-on');
    }
  }

  /* ── Greeting ───────────────────────────────────────────────── */
  async function greet(){
    const greetings = [
      "Hi there — I can help you find the fastest internet plans available in your area and compare the best options. What ZIP code should I check for you?",
      "Hey! I'm here to help you find the right internet plan. I can pull up what's available at your address if you share your ZIP code.",
      "Hi — welcome! Let me find the best internet options in your area. What's your ZIP code?",
    ];
    const msg = greetings[Math.floor(Math.random() * greetings.length)];
    history.push({ role: 'model', parts: [{ text: msg }] });

    if(mode === 'talk'){
      /* Show flashing "Connecting to an agent" until speech begins */
      setVoiceStatus('think', 'Connecting you to a live agent…');
      setOrbState('thinking');
      const connectingDiv = document.createElement('div');
      connectingDiv.className = 'ast-msg ast-msg-bot ast-connecting';
      connectingDiv.textContent = 'Connecting to an agent....';
      msgs.appendChild(connectingDiv);
      msgs.scrollTop = msgs.scrollHeight;
      await new Promise(r => setTimeout(r, 300));
      /* Remove connecting bubble exactly when speech starts */
      let msgShown = false;
      const showGreeting = () => {
        if(connectingDiv.isConnected) connectingDiv.remove();
        if(!msgShown){ msgShown = true; addMsg(msg, 'bot'); }
      };
      await speak(msg, { onStart: showGreeting });
      showGreeting();
    } else {
      /* Chat: "Connecting you to a live agent…" system message then greeting */
      const connectDiv = document.createElement('div');
      connectDiv.className = 'ast-msg ast-msg-system';
      connectDiv.textContent = 'Connecting you to a live agent\u2026';
      msgs.appendChild(connectDiv);
      msgs.scrollTop = msgs.scrollHeight;
      await new Promise(r => setTimeout(r, 900));
      addTyping();
      await new Promise(r => setTimeout(r, 700));
      removeTyping();
      connectDiv.remove();
      addMsg(msg, 'bot');
    }
  }

  /* ── Mic toggle ─────────────────────────────────────────────── */
  function toggleMic(){
    ensureAudioCtx();
    if(isSpeaking){
      /* Interrupt AI speech and start listening */
      stopSpeaking();
      startListening();
      return;
    }
    if(!recognition){
      recognition = initRecognition();
      if(!recognition){
        setVoiceStatus('idle', 'No mic support — type below');
        vinp.focus();
        return;
      }
    }
    /* Toggle: listening → stop & transcribe; idle → start */
    if(isListening){
      stopListeningAndTranscribe();
    } else {
      startListening();
    }
  }

  /* ── Events ─────────────────────────────────────────────────── */
  btn.addEventListener('click', () => { ensureAudioCtx(); isOpen ? close() : open('chat'); });
  closeBtn.addEventListener('click', close);

  tabs.addEventListener('click', e => {
    const tab = e.target.closest('.ast-tab');
    if(tab) switchMode(tab.dataset.mode);
  });

  chatForm.addEventListener('submit', e => { e.preventDefault(); send(chatInput.value); });
  vform.addEventListener('submit', e => { e.preventDefault(); send(vinp.value); });
  micBtn.addEventListener('click', toggleMic);

  /* Badge after 3s */
  setTimeout(() => { if(!isOpen) badge.style.display = 'flex'; }, 3000);

  /* Global API */
  window.openAssistant = function(targetMode){ open(targetMode || 'chat'); };
  window.openVoiceAgent = function(){ open('talk'); };
})();
</script>

