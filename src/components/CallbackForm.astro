---
import { MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';

interface Props {
  providerName?: string;
  phone?: string;
  compact?: boolean;
}
const { providerName, phone = MAIN_PHONE, compact = false } = Astro.props;
---
<!-- Modal Overlay -->
<div class="modal-overlay" id="signup-modal">
  <div class="modal" style="max-width:560px;">
    <button class="modal-close" id="modal-close-btn" aria-label="Close" style="position:absolute;top:16px;right:16px;background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:4px;z-index:2;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div style="text-align:center;margin-bottom:var(--space-lg);">
      <h3 style="font-size:var(--text-2xl);font-weight:800;margin-bottom:var(--space-xs);">
        {providerName
          ? `Get ${providerName} — Call or Sign Up`
          : 'Get Connected — Call or Sign Up'}
      </h3>
      <p style="font-size:var(--text-sm);color:var(--text-secondary);">Choose how you'd like help. Both options are completely free, no obligation.</p>
    </div>

    <!-- Dual option tabs -->
    <div class="cta-toggle" style="display:flex;gap:0;margin-bottom:var(--space-lg);border:2px solid var(--border);border-radius:var(--radius-md);overflow:hidden;">
      <button type="button" class="cta-tab active" data-tab="form" style="flex:1;padding:var(--space-sm) var(--space-md);border:none;cursor:pointer;font-weight:700;font-size:var(--text-md);transition:all 0.2s;background:var(--brand-green);color:white;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
        Sign Up Online
      </button>
      <button type="button" class="cta-tab" data-tab="call" style="flex:1;padding:var(--space-sm) var(--space-md);border:none;cursor:pointer;font-weight:700;font-size:var(--text-md);transition:all 0.2s;background:var(--white);color:var(--text-secondary);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        Call Now (Last Resort)
      </button>
    </div>

    <!-- FORM tab (now shown by default) -->
    <div class="cta-panel" data-panel="form" style="display:flex;">
      <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-bottom: var(--space-md); text-align: center;">
        Fill out the form and we'll find the best deals for your address. A specialist will reach out at your preferred time.
      </p>
      <form class="flex flex-col gap-md" action="#" method="POST" data-form="callback">
        <div class="grid grid-2 gap-md">
          <div class="form-group">
            <label class="form-label" for="cb-name">Your Name</label>
            <input class="form-input" type="text" id="cb-name" name="name" required placeholder="John Smith" />
          </div>
          <div class="form-group">
            <label class="form-label" for="cb-phone">Phone Number</label>
            <input class="form-input" type="tel" id="cb-phone" name="phone" required placeholder="(555) 123-4567" />
          </div>
        </div>
        <div class="grid grid-2 gap-md">
          <div class="form-group">
            <label class="form-label" for="cb-email">Email Address</label>
            <input class="form-input" type="email" id="cb-email" name="email" required placeholder="john@example.com" />
          </div>
          <div class="form-group">
            <label class="form-label" for="cb-zip">ZIP Code</label>
            <input class="form-input" type="text" id="cb-zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" required placeholder="10001" />
          </div>
        </div>
        <div class="grid grid-2 gap-md">
          <div class="form-group">
            <label class="form-label" for="cb-time">Best Time to Call</label>
            <select class="form-select" id="cb-time" name="preferred_time">
              <option value="morning">Morning (8AM-12PM)</option>
              <option value="afternoon" selected>Afternoon (12PM-5PM)</option>
              <option value="evening">Evening (5PM-8PM)</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="cb-needs">What Do You Need?</label>
            <select class="form-select" id="cb-needs" name="needs">
              <option value="internet">Internet Only</option>
              <option value="bundle">Internet + TV Bundle</option>
              <option value="switching">Switching Providers</option>
              <option value="moving">Moving &amp; Need Internet</option>
              <option value="cheapest">Cheapest Option</option>
              <option value="fastest">Fastest Option</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-full" style="padding:var(--space-md);font-size:var(--text-md);">
          Get My Free Recommendation &#8594;
        </button>
        <p style="font-size:var(--text-xs);color:var(--text-tertiary);text-align:center;margin-top:var(--space-xs);">
          We'll never share your info. Unsubscribe anytime.
        </p>
      </form>
    </div>

    <!-- CALL tab (hidden by default) -->
    <div class="cta-panel" data-panel="call" style="display:none;flex-direction:column;gap:var(--space-md);align-items:center;text-align:center;">
      <div style="display:flex;align-items:center;gap:var(--space-sm);flex-wrap:wrap;justify-content:center;">
        <div>
          <p style="font-weight:800;font-size:var(--text-xl);margin:0;color:var(--text-primary);">Speak to an Expert</p>
          <p style="font-size:var(--text-sm);color:var(--text-secondary);margin:0;">Get matched with the best plan in under 5 minutes</p>
        </div>
      </div>
      <a href={formatPhoneForTel(phone)} class="btn btn-cta btn-lg" style="font-size:var(--text-xl);width:100%;padding:var(--space-md);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        {phone}
      </a>
      <p style="font-size: var(--text-sm); color: var(--text-secondary); margin: 0;">
        Mon-Fri 8AM-10PM EST · Sat-Sun 9AM-8PM EST
      </p>
      <div style="display:flex;gap:var(--space-lg);flex-wrap:wrap;justify-content:center;margin-top:var(--space-xs);">
        <span style="font-size:var(--text-sm);display:flex;align-items:center;gap:4px;"><span style="color:var(--brand-green);">&#10003;</span> 100% Free</span>
        <span style="font-size:var(--text-sm);display:flex;align-items:center;gap:4px;"><span style="color:var(--brand-green);">&#10003;</span> No Obligation</span>
        <span style="font-size:var(--text-sm);display:flex;align-items:center;gap:4px;"><span style="color:var(--brand-green);">&#10003;</span> Exclusive Deals</span>
      </div>
    </div>

    <!-- Success message (hidden) -->
    <div class="cta-panel cta-success" style="display:none;text-align:center;padding:var(--space-2xl);">
      <div style="font-size:3rem;margin-bottom:var(--space-md);color:var(--brand-green);">&#10003;</div>
      <h4 style="font-size:var(--text-xl);margin-bottom:var(--space-sm);">You're All Set!</h4>
      <p style="color:var(--text-secondary);margin-bottom:var(--space-md);">Our internet expert will call you during your preferred time to find the best deal for your area.</p>
      <p style="font-size:var(--text-sm);color:var(--text-tertiary);">Can't wait? Call us now:</p>
      <a href={formatPhoneForTel(phone)} class="btn btn-cta" style="margin-top:var(--space-sm);">{phone}</a>
    </div>
  </div>
</div>

<script>
  // Modal open/close logic
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('signup-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    if (!modal) return;

    function openModal() {
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    // All links to #get-connected or with data-open-modal open the modal
    document.querySelectorAll('a[href="#get-connected"], [data-open-modal]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Close on close button
    closeBtn?.addEventListener('click', closeModal);

    // Close on overlay click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });

    // Tab switching
    const tabs = modal.querySelectorAll('.cta-tab');
    const panels = modal.querySelectorAll('.cta-panel:not(.cta-success)');
    const successPanel = modal.querySelector('.cta-success');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab;
        tabs.forEach(t => {
          const el = t as HTMLElement;
          if (el.dataset.tab === target) {
            if (target === 'form') {
              el.style.background = 'var(--brand-green)';
            } else {
              el.style.background = 'var(--brand-blue)';
            }
            el.style.color = 'white';
            el.classList.add('active');
          } else {
            el.style.background = 'var(--white)';
            el.style.color = 'var(--text-secondary)';
            el.classList.remove('active');
          }
        });
        panels.forEach(p => {
          (p as HTMLElement).style.display = (p as HTMLElement).dataset.panel === target ? '' : 'none';
        });
      });
    });

    // Form submit
    const form = modal.querySelector('form[data-form="callback"]');
    if (form) {
      form.addEventListener('submit', (e: Event) => {
        e.preventDefault();
        panels.forEach(p => (p as HTMLElement).style.display = 'none');
        const toggle = modal.querySelector('.cta-toggle') as HTMLElement;
        if (toggle) toggle.style.display = 'none';
        if (successPanel) (successPanel as HTMLElement).style.display = '';
      });
    }
  });
</script>
