---
/**
 * ConversionBoost — Global conversion optimization component
 * Adds: social proof ticker, exit-intent popup, urgency timers, scroll-triggered CTAs
 */
import { MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';
---

<!--
  TRUSTPILOT TRUSTBOX — Replace data-businessunit-id with your ID.
  Find it at: https://businessapp.b2c.trustpilot.com/trustbox-configurator
  Template 5419b732fbfb950b10de65e5 = MicroStar (24 px bar)
-->
<div id="tp-trust-widget"
  class="trustpilot-widget"
  data-locale="en-US"
  data-template-id="5419b732fbfb950b10de65e5"
  data-businessunit-id="REPLACE_WITH_YOUR_TRUSTPILOT_ID"
  data-style-height="28px"
  data-style-width="320px"
  data-theme="light"
  style="display:none;">
  <!-- Fallback shown until Trustpilot JS boots (or if businessunit-id not yet set) -->
  <a href="https://www.trustpilot.com" target="_blank" rel="noopener noreferrer" class="tp-static-badge">
    <span class="tp-stars">★★★★★</span>
    <span>Rated on <strong>Trustpilot</strong></span>
  </a>
</div>
<script src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>

<script define:vars={{ mainPhone: MAIN_PHONE }}>
(function() {
  // ─── Trust Widget: show Trustpilot TrustBox after short delay ───
  setTimeout(() => {
    const tw = document.getElementById('tp-trust-widget');
    if (tw) tw.style.display = 'inline-block';
  }, 4000);

  // ─── Scroll-Depth Tracking ───
  let maxScroll = 0;
  const scrollMilestones = [25, 50, 75, 90];
  const firedMilestones = new Set();

  window.addEventListener('scroll', () => {
    const scrollPct = Math.round(
      (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100
    );
    if (scrollPct > maxScroll) maxScroll = scrollPct;

    scrollMilestones.forEach(m => {
      if (scrollPct >= m && !firedMilestones.has(m)) {
        firedMilestones.add(m);
        if (typeof gtag !== 'undefined') {
          gtag('event', 'scroll_depth', { event_category: 'engagement', event_label: m + '%' });
        }
        console.log('[Analytics] Scroll depth:', m + '%');
      }
    });
  }, { passive: true });

  // ─── Time on Page Tracking ───
  const timeCheckpoints = [30, 60, 120, 300]; // seconds
  const firedTime = new Set();
  setInterval(() => {
    const elapsed = Math.floor(performance.now() / 1000);
    timeCheckpoints.forEach(t => {
      if (elapsed >= t && !firedTime.has(t)) {
        firedTime.add(t);
        if (typeof gtag !== 'undefined') {
          gtag('event', 'time_on_page', { event_category: 'engagement', event_label: t + 's' });
        }
      }
    });
  }, 5000);

})();
</script>

<style>
  /* Trustpilot trust widget badge */
  #tp-trust-widget {
    position: fixed;
    bottom: 90px;
    left: 20px;
    z-index: 9990;
    animation: tpFadeIn 0.4s ease;
  }
  @keyframes tpFadeIn {
    from { opacity: 0; transform: translateX(-16px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .tp-static-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: white;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: 10px 16px;
    font-size: 13px;
    color: var(--text-primary);
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    font-weight: 500;
  }
  .tp-static-badge:hover { border-color: var(--brand-blue); }
  .tp-stars { color: #00b67a; font-size: 15px; letter-spacing: 1px; /* Trustpilot green */ }
  /* (keeping placeholder for future social-proof-inner so internal styles don't break existing CSS references) */
  .social-proof-inner-unused {
    padding: 0; /* placeholder */
  }

  @media (max-width: 480px) {
    #tp-trust-widget { left: 12px; bottom: 80px; }
  }
</style>
