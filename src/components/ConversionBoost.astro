---
/**
 * ConversionBoost — Global conversion optimization component
 * Adds: social proof ticker, exit-intent popup, urgency timers, scroll-triggered CTAs
 */
import { MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';
---

<!-- Social Proof Ticker -->
<div id="social-proof" class="social-proof" style="display:none;">
  <div class="social-proof-inner">
    <span class="social-proof-dot"></span>
    <span id="social-proof-text"></span>
  </div>
</div>

<!-- Exit Intent Popup -->
<div id="exit-popup" class="exit-popup" style="display:none;">
  <div class="exit-popup-overlay" id="exit-overlay"></div>
  <div class="exit-popup-content">
    <button class="exit-popup-close" id="exit-close" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div style="text-align:center;">
      <div style="width:56px;height:56px;border-radius:50%;background:rgba(0,82,255,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto var(--space-md);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--brand-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <h3 style="font-size:var(--text-2xl);margin-bottom:var(--space-sm);color:var(--text-primary);">Wait! Don't Miss Out</h3>
      <p style="color:var(--text-secondary);margin-bottom:var(--space-lg);font-size:var(--text-md);">Our experts can find you the best internet deal in under 5 minutes. Free, no obligation.</p>
      <a href={formatPhoneForTel(MAIN_PHONE)} class="btn btn-cta btn-lg" style="width:100%;margin-bottom:var(--space-sm);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        Call Now — Get Exclusive Deals
      </a>
      <a href="#get-connected" class="btn btn-primary btn-lg" style="width:100%;margin-bottom:var(--space-sm);" id="exit-signup-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
        Sign Up Online — Free Recommendation
      </a>
      <a href="/quiz" class="btn btn-secondary" style="width:100%;">Take the 60-Second Quiz Instead</a>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:var(--space-md);">Mon-Fri 8AM-10PM · Sat-Sun 9AM-8PM EST</p>
    </div>
  </div>
</div>

<script define:vars={{ mainPhone: MAIN_PHONE }}>
(function() {
  // ─── Social Proof Notifications ───
  const proofMessages = [
    { city: 'Houston, TX', action: 'just signed up for Spectrum Internet', time: '2 min ago' },
    { city: 'Phoenix, AZ', action: 'switched to AT&T Fiber 500', time: '3 min ago' },
    { city: 'New York, NY', action: 'saved $35/mo by switching to Verizon Fios', time: '5 min ago' },
    { city: 'Miami, FL', action: 'got Frontier Fiber for $49.99/mo', time: '4 min ago' },
    { city: 'Chicago, IL', action: 'upgraded to T-Mobile 5G Home', time: '7 min ago' },
    { city: 'Atlanta, GA', action: 'compared 5 providers and chose Spectrum', time: '6 min ago' },
    { city: 'Dallas, TX', action: 'found an exclusive Optimum deal', time: '8 min ago' },
    { city: 'Los Angeles, CA', action: 'just got connected with EarthLink Fiber', time: '3 min ago' },
    { city: 'Charlotte, NC', action: 'saved $240/yr switching to Brightspeed', time: '10 min ago' },
    { city: 'Columbus, OH', action: 'upgraded to AltaFiber Gigabit', time: '5 min ago' },
    { city: 'Denver, CO', action: 'compared plans and saved $20/mo', time: '9 min ago' },
    { city: 'Seattle, WA', action: 'got Windstream Kinetic Gig', time: '4 min ago' },
  ];

  const proofEl = document.getElementById('social-proof');
  const proofText = document.getElementById('social-proof-text');
  if (!proofEl || !proofText) return;

  let proofIndex = 0;
  let proofTimeout;

  function showProof() {
    const msg = proofMessages[proofIndex % proofMessages.length];
    proofText.textContent = `Someone in ${msg.city} ${msg.action} — ${msg.time}`;
    proofEl.style.display = 'block';
    proofEl.classList.add('visible');

    // Hide after 5 seconds
    setTimeout(() => {
      proofEl.classList.remove('visible');
      setTimeout(() => { proofEl.style.display = 'none'; }, 300);
    }, 5000);

    proofIndex++;
    // Show next in 15–25 seconds
    proofTimeout = setTimeout(showProof, 15000 + Math.random() * 10000);
  }

  // Start after 8 seconds
  setTimeout(showProof, 8000);

  // ─── Exit Intent Detection ───
  const exitPopup = document.getElementById('exit-popup');
  const exitOverlay = document.getElementById('exit-overlay');
  const exitClose = document.getElementById('exit-close');
  let exitShown = false;

  function showExitPopup() {
    if (exitShown || !exitPopup) return;
    // Don't show if user has dismissed before (session)
    if (sessionStorage.getItem('exitDismissed')) return;
    exitShown = true;
    exitPopup.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function hideExitPopup() {
    if (!exitPopup) return;
    exitPopup.style.display = 'none';
    document.body.style.overflow = '';
    sessionStorage.setItem('exitDismissed', '1');
  }

  // Desktop: mouse leaves viewport at top
  document.addEventListener('mouseout', (e) => {
    if (e.clientY <= 0 && !exitShown) {
      showExitPopup();
    }
  });

  // Mobile: back button / rapid scroll up
  let lastScrollY = window.scrollY;
  let rapidScrollCount = 0;
  window.addEventListener('scroll', () => {
    const current = window.scrollY;
    if (current < lastScrollY && (lastScrollY - current) > 100) {
      rapidScrollCount++;
      if (rapidScrollCount >= 3 && current < 200 && !exitShown) {
        showExitPopup();
      }
    } else {
      rapidScrollCount = 0;
    }
    lastScrollY = current;
  }, { passive: true });

  exitOverlay?.addEventListener('click', hideExitPopup);
  exitClose?.addEventListener('click', hideExitPopup);

  // Close popup when "Sign Up" is clicked so scroll-to-form works
  const exitSignupBtn = document.getElementById('exit-signup-btn');
  exitSignupBtn?.addEventListener('click', hideExitPopup);

  // ─── Scroll-Depth Tracking ───
  let maxScroll = 0;
  const scrollMilestones = [25, 50, 75, 90];
  const firedMilestones = new Set();

  window.addEventListener('scroll', () => {
    const scrollPct = Math.round(
      (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100
    );
    if (scrollPct > maxScroll) maxScroll = scrollPct;

    scrollMilestones.forEach(m => {
      if (scrollPct >= m && !firedMilestones.has(m)) {
        firedMilestones.add(m);
        if (typeof gtag !== 'undefined') {
          gtag('event', 'scroll_depth', { event_category: 'engagement', event_label: m + '%' });
        }
        console.log('[Analytics] Scroll depth:', m + '%');
      }
    });
  }, { passive: true });

  // ─── Time on Page Tracking ───
  const timeCheckpoints = [30, 60, 120, 300]; // seconds
  const firedTime = new Set();
  setInterval(() => {
    const elapsed = Math.floor(performance.now() / 1000);
    timeCheckpoints.forEach(t => {
      if (elapsed >= t && !firedTime.has(t)) {
        firedTime.add(t);
        if (typeof gtag !== 'undefined') {
          gtag('event', 'time_on_page', { event_category: 'engagement', event_label: t + 's' });
        }
      }
    });
  }, 5000);

})();
</script>

<style>
  /* Social Proof Notification */
  .social-proof {
    position: fixed;
    bottom: 90px;
    left: 20px;
    z-index: 9990;
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;
  }
  .social-proof.visible {
    opacity: 1;
    transform: translateX(0);
  }
  .social-proof-inner {
    background: rgba(255,255,255,0.98);
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-primary);
    box-shadow: 0 8px 32px rgba(0,0,0,0.1), 0 1px 3px rgba(0,0,0,0.06);
    max-width: 380px;
    font-weight: 500;
  }
  .social-proof-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    flex-shrink: 0;
    animation: pulse-dot 2s infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Exit Intent Popup */
  .exit-popup {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .exit-popup-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .exit-popup-content {
    position: relative;
    background: rgba(255,255,255,0.99);
    border: 2px solid rgba(0,82,255,0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    max-width: 460px;
    width: 100%;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.2), 0 4px 16px rgba(0,0,0,0.08);
    animation: popupSlide 0.3s ease;
  }
  @keyframes popupSlide {
    from { opacity: 0; transform: scale(0.95) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .exit-popup-close {
    position: absolute;
    top: 16px;
    right: 16px;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
  }
  .exit-popup-close:hover { color: var(--text-primary); }

  @media (max-width: 480px) {
    .social-proof { left: 12px; right: 12px; bottom: 80px; }
    .social-proof-inner { max-width: 100%; font-size: 12px; }
    .exit-popup-content { padding: var(--space-xl); }
  }
</style>
