---
import { MAIN_PHONE, getPartnerProviders } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';
const partners = getPartnerProviders();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">Internet 4 ALL</a>
        <p>Helping Americans find the best internet service since 2024. Compare providers, plans, and prices — all for free.</p>
        <a href={formatPhoneForTel(MAIN_PHONE)} class="btn btn-cta" style="margin-top: 1rem; font-size: var(--text-sm); display:inline-flex;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          {MAIN_PHONE}
        </a>
      </div>

      <div class="footer-col">
        <h4>Tools</h4>
        <a href="/providers">Find Providers</a>
        <a href="/compare">Compare Plans</a>
        <a href="/speed-test">Speed Test</a>
        <a href="/quiz">Internet Quiz</a>
        <a href="/bill-analyzer">Bill Analyzer</a>
      </div>

      <div class="footer-col">
        <h4>Situations</h4>
        <a href="/movers">I'm Moving</a>
        <a href="/switch">Switch Provider</a>
        <a href="/deals">Best Deals</a>
        <a href="/get-connected">Get Connected</a>
        <a href="/resources">Resources</a>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about">About Us</a>
        <a href="/methodology">Our Methodology</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/contact">Contact Us</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Internet 4 ALL. All rights reserved.</p>
      <p>Internet 4 ALL is an independent comparison service. We may earn commissions from partner providers.</p>
    </div>
  </div>
</footer>
