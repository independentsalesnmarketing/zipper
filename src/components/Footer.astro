---
import { MAIN_PHONE, getPartnerProviders } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="Internet 4 ALL Home">
          <img src="/logo.svg" alt="Internet 4 ALL" width="240" height="64" style="height:64px;width:auto;display:block;filter:brightness(0) invert(1);" />
        </a>
        <p>Helping Americans find affordable internet since 2024. Compare providers, plans, and prices — completely free.</p>
        <a href={formatPhoneForTel(MAIN_PHONE)} class="footer-phone-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          {MAIN_PHONE}
        </a>
        <p class="footer-hours">Mon–Fri 8am–9pm · Sat–Sun 9am–6pm EST</p>
      </div>

      <div class="footer-col">
        <h4>Find Internet</h4>
        <a href="/check-availability">Check Availability</a>
        <a href="/providers">All Providers</a>
        <a href="/best-internet">Best Internet</a>
        <a href="/fastest-internet">Fastest Plans</a>
        <a href="/cheap-internet">Budget Options</a>
        <a href="/low-income-internet">Income Programs</a>
        <a href="/deals">Current Deals</a>
        <a href="/compare">Compare Plans</a>
      </div>

      <div class="footer-col">
        <h4>Internet Types</h4>
        <a href="/internet-types/fiber">Fiber Internet</a>
        <a href="/internet-types/cable">Cable Internet</a>
        <a href="/internet-types/5g">5G Home Internet</a>
        <a href="/internet-types/dsl">DSL Internet</a>
        <a href="/internet-types/satellite">Satellite Internet</a>
        <a href="/wireless-internet">Wireless Internet</a>
        <a href="/business-internet">Business Internet</a>
        <a href="/bundles">Internet + TV Bundles</a>
      </div>

      <div class="footer-col">
        <h4>Tools &amp; Resources</h4>
        <a href="/speed-test">Speed Test</a>
        <a href="/bill-analyzer">Bill Analyzer</a>
        <a href="/quiz">Provider Quiz</a>
        <a href="/movers">Moving Guide</a>
        <a href="/switch">Switch Provider</a>
        <a href="/resources">All Resources</a>
        <a href="/blog">Blog</a>
        <a href="/methodology">Our Methodology</a>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about">About Us</a>
        <a href="/why-us">Why Choose Us</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/privacy#do-not-sell">Do Not Sell My Info</a>
      </div>
    </div>

    <div class="footer-states-inline">
      <span>Browse by state:</span>
      <a href="/internet-providers/california">CA</a>
      <a href="/internet-providers/texas">TX</a>
      <a href="/internet-providers/florida">FL</a>
      <a href="/internet-providers/new-york">NY</a>
      <a href="/internet-providers/illinois">IL</a>
      <a href="/internet-providers/pennsylvania">PA</a>
      <a href="/internet-providers/ohio">OH</a>
      <a href="/internet-providers/georgia">GA</a>
      <a href="/internet-providers/north-carolina">NC</a>
      <a href="/internet-providers/michigan">MI</a>
      <a href="/internet-providers/new-jersey">NJ</a>
      <a href="/internet-providers/virginia">VA</a>
      <a href="/internet-providers/washington">WA</a>
      <a href="/internet-providers/arizona">AZ</a>
      <a href="/internet-providers/colorado">CO</a>
      <span class="footer-states-more">+ <a href="/internet-providers">all 50 states</a></span>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Internet 4 ALL. All rights reserved.</p>
      <p>Internet 4 ALL is an independent comparison service. We may earn commissions from partner providers when you sign up through our site. <a href="/methodology">Learn more</a>.</p>
    </div>
  </div>
</footer>
