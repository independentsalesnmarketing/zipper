---
import { MAIN_PHONE, getPartnerProviders, stateNames } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';
import { getStateSlug } from '@data/locations';
const partners = getPartnerProviders();
const year = new Date().getFullYear();
const sortedStates = Object.entries(stateNames).sort((a, b) => a[1].localeCompare(b[1]));
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="Internet 4 ALL Home">
          <img src="/logo.svg" alt="Internet 4 ALL" width="360" height="96" style="height:96px;width:auto;display:block;filter:brightness(0) invert(1);" />
        </a>
        <p>Helping Americans find the best internet service since 2024. Compare providers, plans, and prices — all for free.</p>
        <a href={formatPhoneForTel(MAIN_PHONE)} class="footer-phone-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          {MAIN_PHONE}
        </a>
        <p class="footer-hours">Mon–Fri 8am–9pm EST · Sat–Sun 9am–6pm EST</p>
      </div>

      <div class="footer-col">
        <h4>Find Internet</h4>
        <a href="/check-availability">Check Availability</a>
        <a href="/providers">All Providers</a>
        <a href="/home-internet">Home Internet</a>
        <a href="/wireless-internet">Wireless Internet</a>
        <a href="/business-internet">Business Internet</a>
        <a href="/internet-types">Internet Types</a>
        <a href="/internet-types/fiber">Fiber Internet</a>
        <a href="/internet-types/cable">Cable Internet</a>
        <a href="/internet-types/dsl">DSL Internet</a>
        <a href="/internet-types/satellite">Satellite Internet</a>
        <a href="/internet-types/5g">5G Home Internet</a>
      </div>

      <div class="footer-col">
        <h4>Compare & Save</h4>
        <a href="/best-internet">Best Internet</a>
        <a href="/fastest-internet">Fastest Internet</a>
        <a href="/cheap-internet">Cheap Internet</a>
        <a href="/affordable-internet">Affordable Internet</a>
        <a href="/low-income-internet">Low Income Programs</a>
        <a href="/no-contract-internet">No-Contract Plans</a>
        <a href="/compare">Compare Plans</a>
        <a href="/deals">Best Deals</a>
