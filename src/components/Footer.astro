      </div>

      <div class="footer-col">
        <h4>Internet For You</h4>
        <a href="/internet-for/gaming">Gaming</a>
        <a href="/internet-for/streaming">Streaming</a>
        <a href="/internet-for/work-from-home">Work From Home</a>
        <a href="/internet-for/seniors">Seniors</a>
