    <div class="footer-states">
      <h4>Internet Providers by State</h4>
      <div class="footer-states-grid">
        {sortedStates.map(([abbr, name]) => (
          <a href={`/internet-providers/${getStateSlug(abbr)}`}>{name}</a>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Internet 4 ALL. All rights reserved.</p>
      <p>Internet 4 ALL is an independent comparison service. We may earn commissions from partner providers.</p>
