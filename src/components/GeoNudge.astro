---
/**
 * GeoNudge — Lightweight IP geolocation component.
 * Detects the visitor's approximate location and shows a link
 * to their neighborhood's dedicated internet provider page.
 * Only renders client-side; no SSR output to avoid caching issues.
 */
---
<div id="geo-nudge" style="display:none;position:fixed;bottom:80px;right:20px;z-index:900;max-width:340px;width:calc(100% - 40px);" role="complementary" aria-label="Location suggestion">
  <div style="background:var(--white);border:2px solid rgba(0,82,255,0.15);border-radius:var(--radius-lg);padding:16px 20px;box-shadow:0 8px 32px rgba(0,0,0,0.12);display:flex;align-items:flex-start;gap:12px;">
    <div style="flex-shrink:0;width:36px;height:36px;border-radius:50%;background:rgba(0,82,255,0.08);display:flex;align-items:center;justify-content:center;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
    </div>
    <div style="flex:1;min-width:0;">
      <p style="font-size:13px;color:var(--text-tertiary);margin:0 0 4px;">Looks like you're near</p>
      <a id="geo-nudge-link" href="#" style="font-size:15px;font-weight:700;color:var(--brand-blue);text-decoration:none;display:block;line-height:1.3;">
        <span id="geo-nudge-name"></span> &rarr;
      </a>
      <p style="font-size:12px;color:var(--text-tertiary);margin:4px 0 0;">View providers in your area</p>
    </div>
    <button id="geo-nudge-close" type="button" style="flex-shrink:0;background:none;border:none;cursor:pointer;padding:4px;color:var(--text-tertiary);font-size:18px;line-height:1;" aria-label="Dismiss">&times;</button>
  </div>
</div>

<script>
  (function geoNudge() {
    // Only run on internet-providers pages
    if (!location.pathname.startsWith('/internet-providers')) return;
    // Don't show if user dismissed recently
    const dismissed = sessionStorage.getItem('geo-nudge-dismissed');
    if (dismissed) return;

    // Fetch user's approximate location from free IP geolocation API
    // Using ip-api.com (free, no key required, 45 req/min for non-commercial)
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 4000);

    fetch('https://ip-api.com/json/?fields=status,city,regionName,region,lat,lon', {
      signal: controller.signal,
    })
      .then(r => r.json())
      .then(data => {
        clearTimeout(timeout);
        if (data.status !== 'success' || !data.city) return;

        const city = data.city;
        const stateAbbr = data.region; // 2-letter state code
        if (!stateAbbr) return;

        // Build a slug from the detected city/neighborhood name
        const slug = city.toLowerCase()
          .replace(/['']/g, '')
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/(^-|-$)/g, '');

        if (!slug) return;

        const nhUrl = `/internet-providers/${stateAbbr.toLowerCase()}/${slug}`;

        // Don't nudge if we're already on this page
        if (location.pathname === nhUrl || location.pathname === nhUrl + '/') return;

        // Verify the page exists by checking if we have it in our neighborhood data
        // Do a quick HEAD request to confirm
        fetch(nhUrl, { method: 'HEAD', signal: AbortSignal.timeout(3000) })
          .then(res => {
            if (!res.ok) return;

            const nudge = document.getElementById('geo-nudge');
            const nudgeName = document.getElementById('geo-nudge-name');
            const nudgeLink = document.getElementById('geo-nudge-link');
            const nudgeClose = document.getElementById('geo-nudge-close');
            if (!nudge || !nudgeName || !nudgeLink || !nudgeClose) return;

            nudgeName.textContent = `Internet in ${city}, ${data.regionName}`;
            nudgeLink.href = nhUrl;
            nudge.style.display = 'block';
            nudge.style.animation = 'slideUp 0.3s ease-out';

            nudgeClose.addEventListener('click', () => {
              nudge.style.display = 'none';
              sessionStorage.setItem('geo-nudge-dismissed', '1');
            });

            // Auto-dismiss after 15 seconds
            setTimeout(() => {
              if (nudge.style.display !== 'none') {
                nudge.style.opacity = '0';
                nudge.style.transition = 'opacity 0.3s';
                setTimeout(() => { nudge.style.display = 'none'; }, 300);
              }
            }, 15000);
          })
          .catch(() => {}); // Page doesn't exist, don't show nudge
      })
      .catch(() => {
        clearTimeout(timeout);
      });
  })();
</script>

<style>
  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @media (max-width: 640px) {
    #geo-nudge {
      bottom: 70px !important;
      right: 10px !important;
      max-width: calc(100% - 20px) !important;
    }
  }
</style>
