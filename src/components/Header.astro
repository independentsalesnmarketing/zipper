---
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Internet 4 ALL Home">
      <img src="/logo.svg" alt="Internet 4 ALL" width="360" height="96" style="display:block;" />
    </a>

    <nav id="main-nav" aria-label="Main navigation">
      <a href="/providers">Providers</a>
      <a href="/check-availability">Availability</a>
      <a href="/best-internet">Rankings</a>
      <a href="/compare">Compare</a>
      <a href="/speed-test">Speed Test</a>
      <a href="/deals">Deals</a>
      <a href="/low-income-internet">Assistance</a>
    </nav>

    <button class="btn btn-cta header-cta" id="talk-to-agent-btn" data-event="header-voice" data-event-category="conversion" data-event-label="header-talk-to-agent">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;vertical-align:-2px;"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/></svg>Talk to Agent
    </button>

    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const nav = document.getElementById('main-nav');
  if (menuBtn && nav) {
    menuBtn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // Mark active nav link
  const path = window.location.pathname;
  document.querySelectorAll('#main-nav a').forEach(a => {
    const href = a.getAttribute('href');
    if (href && (path === href || path.startsWith(href + '/'))) {
      a.classList.add('active');
    }
  });

  // Talk to Agent button → opens voice agent
  const agentBtn = document.getElementById('talk-to-agent-btn');
  if(agentBtn){
    agentBtn.addEventListener('click', () => {
      if(typeof window.openAssistant === 'function') window.openAssistant('talk');
      else if(typeof window.openVoiceAgent === 'function') window.openVoiceAgent();
    });
  }
</script>
