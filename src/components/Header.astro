---
import { MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Internet 4 ALL Home">
      <img src="/logo.svg" alt="Internet 4 ALL" width="360" height="96" style="height:96px;width:auto;display:block;" />
    </a>

    <nav id="main-nav" aria-label="Main navigation">
      <a href="/providers">Providers</a>
      <a href="/check-availability">Availability</a>
      <a href="/best-internet">Rankings</a>
      <a href="/compare">Compare</a>
      <a href="/speed-test">Speed Test</a>
      <a href="/deals">Deals</a>
      <a href="/low-income-internet">Assistance</a>
    </nav>

    <a href="#get-connected" class="btn btn-cta header-cta" data-event="header-signup" data-event-category="conversion" data-event-label="header-check-availability">
      Check Availability
    </a>

    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const nav = document.getElementById('main-nav');
  if (menuBtn && nav) {
    menuBtn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // Mark active nav link
  const path = window.location.pathname;
  document.querySelectorAll('#main-nav a').forEach(a => {
    const href = a.getAttribute('href');
    if (href && (path === href || path.startsWith(href + '/'))) {
      a.classList.add('active');
    }
  });
</script>
