---
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Internet 4 ALL Home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 52" fill="none" role="img" aria-label="Internet 4 ALL" class="logo-svg" width="200" height="52">
        <defs>
          <linearGradient id="hPinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#0052FF"/>
            <stop offset="50%" style="stop-color:#3d7eff"/>
            <stop offset="100%" style="stop-color:#b700ff"/>
          </linearGradient>
          <linearGradient id="hTextGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#0052FF"/>
            <stop offset="50%" style="stop-color:#3d7eff"/>
            <stop offset="100%" style="stop-color:#b700ff"/>
          </linearGradient>
        </defs>
        <g transform="translate(2, 1)">
          <path d="M24 3C16.3 3 10 9.3 10 17c0 10.5 14 28 14 28s14-17.5 14-28c0-7.7-6.3-14-14-14z" fill="url(#hPinGrad)"/>
          <circle cx="24" cy="17" r="2.5" fill="white"/>
          <path d="M19.2 13.5a6.5 6.5 0 0 1 9.6 0" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M16.6 11a10 10 0 0 1 14.8 0" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.7"/>
        </g>
        <text x="60" y="20" font-family="'Inter', 'Segoe UI', Arial, sans-serif" font-size="13" font-weight="700" letter-spacing="0.5" fill="url(#hTextGrad)">INTERNET</text>
        <text x="60" y="38" font-family="'Inter', 'Segoe UI', Arial, sans-serif" font-size="20" font-weight="900" letter-spacing="-0.5" fill="#0A0E1E">4 ALL</text>
      </svg>
    </a>

    <nav id="main-nav" aria-label="Main navigation">
      <a href="/providers">Providers</a>
      <a href="/check-availability">Availability</a>
      <a href="/best-internet">Rankings</a>
      <a href="/compare">Compare</a>
      <a href="/speed-test">Speed Test</a>
      <a href="/deals">Deals</a>
      <a href="/low-income-internet">Assistance</a>
    </nav>

    <button class="btn btn-cta header-cta" id="talk-to-agent-btn" data-event="header-voice" data-event-category="conversion" data-event-label="header-talk-to-agent">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;vertical-align:-2px;"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/></svg>Talk to Agent
    </button>

    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const nav = document.getElementById('main-nav');
  if (menuBtn && nav) {
    menuBtn.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // Mark active nav link
  const path = window.location.pathname;
  document.querySelectorAll('#main-nav a').forEach(a => {
    const href = a.getAttribute('href');
    if (href && (path === href || path.startsWith(href + '/'))) {
      a.classList.add('active');
    }
  });

  // Talk to Agent button → opens voice agent
  const agentBtn = document.getElementById('talk-to-agent-btn');
  if(agentBtn){
    agentBtn.addEventListener('click', () => {
      if(typeof window.openAssistant === 'function') window.openAssistant('talk');
      else if(typeof window.openVoiceAgent === 'function') window.openVoiceAgent();
    });
  }
</script>
