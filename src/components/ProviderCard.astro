---
import type { Provider } from '@lib/providers';
import { formatPrice, getMinPrice, getMaxSpeed, getSpeedValue, getSpeedUnit, getTypeLabel, MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';

interface Props {
  provider: Provider;
  rank?: number;
  badge?: string;
  showPlans?: boolean;
}

const { provider, rank, badge, showPlans = false } = Astro.props;
const minPrice = getMinPrice(provider);
const maxSpeed = getMaxSpeed(provider);

const badgeLabels: Record<string, string> = {
  'best-overall': 'Best Overall',
  'best-speed': 'Fastest',
  'best-value': 'Best Value',
};
---

<div class={`provider-card${provider.isPartner ? ' provider-card--partner' : ''}`} data-rank={rank}>

  {badge && (
    <div class={`pc-badge pc-badge-${badge}`}>
      {badgeLabels[badge] ?? badge}
    </div>
  )}

  <!-- Column 1: Logo -->
  <div class="pc-col-logo">
    <a href={`/provider/${provider.slug}`} class="pc-logo-link" aria-label={`${provider.name} details`}>
      {provider.logo ? (
        <img src={provider.logo} alt={`${provider.name} logo`} width="160" height="80" loading="lazy" />
      ) : (
        <div class="pc-logo-fallback">{provider.name.charAt(0)}</div>
      )}
    </a>
    {provider.isPartner && (
      <span class="pc-recommended-chip">Recommended</span>
    )}
  </div>

  <!-- Column 2: Info -->
  <div class="pc-col-info">
    <a href={`/provider/${provider.slug}`} class="pc-name">{provider.name}</a>
    <div class="pc-tags">
      {provider.types.map(t => (
        <span class={`tag tag-${t}`}>{getTypeLabel(t)}</span>
      ))}
    </div>
    {provider.promo && (
      <div class="pc-promo">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
          <line x1="7" y1="7" x2="7.01" y2="7"/>
        </svg>
        <span>{provider.promo}</span>
      </div>
    )}
  </div>

  <!-- Column 3: Metrics -->
  <div class="pc-col-metrics">
    <div class="pc-metric">
      <div class="pc-metric-label">Plans Starting At</div>
      <div class="pc-metric-value">
        <strong>{formatPrice(minPrice)}</strong><span class="pc-metric-unit">/mo</span>
      </div>
    </div>
    <div class="pc-metric">
      <div class="pc-metric-label">Speeds Up To</div>
      <div class="pc-metric-value">
        <strong>{getSpeedValue(maxSpeed)}</strong><span class="pc-metric-unit">{getSpeedUnit(maxSpeed)}</span>
      </div>
    </div>
  </div>

  <!-- Column 4: Actions -->
  <div class="pc-col-actions">
    {provider.rating && (
      <div class="pc-rating">
        <div class="pc-rating-stars-row">
          <span class="pc-stars">{'★'.repeat(Math.floor(provider.rating))}<span class="pc-stars-empty">{'★'.repeat(5 - Math.floor(provider.rating))}</span></span>
          <span class="pc-rating-num">{provider.rating.toFixed(1)}</span>
        </div>
        {provider.reviewSource && provider.reviewUrl && (
          <a href={provider.reviewUrl} target="_blank" rel="noopener noreferrer" class="pc-rating-source">{provider.reviewSource}</a>
        )}
        {provider.reviewCount && (
          <span class="pc-rating-count">{provider.reviewCount.toLocaleString()} reviews</span>
        )}
      </div>
    )}
    <a
      href="#get-connected"
      class="pc-btn-primary"
      data-signup-provider={provider.slug}
      data-event="provider-signup"
      data-event-category="conversion"
      data-event-label={`signup-${provider.slug}`}
    >
      Check Availability
    </a>
    <a href={`/provider/${provider.slug}`} class="pc-btn-secondary">
      View Plans
    </a>
  </div>

</div>

{showPlans && (
  <div class="grid grid-3" style="margin-top: var(--space-md); margin-bottom: var(--space-lg);">
    {provider.plans.map((plan, i) => (
      <div class={`plan-card ${i === Math.floor(provider.plans.length / 2) ? 'plan-card--featured gradient-border' : ''}`}>
        <div class="plan-name">{plan.name}</div>
        <div class="plan-speed">{plan.speed >= 1000 ? (plan.speed / 1000).toFixed(plan.speed % 1000 === 0 ? 0 : 1) + ' Gbps' : plan.speed + ' Mbps'}</div>
        <div class="plan-speed-unit">download speed</div>
        <div class="plan-price">
          {formatPrice(plan.promoPrice)} <span>/mo</span>
        </div>
        {plan.promoPrice < plan.price && (
          <div class="plan-original-price">Reg. {formatPrice(plan.price)}/mo</div>
        )}
        <div style="margin-top: var(--space-sm); font-size: var(--text-xs); color: var(--text-tertiary);">
          {plan.contract} contract · {plan.dataCap} data
        </div>
        <ul class="plan-features">
          {plan.features.map(f => <li>{f}</li>)}
        </ul>
        <a href="#get-connected" class="btn btn-cta w-full" style="margin-top: var(--space-lg);" data-signup-provider={provider.slug}>
          Check Availability
        </a>
      </div>
    ))}
  </div>
)}

<style>
  /* ============================================
     PROVIDER CARD — Clean, Modern, Conversion-Focused
     4-column grid: Logo | Info | Metrics | Actions
     ============================================ */

  .provider-card {
    display: grid;
    grid-template-columns: 188px 1fr 262px 210px;
    align-items: center;
    gap: 0;
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
    min-height: 148px;
  }

  .provider-card--partner {
    border-color: rgba(0, 82, 255, 0.22);
  }

  .provider-card:hover {
    border-color: var(--brand-blue);
    box-shadow: 0 6px 28px rgba(0, 82, 255, 0.13);
    transform: translateY(-2px);
  }

  /* ── Badge (Best Overall / Fastest / Best Value) ── */
  .pc-badge {
    position: absolute;
    top: 0;
    left: 0;
    padding: 5px 16px 5px 20px;
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    border-radius: var(--radius-lg) 0 var(--radius-md) 0;
    z-index: 1;
  }

  .pc-badge-best-overall {
    background: linear-gradient(135deg, #f59e0b, #fcd34d);
    color: #78350f;
  }

  .pc-badge-best-speed {
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: white;
  }

  .pc-badge-best-value {
    background: linear-gradient(135deg, #00d584, #10b981);
    color: #003d1a;
  }

  /* ── Column 1: Logo ── */
  .pc-col-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px 16px;
    align-self: stretch;
    border-right: 1px solid var(--gray-100);
  }

  .pc-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 148px;
    height: 84px;
    background: white;
    border: 1.5px solid var(--gray-100);
    border-radius: 10px;
    padding: 12px 16px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
    text-decoration: none;
    flex-shrink: 0;
  }

  .pc-logo-link:hover {
    border-color: var(--brand-blue);
    box-shadow: 0 2px 12px rgba(0, 82, 255, 0.1);
  }

  .pc-logo-link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pc-logo-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 2.5rem;
    color: var(--brand-blue);
  }

  .pc-recommended-chip {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    background: rgba(0, 82, 255, 0.07);
    color: var(--brand-blue);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-full);
    border: 1px solid rgba(0, 82, 255, 0.18);
    white-space: nowrap;
  }

  /* ── Column 2: Info ── */
  .pc-col-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    padding: 24px 20px;
    align-self: stretch;
    min-width: 0;
  }

  .pc-name {
    font-weight: 800;
    font-size: var(--text-xl);
    color: var(--text-primary);
    text-decoration: none;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .pc-name:hover {
    color: var(--brand-blue);
  }

  .pc-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }

  .pc-promo {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    margin-top: 4px;
    padding: 5px 10px;
    background: rgba(245, 158, 11, 0.07);
    border: 1px solid rgba(245, 158, 11, 0.22);
    border-radius: 8px;
    font-size: 11.5px;
    line-height: 1.4;
    color: #92400e;
    font-weight: 600;
  }

  .pc-promo svg {
    flex-shrink: 0;
    margin-top: 1px;
    color: #b45309;
  }

  .pc-promo span {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* ── Column 3: Metrics ── */
  .pc-col-metrics {
    display: flex;
    flex-direction: row;
    align-self: stretch;
    border-left: 1px solid var(--gray-100);
    border-right: 1px solid var(--gray-100);
  }

  .pc-metric {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 24px 16px;
    text-align: center;
  }

  .pc-metric + .pc-metric {
    border-left: 1px solid var(--gray-100);
  }

  .pc-metric-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-tertiary);
    margin-bottom: 8px;
    white-space: nowrap;
  }

  .pc-metric-value {
    display: flex;
    align-items: baseline;
    gap: 3px;
    justify-content: center;
  }

  .pc-metric-value strong {
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1;
  }

  .pc-metric-unit {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-tertiary);
  }

  /* ── Column 4: Actions ── */
  .pc-col-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px;
    align-self: stretch;
    justify-content: center;
  }

  .pc-rating {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 6px;
  }

  .pc-rating-stars-row {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .pc-stars {
    color: #f59e0b;
    font-size: 14px;
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .pc-stars-empty {
    color: var(--gray-200);
  }

  .pc-rating-num {
    font-weight: 800;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .pc-rating-source {
    font-size: 11px;
    color: var(--brand-blue);
    text-decoration: none;
    line-height: 1.3;
    display: block;
  }

  .pc-rating-source:hover {
    text-decoration: underline;
  }

  .pc-rating-count {
    font-size: 11px;
    color: var(--text-tertiary);
    display: block;
  }

  .pc-btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 11px 16px;
    background: linear-gradient(135deg, #00d584, #00c578);
    color: #003d1a;
    font-weight: 800;
    font-size: 0.875rem;
    border-radius: 10px;
    text-decoration: none;
    text-align: center;
    transition: filter 0.15s, box-shadow 0.15s, transform 0.15s;
    box-shadow: 0 3px 10px rgba(0, 213, 132, 0.22);
    min-height: 44px;
    border: none;
  }

  .pc-btn-primary:hover {
    filter: brightness(1.05);
    box-shadow: 0 5px 18px rgba(0, 213, 132, 0.38);
    transform: translateY(-1px);
  }

  .pc-btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px 16px;
    background: white;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.875rem;
    border: 2px solid var(--gray-200);
    border-radius: 10px;
    text-decoration: none;
    text-align: center;
    transition: border-color 0.15s, color 0.15s;
    min-height: 40px;
  }

  .pc-btn-secondary:hover {
    border-color: var(--brand-blue);
    color: var(--brand-blue);
  }

  /* ── Plan Cards (showPlans) ── */
  .plan-card {
    padding: var(--space-lg);
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: all 0.2s ease;
  }

  .plan-card:hover {
    border-color: var(--brand-blue);
    box-shadow: 0 4px 16px rgba(0, 82, 255, 0.15);
  }

  .plan-card--featured {
    border: 2px solid transparent;
    background: linear-gradient(135deg, rgba(0, 82, 255, 0.05), rgba(0, 213, 132, 0.05));
  }

  .plan-name {
    font-weight: 800;
    font-size: var(--text-lg);
    margin-bottom: var(--space-xs);
  }

  .plan-speed {
    font-weight: 800;
    font-size: var(--text-2xl);
    color: var(--brand-blue);
  }

  .plan-speed-unit {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .plan-price {
    font-weight: 800;
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .plan-price span {
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .plan-original-price {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-decoration: line-through;
    margin-bottom: var(--space-sm);
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .plan-features li {
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
  }

  .plan-features li:last-child {
    border-bottom: none;
  }

  /* ── Responsive ── */
  @media (max-width: 1040px) {
    .provider-card {
      grid-template-columns: 170px 1fr 230px 200px;
    }
  }

  @media (max-width: 860px) {
    .provider-card {
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
    }
    .pc-col-logo {
      grid-column: 1;
      grid-row: 1;
      border-right: none;
      padding-right: 0;
    }
    .pc-col-info {
      grid-column: 2 / 4;
      grid-row: 1;
    }
    .pc-col-metrics {
      grid-column: 1 / 3;
      grid-row: 2;
      border-left: none;
      border-right: none;
      border-top: 1px solid var(--gray-100);
    }
    .pc-col-actions {
      grid-column: 3;
      grid-row: 2;
      border-left: 1px solid var(--gray-100);
      padding-left: 16px;
    }
  }

  @media (max-width: 600px) {
    .provider-card {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .pc-col-logo {
      grid-column: 1;
      grid-row: 1;
      flex-direction: row;
      justify-content: flex-start;
      padding: 16px 16px 0;
      gap: 12px;
    }
    .pc-col-info {
      grid-column: 1;
      grid-row: 2;
      padding-top: 12px;
    }
    .pc-col-metrics {
      grid-column: 1;
      grid-row: 3;
      border-top: 1px solid var(--gray-100);
    }
    .pc-col-actions {
      grid-column: 1;
      grid-row: 4;
      border-left: none;
      border-top: 1px solid var(--gray-100);
      padding: 16px;
    }
    .pc-btn-primary,
    .pc-btn-secondary {
      width: 100%;
    }
  }
</style>

<style>
  .provider-card {
    display: grid;
    grid-template-columns: minmax(200px, 260px) 1fr minmax(190px, 230px);
    gap: var(--space-lg);
    align-items: stretch;
    padding: var(--space-lg) var(--space-xl);
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .provider-card--partner {
    border-color: rgba(0, 82, 255, 0.25);
    background: linear-gradient(135deg, rgba(0, 82, 255, 0.02), rgba(0, 213, 132, 0.02));
  }

  .provider-card:hover {
    border-color: var(--brand-blue);
    box-shadow: 0 4px 20px rgba(0, 82, 255, 0.15);
    transform: translateY(-1px);
  }

  .pc-badge {
    position: absolute;
    top: -12px;
    left: 24px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .pc-badge-best-overall {
    background: linear-gradient(135deg, #ffd700, #ffed4e);
    color: #333;
  }

  .pc-badge-best-speed {
    background: linear-gradient(135deg, #00d9ff, #0099ff);
    color: white;
  }

  .pc-badge-best-value {
    background: linear-gradient(135deg, #00d984, #00d9ff);
    color: white;
  }

  .pc-left {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    overflow: hidden;
    padding-top: 4px;
  }

  .pc-logo-compact {
    width: 70px;
    height: 70px;
    min-width: 70px;
    border-radius: var(--radius-md);
    object-fit: contain;
    background: var(--gray-50);
    border: 1px solid var(--border);
    padding: 6px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .pc-logo-compact img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pc-logo-fallback {
    width: 70px;
    height: 70px;
    min-width: 70px;
    border-radius: var(--radius-md);
    background: var(--brand-blue);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: var(--text-2xl);
    flex-shrink: 0;
  }

  .pc-name-compact {
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .pc-name-compact:hover {
    color: var(--brand-blue);
  }

  .pc-partner-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: rgba(0, 82, 255, 0.1);
    color: var(--brand-blue);
  }

  .pc-tags-compact {
    display: flex;
    gap: 4px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .pc-promo {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    margin-top: 6px;
    padding: 5px 8px;
    background: rgba(255, 193, 7, 0.12);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: var(--radius-sm);
    font-size: 11px;
    line-height: 1.4;
    color: #7a5c00;
    font-weight: 600;
    word-break: break-word;
  }
  .pc-promo svg { flex-shrink: 0; margin-top: 1px; color: #b58900; }

  .pc-center {
    display: flex;
    gap: var(--space-xl);
    align-items: center;
    justify-content: center;
  }

  .metric-compact {
    text-align: center;
    min-width: 80px;
  }

  .metric-label-compact {
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .metric-value-compact {
    font-weight: 800;
    font-size: var(--text-xl);
    color: var(--text-primary);
    display: flex;
    align-items: baseline;
    gap: 4px;
    justify-content: center;
  }

  .metric-value-compact .unit {
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .pc-right {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 8px;
    border-left: 1px solid var(--border);
    padding-left: var(--space-lg);
  }

  .pc-rating-compact {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    text-align: center;
  }

  .pc-rating-compact .stars {
    color: var(--brand-amber);
  }

  .pc-rating-compact .rating-num {
    font-weight: 700;
    color: var(--text-primary);
  }

  .pc-rating-compact .rating-source {
    display: block;
