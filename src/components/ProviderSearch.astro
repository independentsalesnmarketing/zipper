  .ps-skel-btn { width: 100px; height: 36px; border-radius: var(--radius-md); background: var(--surface-secondary); }
  @keyframes psPulse { 0%,100%{opacity:0.5;} 50%{opacity:0.25;} }

  /* Result rows (generated by JS — uses existing .provider-card classes where possible) */
  :global(.ps-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-md);
