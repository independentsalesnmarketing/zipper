    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: var(--text-4xl);
    flex-shrink: 0;
    aspect-ratio: 1;
  }
  :global(.ps-info) { flex: 1; min-width: 140px; }
  :global(.ps-name) {
    font-weight: 800;
    font-size: var(--text-xl);
    color: var(--text-primary);
    text-decoration: none;
  }
  :global(.ps-name:hover) { color: var(--brand-blue); }
  :global(.ps-tags) { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }
  :global(.ps-metrics) {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    flex-wrap: wrap;
  }
  :global(.ps-metric) { text-align: center; min-width: 70px; }
  :global(.ps-metric-label) { font-size: var(--text-xs); text-transform: uppercase; color: var(--text-tertiary); letter-spacing: 0.05em; }
  :global(.ps-metric-val) { font-weight: 800; font-size: var(--text-xl); }
  :global(.ps-metric-val small) { font-weight: 400; font-size: var(--text-sm); color: var(--text-tertiary); }
  :global(.ps-actions) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex-shrink: 0;
  }
  :global(.ps-btn-order) {
    font-weight: 800 !important;
    font-size: var(--text-base) !important;
    background: linear-gradient(135deg, var(--brand-green), #1aff9f) !important;
