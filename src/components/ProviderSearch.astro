  .ps-skel-circle { width: 44px; height: 44px; border-radius: 50%; background: var(--surface-secondary); flex-shrink: 0; }
  .ps-skel-lines { flex: 1; }
  .ps-skel-line { height: 12px; border-radius: 6px; background: var(--surface-secondary); margin-bottom: 6px; }
  .ps-skel-line.w70 { width: 70%; }
  .ps-skel-line.w40 { width: 40%; }
