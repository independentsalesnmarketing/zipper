  :global(.ps-btn-order:hover) {
    filter: brightness(1.08) !important;
    box-shadow: 0 6px 16px rgba(0,213,132,0.5) !important;
    transform: translateY(-2px) !important;
  }
  :global(.ps-btn-plans) {
    font-size: var(--text-base) !important;
    font-weight: 700 !important;
    background: white !important;
    border: 2px solid var(--gray-200) !important;
    color: var(--text-primary) !important;
    min-height: 44px !important;
  }
  :global(.ps-btn-plans:hover) {
    border-color: var(--brand-blue) !important;
    background: var(--gray-50) !important;
  }

  :global(.ps-cta-card) {
    margin-top: var(--space-xl);
    padding: var(--space-xl);
    border: 2px solid rgba(0,82,255,0.2);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(0,82,255,0.04), rgba(0,213,132,0.04));
    text-align: center;
  }
  :global(.ps-cta-card h4) { margin-bottom: var(--space-xs); }
  :global(.ps-cta-card p) { color: var(--text-secondary); font-size: var(--text-sm); margin-bottom: var(--space-md); }

  @media (max-width: 1100px) {
    :global(.ps-row) {
      gap: var(--space-lg);
    }
    :global(.ps-logo),
    :global(.ps-logo-fallback) {
      width: 160px;
      height: 160px;
      padding: 10px;
    }
  }
  @media (max-width: 900px) {
    :global(.ps-row) {
      flex-wrap: wrap;
      padding: var(--space-md);
    }
    :global(.ps-logo),
    :global(.ps-logo-fallback) {
      width: 130px;
      height: 130px;
    }
    :global(.ps-metrics) { width: 100%; justify-content: space-around; }
    :global(.ps-actions) { width: 100%; flex-direction: row; }
    :global(.ps-actions .btn) { flex: 1; text-align: center; font-size: var(--text-sm) !important; }
  }
  @media (max-width: 768px) {
    :global(.ps-row) {
      padding: var(--space-md);
    }
    :global(.ps-logo),
    :global(.ps-logo-fallback) {
      width: 110px;
      height: 110px;
    }
    :global(.ps-metrics) { width: 100%; justify-content: space-between; gap: var(--space-sm); }
    :global(.ps-metric) { min-width: auto; }
  }
  @media (max-width: 600px) {
    :global(.ps-row) {
      flex-direction: column;
      gap: var(--space-md);
    }
    :global(.ps-rank) { display: none; }
    :global(.ps-logo),
    :global(.ps-logo-fallback) {
      width: 100px;
      height: 100px;
      margin: 0 auto;
    }
    :global(.ps-info) { text-align: center; }
    :global(.ps-metrics) { width: 100%; justify-content: space-around; flex-wrap: wrap; }
    :global(.ps-actions) { width: 100%; }
    :global(.ps-actions .btn) { width: 100%; }
  }
</style>

<script>
(function() {
  'use strict';

  // ===== NAME MAP: API provider names → our provider IDs =====
  const NM: Record<string, string> = {
    'charter':'spectrum','charter communications':'spectrum','spectrum':'spectrum',
    'at&t':'att','att':'att','at&t services':'att','bellsouth':'att','at&t fiber':'att',
    'at&t air':'att-air','att air':'att-air',
    't-mobile fiber':'tmobile','metronet':'tmobile','metronet holdings':'tmobile','metronet inc':'tmobile',
    't-mobile':'tmobile-5g','tmobile':'tmobile-5g','t-mobile usa':'tmobile-5g','t-mobile home internet':'tmobile-5g',
    'verizon':'verizon','verizon communications':'verizon','verizon fios':'verizon','mci':'verizon',
    'windstream':'windstream','windstream holdings':'windstream','kinetic':'windstream',
    'altice':'optimum','altice usa':'optimum','optimum':'optimum','suddenlink':'optimum','cablevision':'optimum',
    'frontier':'frontier','frontier communications':'frontier',
    'earthlink':'earthlink',
    'brightspeed':'brightspeed','lumen':'brightspeed','centurylink':'brightspeed','centurytel':'brightspeed',
    'altafiber':'altafiber','cincinnati bell':'altafiber',
    'xfinity':'xfinity','comcast':'xfinity','comcast cable':'xfinity',
    'starlink':'starlink','spacex':'starlink',
    'viasat':'viasat','exede':'viasat',
    'hughesnet':'hughesnet','hughes':'hughesnet',
    'ziply':'ziply','ziply fiber':'ziply',
    'cox':'cox','cox communications':'cox',
    'wow':'wow','wideopen':'wow',
    'google fiber':'google-fiber',
    'fidium':'fidium',
    'minternet':'mintmobile','mint mobile':'mintmobile',
    'mediacom':'mediacom',
    'us cellular':'uscellular','u.s. cellular':'uscellular',
    'geolinks':'geolinks',
  };

  const TECH_LABELS: Record<string,string> = {
    fiber:'Fiber', cable:'Cable', dsl:'DSL', '5g':'5G Home',
    satellite:'Satellite', 'fixed wireless':'Fixed Wireless',
    'fixed_wireless':'Fixed Wireless', 'leo satellite':'Satellite',
    'gso satellite':'Satellite',
  };
  const TECH_CLASS: Record<string,string> = {
    fiber:'tag-fiber', cable:'tag-cable', dsl:'tag-dsl',
    '5g':'tag-5g', satellite:'tag-satellite',
    'fixed wireless':'tag-fixed-wireless', 'fixed_wireless':'tag-fixed-wireless',
    'leo satellite':'tag-satellite', 'gso satellite':'tag-satellite',
  };

  function fmtSpeed(m: number): string {
    if (m >= 1000) return (m/1000).toFixed(m%1000===0?0:1)+' Gbps';
    return m+' Mbps';
  }
  function fmtPrice(p: number): string { return '$'+p.toFixed(2); }

  function mapTech(t: string): string {
    if (!t) return '';
    const l = t.toLowerCase();
    if (l.includes('fiber')||l==='fttp'||l==='ftth') return 'fiber';
    if (l.includes('cable')||l.includes('docsis')||l==='hfc') return 'cable';
    if (l.includes('dsl')||l.includes('adsl')||l.includes('vdsl')) return 'dsl';
    if (l.includes('5g')||l.includes('fixed wireless')||l.includes('fixed_wireless')) return '5g';
    if (l.includes('satellite')||l.includes('leo')||l.includes('gso')) return 'satellite';
    if (l.includes('wireless')||l.includes('lte')) return '5g';
    return '';
  }

  function matchName(raw: string): string|null {
    const l = raw.toLowerCase().trim();
    if (NM[l]) return NM[l];
    for (const [k,v] of Object.entries(NM)) {
      if (l.includes(k) || k.includes(l)) return v;
    }
    return null;
  }

  // ===== GEOCODING =====
  async function geocodeZip(zip: string): Promise<{lat:number,lng:number,city:string,state:string}|null> {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);
      const r = await fetch(`https://api.zippopotam.us/us/${zip}`, {signal: controller.signal});
      clearTimeout(timeoutId);
      if (r.ok) {
        const d = await r.json();
        if (d.places?.length) return {lat:+d.places[0].latitude,lng:+d.places[0].longitude,city:d.places[0]['place name']||'',state:d.places[0]['state abbreviation']||''};
      }
    } catch {}
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 6000);
      const r = await fetch(`https://nominatim.openstreetmap.org/search?postalcode=${zip}&country=US&format=json&limit=1`,{
        headers:{'User-Agent':'Internet4ALL/1.0'},
        signal:controller.signal
      });
      clearTimeout(timeoutId);
      if (r.ok) { const d=await r.json(); if (d[0]) return {lat:+d[0].lat,lng:+d[0].lon,city:'',state:''}; }
    } catch {}
    return null;
  }

  async function geocodeAddr(q: string): Promise<{lat:number,lng:number,display:string}|null> {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 6000);
      const r = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=1&countrycodes=us`,{
        headers:{'User-Agent':'Internet4ALL/1.0'},
        signal:controller.signal
      });
      clearTimeout(timeoutId);
      if (r.ok) { const d=await r.json(); if (d[0]) return {lat:+d[0].lat,lng:+d[0].lon,display:d[0].display_name}; }
    } catch {}
    return null;
  }

  // ===== AUTOCOMPLETE =====
  let acTimer: ReturnType<typeof setTimeout>;
  let acItems: {display:string,zip:string,lat:number,lng:number}[] = [];
  let acIdx = -1;
  // IP-detected location for autocomplete bias (set by init)
  let _biasCity = '';
  let _biasState = '';
  let _biasLat = 0;
  let _biasLon = 0;

  // Photon by Komoot — OSM-backed, designed for typeahead, no API key required.
  async function fetchSuggestions(q: string, biasLat?: number, biasLon?: number): Promise<typeof acItems> {
    if (q.length < 3) return [];
    // Don't search pure house numbers — wait until user adds a street name
    if (/^\d+\s*$/.test(q.trim())) return [];
    // Require at least 2 letters after the number for "123 Ma" style queries
    if (/^\d+\s+\w$/.test(q.trim())) return [];
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);
      let url = `https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&limit=6&lang=en`;
      if (biasLat && biasLon) url += `&lat=${biasLat}&lon=${biasLon}&zoom=14`;
      const r = await fetch(url, { signal: controller.signal });
      clearTimeout(timeoutId);
      if (!r.ok) return [];
      const data = await r.json();
      return (data.features as any[])
        .filter((f: any) => f.properties?.countrycode === 'US')
        .map((f: any) => {
          const p = f.properties;
          const [lon, lat] = f.geometry.coordinates as [number, number];
          const parts: string[] = [];
          if (p.housenumber && p.street) parts.push(p.housenumber + ' ' + p.street);
          else if (p.street) parts.push(p.street);
          else if (p.name) parts.push(p.name);
          const locality = p.city || p.town || p.village || p.hamlet || '';
          if (locality) parts.push(locality);
          if (p.state) parts.push(p.state);
          if (p.postcode) parts.push(p.postcode);
          return { display: parts.join(', '), zip: p.postcode || '', lat, lng: lon };
        })
        .filter((s: any) => s.display);
    } catch (e) {
      return [];
    }
  }

  // ===== API =====
  async function fetchProviders(lat: number, lng: number): Promise<any[]> {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 10000);
      const r = await fetch(`https://broadbandmap.com/api/v1/location/internet?lat=${lat}&lng=${lng}`,{signal:controller.signal});
      clearTimeout(timeoutId);
      if (r.status===429) throw new Error('RATE_LIMITED');
      if (!r.ok) throw new Error('HTTP_'+r.status);
      const d = await r.json();
      return d?.providers || [];
    } catch (e: any) {
      if (e.message === 'RATE_LIMITED') throw e;
      if (e.name === 'AbortError' || e.message.includes('timeout')) throw new Error('TIMEOUT');
      if (e instanceof TypeError && e.message.includes('fetch')) throw new Error('NETWORK_ERROR');
      throw e;
    }
  }

  // ===== MATCH & ENRICH =====
  interface LocalP { id:string; name:string; slug:string; types:string[]; rating:number; pt:boolean; phone:string; logo:string|null; ms:number; mp:number; }
  interface EnrichedP {
    name:string; slug:string|null; types:string[]; maxDown:number; maxUp:number;
    rating:number|null; phone:string; logo:string|null; minPrice:number;
    score:number; apiConfirmed:boolean; isPartner:boolean;
  }

  function matchAndEnrich(apiProviders: any[], locals: LocalP[], mainPhone: string): EnrichedP[] {
    const byName = new Map<string, {name:string,techs:string[],maxD:number,maxU:number}>();
    for (const p of apiProviders) {
      const n = p.name||'Unknown';
      if (!byName.has(n.toLowerCase())) byName.set(n.toLowerCase(),{name:n,techs:[],maxD:0,maxU:0});
      const e = byName.get(n.toLowerCase())!;
      const t = mapTech(p.technology||'');
      if (t && !e.techs.includes(t)) e.techs.push(t);
      if ((p.max_download_mbps||0)>e.maxD) e.maxD=p.max_download_mbps;
      if ((p.max_upload_mbps||0)>e.maxU) e.maxU=p.max_upload_mbps;
    }

    const result: EnrichedP[] = [];
    const usedIds = new Set<string>();

    for (const [,api] of byName) {
      const id = matchName(api.name);
      const local = id ? locals.find(l=>l.id===id) : null;
      if (local && !usedIds.has(local.id)) {
        usedIds.add(local.id);
        result.push({
          name: local.name,
          slug: local.slug,
          types: api.techs.length ? api.techs : local.types,
          maxDown: api.maxD || local.ms,
          maxUp: api.maxU,
          rating: local.rating,
          phone: local.pt ? local.phone : mainPhone,
          logo: local.logo,
          minPrice: local.mp,
          score: 0,
          apiConfirmed: true,
          isPartner: local.pt,
        });
      } else if (!local) {
        result.push({
          name: api.name,
          slug: null,
          types: api.techs,
          maxDown: api.maxD,
          maxUp: api.maxU,
          rating: null,
          phone: mainPhone,
          logo: null,
          minPrice: 0,
          score: 0,
          apiConfirmed: true,
          isPartner: false,
        });
      }
    }

    // Score — partners heavily prioritized
    for (const p of result) {
      let s = 0;
      // Partner bonus — massive priority
      const local = locals.find(l => l.slug === p.slug);
      if (local && local.pt) s += 50;
      // Nationwide partners (att-air, earthlink) always featured
      if (p.slug === 'att-air' || p.slug === 'earthlink') s += 30;
      // Tech bonus
      if (p.types.includes('fiber')) s += 20;
      else if (p.types.includes('cable')) s += 12;
      else if (p.types.includes('5g')) s += 10;
      s += Math.min(p.maxDown / 100, 30);
      if (p.rating) s += p.rating * 2.5;
      if (p.minPrice > 0) s += 4;
      if (p.slug) s += 5; // enriched = more useful
      p.score = s;
    }

    result.sort((a,b) => b.score - a.score);
    return result;
  }

  // ===== RENDERING =====
  function renderRow(p: EnrichedP, rank: number, mainPhone: string): string {
    const logo = p.logo
      ? `<img class="ps-logo" src="${p.logo}" alt="${p.name}" width="140" height="140" loading="lazy" />`
      : `<div class="ps-logo-fallback">${p.name.charAt(0)}</div>`;
    const nameLink = p.slug ? `<a href="/provider/${p.slug}" class="ps-name">${p.name}</a>` : `<span class="ps-name">${p.name}</span>`;
    const partnerBadge = p.isPartner ? `<span class="ps-partner-badge">Recommended</span>` : '';
    const tags = p.types.map(t => {
      const cls = TECH_CLASS[t] || '';
      const label = TECH_LABELS[t] || t;
      return `<span class="tag ${cls}">${label}</span>`;
    }).join('');
    const rating = p.rating ? `<span style="color:var(--brand-amber);">${'★'.repeat(Math.floor(p.rating))}</span> <span style="font-size:var(--text-xs);color:var(--text-tertiary);">${p.rating.toFixed(1)}</span>` : '';
    const price = p.minPrice > 0 ? fmtPrice(p.minPrice) : '—';
    const tel = 'tel:+1' + (p.phone||mainPhone).replace(/\D/g,'');

    return `<div class="ps-row${p.isPartner ? ' ps-row--partner' : ''}">
      <div class="ps-rank">${rank}</div>
      ${logo}
      <div class="ps-info">
        ${nameLink}${partnerBadge}
        <div class="ps-tags">${tags}</div>
      </div>
      <div class="ps-metrics">
        <div class="ps-metric"><div class="ps-metric-label">Download</div><div class="ps-metric-val">${fmtSpeed(p.maxDown)}</div></div>
        <div class="ps-metric"><div class="ps-metric-label">Upload</div><div class="ps-metric-val">${fmtSpeed(p.maxUp)}</div></div>
        <div class="ps-metric"><div class="ps-metric-label">From</div><div class="ps-metric-val">${price}<small>/mo</small></div></div>
        ${rating ? `<div class="ps-metric"><div class="ps-metric-label">Rating</div><div class="ps-metric-val">${rating}</div></div>` : ''}
      </div>
      <div class="ps-actions">
        <a href="#get-connected" class="btn btn-cta ps-btn-order" data-signup-provider="${p.slug || ''}">Check Availability</a>
        ${p.slug ? `<a href="/provider/${p.slug}" class="btn btn-secondary btn-sm ps-btn-plans">View Plans</a>` : ''}
      </div>
    </div>`;
  }

  function renderResults(providers: EnrichedP[], container: HTMLElement, mainPhone: string, location: string): void {
    let html = `<div class="ps-header">
      <h3>${providers.length} Provider${providers.length!==1?'s':''} in ${location}</h3>
      <span class="ps-badge ps-badge-live">&#10003; VERIFIED — FCC Data</span>
    </div>`;
    html += providers.map((p,i) => renderRow(p, i+1, mainPhone)).join('');
    html += `<div class="ps-cta-card">
      <h4>Not sure which plan is right for you?</h4>
      <p>Our free comparison tool checks every provider at your address — no obligation, no spam.</p>
      <a href="#get-connected" class="btn btn-cta btn-lg">Check Availability</a>
      <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:var(--space-xs);">Takes less than 2 minutes · No commitment required</div>
    </div>`;
    container.innerHTML = html;
  }

  function renderError(container: HTMLElement, mainPhone: string): void {
    container.innerHTML = `<div class="ps-cta-card">
      <h4>We couldn't verify providers right now</h4>
      <p>Check availability at your address using our instant comparison tool — free, no commitment.</p>
      <a href="#get-connected" class="btn btn-cta btn-lg">Check Availability</a>
      <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:var(--space-xs);">Takes less than 2 minutes · No commitment required</div>
    </div>`; 
  }

  function renderLoading(container: HTMLElement, location: string): void {
    container.innerHTML = `<div class="ps-loading">
      <div class="ps-loading-bar"><div class="ps-loading-fill"></div></div>
      <p class="ps-loading-text">Verifying providers in ${location}...</p>
      <div class="ps-skeletons">${[1,2,3,4,5].map(()=>`<div class="ps-skel"><div class="ps-skel-circle"></div><div class="ps-skel-lines"><div class="ps-skel-line w70"></div><div class="ps-skel-line w40"></div></div><div class="ps-skel-block"></div><div class="ps-skel-btn"></div></div>`).join('')}</div>
    </div>`;
  }

  // ===== MAIN =====
  async function runSearch(lat: number, lng: number, location: string, locals: LocalP[], mainPhone: string, container: HTMLElement): Promise<void> {
    renderLoading(container, location);
    try {
      const raw = await fetchProviders(lat, lng);
      const enriched = matchAndEnrich(raw, locals, mainPhone);
      if (enriched.length > 0) {
        renderResults(enriched, container, mainPhone, location);
        // Hide static fallback
        const fallback = document.getElementById('static-providers');
        if (fallback) fallback.style.display = 'none';
        // Dispatch event so parent page can update hero/state
        window.dispatchEvent(new CustomEvent('ps:results', { detail: { count: enriched.length, location } }));
      } else {
        renderError(container, mainPhone);
      }
    } catch (e: any) {
      // Suppress error logging, show user-friendly message instead
      if (e.message === 'RATE_LIMITED') {
        container.innerHTML = `<div class="ps-cta-card">
          <h4>High demand right now</h4>
          <p>Call us for instant results — our experts check every provider at your address in real-time.</p>
          <a href="tel:+1${mainPhone.replace(/\D/g,'')}" class="btn btn-cta btn-lg">Call ${mainPhone}</a>
        </div>`;
      } else {
        // Handle network errors, timeouts, and other errors gracefully
        renderError(container, mainPhone);
      }
    }
  }

  function init(): void {
    const el = document.getElementById('ps-root');
    if (!el) return;

    const locals: LocalP[] = JSON.parse(el.dataset.providers || '[]');
    const mainPhone = el.dataset.mainPhone || '';
    const city = el.dataset.city || '';
    const st = el.dataset.state || '';
    const stName = el.dataset.stateName || '';
    const zip = el.dataset.zip || '';
    const latStr = el.dataset.lat || '';
    const lngStr = el.dataset.lng || '';
    const auto = el.dataset.auto === '1';
    const container = document.getElementById('ps-results') as HTMLElement;
    const input = document.getElementById('ps-input') as HTMLInputElement;
    const form = document.getElementById('ps-form') as HTMLFormElement;
    const suggestEl = document.getElementById('ps-suggest') as HTMLUListElement;

    if (!container) return;

    // ── IP geolocation for autocomplete bias (non-blocking, US only) ──
    let ipDetectedCity = city;
    let ipDetectedState = st;
    _biasCity = city;
    _biasState = st;
    if (input && !auto) {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 3000);
      fetch('https://get.geojs.io/v1/ip/geo.json', { signal: controller.signal })
        .then(r => {
          clearTimeout(timeoutId);
          if (!r.ok) return null;
          return r.json();
        })
        .then((d: { city?: string; region?: string; country?: string; latitude?: string; longitude?: string } | null) => {
          if (d && d.country === 'United States' && d.city && d.region) {
            ipDetectedCity = d.city;
            ipDetectedState = d.region;
            _biasCity = d.city;
            _biasState = d.region;
            _biasLat = parseFloat(d.latitude || '0');
            _biasLon = parseFloat(d.longitude || '0');
            // Update placeholder with detected location if we're in a non-specific context
            if (!zip && (!city || city.toLowerCase() !== d.city.toLowerCase())) {
              input.placeholder = `Enter address — detected near ${d.city}, ${d.region}`;
            }
          }
        })
        .catch(() => {
          // Silently fail - geolocation is optional for autocomplete bias
        });
    }

    // Auto-search (ZIP pages)
    if (auto) {
      const lat = parseFloat(latStr);
      const lng = parseFloat(lngStr);
      const loc = zip ? `ZIP ${zip}` : `${city}, ${st}`;
      if (!isNaN(lat) && !isNaN(lng)) {
        runSearch(lat, lng, loc, locals, mainPhone, container);
      } else if (zip) {
        geocodeZip(zip).then(geo => {
          if (geo) runSearch(geo.lat, geo.lng, loc, locals, mainPhone, container);
          else renderError(container, mainPhone);
        });
      }
    }

    // Form submit (main search)
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = input.value.trim();
        if (!q) return;
        if (/^\d{5}$/.test(q)) {
          geocodeZip(q).then(geo => {
            if (geo) {
              const loc = `ZIP ${q}` + (geo.city ? ` — ${geo.city}, ${geo.state}` : '');
              runSearch(geo.lat, geo.lng, loc, locals, mainPhone, container);
            } else {
              renderError(container, mainPhone);
            }
          });
        } else {
          geocodeAddr(q).then(geo => {
            if (geo) {
              const loc = geo.display.split(',').slice(0,3).join(',');
              runSearch(geo.lat, geo.lng, loc, locals, mainPhone, container);
            } else {
              container.innerHTML = `<p style="color:#ff4444;padding:var(--space-md) 0;font-size:var(--text-sm);">Couldn't find that address. Try entering your 5-digit ZIP code, or call us for help.</p>`;
            }
          });
        }
      });
    }

    // Expose search functions globally so ZIP page can use them
    if (!window.psGeocode) {
      (window as any).psGeocode = {};
    }
    (window as any).psGeocode.geocodeZip = geocodeZip;
    (window as any).psGeocode.geocodeAddr = geocodeAddr;
    (window as any).psGeocode.fetchSuggestions = fetchSuggestions;
    (window as any).psGeocode.runSearch = runSearch;
    (window as any).psGeocode.mainPhone = mainPhone;
    (window as any).psGeocode.locals = locals;
    (window as any).psGeocode.container = container;

    // Autocomplete
    if (input && suggestEl) {
      function showSugs(items: typeof acItems) {
        acItems = items; acIdx = -1;
        if (!items.length) { suggestEl.style.display='none'; return; }
        suggestEl.innerHTML = items.map((s,i)=>`<li data-i="${i}"><div class="sg-main">${s.display}</div></li>`).join('');
        suggestEl.style.display = 'block';
      }
      function closeSugs() { suggestEl.style.display='none'; acItems=[]; acIdx=-1; }
      function selectSug(i: number) {
        const s = acItems[i]; if (!s) return;
        input.value = s.display;
        closeSugs();
        // If we have a ZIP code, navigate to the ZIP page for best experience
        if (s.zip && /^\d{5}$/.test(s.zip)) {
          window.location.href = `/internet-providers/zip/${s.zip}`;
          return;
        }
        // Otherwise run a search in place
        const loc = s.display;
        runSearch(s.lat, s.lng, loc, locals, mainPhone, container);
      }

      input.addEventListener('input', () => {
        clearTimeout(acTimer);
        const v = input.value.trim();
        // Skip: too short, exact ZIP, or purely numeric (just a house number)
        if (v.length < 3 || /^\d{5}$/.test(v) || /^\d+\s*$/.test(v)) { closeSugs(); return; }
        acTimer = setTimeout(async () => {
          const items = await fetchSuggestions(v, _biasLat || undefined, _biasLon || undefined);
          if (document.activeElement === input && input.value.trim().length >= 3) showSugs(items);
        }, 400);
      });

      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!acItems.length) return;
        if (e.key==='ArrowDown') { e.preventDefault(); acIdx=Math.min(acIdx+1,acItems.length-1); updActive(); }
        else if (e.key==='ArrowUp') { e.preventDefault(); acIdx=Math.max(acIdx-1,0); updActive(); }
        else if (e.key==='Enter'&&acIdx>=0) { e.preventDefault(); selectSug(acIdx); }
        else if (e.key==='Escape') closeSugs();
      });

      function updActive() {
        suggestEl.querySelectorAll('li').forEach((li,i)=>li.classList.toggle('active',i===acIdx));
      }

      suggestEl.addEventListener('mousedown', (e: MouseEvent) => {
        const li = (e.target as HTMLElement).closest('li');
        if (li) selectSug(parseInt(li.getAttribute('data-i')||'0'));
      });

      input.addEventListener('blur', ()=>setTimeout(closeSugs, 200));
    }
  }

  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
