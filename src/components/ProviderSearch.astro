---
/**
 * ProviderSearch — The conversion engine.
 *
 * Client-side BroadbandMap API search that fires from the VISITOR's browser
 * (their IP, their 60/hr budget — no rate limit issue).
 *
 *   ZIP page:  <ProviderSearch ... autoSearch />  → fires immediately
 *   City page: <ProviderSearch ... />              → fires when user searches
 */
import { providers as allProviders, getMaxSpeed, getMinPrice } from '@lib/providers';

interface Props {
  cityName: string;
  state: string;
  stateName: string;
  zip?: string;
  lat?: number;
  lng?: number;
  autoSearch?: boolean;
  inputPlaceholder?: string;
}

const { cityName, state, stateName, zip, lat, lng, autoSearch = false, inputPlaceholder } = Astro.props;

const defaultPlaceholder = autoSearch ? 'Refine - enter exact address' : `Enter ZIP code or address in ${cityName}`;
const placeholderText = inputPlaceholder || defaultPlaceholder;

const clientProviders = allProviders.map(p => ({
  id: p.id,
  name: p.name,
  slug: p.slug,
  types: p.types,
  rating: p.rating,
  pt: p.isPartner,
  logo: p.logo,
  ms: getMaxSpeed(p),
  mp: getMinPrice(p),
}));
---

<section
  id="ps-root"
  data-providers={JSON.stringify(clientProviders)}
  data-city={cityName}
  data-state={state}
  data-state-name={stateName}
  data-zip={zip || ''}
  data-lat={lat?.toString() || ''}
  data-lng={lng?.toString() || ''}
  data-auto={autoSearch ? '1' : ''}
  style="margin-bottom:var(--space-2xl);"
>
  <!-- Search Box (hidden on ZIP pages where results auto-load) -->
  <div class="ps-search" id="ps-search" style={autoSearch ? "display:none;" : ""}>
    <form id="ps-form" class="ps-form">
      <div class="ps-input-group">
        <svg class="ps-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <input
          id="ps-input"
          type="text"
          placeholder={placeholderText}
          autocomplete="off"
          spellcheck="false"
          aria-label={placeholderText}
        />
        <ul id="ps-suggest" class="ps-suggest"></ul>
      </div>
      <button type="submit" class="btn btn-cta">Check Availability</button>
    </form>
    <div class="ps-help-row">
      <span>or</span>
      <a href="#get-connected" class="ps-help-link">sign up for free help</a>
    </div>
  </div>

  <!-- Results -->
  <div id="ps-results">
    {autoSearch && (
      <div id="ps-loading" class="ps-loading">
        <div class="ps-loading-bar"><div class="ps-loading-fill"></div></div>
        <p class="ps-loading-text">Verifying providers in {zip || cityName}...</p>
        <div class="ps-skeletons">
          {[1,2,3,4,5].map(() => (
            <div class="ps-skel">
              <div class="ps-skel-circle"></div>
              <div class="ps-skel-lines"><div class="ps-skel-line w70"></div><div class="ps-skel-line w40"></div></div>
              <div class="ps-skel-block"></div>
              <div class="ps-skel-btn"></div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .ps-search { margin-bottom: var(--space-lg); }
  .ps-form {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .ps-input-group {
    flex: 1;
    min-width: 260px;
    position: relative;
  }
