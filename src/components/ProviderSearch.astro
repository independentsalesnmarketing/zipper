  .ps-skeletons { display: grid; gap: var(--space-sm); }
  .ps-skel {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    animation: psPulse 1.5s ease-in-out infinite;
