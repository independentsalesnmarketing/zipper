  }
  :global(.su-cal-day.su-cal-day-available) {
    background: linear-gradient(160deg, #b7f0d4 0%, #80ddb0 100%);
    border-color: #2db87a;
    color: #095c32;
    box-shadow: 0 2px 7px rgba(0, 150, 80, 0.22);
  }
  :global(.su-cal-day.su-cal-day-available:hover),
  :global(.su-cal-day.su-cal-day-available:focus-visible) {
    background: linear-gradient(160deg, #8ee8bb 0%, #50c990 100%);
    box-shadow: 0 5px 14px rgba(0, 140, 70, 0.32);
    transform: translateY(-2px);
    outline: none;
    border-color: #15944f;
  }
  :global(.su-cal-day.su-cal-day-unavailable) {
    background: linear-gradient(160deg, #fdc5ca 0%, #f99aa2 100%);
    border-color: #e04060;
    color: #7a0f25;
    cursor: not-allowed;
    box-shadow: 0 1px 5px rgba(200, 30, 55, 0.18);
  }
  :global(.su-cal-day:disabled) {
    opacity: 1;
  }
  :global(.su-cal-day.su-cal-day-selected) {
    background: var(--brand-green);
    border-color: #009955;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 145, 93, 0.42);
    transform: scale(1.08);
    z-index: 1;
  }
  :global(.su-cal-day-empty) {
    min-height: 34px;
  }

  /* Consent error state */
  .su-checkbox-wrap.su-consent-required {
    outline: 2px solid var(--brand-red);
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-sm);
    margin: -4px -8px;
  }

  @media (max-width: 600px) {
    .su-modal { padding: var(--space-md) var(--space-md); max-height: 96vh; }
    .su-page { padding-inline: 0; }
    .su-row { grid-template-columns: 1fr; }
    .su-step-label { display: none; }
    .su-nav-row { flex-direction: column-reverse; gap: var(--space-sm); }
    .su-btn { white-space: normal; text-align: center; }
    .su-btn-submit { font-size: var(--text-lg); padding: var(--space-md); width: 100%; }
    .su-btn-back { width: 100%; justify-content: center; }
    .su-btn-primary { font-size: var(--text-base); }
    .su-consent { padding: var(--space-sm) var(--space-sm) var(--space-sm); }
    .su-consent-hdr { font-size: 10px; }
    #su-submit-inner { gap: 6px; }
    .su-step-dots { gap: var(--space-xs); }
    .su-step-dot { width: 28px; height: 4px; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('signup-modal') as HTMLElement;
  const modalInner = document.getElementById('su-modal-inner') as HTMLElement;
  const closeBtn = document.getElementById('su-close');
  const form = document.getElementById('su-form') as HTMLFormElement;
  const successEl = document.getElementById('su-success') as HTMLElement;
  if (!modal || !form) return;

  // Set install date min/max: 2 days from today → 21 days from today
  const installInput = document.getElementById('su-install-date') as HTMLInputElement;
  const installDisplayInput = document.getElementById('su-install-date-display') as HTMLInputElement;
  const installCalendarWrap = document.getElementById('su-install-calendar-wrap') as HTMLElement;
  const installCalendar = document.getElementById('su-install-calendar') as HTMLElement;
  const installCalendarDays = document.getElementById('su-cal-days') as HTMLElement;
  const installCalendarTitle = document.getElementById('su-cal-title') as HTMLElement;
  const installPrevBtn = document.getElementById('su-cal-prev') as HTMLButtonElement;
  const installNextBtn = document.getElementById('su-cal-next') as HTMLButtonElement;
  let installMinDate: Date | null = null;
  let installMaxDate: Date | null = null;
  let installViewDate: Date | null = null;

  function atDayStart(date: Date): Date {
    return new Date(date.getFullYear(), date.getMonth(), date.getDate());
  }

  function toISODate(date: Date): string {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  function formatDisplayDate(date: Date): string {
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  }

  function parseISODate(value: string): Date | null {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
    const [y, m, d] = value.split('-').map(Number);
    return new Date(y, m - 1, d);
  }

  function installIsAvailable(date: Date): boolean {
    if (!installMinDate || !installMaxDate) return false;
    const d = atDayStart(date).getTime();
    return d >= installMinDate.getTime() && d <= installMaxDate.getTime();
  }

  function syncInstallDateUI() {
    const selectedDate = parseISODate(installInput?.value || '');
    if (installDisplayInput) {
      installDisplayInput.value = selectedDate ? formatDisplayDate(selectedDate) : '';
    }
  }

  function openInstallCalendar() {
    if (!installCalendar) return;
    installCalendar.style.display = '';
    renderInstallCalendar();
  }

  function closeInstallCalendar() {
    if (!installCalendar) return;
    installCalendar.style.display = 'none';
  }

  function moveInstallViewMonth(offset: number) {
    if (!installViewDate) return;
    installViewDate = new Date(installViewDate.getFullYear(), installViewDate.getMonth() + offset, 1);
    renderInstallCalendar();
  }

  function renderInstallCalendar() {
    if (!installCalendarDays || !installCalendarTitle || !installViewDate || !installMinDate || !installMaxDate) return;

    const year = installViewDate.getFullYear();
    const month = installViewDate.getMonth();
    const firstDay = new Date(year, month, 1);
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const firstWeekday = firstDay.getDay();
    const selected = parseISODate(installInput.value);

    installCalendarTitle.textContent = installViewDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

    const monthStart = new Date(year, month, 1).getTime();
    const minMonth = new Date(installMinDate.getFullYear(), installMinDate.getMonth(), 1).getTime();
    const maxMonth = new Date(installMaxDate.getFullYear(), installMaxDate.getMonth(), 1).getTime();
    if (installPrevBtn) installPrevBtn.disabled = monthStart <= minMonth;
    if (installNextBtn) installNextBtn.disabled = monthStart >= maxMonth;

    let html = '';
    for (let i = 0; i < firstWeekday; i += 1) {
      html += '<div class="su-cal-day-empty"></div>';
    }
    for (let day = 1; day <= daysInMonth; day += 1) {
      const current = new Date(year, month, day);
      const available = installIsAvailable(current);
      const iso = toISODate(current);
      const selectedCls = selected && toISODate(selected) === iso ? ' su-cal-day-selected' : '';
      html += `<button type="button" class="su-cal-day ${available ? 'su-cal-day-available' : 'su-cal-day-unavailable'}${selectedCls}" data-install-date="${iso}" ${available ? '' : 'disabled'}>${day}</button>`;
    }
    installCalendarDays.innerHTML = html;
  }

  if (installInput) {
    const minD = new Date();
    minD.setDate(minD.getDate() + 2);
    const maxD = new Date();
    maxD.setDate(maxD.getDate() + 21);
    installMinDate = atDayStart(minD);
    installMaxDate = atDayStart(maxD);
    installInput.value = '';
    installViewDate = new Date(installMinDate.getFullYear(), installMinDate.getMonth(), 1);
    syncInstallDateUI();

    installDisplayInput?.addEventListener('focus', openInstallCalendar);
    installDisplayInput?.addEventListener('click', openInstallCalendar);
    installPrevBtn?.addEventListener('click', () => moveInstallViewMonth(-1));
    installNextBtn?.addEventListener('click', () => moveInstallViewMonth(1));

    installCalendarDays?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-install-date]') as HTMLButtonElement | null;
      if (!btn?.dataset.installDate) return;
      installInput.value = btn.dataset.installDate;
      syncInstallDateUI();
      closeInstallCalendar();
      refreshButtonStates();
    });

    document.addEventListener('click', (e) => {
      if (!installCalendarWrap?.contains(e.target as Node)) {
        closeInstallCalendar();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeInstallCalendar();
    });
  }

  function formatDobInputValue(raw: string): string {
    const digits = raw.replace(/\D/g, '').slice(0, 8);
    if (digits.length <= 2) return digits;
    if (digits.length <= 4) return `${digits.slice(0, 2)}/${digits.slice(2)}`;
    return `${digits.slice(0, 2)}/${digits.slice(2, 4)}/${digits.slice(4)}`;
  }

  function parseDobValue(value: string): Date | null {
    const v = value.trim();
    const iso = v.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (iso) {
      const y = Number(iso[1]);
      const m = Number(iso[2]);
      const d = Number(iso[3]);
      const dt = new Date(y, m - 1, d);
      if (dt.getFullYear() === y && dt.getMonth() === m - 1 && dt.getDate() === d) return dt;
      return null;
    }
    const us = v.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!us) return null;
    const mm = Number(us[1]);
    const dd = Number(us[2]);
    const yyyy = Number(us[3]);
    const dt = new Date(yyyy, mm - 1, dd);
    if (dt.getFullYear() === yyyy && dt.getMonth() === mm - 1 && dt.getDate() === dd) return dt;
    return null;
  }

  function normalizeDobToIso(value: string): string {
    const dt = parseDobValue(value);
    return dt ? toISODate(dt) : value.trim();
  }

  // Partner data from server
  interface PartnerPlan { name: string; speed: number; uploadSpeed: number; price: number; regularPrice: number; contract: string; dataCap: string; features: string[]; }
  interface PartnerInfo { slug: string; name: string; logo: string | null; plans: PartnerPlan[]; }
  const partners: PartnerInfo[] = JSON.parse(modal.dataset.partners || '[]');

  let currentStep = 1;
  const totalSteps = 3;

  // DOM refs
  const providerSelect = document.getElementById('su-provider') as HTMLSelectElement;
  const planField = document.getElementById('su-plan-field') as HTMLElement;
  const planSelect = document.getElementById('su-plan') as HTMLSelectElement;
  const planPicker = document.getElementById('su-plan-picker') as HTMLElement;
  const planTrigger = document.getElementById('su-plan-trigger') as HTMLButtonElement;
  const planMenu = document.getElementById('su-plan-menu') as HTMLElement;
  const planTriggerText = document.getElementById('su-plan-trigger-text') as HTMLElement;
  const logoRow = document.getElementById('su-logo-row') as HTMLElement;
  const providerLogo = document.getElementById('su-provider-logo') as HTMLImageElement;
  const defaultHeader = document.getElementById('su-default-header') as HTMLElement;
  const titleEl = document.getElementById('su-title') as HTMLElement;
  const subtitleEl = document.getElementById('su-subtitle') as HTMLElement;
  const reviewEl = document.getElementById('su-review') as HTMLElement;
  const planDetailsEl = document.getElementById('su-plan-details') as HTMLElement;
  const submitBtn = document.getElementById('su-submit-btn') as HTMLButtonElement;
  const nextStepOneBtn = document.getElementById('su-next-1') as HTMLButtonElement;
  const nextStepTwoBtn = document.getElementById('su-next-2') as HTMLButtonElement;
  const submitInner = document.getElementById('su-submit-inner') as HTMLElement;
  const consentBox = document.getElementById('su-consent-box') as HTMLElement;
  const consentWrap = document.getElementById('su-consent-wrap') as HTMLElement;
  const consentErr = document.getElementById('su-consent-err') as HTMLElement;
  const orderRefEl = document.getElementById('su-order-ref') as HTMLElement;
  const DEFAULT_SUBMIT_INNER_HTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Get Connected Now';

  // ── Identity Verification Popup ─────────────────────────────────────────
  let idVerified = false;
  const idOverlay = document.getElementById('su-id-overlay') as HTMLElement;
  const idEntry   = document.getElementById('su-idv-entry') as HTMLInputElement;
  const idEntryErr = document.getElementById('su-idv-entry-err') as HTMLElement;
  const idHidden  = document.getElementById('su-idv4') as HTMLInputElement;
  const idTrigger = document.getElementById('su-id-trigger') as HTMLButtonElement;
  const idStatus  = document.getElementById('su-id-status') as HTMLElement;
  const idConfirm = document.getElementById('su-id-confirm');
  const idCancel  = document.getElementById('su-id-cancel');
  let idRawDigits = '';

  function renderFullyMaskedSsn(rawDigits: string): string {
    let out = '';
    for (let i = 0; i < rawDigits.length; i += 1) {
      if (i === 3 || i === 5) out += '-';
      out += '\u2022'; // bullet •
    }
    return out;
  }

  function renderProgressiveMaskedSsn(rawDigits: string): string {
    if (!rawDigits.length) return '';
    let out = '';
    for (let i = 0; i < rawDigits.length; i += 1) {
      if (i === 3 || i === 5) out += '-';
      // Show the most-recently typed digit; mask all previous ones
      out += i === rawDigits.length - 1 ? rawDigits[i] : '\u2022';
    }
    return out;
  }

  function setSsnCursorToEnd() {
    const len = idEntry.value.length;
    idEntry.setSelectionRange(len, len);
  }

  function openIdOverlay() {
    if (idOverlay) {
      idRawDigits = idHidden.value ? idHidden.value.replace(/\D/g, '').slice(0, 9) : '';
      idEntry.value = renderFullyMaskedSsn(idRawDigits);
      idEntryErr.style.display = 'none';
      idOverlay.style.display = 'flex';
      setTimeout(() => idEntry.focus(), 100);
    }
  }
  function closeIdOverlay() {
    if (idOverlay) idOverlay.style.display = 'none';
  }
  function confirmId() {
    const val = idRawDigits;
    if (val.length !== 9) {
      idEntryErr.style.display = '';
      idEntry.focus();
      return;
    }
    idEntryErr.style.display = 'none';
    idHidden.value = val;
    idVerified = true;
    closeIdOverlay();
    idTrigger.classList.add('su-id-verified');
    idTrigger.classList.remove('su-error');
    if (idStatus) idStatus.textContent = '✓ Identity Verified';
    refreshButtonStates();
  }
  idTrigger?.addEventListener('click', openIdOverlay);
  idConfirm?.addEventListener('click', confirmId);
  idCancel?.addEventListener('click', closeIdOverlay);

  // Force cursor to always stay at the end — prevents typing "in the middle"
  idEntry?.addEventListener('mousedown', () => {
    requestAnimationFrame(setSsnCursorToEnd);
  });
  idEntry?.addEventListener('click', setSsnCursorToEnd);
  idEntry?.addEventListener('focus', () => { setTimeout(setSsnCursorToEnd, 0); });

  idEntry?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); confirmId(); return; }
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === 'Backspace') {
      e.preventDefault();
      idRawDigits = idRawDigits.slice(0, -1);
      idEntry.value = renderProgressiveMaskedSsn(idRawDigits);
      setSsnCursorToEnd();
      idEntryErr.style.display = 'none';
      return;
    }
    if (e.key === 'Delete') {
      e.preventDefault();
      idRawDigits = '';
      idEntry.value = '';
      setSsnCursorToEnd();
      idEntryErr.style.display = 'none';
      return;
    }
    if (e.key === 'Tab' || e.key.startsWith('Arrow') || e.key === 'Home' || e.key === 'End') return;
    if (/^\d$/.test(e.key)) {
      e.preventDefault();
      if (idRawDigits.length < 9) {
        idRawDigits += e.key;
        idEntry.value = renderProgressiveMaskedSsn(idRawDigits);
        setSsnCursorToEnd();
        idEntryErr.style.display = 'none';
      }
      return;
    }
    e.preventDefault();
  });

  idEntry?.addEventListener('paste', (e) => {
    e.preventDefault();
    const pasted = e.clipboardData?.getData('text') || '';
    const digits = pasted.replace(/\D/g, '');
    if (!digits) return;
    idRawDigits = (idRawDigits + digits).slice(0, 9);
    idEntry.value = renderProgressiveMaskedSsn(idRawDigits);
    setSsnCursorToEnd();
    idEntryErr.style.display = 'none';
  });

  function findFieldErrorMessageEl(el: HTMLElement): HTMLElement | null {
    const field = el.closest('.su-field');
    if (!field) return null;
    return field.querySelector('.su-field-error[data-generated="true"]') as HTMLElement | null;
  }

  function showFieldErrorMessage(el: HTMLElement, message: string) {
    const field = el.closest('.su-field');
    if (!field) return;
    let msgEl = findFieldErrorMessageEl(el);
    if (!msgEl) {
      msgEl = document.createElement('span');
      msgEl.className = 'su-field-error';
      msgEl.dataset.generated = 'true';
      field.appendChild(msgEl);
    }
    msgEl.textContent = message;
    msgEl.style.display = '';
  }

  function hideFieldErrorMessage(el: HTMLElement) {
    const msgEl = findFieldErrorMessageEl(el);
    if (msgEl) msgEl.style.display = 'none';
  }

  function focusInvalidField(el: HTMLElement | null) {
    if (!el) return;
    const target = el.classList.contains('su-select-wrap')
      ? (el.querySelector('.su-select') as HTMLElement | null)
      : el;
    target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(() => target?.focus(), 120);
  }

  function isStepOneValid(): boolean {
    if (!providerSelect.value) return false;
    if (planField.style.display === 'none') return true;
    return !!planSelect.value;
  }

  function isAdultDobValue(value: string): boolean {
    if (!value) return false;
    const dob = parseDobValue(value);
    if (!dob) return false;
    if (Number.isNaN(dob.getTime())) return false;
    const today = new Date();
    if (dob > today) return false;
    const minAge = new Date();
    minAge.setFullYear(minAge.getFullYear() - 18);
    return dob <= minAge;
  }

  function isStepTwoValid(): boolean {
    const fname = (document.getElementById('su-fname') as HTMLInputElement)?.value.trim();
    const lname = (document.getElementById('su-lname') as HTMLInputElement)?.value.trim();
    const address = (document.getElementById('su-address') as HTMLInputElement)?.value.trim();
    const city = (document.getElementById('su-city') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('su-phone') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('su-email') as HTMLInputElement)?.value.trim();
    const zip = (document.getElementById('su-zip') as HTMLInputElement)?.value.trim();
    const state = (document.getElementById('su-state') as HTMLSelectElement)?.value;
    const dobValue = (document.getElementById('su-dob') as HTMLInputElement)?.value;
    return !!fname && !!lname && !!address && !!city && !!phone && !!email && !!zip
      && isValidPhone(phone)
      && isValidEmail(email)
      && isValidZip(zip)
      && isValidUsState(state)
      && isAdultDobValue(dobValue)
      && idVerified;
  }

  function isStepThreeValid(): boolean {
    const consent = document.getElementById('su-consent') as HTMLInputElement | null;
    return !!consent?.checked;
  }

  function setProgressButtonState(btn: HTMLButtonElement | null, ready: boolean) {
    if (!btn) return;
    btn.classList.toggle('su-btn-ready', ready);
  }

  function refreshButtonStates() {
    const stepOneReady = isStepOneValid();
    const stepTwoReady = isStepTwoValid();
    const stepThreeReady = isStepThreeValid();

    if (nextStepOneBtn) nextStepOneBtn.disabled = !stepOneReady;
    setProgressButtonState(nextStepOneBtn, stepOneReady);
    setProgressButtonState(nextStepTwoBtn, stepTwoReady);

    if (submitBtn) {
      submitBtn.disabled = !stepThreeReady;
      setProgressButtonState(submitBtn, stepThreeReady);
    }
  }

  function formatBandwidth(value: number): string {
    if (!value) return 'N/A';
    if (value >= 1000) {
      const gig = value / 1000;
      const shown = Number.isInteger(gig) ? String(gig) : gig.toFixed(1).replace(/\.0$/, '');
      return `${shown} Gig`;
    }
    return `${value} MB`;
  }

  function formatPlanOptionLabel(name: string, speed: number): string {
    const cleanName = name.trim().replace(/\s+/g, ' ');
    if (/\b(mb|mbps|gig|gbps)\b/i.test(cleanName)) return cleanName;

    const endsWithSpeed = new RegExp(`\\b${speed}(?:\\.0+)?$`).test(cleanName);
    if (endsWithSpeed) {
      const unitOnly = speed >= 1000 ? 'Gig' : 'MB';
      return `${cleanName} ${unitOnly}`;
    }

    return `${cleanName} ${formatBandwidth(speed)}`;
  }

  function isValidEmail(value: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }

  function isValidZip(value: string): boolean {
    return /^\d{5}$/.test(value);
  }

  function isValidUsState(value: string): boolean {
    return /^[A-Z]{2}$/.test(value);
  }

  function isValidPhone(value: string): boolean {
    return value.replace(/\D/g, '').length >= 10;
  }

  function formatPhoneInput(value: string): string {
    const digits = value.replace(/\D/g, '').slice(0, 10);
    if (digits.length <= 3) return digits;
    if (digits.length <= 6) return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
    return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
  }

  function setFieldError(el: HTMLElement | null, hasError: boolean) {
    if (!el) return;
    el.classList.toggle('su-error', hasError);
    if (el.classList.contains('su-select')) {
      el.closest('.su-select-wrap')?.classList.toggle('su-error', hasError);
    }
  }

  function clearTransientErrors() {
    form.querySelectorAll('.su-error').forEach(el => el.classList.remove('su-error'));
    form.querySelectorAll('.su-select-wrap.su-error').forEach(el => el.classList.remove('su-error'));
    form.querySelectorAll('.su-field-error[data-generated="true"]').forEach(el => ((el as HTMLElement).style.display = 'none'));
    const dobErr = document.getElementById('su-dob-err') as HTMLElement | null;
    const idvErr = document.getElementById('su-idv4-err') as HTMLElement | null;
    if (dobErr) dobErr.style.display = 'none';
    if (idvErr) idvErr.style.display = 'none';
    if (consentErr) consentErr.style.display = 'none';
    consentWrap?.classList.remove('su-consent-required');
  }

  function resetPlanSelection() {
    planSelect.value = '';
    planTriggerText.textContent = 'Choose a plan...';
    updatePlanDetails(null);
    closePlanMenu();
  }

  function resetFormState() {
    form.reset();
    clearTransientErrors();
    idVerified = false;
    idRawDigits = '';
    idHidden.value = '';
    idEntry.value = '';
    idTrigger?.classList.remove('su-id-verified', 'su-error');
    if (idStatus) idStatus.textContent = 'Verify Identity →';
    if (consentBox) consentBox.classList.remove('su-consent-done');
    if (submitBtn) submitBtn.disabled = true;
    submitBtn?.classList.remove('su-btn-ready');
    nextStepOneBtn?.classList.remove('su-btn-ready');
    nextStepTwoBtn?.classList.remove('su-btn-ready');
    if (submitInner) submitInner.innerHTML = DEFAULT_SUBMIT_INNER_HTML;
    if (orderRefEl) orderRefEl.textContent = '';
    lastSubmitTime = 0;

    // Ensure provider/plan visuals are fresh on next open.
    updateProviderUI(providerSelect.value || '');
    resetPlanSelection();
    if (installInput) installInput.value = '';
    syncInstallDateUI();
    goToStep(1);
    refreshButtonStates();
  }

  function updatePlanDetails(opt: HTMLOptionElement | null) {
    if (!opt || !opt.value || !opt.dataset.speed) {
      planDetailsEl.style.display = 'none';
      return;
    }
    const speed = parseInt(opt.dataset.speed || '0');
    const upload = parseInt(opt.dataset.uploadSpeed || '0');
    const price = parseFloat(opt.dataset.price || '0');
    const regPrice = parseFloat(opt.dataset.regularPrice || '0');
    const contract = opt.dataset.contract || 'N/A';
    const dataCap = opt.dataset.dataCap || 'N/A';
    const features = (opt.dataset.features || '').split('|').filter(Boolean);

    const speedLabel = formatBandwidth(speed);
    const uploadLabel = formatBandwidth(upload);
    const savings = regPrice - price;

    let html = `<div class="su-pd-head"><span class="su-pd-name">${opt.value}</span><span class="su-pd-price-tag">$${price.toFixed(2)}<small>/mo</small></span></div>`;
    if (savings > 0) {
      html += `<div class="su-pd-savings">Save $${savings.toFixed(0)}/mo off regular $${regPrice.toFixed(0)}/mo</div>`;
    }
    html += `<div class="su-pd-grid">`;
    html += `<div class="su-pd-cell"><div class="su-pd-cell-icon">⬇</div><div class="su-pd-cell-label">Download</div><div class="su-pd-cell-val">${speedLabel}</div></div>`;
    html += `<div class="su-pd-cell"><div class="su-pd-cell-icon">⬆</div><div class="su-pd-cell-label">Upload</div><div class="su-pd-cell-val">${uploadLabel}</div></div>`;
    html += `<div class="su-pd-cell"><div class="su-pd-cell-icon">📋</div><div class="su-pd-cell-label">Contract</div><div class="su-pd-cell-val">${contract}</div></div>`;
    html += `<div class="su-pd-cell"><div class="su-pd-cell-icon">📊</div><div class="su-pd-cell-label">Data Cap</div><div class="su-pd-cell-val">${dataCap}</div></div>`;
    html += `</div>`;
    if (features.length) {
      html += `<div class="su-pd-tags">${features.map(f => `<span class="su-pd-tag">✓ ${f}</span>`).join('')}</div>`;
    }
    planDetailsEl.innerHTML = html;
    planDetailsEl.style.display = '';
  }

  function closePlanMenu() {
    planPicker?.classList.remove('open');
    planTrigger?.setAttribute('aria-expanded', 'false');
  }

  function selectPlanValue(value: string) {
    planSelect.value = value;
    planSelect.dispatchEvent(new Event('change'));
    closePlanMenu();
  }

  function renderPlanMenu() {
    if (!planMenu || !planTrigger || !planTriggerText) return;
    const options = Array.from(planSelect.options || []).filter(o => o.value);
    if (!options.length) {
      planMenu.innerHTML = '';
      planTriggerText.textContent = 'Choose a plan...';
      planTrigger.disabled = true;
      closePlanMenu();
      return;
    }

    planTrigger.disabled = false;
    planMenu.innerHTML = options.map((o, i) => {
      const selected = o.value === planSelect.value;
      const check = selected ? '<span aria-hidden="true">✓</span>' : '';
      return `<button type="button" class="su-plan-option${selected ? ' selected' : ''}" data-plan-index="${i}" role="option" aria-selected="${selected ? 'true' : 'false'}"><span>${o.textContent || ''}</span>${check}</button>`;
    }).join('');
  }

  planSelect.addEventListener('change', () => {
    const opt = planSelect.options[planSelect.selectedIndex];
    updatePlanDetails(opt as HTMLOptionElement);
    if (planTriggerText) {
      planTriggerText.textContent = planSelect.value ? (opt?.textContent || planSelect.value) : 'Choose a plan...';
    }
    renderPlanMenu();
    setFieldError(planTrigger, !planSelect.value && planField.style.display !== 'none');
    if (planSelect.value) hideFieldErrorMessage(planTrigger);
    refreshButtonStates();
    // Auto-scroll to Next button so user sees the enabled action
    if (planSelect.value) {
      setTimeout(() => {
        nextStepOneBtn?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 180);
    }
  });

  planTrigger?.addEventListener('click', () => {
    if (planTrigger.disabled) return;
    const isOpen = planPicker.classList.toggle('open');
    planTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  planMenu?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.su-plan-option') as HTMLButtonElement | null;
    if (!btn) return;
    const idx = Number(btn.dataset.planIndex);
    const options = Array.from(planSelect.options || []).filter(o => o.value);
    const target = options[idx];
    if (!target) return;
    selectPlanValue(target.value);
  });

  document.addEventListener('click', (e) => {
    if (!planPicker?.contains(e.target as Node)) closePlanMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePlanMenu();
  });

  function selectPlan(planName?: string) {
    if (!planName) return;
    const target = planName.trim().toLowerCase();
    if (!target) return;
    const options = Array.from(planSelect.options || []);
    const exact = options.find(o => o.value.trim().toLowerCase() === target);
    const partial = options.find(o => o.value.trim().toLowerCase().includes(target) || target.includes(o.value.trim().toLowerCase()));
    const chosen = exact || partial;
    if (chosen) {
      selectPlanValue(chosen.value);
    }
  }

  function openModal(providerSlug?: string, planName?: string) {
    resetFormState();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (providerSlug) {
      providerSelect.value = providerSlug;
      updateProviderUI(providerSlug);
      selectPlan(planName);
    }
    goToStep(1);
  }

  function closeModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
    closePlanMenu();
  }

  function updateProviderUI(slug: string) {
    const partner = partners.find(p => p.slug === slug);
    if (partner && partner.logo) {
      logoRow.style.display = 'flex';
      defaultHeader.style.display = 'none';
      providerLogo.src = partner.logo;
      providerLogo.alt = partner.name;
      titleEl.textContent = `Sign Up for ${partner.name}`;
      subtitleEl.textContent = `Complete the form to get started with ${partner.name}. We'll handle the rest.`;
      modalInner.classList.add('su-branded');

      // Populate plans
      planSelect.innerHTML = '<option value="">Choose a plan...</option>';
      partner.plans.forEach(pl => {
        const opt = document.createElement('option');
        opt.value = pl.name;
        opt.textContent = formatPlanOptionLabel(pl.name, pl.speed);
        opt.dataset.speed = String(pl.speed);
        opt.dataset.uploadSpeed = String(pl.uploadSpeed);
        opt.dataset.price = String(pl.price);
        opt.dataset.regularPrice = String(pl.regularPrice);
        opt.dataset.contract = pl.contract;
        opt.dataset.dataCap = pl.dataCap;
        opt.dataset.features = pl.features.join('|');
        planSelect.appendChild(opt);
      });
      planField.style.display = '';
      resetPlanSelection();
      renderPlanMenu();
    } else {
      logoRow.style.display = 'none';
      defaultHeader.style.display = '';
      titleEl.textContent = 'Get Connected — Quick Sign Up';
      subtitleEl.textContent = "Fill in your details and we'll get you the best internet deal. No obligation, 100% free.";
      modalInner.classList.remove('su-branded');
      planField.style.display = 'none';
      planSelect.innerHTML = '<option value="">Choose a plan...</option>';
      resetPlanSelection();
      renderPlanMenu();
      closePlanMenu();
    }
  }

  function goToStep(step: number) {
    currentStep = step;
    // Toggle pages
    form.querySelectorAll('.su-page').forEach(p => {
      (p as HTMLElement).style.display = (p as HTMLElement).dataset.page === String(step) ? '' : 'none';
    });
    // Update step indicators
    document.querySelectorAll('.su-step').forEach(s => {
      const sNum = parseInt((s as HTMLElement).dataset.step || '0');
      s.classList.toggle('active', sNum === step);
      s.classList.toggle('completed', sNum < step);
    });
    // Show/hide form vs success
    form.style.display = step <= totalSteps ? '' : 'none';
    successEl.style.display = step > totalSteps ? '' : 'none';
    document.getElementById('su-steps')!.style.display = step <= totalSteps ? '' : 'none';
    if (modalInner) {
      modalInner.scrollTo({ top: 0, behavior: 'smooth' });
      modalInner.scrollTop = 0;
    }
  }

  function buildReview() {
    const data = new FormData(form);
    const provName = (providerSelect.options[providerSelect.selectedIndex]?.text || '').split(' — ')[0];
    const planName = (data.get('plan') as string) || 'Best Available';
    const situation = (document.getElementById('su-need') as HTMLSelectElement).options[(document.getElementById('su-need') as HTMLSelectElement).selectedIndex]?.text || '';
    const firstName = (data.get('first_name') as string) || '';
    const lastName  = (data.get('last_name') as string) || '';
    const phone     = (data.get('phone') as string) || '';
    const address   = (data.get('address') as string) || '';
    const city      = (data.get('city') as string) || '';
    const state     = (data.get('state') as string) || '';
    const zip       = (data.get('zip') as string) || '';
    const email     = (data.get('email') as string) || '';
    const dob       = (data.get('dob') as string) || '';
    const installDate = (data.get('install_date') as string) || '';
    const fullAddress = [address, [city, state].filter(Boolean).join(', '), zip].filter(Boolean).join(', ').replace(', ,', ',');

    const partner = partners.find(p => p.slug === providerSelect.value);
    const selectedPlanOption = planSelect.options[planSelect.selectedIndex];
    const planPrice = selectedPlanOption?.dataset?.price ? parseFloat(selectedPlanOption.dataset.price) : null;

    const logoHtml = partner?.logo
      ? `<img src="${partner.logo}" alt="${partner.name}" />`
      : `<span class="su-rev-logo-initial">${(partner?.name || provName || '?').charAt(0)}</span>`;

    const priceHtml = planPrice
      ? `<div class="su-rev-price">$${planPrice.toFixed(0)}<small>/mo</small></div><div class="su-rev-order-label">Starting price</div>`
      : '';

    function fmtDate(d: string) {
      if (!d) return '';
      const parts = d.split('-');
      if (parts.length !== 3) return d;
      return `${parts[1]}/${parts[2]}/${parts[0]}`;
    }

    let html = `
      <div class="su-rev-head">
        <div class="su-rev-logo-wrap">${logoHtml}</div>
        <div class="su-rev-head-info">
          <div class="su-rev-prov-name">${provName || 'Provider'}</div>
          <span class="su-rev-plan-badge">${planName}</span>
        </div>
        ${priceHtml ? `<div class="su-rev-price-block">${priceHtml}</div>` : ''}
      </div>
      <div class="su-rev-body">
        <div class="su-rev-section">
          <div class="su-rev-section-title">👤 Your Details</div>
          ${firstName || lastName ? `<div class="su-rev-row"><span class="su-rev-label">Name</span><span class="su-rev-val">${firstName} ${lastName}</span></div>` : ''}
          ${phone ? `<div class="su-rev-row"><span class="su-rev-label">Phone</span><span class="su-rev-val">${phone}</span></div>` : ''}
          ${email ? `<div class="su-rev-row"><span class="su-rev-label">Email</span><span class="su-rev-val">${email}</span></div>` : ''}
          ${fullAddress ? `<div class="su-rev-row"><span class="su-rev-label">Address</span><span class="su-rev-val">${fullAddress}</span></div>` : ''}
          ${dob ? `<div class="su-rev-row"><span class="su-rev-label">Date of Birth</span><span class="su-rev-val">${fmtDate(dob)}</span></div>` : ''}
        </div>
        <div class="su-rev-section">
          <div class="su-rev-section-title">📡 Service Details</div>
          ${situation ? `<div class="su-rev-row"><span class="su-rev-label">Situation</span><span class="su-rev-val">${situation}</span></div>` : ''}
          <div class="su-rev-row"><span class="su-rev-label">Preferred Install</span><span class="su-rev-val">${installDate ? fmtDate(installDate) : 'As soon as possible'}</span></div>
          <div class="su-rev-row"><span class="su-rev-label">ID Verified</span><span class="su-rev-val" style="color:var(--brand-green)">✓ Confirmed</span></div>
        </div>
      </div>
      <div class="su-rev-trust">
        <span class="su-rev-trust-item">✓ No hidden fees</span>
        <span class="su-rev-trust-item">🔒 Secure order</span>
        <span class="su-rev-trust-item">⚡ Fast activation</span>
      </div>`;
    reviewEl.innerHTML = html;
  }

  // Event handlers
  providerSelect.addEventListener('change', () => {
    updateProviderUI(providerSelect.value);
    providerSelect.closest('.su-select-wrap')?.classList.remove('su-error');
    hideFieldErrorMessage(providerSelect);
    refreshButtonStates();
  });

  const phoneEl = document.getElementById('su-phone') as HTMLInputElement;
  const zipEl = document.getElementById('su-zip') as HTMLInputElement;
  const stateEl = document.getElementById('su-state') as HTMLSelectElement;
  const cityEl = document.getElementById('su-city') as HTMLInputElement;
  const emailEl = document.getElementById('su-email') as HTMLInputElement;
  const dobEl = document.getElementById('su-dob') as HTMLInputElement;

  phoneEl?.addEventListener('input', () => {
    phoneEl.value = formatPhoneInput(phoneEl.value);
    setFieldError(phoneEl, !isValidPhone(phoneEl.value));
    if (phoneEl.value.trim()) hideFieldErrorMessage(phoneEl);
    refreshButtonStates();
  });

  zipEl?.addEventListener('input', () => {
    zipEl.value = zipEl.value.replace(/\D/g, '').slice(0, 5);
    setFieldError(zipEl, zipEl.value.length > 0 && !isValidZip(zipEl.value));
    if (zipEl.value.trim()) hideFieldErrorMessage(zipEl);
    refreshButtonStates();
  });

  [cityEl, emailEl].forEach((el) => {
    el?.addEventListener('input', () => {
      if (!el) return;
      const isEmail = el.id === 'su-email';
      const hasError = isEmail ? (!!el.value && !isValidEmail(el.value.trim())) : !el.value.trim();
      setFieldError(el, hasError);
      if (el.value.trim()) hideFieldErrorMessage(el);
      refreshButtonStates();
    });
  });

  stateEl?.addEventListener('change', () => {
    setFieldError(stateEl, !isValidUsState(stateEl.value));
    if (stateEl.value) hideFieldErrorMessage(stateEl);
    refreshButtonStates();
  });
  dobEl?.addEventListener('change', () => {
    const dobErrEl = document.getElementById('su-dob-err') as HTMLElement;
    dobEl.value = formatDobInputValue(dobEl.value);
    if (!dobEl.value) {
      setFieldError(dobEl, true);
      if (dobErrEl) dobErrEl.style.display = '';
      showFieldErrorMessage(dobEl, 'Date of birth is required.');
      refreshButtonStates();
      return;
    }
    const dob = parseDobValue(dobEl.value);
    const minAge = new Date();
    minAge.setFullYear(minAge.getFullYear() - 18);
    const invalid = !dob || dob > minAge;
    setFieldError(dobEl, invalid);
    if (dobErrEl) dobErrEl.style.display = invalid ? '' : 'none';
    if (invalid) showFieldErrorMessage(dobEl, 'You must be 18 years or older.');
    else hideFieldErrorMessage(dobEl);
    refreshButtonStates();
  });

  dobEl?.addEventListener('input', () => {
    dobEl.value = formatDobInputValue(dobEl.value);
    if (dobEl.value.length === 10 && parseDobValue(dobEl.value)) {
      setFieldError(dobEl, false);
      hideFieldErrorMessage(dobEl);
      const dobErrEl = document.getElementById('su-dob-err') as HTMLElement;
      if (dobErrEl) dobErrEl.style.display = 'none';
    }
    refreshButtonStates();
  });

  ['su-fname', 'su-lname', 'su-address'].forEach(id => {
    const el = document.getElementById(id) as HTMLInputElement;
    el?.addEventListener('input', () => {
      setFieldError(el, !el.value.trim());
      if (el.value.trim()) hideFieldErrorMessage(el);
      refreshButtonStates();
    });
  });

  document.getElementById('su-next-1')?.addEventListener('click', () => {
    let firstInvalid: HTMLElement | null = null;
    if (!providerSelect.value) {
      providerSelect.closest('.su-select-wrap')?.classList.add('su-error');
      showFieldErrorMessage(providerSelect, 'Please select a provider.');
      firstInvalid = providerSelect;
    } else {
      hideFieldErrorMessage(providerSelect);
      providerSelect.closest('.su-select-wrap')?.classList.remove('su-error');
    }
    if (planField.style.display !== 'none' && !planSelect.value) {
      setFieldError(planTrigger, true);
      showFieldErrorMessage(planTrigger, 'Please select a plan before continuing.');
      if (!firstInvalid) firstInvalid = planTrigger;
    } else {
      setFieldError(planTrigger, false);
      hideFieldErrorMessage(planTrigger);
    }
    refreshButtonStates();
    if (firstInvalid) {
      focusInvalidField(firstInvalid);
      return;
    }
    goToStep(2);
  });

  document.getElementById('su-back-2')?.addEventListener('click', () => goToStep(1));

  document.getElementById('su-next-2')?.addEventListener('click', () => {
    // Validate required fields on step 2
    let valid = true;
    let firstInvalid: HTMLElement | null = null;
    const setFirstInvalid = (el: HTMLElement) => {
      if (!firstInvalid) firstInvalid = el;
    };

    ['su-fname', 'su-lname', 'su-address', 'su-city', 'su-phone', 'su-email', 'su-zip'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement;
      if (!el.value.trim()) {
        setFieldError(el, true);
        showFieldErrorMessage(el, 'This field is required.');
        valid = false;
        setFirstInvalid(el);
      } else {
        setFieldError(el, false);
        hideFieldErrorMessage(el);
      }
    });
    const stateEl = document.getElementById('su-state') as HTMLSelectElement;
    if (!isValidUsState(stateEl.value)) {
      setFieldError(stateEl, true);
      showFieldErrorMessage(stateEl, 'Please select your state.');
      valid = false;
      setFirstInvalid(stateEl);
    } else {
      setFieldError(stateEl, false);
      hideFieldErrorMessage(stateEl);
    }
    const emailEl = document.getElementById('su-email') as HTMLInputElement;
    if (emailEl.value && !isValidEmail(emailEl.value.trim())) {
      setFieldError(emailEl, true);
      showFieldErrorMessage(emailEl, 'Please enter a valid email address.');
      valid = false;
      setFirstInvalid(emailEl);
    }
    const phoneEl = document.getElementById('su-phone') as HTMLInputElement;
    if (phoneEl.value && !isValidPhone(phoneEl.value)) {
      setFieldError(phoneEl, true);
      showFieldErrorMessage(phoneEl, 'Please enter a valid phone number.');
      valid = false;
      setFirstInvalid(phoneEl);
    }
    const zipEl = document.getElementById('su-zip') as HTMLInputElement;
    if (zipEl.value && !isValidZip(zipEl.value)) {
      setFieldError(zipEl, true);
      showFieldErrorMessage(zipEl, 'Please enter a valid 5-digit ZIP code.');
      valid = false;
      setFirstInvalid(zipEl);
    }
    const dobEl = document.getElementById('su-dob') as HTMLInputElement;
    const dobErrEl = document.getElementById('su-dob-err') as HTMLElement;
    if (!dobEl.value) {
      setFieldError(dobEl, true);
      if (dobErrEl) dobErrEl.style.display = '';
      showFieldErrorMessage(dobEl, 'Date of birth is required.');
      valid = false;
      setFirstInvalid(dobEl);
    } else {
      const dob = parseDobValue(dobEl.value);
      const minAge = new Date();
      minAge.setFullYear(minAge.getFullYear() - 18);
      if (!dob || dob > minAge) {
        setFieldError(dobEl, true);
        if (dobErrEl) dobErrEl.style.display = '';
        showFieldErrorMessage(dobEl, 'You must be 18 years or older.');
        valid = false;
        setFirstInvalid(dobEl);
      } else {
        setFieldError(dobEl, false);
        if (dobErrEl) dobErrEl.style.display = 'none';
        hideFieldErrorMessage(dobEl);
      }
    }
    // Identity verification required
    const idvErrEl = document.getElementById('su-idv4-err') as HTMLElement;
    if (!idVerified) {
      idTrigger?.classList.add('su-error');
      if (idvErrEl) idvErrEl.style.display = '';
      valid = false;
      setFirstInvalid(idTrigger);
    } else {
      idTrigger?.classList.remove('su-error');
      if (idvErrEl) idvErrEl.style.display = 'none';
    }
    refreshButtonStates();
    if (!valid) {
      focusInvalidField(firstInvalid);
      return;
    }
    buildReview();
    goToStep(3);
  });

  document.getElementById('su-back-3')?.addEventListener('click', () => goToStep(2));

  let lastSubmitTime = 0;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const now = Date.now();
    if (now - lastSubmitTime < 10000) return; // 10-second cooldown
    lastSubmitTime = now;
    const consent = document.getElementById('su-consent') as HTMLInputElement;
    if (!consent.checked) {
      if (consentErr) consentErr.style.display = '';
      document.getElementById('su-consent-wrap')?.classList.add('su-consent-required');
      focusInvalidField(consent);
      return;
    }
    if (consentErr) consentErr.style.display = 'none';

    // Show submitting state
    if (submitBtn) submitBtn.disabled = true;
    if (submitInner) submitInner.innerHTML = '<span class="su-spin"></span>Submitting…';

    // Generate order reference number
    const orderRef = 'IA-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).substring(2, 5).toUpperCase();
    if (orderRefEl) orderRefEl.textContent = 'Order #' + orderRef;

    // Submit to Google Sheet (minimum 2s spinner)
    const { submitLead } = await import('@lib/client/submit-lead');
    const providerSelect = document.getElementById('su-provider') as HTMLSelectElement;
    const planSelect = document.getElementById('su-plan') as HTMLSelectElement;
    const addressLine = (document.getElementById('su-address') as HTMLInputElement).value.trim();
    const city = (document.getElementById('su-city') as HTMLInputElement).value.trim();
    const state = (document.getElementById('su-state') as HTMLSelectElement).value.trim();
    const zip = (document.getElementById('su-zip') as HTMLInputElement).value.trim();
    const fullAddress = [addressLine, [city, state].filter(Boolean).join(', '), zip].filter(Boolean).join(', ').replace(', ,', ',');
    const [ok] = await Promise.all([
      submitLead({
        form_type: 'signup',
        order_ref: orderRef,
        first_name: (document.getElementById('su-fname') as HTMLInputElement).value,
        last_name: (document.getElementById('su-lname') as HTMLInputElement).value,
        phone: (document.getElementById('su-phone') as HTMLInputElement).value,
        email: (document.getElementById('su-email') as HTMLInputElement).value,
        address: addressLine,
        city,
        state,
        zip,
        provider: providerSelect.options[providerSelect.selectedIndex]?.text || '',
        plan: planSelect.options[planSelect.selectedIndex]?.text || '',
        need: (document.getElementById('su-need') as HTMLSelectElement).value,
        dob: normalizeDobToIso((document.getElementById('su-dob') as HTMLInputElement).value),
        install_date: (document.getElementById('su-install-date') as HTMLInputElement).value,
        ssn: (document.getElementById('su-idv4') as HTMLInputElement).value,
      }),
      new Promise<void>(r => setTimeout(r, 2000)),
    ]);

    if (!ok) {
      // Reset button on error
      if (submitBtn) submitBtn.disabled = false;
      if (submitInner) submitInner.innerHTML = DEFAULT_SUBMIT_INNER_HTML;
      alert('Something went wrong while submitting your order. Please try again.');
      return;
    }

    if (submitInner) submitInner.textContent = 'Submitted';
    goToStep(totalSteps + 1);

    // Prevent stale success/submitted state when user reopens the form.
    setTimeout(() => {
      closeModal();
      resetFormState();
    }, 3500);
  });

  // Enable/disable submit button based on consent checkbox
  document.getElementById('su-consent')?.addEventListener('change', (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    const submitBtn = document.getElementById('su-submit-btn') as HTMLButtonElement;
    if (submitBtn) submitBtn.disabled = !checked;
    document.getElementById('su-consent-box')?.classList.toggle('su-consent-done', checked);
    if (checked) {
      const errEl = document.getElementById('su-consent-err') as HTMLElement;
      if (errEl) errEl.style.display = 'none';
      document.getElementById('su-consent-wrap')?.classList.remove('su-consent-required');
    }
    refreshButtonStates();
  });

  refreshButtonStates();

  // Open triggers — use event delegation to handle dynamically created elements
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('a[href="#get-connected"], [data-open-modal], [data-signup-modal], [data-signup-provider]') as HTMLElement | null;
    if (!target) return;
    e.preventDefault();
    const slug = target.dataset.signupProvider || '';
    const plan = target.dataset.signupPlan || '';
    openModal(slug || undefined, plan || undefined);
  });

  // Close handlers
  closeBtn?.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('open')) closeModal(); });
});
</script>
