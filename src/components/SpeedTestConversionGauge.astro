    border: 1px solid rgba(255,255,255,0.07);
    text-align: right;
    backdrop-filter: blur(12px);
  }

  .score-chip-label {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 0.76rem;
