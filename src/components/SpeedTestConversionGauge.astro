---
interface Props {
  downloadMbps?: number;
  uploadMbps?: number;
  pingMs?: number;
  availableFiberMbps?: number;
  providerType?: string;
  addressLabel?: string;
  ctaHref?: string;
  ctaText?: string;
  title?: string;
  subtitle?: string;
  units?: string;
  size?: number;
}

const {
  downloadMbps = 947,
  uploadMbps = 41,
  pingMs = 28,
  availableFiberMbps = 5000,
  providerType = "Cable",
  addressLabel = "Your Address",
  ctaHref = "/check-availability",
  ctaText = "Check Fiber Plans",
  title = "Network Performance Report",
  subtitle = "Measured against next-gen fiber potential",
  units = "Mbps",
  size = 520,
} = Astro.props;

const uid = `g-${Math.random().toString(36).slice(2, 10)}`;

const formatSpeed = (n: number) => {
  if (n >= 1000) {
    const g = n / 1000;
    return Number.isInteger(g) ? `${g} Gig` : `${g.toFixed(1)} Gig`;
  }
  return `${Math.round(n)} Mbps`;
};

const adaptiveGaugeMax = (speed: number, fiber: number) => {
  if (fiber >= 10000) return 10000;
  if (fiber >= 8000) return 8000;
  if (fiber >= 5000) return 5000;
  if (fiber >= 2000) return 2000;
  if (fiber >= 1000) return 1000;

  if (speed <= 100) return 500;
  if (speed <= 300) return 1000;
  if (speed <= 700) return 2000;
  return Math.max(1000, Math.ceil(speed * 2));
};

const gaugeMax = adaptiveGaugeMax(downloadMbps, availableFiberMbps);
const ratio = Math.min(downloadMbps / gaugeMax, 1);
const relativeToFiber = Math.min(downloadMbps / availableFiberMbps, 1);

const getPerformanceLabel = (fiberRatio: number) => {
  if (fiberRatio < 0.12) return "Large Gap vs Fiber Ceiling";
  if (fiberRatio < 0.25) return "Upgrade Headroom Available";
  if (fiberRatio < 0.45) return "Solid, With Room to Improve";
  if (fiberRatio < 0.7) return "Strong, Still Behind Multi-Gig";
  return "High Performance Connection";
};

const getScore = (down: number, up: number, ping: number, fiber: number) => {
  let score = 100;

  const fiberPenalty = Math.min((down / fiber) * 100, 100);
  score -= Math.max(0, 55 - fiberPenalty);

  if (up < 50) score -= 18;
  else if (up < 100) score -= 10;
  else if (up < 300) score -= 4;

  if (ping > 40) score -= 16;
  else if (ping > 25) score -= 10;
  else if (ping > 15) score -= 5;

  return Math.max(46, Math.min(94, Math.round(score)));
};

const connectionScore = getScore(downloadMbps, uploadMbps, pingMs, availableFiberMbps);
const performanceLabel = getPerformanceLabel(relativeToFiber);
const fiberGap = Math.max(0, availableFiberMbps - downloadMbps);

const headlineMessage =
  relativeToFiber < 0.2
    ? "Your connection is running well below what modern fiber can deliver."
    : relativeToFiber < 0.4
      ? "Your speed is decent, but still behind higher-tier fiber available today."
      : "Your connection performs well, but faster multi-gig options may be available.";

const recommendation =
  availableFiberMbps >= 5000
    ? `Up to ${formatSpeed(availableFiberMbps)} fiber may be available at this address.`
    : `Faster fiber options up to ${formatSpeed(availableFiberMbps)} may be available nearby.`;
---

<section
  class="speed-card"
  data-speed-card
  data-download={downloadMbps}
  data-upload={uploadMbps}
  data-ping={pingMs}
  data-fiber={availableFiberMbps}
  data-gauge-max={gaugeMax}
  data-score={connectionScore}
  style={`--card-size:${size}px;`}
>
  <div class="backdrop-grid" aria-hidden="true"></div>
  <div class="ambient ambient-a" aria-hidden="true"></div>
  <div class="ambient ambient-b" aria-hidden="true"></div>

  <div class="header">
    <div>
      <p class="eyebrow">{addressLabel}</p>
      <h2>{title}</h2>
      <p class="subtitle">{subtitle}</p>
    </div>
    <div class="score-chip">
      <span class="score-chip-label">Connection Score</span>
      <strong class="score-value">{connectionScore}</strong>
    </div>
  </div>

  <div class="gauge-shell">
    <svg
      class="gauge-svg"
      viewBox="0 0 560 360"
      role="img"
      aria-label={`Speed test result showing ${downloadMbps} ${units}, compared against ${availableFiberMbps} Mbps fiber potential`}
    >
      <defs>
        <linearGradient id={`${uid}-arc`} x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#ff4d6d" />
          <stop offset="40%" stop-color="#ffb547" />
          <stop offset="72%" stop-color="#4dd2ff" />
          <stop offset="100%" stop-color="#b061ff" />
        </linearGradient>

        <linearGradient id={`${uid}-track`} x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="rgba(255,255,255,0.07)" />
          <stop offset="100%" stop-color="rgba(255,255,255,0.04)" />
        </linearGradient>

        <filter id={`${uid}-glow`} x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="7" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <g transform="translate(280 260)">
        {
          Array.from({ length: 37 }).map((_, i) => {
            const angle = -122 + i * 6.8;
            const major = i % 4 === 0;
            return (
              <line
                x1="0"
                y1={major ? "-182" : "-176"}
                x2="0"
                y2={major ? "-148" : "-156"}
                transform={`rotate(${angle})`}
                class={major ? "tick major" : "tick"}
              />
            );
          })
        }
      </g>

      <path
        class="arc-track"
        d="M 70 260 A 210 210 0 0 1 490 260"
        pathLength="100"
      />

      <path
        class="arc-progress"
        d="M 70 260 A 210 210 0 0 1 490 260"
        pathLength="100"
        stroke-dasharray="100"
        stroke-dashoffset="100"
        stroke={`url(#${uid}-arc)`}
        filter={`url(#${uid}-glow)`}
      />

      <path
        class="ghost-fiber-arc"
        d="M 105 260 A 175 175 0 0 1 455 260"
        pathLength="100"
      />

      <g class="needle-wrap" transform="translate(280 260) rotate(-122)">
        <line class="needle-shadow" x1="0" y1="0" x2="0" y2="-156" />
        <line class="needle" x1="0" y1="0" x2="0" y2="-154" />
        <circle class="hub outer" cx="0" cy="0" r="18" />
        <circle class="hub mid" cx="0" cy="0" r="10" />
        <circle class="hub inner" cx="0" cy="0" r="4" />
      </g>

      <text x="85" y="283" class="scale-text">0</text>
      <text x="448" y="283" class="scale-text">{formatSpeed(gaugeMax)}</text>

      <text x="280" y="110" text-anchor="middle" class="fiber-cap-text">
        Potential: {formatSpeed(availableFiberMbps)} Fiber
      </text>
    </svg>

    <div class="center-readout">
      <div class="badge-row">
        <span class="badge primary">Current Speed</span>
        <span class="badge live">Live Result</span>
      </div>

      <div class="value-row">
        <span class="animated-number" data-role="download-value">0</span>
        <span class="units">{units}</span>
      </div>

      <div class="mini-progress">
        <div class="mini-progress-fill" data-role="mini-fill"></div>
      </div>

      <div class="comparison-line">
        <span>Your speed: {formatSpeed(downloadMbps)}</span>
        <span>Fiber potential: {formatSpeed(availableFiberMbps)}</span>
      </div>

      <p class="performance-label">{performanceLabel}</p>
    </div>
  </div>

  <div class="metrics">
    <div class="metric">
      <span class="metric-label">Download</span>
      <strong>{formatSpeed(downloadMbps)}</strong>
      <small>Measured now</small>
    </div>
    <div class="metric">
      <span class="metric-label">Upload</span>
      <strong>{formatSpeed(uploadMbps)}</strong>
      <small>{uploadMbps < 100 ? "Limited for modern usage" : "Healthy upstream performance"}</small>
    </div>
    <div class="metric">
      <span class="metric-label">Latency</span>
      <strong>{pingMs} ms</strong>
      <small>{pingMs > 25 ? "Potential congestion detected" : "Responsive connection"}</small>
    </div>
    <div class="metric accent">
      <span class="metric-label">Infrastructure</span>
      <strong>{providerType}</strong>
      <small>{recommendation}</small>
    </div>
  </div>

  <div class="insight-panel">
    <div class="insight-copy">
      <p class="insight-kicker">Upgrade Insight</p>
      <h3>{headlineMessage}</h3>
      <p>
        You are leaving about <strong>{formatSpeed(fiberGap)}</strong> of potential performance on the table compared with
        top-tier fiber availability.
      </p>
    </div>

    <div class="insight-cta">
      <a href={ctaHref} class="cta-button">{ctaText}</a>
      <p class="cta-note">See faster plans, pricing, and availability at your address.</p>
    </div>
  </div>
</section>

<script>
  const clamp = (n, min, max) => Math.min(Math.max(n, min), max);
  const easeOutExpo = (t) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

  document.querySelectorAll("[data-speed-card]").forEach((card) => {
    const download = Number(card.dataset.download || 0);
    const gaugeMax = Number(card.dataset.gaugeMax || 1000);
    const ratio = clamp(download / gaugeMax, 0, 1);

    const arc = card.querySelector(".arc-progress");
    const needle = card.querySelector(".needle-wrap");
    const valueNode = card.querySelector('[data-role="download-value"]');
    const miniFill = card.querySelector('[data-role="mini-fill"]');

    const targetAngle = -122 + ratio * 244;
    const duration = 1700;
    const start = performance.now();

    function frame(now) {
      const elapsed = now - start;
      const t = clamp(elapsed / duration, 0, 1);
      const eased = easeOutExpo(t);

      const currentRatio = ratio * eased;
      const currentValue = Math.round(download * eased);
      const currentAngle = -122 + (targetAngle + 122) * eased;

      if (arc) arc.style.strokeDashoffset = `${100 - currentRatio * 100}`;
      if (needle) needle.setAttribute("transform", `translate(280 260) rotate(${currentAngle})`);
      if (valueNode) valueNode.textContent = currentValue.toLocaleString();
      if (miniFill) miniFill.style.width = `${currentRatio * 100}%`;

      if (t < 1) requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  });
</script>

<style>
  .speed-card {
    --card-size: 520px;
    --bg-1: #050b1f;
    --bg-2: #0b1530;
    --bg-3: #132348;
    --panel: rgba(10, 16, 32, 0.72);
    --line: rgba(255, 255, 255, 0.08);
    --text: #f4f8ff;
    --muted: #9ab0d0;
    --cyan: #4dd2ff;
    --blue: #4e84ff;
    --purple: #b061ff;
    --yellow: #ffb547;
    --red: #ff4d6d;
    --green: #7dffa3;

    position: relative;
    width: min(100%, 980px);
    margin: 0 auto;
    padding: 28px;
    border-radius: 30px;
    overflow: hidden;
    color: var(--text);
    background:
      radial-gradient(circle at 15% 20%, rgba(77, 210, 255, 0.18), transparent 28%),
      radial-gradient(circle at 84% 16%, rgba(176, 97, 255, 0.18), transparent 26%),
      radial-gradient(circle at 50% 72%, rgba(78, 132, 255, 0.18), transparent 32%),
      linear-gradient(180deg, rgba(255,255,255,0.03), transparent 32%),
      linear-gradient(145deg, var(--bg-3), var(--bg-1) 74%);
