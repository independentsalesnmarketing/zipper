---
interface Props {
  text?: string;
}
const { text = 'Need help choosing? Let us find your best deal.' } = Astro.props;
---
<div class="sticky-cta">
  <div class="cta-inner">
    <div class="cta-text">
      <strong>Internet 4 ALL</strong> — {text}
    </div>
    <div style="display:flex;align-items:center;gap:var(--space-sm);">
      <a href="#get-connected" class="btn btn-primary" style="font-size:var(--text-sm);padding:0.5em 1em;white-space:nowrap;" data-event="sticky-signup" data-event-category="conversion" data-event-label="sticky-bar-signup">
        Get Connected
      </a>
    </div>
  </div>
</div>
