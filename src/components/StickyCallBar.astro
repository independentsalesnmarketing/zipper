---
import { MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel } from '@lib/utils';

interface Props {
  text?: string;
  phone?: string;
}
const { text = 'Need help choosing? Talk to an expert.', phone = MAIN_PHONE } = Astro.props;
---
<div class="sticky-cta">
  <div class="cta-inner">
    <div class="cta-text">
      <strong>Internet 4 ALL</strong> — {text}
    </div>
    <div style="display:flex;align-items:center;gap:var(--space-sm);">
      <a href="#get-connected" class="btn btn-primary" style="font-size:var(--text-sm);padding:0.5em 1em;white-space:nowrap;font-weight:800;" data-event="sticky-signup" data-event-category="conversion" data-event-label="sticky-bar-signup">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
        Get Started
      </a>
      <a href={formatPhoneForTel(phone)} class="btn btn-secondary" style="font-size: var(--text-sm); padding: 0.5em 1em;" data-event="sticky-call" data-event-category="conversion" data-event-label="sticky-bar-call">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        Call
      </a>
    </div>
  </div>
</div>
