---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const faqs = [
  { question: 'Is Internet 4 ALL really free?', answer: 'Yes. Our service is 100% free for consumers. We earn commissions from partner providers when you sign up through our site, but this never increases the cost to you.' },
  { question: 'How does Internet 4 ALL make money?', answer: 'We earn referral commissions from partner internet providers. This keeps our service free for you. We always disclose partnerships and never let them influence rankings.' },
  { question: 'Do you cover all 50 states?', answer: 'Yes. We track providers across all 50 states plus Washington D.C. Enter your ZIP code to see exactly what is available at your address.' },
  { question: 'Are your recommendations unbiased?', answer: 'Yes. Our ratings are based on speed, price, reliability, and customer satisfaction data — not advertising dollars. We show all available options, not just partners.' },
];
---
<Base
  title="About Internet4All — Independent Provider Comparison"
  description="Internet4All is an independent service comparing every US internet provider — fiber, cable, satellite & 5G. No paid rankings. Find the best plan for your address."
  schema={[generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet-4-all.com' }, { name: 'About Us', url: 'https://internet-4-all.com/about' }]), generateFAQSchema(faqs)]}
>
  <section class="section" style="padding-top:var(--space-xl);">
    <div class="container" style="max-width:740px;">
      <Breadcrumb items={[{ name: 'About Us' }]} />
      <h1 class="reveal">About <span class="gradient-text">Internet4All</span></h1>

      <div class="card reveal" style="padding:var(--space-xl);margin:var(--space-xl) 0;">
        <h2 style="font-size:var(--text-xl);margin-bottom:var(--space-md);">Our Mission</h2>
        <p style="font-size:var(--text-lg);line-height:1.8;">Everyone deserves fast, affordable internet. We exist to help Americans navigate the confusing world of internet providers — for free. No hidden agendas, no mystery fees, just honest information and real human help.</p>
      </div>

      <div class="reveal" style="margin-bottom:var(--space-xl);">
        <h2 style="margin-bottom:var(--space-lg);">What We Do</h2>
        <div class="grid grid-1" style="gap:var(--space-md);">
          {[
            { icon: '🔍', title: 'Compare Providers', desc: 'We track pricing, speeds, and availability data from every major internet provider so you can compare them in one place.' },
            { icon: '📞', title: 'Free Expert Help', desc: 'Reach out and speak to a real person. We\'ll help you understand your options, choose the right plan, and get connected.' },
            { icon: '⚖️', title: 'Unbiased Recommendations', desc: 'We show you all available options — not just our partners. Our ratings are based on data, not advertising dollars.' },
            { icon: '🛠️', title: 'Free Tools', desc: 'Speed tests, bill analyzers, internet quizzes — all free, no signup required. Built to help you make smarter decisions.' },
          ].map(item => (
            <div class="card flex items-center" style="gap:var(--space-lg);">
              <div style="font-size:1.75rem;flex-shrink:0;line-height:1;">{item.icon}</div>
              <div>
                <h4 style="margin-bottom:var(--space-xs);">{item.title}</h4>
                <p style="font-size:var(--text-sm);">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card gradient-border reveal" style="padding:var(--space-xl);text-align:center;">
        <h3 style="margin-bottom:var(--space-sm);">How We Make Money</h3>
        <p style="font-size:var(--text-sm);max-width:500px;margin:0 auto;">We earn commissions when you sign up with one of our partner providers through our site, chat, or Talk to Agent flows. This keeps everything free for you. We always disclose which providers are partners and never let partnerships influence our rankings or recommendations.</p>
      </div>

      <div class="reveal" style="margin-top:var(--space-xl);">
        <h2 style="margin-bottom:var(--space-lg);">By the Numbers</h2>
        <div class="stats-bar">
          <div><div class="stat-value">30+</div><div class="stat-label">Providers Tracked</div></div>
          <div><div class="stat-value">50</div><div class="stat-label">States Covered</div></div>
          <div><div class="stat-value">500K+</div><div class="stat-label">People Helped</div></div>
          <div><div class="stat-value">100%</div><div class="stat-label">Free</div></div>
        </div>
      </div>

      <div class="text-center reveal" style="margin-top:var(--space-2xl);">
        <h3>Questions?</h3>
        <p style="margin:var(--space-sm) 0 var(--space-md);">We'd love to hear from you.</p>
        <a href="#get-connected" class="btn btn-cta">Get Connected</a>
      </div>

      <!-- Explore the Site -->
      <div class="reveal" style="margin-top:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-lg);">Explore Our Site</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-md);">
          <a href="/providers" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Browse Providers</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">See all internet providers</p>
          </a>
          <a href="/compare" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Compare Plans</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Side-by-side comparison</p>
          </a>
          <a href="/deals" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Best Deals</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Today's lowest prices</p>
          </a>
          <a href="/speed-test" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Speed Test</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Check your internet speed</p>
          </a>
          <a href="/check-availability" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Check Availability</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">See what's at your address</p>
          </a>
          <a href="/resources" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Guides & Resources</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Expert internet guides</p>
          </a>
          <a href="/internet-types" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Internet Types</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Fiber, Cable, DSL, 5G</p>
          </a>
          <a href="/methodology" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">Our Methodology</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">How we rank providers</p>
          </a>
        </div>
      </div>
      <!-- FAQ -->
      <div class="reveal" style="margin-top:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-xl);">Frequently Asked Questions</h2>
        {faqs.map(f => (
          <details class="card" style="padding:var(--space-lg);margin-bottom:var(--space-md);">
            <summary style="cursor:pointer;font-weight:700;">{f.question}</summary>
            <p style="margin-top:var(--space-sm);font-size:var(--text-sm);line-height:1.7;">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <StickyCallBar />
</Base>
