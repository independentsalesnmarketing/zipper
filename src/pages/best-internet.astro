---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel, generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import type { Provider } from '@lib/providers';

const year = new Date().getFullYear();
const month = new Date().toLocaleString('en-US', { month: 'long' });
const phone = MAIN_PHONE;
const phoneHref = formatPhoneForTel(phone);

// Rank providers: partners first, then by rating
const rankedProviders = getAllProviders()
  .sort((a, b) => {
    if (a.isPartner && !b.isPartner) return -1;
    if (!a.isPartner && b.isPartner) return 1;
    return b.rating - a.rating;
  });

const topPick = rankedProviders[0];

const categories = [
  { title: 'Best Overall', icon: '🏆', provider: rankedProviders[0], reason: `Top-rated with ${formatSpeed(getMaxSpeed(rankedProviders[0]))} speeds and excellent customer satisfaction.` },
  { title: 'Best Value', icon: '💰', provider: rankedProviders.find(p => getMinPrice(p) <= 40 && getMaxSpeed(p) >= 300) || rankedProviders[1], reason: 'Best balance of speed, features, and price.' },
  { title: 'Best for Speed', icon: '⚡', provider: rankedProviders.reduce((a, b) => getMaxSpeed(a) > getMaxSpeed(b) ? a : b), reason: `Fastest available speeds up to ${formatSpeed(getMaxSpeed(rankedProviders.reduce((a, b) => getMaxSpeed(a) > getMaxSpeed(b) ? a : b)))}.` },
  { title: 'Best for Rural', icon: '🌾', provider: rankedProviders.find(p => p.coverage.includes('Nationwide') && p.types.includes('satellite')) || rankedProviders.find(p => p.coverage.includes('Nationwide')) || rankedProviders[3], reason: 'Available virtually everywhere, including remote areas.' },
  { title: 'Best No Contract', icon: '🔓', provider: rankedProviders.find(p => p.plans.every(plan => plan.contract === 'None') && getMaxSpeed(p) >= 300) || rankedProviders[2], reason: 'All plans are month-to-month with no early termination fees.' },
  { title: 'Best Budget', icon: '🏷️', provider: rankedProviders.reduce((a, b) => getMinPrice(a) < getMinPrice(b) ? a : b), reason: `Most affordable plans starting at ${formatPrice(getMinPrice(rankedProviders.reduce((a, b) => getMinPrice(a) < getMinPrice(b) ? a : b)))}/mo.` },
];

const faqs = [
  { question: `What is the best internet provider in ${year}?`, answer: `Based on our analysis of speed, price, reliability, coverage, and customer satisfaction, ${topPick.name} ranks as the best overall internet provider in ${year}. However, the best provider for you depends on your address, budget, and needs. Call ${phone} for a personalized recommendation.` },
  { question: 'How do you rank internet providers?', answer: 'We evaluate providers on 6 criteria: 1) Speed offerings and consistency. 2) Pricing and value. 3) Contract terms and transparency. 4) Coverage and availability. 5) Customer satisfaction ratings. 6) Technology type (fiber scores highest). Our rankings are updated monthly.' },
  { question: 'Is fiber internet always better?', answer: 'For most users, yes. Fiber offers the fastest speeds, lowest latency, symmetrical upload/download, no data caps, and no congestion during peak hours. The main limitation is availability — fiber is only in ~43% of US addresses. Cable is an excellent alternative where fiber isn\'t available.' },
  { question: 'What internet speed do I actually need?', answer: '1-2 people, basic use: 25-50 Mbps. Small family, streaming + WFH: 100-200 Mbps. Large family, gaming + 4K: 300-500 Mbps. Power users, content creators: 500-1000 Mbps. Most households are well-served by 100-300 Mbps.' },
  { question: 'Should I choose the cheapest internet plan?', answer: 'Not necessarily. The cheapest plan may have data caps, slow speeds, long contracts, or poor customer service. The best value is a mid-tier plan with adequate speed, no data caps, and no contract. We recommend starting at 100 Mbps and going up from there.' },
  { question: 'How often do internet provider rankings change?', answer: 'Rankings can shift quarterly as providers update plans, expand coverage, or change pricing. Major events (new fiber buildouts, 5G expansion, price changes) trigger re-evaluation. We update our rankings monthly to reflect the latest information.' },
];

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet4all.com' },
    { name: 'Best Internet Providers', url: 'https://internet4all.com/best-internet' },
  ]),
  generateFAQSchema(faqs),
];
---
<Base
  title={`Best Internet Providers of ${year} — Expert Rankings & Reviews`}
  description={`Compare the best internet providers in ${year}. Expert rankings of ${rankedProviders.length} providers by speed, price, reliability, and customer satisfaction. Updated ${month} ${year}.`}
  schema={schemas}
>
  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container">
      <Breadcrumb items={[{ name: 'Best Internet Providers' }]} />

      <!-- Hero -->
      <div class="text-center reveal" style="margin-bottom: var(--space-3xl);">
        <div class="badge badge-blue" style="margin-bottom: var(--space-md);">Updated {month} {year}</div>
        <h1 style="font-size: var(--text-4xl); margin-bottom: var(--space-md);">
          Best <span class="gradient-text">Internet Providers</span> of {year}
        </h1>
        <p class="hero-subtitle" style="max-width: 680px; margin-inline: auto;">
          We analyzed {rankedProviders.length} internet providers across speed, price, reliability, coverage, and customer satisfaction.
          Here are our expert rankings.
        </p>
        <a href={phoneHref} class="btn btn-call mt-xl" style="font-size: var(--text-lg);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Call {phone} for Expert Advice
        </a>
      </div>

      <!-- Category Winners -->
      <div class="grid grid-3 reveal" style="margin-bottom: var(--space-3xl);">
        {categories.map(cat => (
          <div class="card" style="padding: var(--space-xl); text-align: center;">
            <div style="font-size: var(--text-sm); color: var(--text-tertiary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">{cat.title}</div>
            <div style="font-size: var(--text-xl); font-weight: 800; margin: var(--space-sm) 0;">{cat.provider.name}</div>
            <p style="font-size: var(--text-xs); color: var(--text-secondary);">{cat.reason}</p>
          </div>
        ))}
      </div>

      <!-- Full Rankings Table -->
      <div class="card reveal" style="margin-bottom: var(--space-3xl); overflow: hidden;">
        <div style="padding: var(--space-xl) var(--space-xl) var(--space-md);">
          <h2>Complete Provider Rankings</h2>
          <p class="text-secondary">All {rankedProviders.length} providers ranked. Partner providers are verified and recommended.</p>
        </div>
        <div style="overflow-x: auto;">
          <table class="comparison-table" style="width:100%;">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Provider</th>
                <th>Rating</th>
                <th>Max Speed</th>
                <th>Starting Price</th>
                <th>Type</th>
                <th>Contract</th>
                <th>Data Cap</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {rankedProviders.map((p, i) => {
                const cheapest = p.plans.reduce((a, b) => a.promoPrice < b.promoPrice ? a : b);
                return (
                  <tr style={p.isPartner ? '' : 'opacity:0.85;'}>
                    <td style="font-weight:800;font-size:var(--text-lg);">#{i+1}</td>
                    <td>
                      <div class="flex items-center gap-sm">
                        <span style="font-weight:600;">{p.name}</span>
                        {p.isPartner && <span class="badge badge-green" style="font-size:0.6rem;">Partner</span>}
                      </div>
                    </td>
                    <td style="font-weight:600;">{p.rating}/5</td>
                    <td>{formatSpeed(getMaxSpeed(p))}</td>
                    <td style="font-weight:700;color:var(--brand-green);">{formatPrice(cheapest.promoPrice)}/mo</td>
                    <td>{p.types.map(t => getTypeLabel(t)).join(', ')}</td>
                    <td>{cheapest.contract}</td>
                    <td>{p.plans.some(plan => plan.dataCap === 'Unlimited') ? 'Unlimited available' : cheapest.dataCap}</td>
                    <td>
                      <a href={formatPhoneForTel(p.isPartner ? p.phone : MAIN_PHONE)} class="btn btn-call" style="font-size:var(--text-xs);padding:var(--space-xs) var(--space-sm);">
                        Call
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Detailed Reviews -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Detailed Provider Reviews</h2>
        {rankedProviders.slice(0, 10).map((p, i) => {
          const maxS = getMaxSpeed(p);
          const maxU = getMaxUpload(p);
          const minP = getMinPrice(p);
          return (
            <div class="card" style={`padding: var(--space-2xl); margin-bottom: var(--space-lg); ${!p.isPartner ? 'opacity:0.85;' : ''}`}>
              <div class="flex items-center gap-lg flex-wrap" style="margin-bottom: var(--space-lg);">
                <span style="font-size:var(--text-3xl);font-weight:800;color:var(--text-tertiary);">#{i+1}</span>
                <div style="width:56px;height:56px;border-radius:var(--radius-md);background:var(--gray-100);display:flex;align-items:center;justify-content:center;overflow:hidden;">
                  {p.logo ? <img src={p.logo} alt={p.name} width="56" height="56" style="padding:6px;object-fit:contain;" /> : <span style="font-weight:800;font-size:var(--text-xl);color:var(--text-tertiary);">{p.name.charAt(0)}</span>}
                </div>
                <div style="flex:1;">
                  <h3 style="font-size: var(--text-xl); margin-bottom: 0;">
                    {p.name}
                    {p.isPartner && <span class="badge badge-green" style="margin-left:var(--space-xs);font-size:0.65rem;">RECOMMENDED</span>}
                  </h3>
                  <span class="text-secondary">{p.rating}/5 • {p.reviewCount.toLocaleString()} reviews • {p.types.map(t => getTypeLabel(t)).join(', ')}</span>
                </div>
                <a href={formatPhoneForTel(p.isPartner ? p.phone : MAIN_PHONE)} class="btn btn-call">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                  {p.isPartner ? p.phone : phone}
                </a>
              </div>

              <p style="margin-bottom: var(--space-md);">{p.description}</p>

              <div class="grid grid-2" style="gap: var(--space-md); margin-bottom: var(--space-md);">
                <div>
                  <h4 style="color: var(--brand-green); font-size: var(--text-sm); margin-bottom: var(--space-xs);">✓ Pros</h4>
                  <ul style="margin:0;padding-left:var(--space-lg);font-size:var(--text-sm);color:var(--text-secondary);">
                    {p.pros.map(pro => <li>{pro}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 style="color: var(--text-warning); font-size: var(--text-sm); margin-bottom: var(--space-xs);">✗ Cons</h4>
                  <ul style="margin:0;padding-left:var(--space-lg);font-size:var(--text-sm);color:var(--text-secondary);">
                    {p.cons.map(con => <li>{con}</li>)}
                  </ul>
                </div>
              </div>

              <div class="grid grid-4" style="gap:var(--space-sm);">
                <div class="card" style="padding:var(--space-sm);text-align:center;background:var(--gray-50);">
                  <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Max Speed</div>
                  <div style="font-weight:700;font-size:var(--text-sm);">{formatSpeed(maxS)}</div>
                </div>
                <div class="card" style="padding:var(--space-sm);text-align:center;background:var(--gray-50);">
                  <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Max Upload</div>
                  <div style="font-weight:700;font-size:var(--text-sm);">{formatSpeed(maxU)}</div>
                </div>
                <div class="card" style="padding:var(--space-sm);text-align:center;background:var(--gray-50);">
                  <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Starting At</div>
                  <div style="font-weight:700;font-size:var(--text-sm);color:var(--brand-green);">{formatPrice(minP)}/mo</div>
                </div>
                <div class="card" style="padding:var(--space-sm);text-align:center;background:var(--gray-50);">
                  <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Coverage</div>
                  <div style="font-weight:700;font-size:var(--text-sm);">{p.coverage.includes('Nationwide') ? 'Nationwide' : p.coverage.length + ' states'}</div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Related Pages -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-lg);">More Comparisons</h2>
        <div class="grid grid-3" style="gap: var(--space-sm);">
          <a href="/fastest-internet" class="card" style="padding:var(--space-md);text-decoration:none;font-weight:500;">Fastest Internet Providers</a>
          <a href="/cheap-internet" class="card" style="padding:var(--space-md);text-decoration:none;font-weight:500;">Cheapest Internet Plans</a>
          <a href="/no-contract-internet" class="card" style="padding:var(--space-md);text-decoration:none;font-weight:500;">No-Contract Internet</a>
          <a href="/internet-types/fiber" class="card" style="padding:var(--space-md);text-decoration:none;font-weight:500;">Best Fiber Internet</a>
          <a href="/internet-types/cable" class="card" style="padding:var(--space-md);text-decoration:none;font-weight:500;">Best Cable Internet</a>
          <a href="/internet-types/5g" class="card" style="padding:var(--space-md);text-decoration:none;font-weight:500;">Best 5G Internet</a>
        </div>
      </div>

      <!-- FAQs -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Frequently Asked Questions</h2>
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>

    </div>
  </section>
  <StickyCallBar phone={phone} message="Expert advice — call now" />
</Base>
