---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel, generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import { stateNames } from '@lib/providers';
import type { Provider } from '@lib/providers';

const year = new Date().getFullYear();
const month = new Date().toLocaleString('en-US', { month: 'long' });
const phone = MAIN_PHONE;
const phoneHref = formatPhoneForTel(phone);

const allProviders = getAllProviders();

// Build cheap plans array: every plan under $50/mo promo price
const cheapPlans = allProviders.flatMap(p =>
  p.plans
    .filter(plan => plan.promoPrice <= 50)
    .map(plan => ({ provider: p, plan }))
).sort((a, b) => a.plan.promoPrice - b.plan.promoPrice);

const cheapProviders = allProviders
  .filter(p => p.plans.some(plan => plan.promoPrice <= 50))
  .sort((a, b) => {
    if (a.isPartner && !b.isPartner) return -1;
    if (!a.isPartner && b.isPartner) return 1;
    return getMinPrice(a) - getMinPrice(b);
  });

const stateList = Object.entries(stateNames).sort((a, b) => a[1].localeCompare(b[1]));

const faqs = [
  { question: 'What is the cheapest internet plan available?', answer: `The most affordable plans start at ${formatPrice(cheapPlans[0]?.plan.promoPrice || 25)}/mo from ${cheapPlans[0]?.provider.name || 'select providers'}. Prices vary by location and availability. Chat with us and we'll find the cheapest option at your address.` },
  { question: 'Can I get internet for under $30 a month?', answer: `Yes. Several providers offer plans under $30/mo, including promotional pricing from T-Mobile, Mint Mobile, WOW!, and others. Some providers also offer discounted rates through the Affordable Connectivity Program (ACP) for qualifying households. Chat with us to check availability.` },
  { question: 'Is cheap internet slow?', answer: 'Not necessarily. Many budget plans offer 100-300 Mbps, which is more than enough for streaming, video calls, and browsing. 5G home internet plans are especially competitive — offering high speeds at lower prices because they don\'t require expensive infrastructure to your home.' },
  { question: 'What is the best cheap internet for streaming?', answer: 'For budget streaming, look for plans with at least 50 Mbps download speed and no data caps. T-Mobile 5G Home Internet ($50/mo), Frontier Fiber 500 ($49.99/mo), and Spectrum Internet ($49.99/mo) all offer excellent streaming performance at affordable prices.' },
  { question: 'How can I lower my internet bill?', answer: '1) Contact your provider and ask for retention deals. 2) Bundle less — internet-only is often cheaper. 3) Drop to a lower speed tier if you don\'t need gigabit. 4) Switch providers to get new-customer pricing. 5) Check if you qualify for the ACP discount. 6) Chat with us — we can find the best current deal for your address.' },
  { question: 'Do cheap internet plans have data caps?', answer: 'It depends on the provider. Fiber providers (Verizon Fios, AT&T Fiber, Frontier) and 5G home internet (T-Mobile) typically have no data caps at any price. Cable providers like Xfinity impose 1.2 TB caps on lower tiers. Always check data caps before signing up — we can help you compare.' },
];

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet4all.com' },
    { name: 'Cheap Internet', url: 'https://internet4all.com/cheap-internet' },
  ]),
  generateFAQSchema(faqs),
];
---
<Base
  title={`Cheapest Internet Plans in ${year} — Plans Starting at ${formatPrice(cheapPlans[0]?.plan.promoPrice || 25)}/mo`}
  description={`Find the cheapest internet plans near you. Compare affordable internet options from ${cheapProviders.length}+ providers. Plans starting at ${formatPrice(cheapPlans[0]?.plan.promoPrice || 25)}/mo. No data caps available.`}
  schema={schemas}
>
  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container">
      <Breadcrumb items={[{ name: 'Cheap Internet' }]} />

      <!-- Hero -->
      <div class="text-center reveal" style="margin-bottom: var(--space-3xl);">
        <div class="badge badge-green" style="margin-bottom: var(--space-md);">Updated {month} {year}</div>
        <h1 style="font-size: var(--text-4xl); margin-bottom: var(--space-md);">
          Cheapest <span class="gradient-text">Internet Plans</span>
        </h1>
        <p class="hero-subtitle" style="max-width: 680px; margin-inline: auto;">
          Internet doesn't have to be expensive. We found {cheapPlans.length}+ plans under $50/mo from {cheapProviders.length} providers.
          Get fast, reliable internet without breaking the bank.
        </p>
        <div class="flex justify-center gap-md mt-xl flex-wrap">
          <a href="#get-connected" class="btn btn-cta" data-open-chat="true">
            Chat With Our Team
          </a>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="grid grid-4 reveal" style="margin-bottom: var(--space-3xl);">
        <div class="card text-center" style="padding: var(--space-xl);">
          <div style="font-size: var(--text-3xl); font-weight: 800; color: var(--brand-green);">{formatPrice(cheapPlans[0]?.plan.promoPrice || 25)}</div>
          <div class="text-secondary" style="font-size: var(--text-sm);">Lowest Price</div>
        </div>
        <div class="card text-center" style="padding: var(--space-xl);">
          <div style="font-size: var(--text-3xl); font-weight: 800; color: var(--brand-green);">{cheapPlans.length}+</div>
          <div class="text-secondary" style="font-size: var(--text-sm);">Plans Under $50</div>
        </div>
        <div class="card text-center" style="padding: var(--space-xl);">
          <div style="font-size: var(--text-3xl); font-weight: 800; color: var(--brand-green);">{cheapProviders.length}</div>
          <div class="text-secondary" style="font-size: var(--text-sm);">Providers</div>
        </div>
        <div class="card text-center" style="padding: var(--space-xl);">
          <div style="font-size: var(--text-3xl); font-weight: 800; color: var(--brand-green);">0</div>
          <div class="text-secondary" style="font-size: var(--text-sm);">Contracts Required*</div>
        </div>
      </div>

      <!-- Cheapest Plans Table -->
      <div class="card reveal" style="margin-bottom: var(--space-3xl); overflow: hidden;">
        <div style="padding: var(--space-xl) var(--space-xl) var(--space-md);">
          <h2>Cheapest Internet Plans Ranked by Price</h2>
          <p class="text-secondary">All plans under $50/mo, sorted from cheapest to most expensive.</p>
        </div>
        <div style="overflow-x: auto;">
          <table class="comparison-table" style="width:100%;">
            <thead>
              <tr>
                <th>Provider</th>
                <th>Plan</th>
                <th>Price</th>
                <th>Speed</th>
                <th>Type</th>
                <th>Data Cap</th>
                <th>Contract</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {cheapPlans.slice(0, 25).map(({ provider: p, plan }) => (
                <tr style={p.isPartner ? '' : 'opacity:0.85;'}>
                  <td>
                    <div class="flex items-center gap-sm">
                      <span style="font-weight:600;">{p.name}</span>
                      {p.isPartner && <span class="badge badge-green" style="font-size:0.65rem;">Partner</span>}
                    </div>
                  </td>
                  <td>{plan.name}</td>
                  <td style="font-weight:700;color:var(--brand-green);">{formatPrice(plan.promoPrice)}/mo</td>
                  <td>{formatSpeed(plan.speed)}</td>
                  <td>{p.types.map(t => t.charAt(0).toUpperCase() + t.slice(1)).join(', ')}</td>
                  <td>{plan.dataCap}</td>
                  <td>{plan.contract}</td>
                  <td>
                    <a href={formatPhoneForTel(p.isPartner ? p.phone : MAIN_PHONE)} class="btn btn-call" style="font-size:var(--text-xs);padding:var(--space-xs) var(--space-sm);">
                      Call
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Provider Cards -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Best Cheap Internet Providers in {year}</h2>
        <div class="grid grid-2">
          {cheapProviders.slice(0, 12).map((p, i) => {
            const cheapestPlan = p.plans.reduce((a, b) => a.promoPrice < b.promoPrice ? a : b);
            return (
              <div class="card" style={`padding: var(--space-xl); ${!p.isPartner ? 'opacity:0.85;' : ''}`}>
                <div class="flex items-center gap-md" style="margin-bottom: var(--space-md);">
                  <div style="width:48px;height:48px;border-radius:var(--radius-md);background:var(--gray-100);display:flex;align-items:center;justify-content:center;overflow:hidden;">
                    {p.logo ? (
                      <img src={p.logo} alt={p.name} width="48" height="48" style="padding:4px;object-fit:contain;" />
                    ) : (
                      <span style="font-weight:800;color:var(--text-tertiary);">{p.name.charAt(0)}</span>
                    )}
                  </div>
                  <div style="flex:1;">
                    <h3 style="font-size: var(--text-lg); margin-bottom: 0;">
                      {i + 1}. {p.name}
                      {p.isPartner && <span class="badge badge-green" style="margin-left:var(--space-xs);font-size:0.65rem;">RECOMMENDED</span>}
                    </h3>
                    <span class="text-secondary" style="font-size:var(--text-sm);">Starting at {formatPrice(cheapestPlan.promoPrice)}/mo • Up to {formatSpeed(getMaxSpeed(p))}</span>
                  </div>
                </div>
                <p class="text-secondary" style="font-size:var(--text-sm);margin-bottom:var(--space-md);">{p.description}</p>
                <div class="flex gap-sm flex-wrap" style="margin-bottom:var(--space-md);">
                  {p.pros.slice(0, 3).map(pro => (
                    <span class="badge" style="font-size:0.7rem;">✓ {pro}</span>
                  ))}
                </div>
                <div class="flex gap-sm">
                  <a href={formatPhoneForTel(p.isPartner ? p.phone : MAIN_PHONE)} class="btn btn-call" style="flex:1;font-size:var(--text-sm);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                    {p.isPartner ? p.phone : phone}
                  </a>
                  <a href={`/provider/${p.slug}`} class="btn btn-secondary" style="font-size:var(--text-sm);">Details</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Tips Section -->
      <div class="card reveal" style="margin-bottom: var(--space-3xl); padding: var(--space-2xl);">
        <h2 style="margin-bottom: var(--space-xl);">7 Ways to Get Cheaper Internet</h2>
        <div class="grid grid-2" style="gap: var(--space-lg);">
          <div>
            <h3 style="font-size: var(--text-base);">1. Switch Providers for New-Customer Pricing</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">ISPs reserve their best prices for new customers. Switching every 1-2 years can save $20-40/mo.</p>
          </div>
          <div>
            <h3 style="font-size: var(--text-base);">2. Consider 5G Home Internet</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">T-Mobile and Verizon 5G plans start at $25-50/mo with no contracts — often cheaper than cable with comparable speeds.</p>
          </div>
          <div>
            <h3 style="font-size: var(--text-base);">3. Drop to a Lower Speed Tier</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">Most households only need 100-300 Mbps. Dropping from gigabit can save $20-40/mo with no noticeable difference.</p>
          </div>
          <div>
            <h3 style="font-size: var(--text-base);">4. Use Your Own Equipment</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">Renting a modem/router costs $10-15/mo. Buying your own pays for itself in 6-8 months and saves hundreds long-term.</p>
          </div>
          <div>
            <h3 style="font-size: var(--text-base);">5. Call the Retention Department</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">If you threaten to cancel, you'll often get transferred to "retention" who can offer significant discounts to keep you.</p>
          </div>
          <div>
            <h3 style="font-size: var(--text-base);">6. Check for Low-Income Programs</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">Programs like Internet Essentials (Comcast), Access from AT&T, and the ACP offer $10-30/mo internet for qualifying households.</p>
          </div>
          <div>
            <h3 style="font-size: var(--text-base);">7. Skip the Bundle</h3>
            <p class="text-secondary" style="font-size:var(--text-sm);">TV bundles seem like deals but usually cost more than internet-only + a streaming service. Cut the cord and save.</p>
          </div>
          <div style="display:flex;align-items:center;justify-content:center;">
            <a href={phoneHref} class="btn btn-call" style="font-size:var(--space-lg);padding:var(--space-md) var(--space-xl);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              Call for Best Price: {phone}
            </a>
          </div>
        </div>
      </div>

      <!-- Cheap Internet by State -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Cheap Internet by State</h2>
        <div class="grid grid-4" style="gap: var(--space-sm);">
          {stateList.map(([abbr, name]) => (
            <a href={`/cheap-internet/${abbr.toLowerCase()}`} class="card" style="padding: var(--space-sm) var(--space-md); text-decoration: none; font-size: var(--text-sm); font-weight: 500;">
              {name} →
            </a>
          ))}
        </div>
      </div>

      <!-- FAQs -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Frequently Asked Questions</h2>
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>

    </div>
  </section>
  <StickyCallBar text="Find cheap internet plans that fit your budget" />
</Base>
