---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SearchBar from '@components/SearchBar.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import CoverageMap from '@components/CoverageMap.astro';
import ProviderSearch from '@components/ProviderSearch.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getTypeLabel } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import { stateNames } from '@lib/providers';
import { getStateSlug } from '@data/locations';

const year = new Date().getFullYear();
const month = new Date().toLocaleString('en-US', { month: 'long' });
const allProviders = getAllProviders();
const partners = getPartnerProviders();
const fiberProviders = allProviders.filter(p => p.types.includes('fiber'));
const cableProviders = allProviders.filter(p => p.types.includes('cable'));

const steps = [
  { icon: '📍', title: 'Enter Your Address', desc: 'Type your ZIP code or full street address to begin your personalized search.' },
  { icon: '📊', title: 'Compare Available Providers', desc: 'See every internet provider at your exact address — with speeds, prices, and ratings.' },
  { icon: '✅', title: 'Get Connected', desc: 'Sign up for the best deal and get set up hassle-free.' },
];

const coverageTypes = [
  { type: 'Fiber Optic', icon: '⚡', count: fiberProviders.length, desc: `The fastest technology available. Symmetrical upload/download speeds up to 8 Gbps. Available from ${fiberProviders.slice(0, 3).map(p => p.name).join(', ')} and more.`, link: '/internet-types/fiber' },
  { type: 'Cable Internet', icon: '📡', count: cableProviders.length, desc: `Widely available with speeds up to 1.2 Gbps download. The most common broadband technology in America.`, link: '/internet-types/cable' },
  { type: '5G Home Internet', icon: '📱', count: allProviders.filter(p => p.types.includes('5g')).length, desc: 'No wires needed. Uses cellular 5G towers for home internet. Fast expanding in urban and suburban areas.', link: '/internet-types/5g' },
  { type: 'Fixed Wireless', icon: '📶', count: allProviders.filter(p => p.types.includes('fixed-wireless')).length, desc: 'Uses radio towers to deliver internet without cables. Popular in suburban and semi-rural areas.', link: '/internet-types/fixed-wireless' },
  { type: 'DSL Internet', icon: '🔌', count: allProviders.filter(p => p.types.includes('dsl')).length, desc: 'Uses existing phone lines. Available almost everywhere, but slower than cable and fiber.', link: '/internet-types/dsl' },
  { type: 'Satellite Internet', icon: '🛰️', count: allProviders.filter(p => p.types.includes('satellite')).length, desc: 'Available nationwide, even in the most remote areas. Best for rural locations with no other options.', link: '/internet-types/satellite' },
];

const faqs = [
  { question: 'How do I check what internet providers are available at my address?', answer: `Enter your ZIP code in the search box above and we'll show you every provider available at your location. Our database uses real FCC broadband data covering every major provider across all 50 states. For the most precise results, sign up and our experts can look up your exact street address.` },
  { question: 'Why does internet availability vary by address?', answer: 'Internet infrastructure is built street by street. Even neighbors across the road may have different options. Fiber lines, cable networks, and wireless towers each have specific coverage footprints. That\'s why checking your exact address — not just your ZIP code — matters for accurate results.' },
  { question: 'What if no good internet providers serve my area?', answer: 'You still have options! Satellite internet (Starlink, Viasat, HughesNet) covers virtually every address in America. Fixed wireless and 5G home internet are expanding rapidly. T-Mobile 5G Home Internet is available to 300+ million people. Sign up for the best option at your address.' },
  { question: 'How accurate is your internet availability checker?', answer: `Our data comes from the FCC Broadband Map — the most comprehensive broadband database in America. We cross-reference provider service areas, coverage maps, and real customer data. For 100% accuracy, sign up and we'll verify availability at your exact address in real-time.` },
  { question: 'Can I check internet availability before I move?', answer: 'Absolutely! Enter the ZIP code of your new address to see what\'s available before you move. Our moving specialists can set up internet at your new home — often with same-day installation. Visit our movers page for a complete moving checklist.' },
  { question: 'What internet speed is available at my address?', answer: `Available speeds depend on your address and provider. Fiber addresses get up to 8 Gbps. Cable addresses typically max at 1-1.2 Gbps. 5G home internet offers 100-300 Mbps in most areas. Enter your ZIP code above for exact speeds at your address.` },
  { question: 'Is fiber internet available at my address?', answer: `Fiber is available to roughly 43% of US addresses and growing fast. ${fiberProviders.map(p => p.name).join(', ')} are the major fiber providers. Enter your ZIP code to check fiber availability — we can tell you if fiber is coming to your area soon.` },
  { question: 'How do I find cheap internet at my address?', answer: `Start by checking all available providers with our tool above. Then compare their lowest-tier plans. Many providers offer plans starting at $30-50/mo. The FCC Lifeline program ($9.25/mo off) and provider-specific income programs like Xfinity Internet Essentials ($9.95/mo) can reduce costs for qualifying households. Sign up for exclusive deals not listed online.` },
];

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet-4-all.com' },
    { name: 'Check Availability', url: 'https://internet-4-all.com/check-availability' },
  ]),
  generateFAQSchema(faqs),
];
---
<Base
  title={`Check Internet Availability by Address (${year})`}
  description="Enter your address and see every internet provider available. Fiber, cable, 5G & satellite — one search shows all local providers, speeds, and real pricing."
  schema={schemas}
>
  <StickyCallBar text="Check internet at your address — get instant results" />

  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container">
      <Breadcrumb items={[{ name: 'Check Availability' }]} />

      <!-- Hero -->
      <div class="text-center reveal" style="margin-bottom: var(--space-3xl); position: relative; z-index: 2;">
        <div class="badge badge-blue" style="margin-bottom: var(--space-md);">🔍 Powered by FCC Broadband Data</div>
        <h1 style="font-size: var(--text-4xl); margin-bottom: var(--space-md);">
          Check Internet <span class="gradient-text">at Your Address</span>
        </h1>
        <p class="hero-subtitle" style="max-width: 700px; margin-inline: auto;">
          Find every internet provider, plan, and price available where you live. Our free tool searches every major provider
          using real FCC broadband data — updated {month} {year}.
        </p>

        <div style="max-width: 580px; margin: var(--space-xl) auto 0; position: relative; z-index: 2100;">
          <SearchBar size="large" mode="address" placeholder="Enter your full address" />
          <p style="font-size: var(--text-xs); color: var(--text-tertiary); margin-top: var(--space-sm);">
            No signup required • Works for any US address • Results in 10 seconds
          </p>
        </div>

        <div style="margin-top: var(--space-xl);">
          <a href="#get-connected" class="btn btn-cta btn-lg" style="font-size: var(--text-lg);">
            Get Free Expert Help
          </a>
        </div>
      </div>

      <!-- Live provider results when arriving with ?zip=XXXXX -->
      <div id="ca-ps-wrap" style="display:none; margin-bottom:var(--space-3xl);">
        <div id="ca-ps-heading" style="margin-bottom:var(--space-lg);">
          <h2 id="ca-ps-title">Providers Available in Your Area</h2>
          <p style="color:var(--text-secondary);">Live results from the FCC Broadband Map — updated in real time.</p>
        </div>
        <ProviderSearch
          cityName="your area"
          state=""
          stateName=""
          autoSearch
        />
      </div>

      <!-- How It Works -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 class="text-center" style="margin-bottom: var(--space-xl);">How the Internet Availability Checker Works</h2>
        <div class="grid grid-3">
          {steps.map((step, i) => (
            <div class="card text-center" style="padding: var(--space-xl);">
              <div style="font-size: var(--text-xs); color: var(--brand-blue); font-weight: 700; text-transform: uppercase; margin-bottom: var(--space-xs);">Step {i + 1}</div>
              <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-sm);">{step.title}</h3>
              <p style="font-size: var(--text-sm); color: var(--text-secondary);">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Coverage Map -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 class="text-center" style="margin-bottom: var(--space-md);">See Internet Coverage at Your Address</h2>
        <p class="text-center" style="color: var(--text-secondary); max-width: 640px; margin-inline: auto; margin-bottom: var(--space-xl); font-size: var(--text-sm);">
          Toggle providers to compare coverage areas nationwide. Enter your ZIP above for exact availability and pricing at your specific address.
        </p>
        <CoverageMap height="480px" />
        <div class="text-center" style="margin-top: var(--space-lg);">
          <a href="/coverage-map" style="color: var(--brand-blue); font-size: var(--text-sm); font-weight: 600;">View full coverage map with all 14 providers →</a>
        </div>
      </div>

      <!-- Internet Types at Your Address -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-sm);">Types of Internet Available at Your Address</h2>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-xl); max-width: 700px;">
          Availability depends on your exact location. Here are the internet technologies you may find when you check your address.
        </p>
        <div class="grid grid-2" style="gap: var(--space-lg);">
          {coverageTypes.map(ct => (
            <a href={ct.link} class="card" style="padding: var(--space-xl); text-decoration: none;">
              <div class="flex items-center gap-sm" style="margin-bottom: var(--space-md);">
                <h3 style="font-size: var(--text-lg); margin: 0;">{ct.type}</h3>
                <span class="badge badge-blue" style="margin-left: auto; font-size: 0.65rem;">{ct.count} providers</span>
              </div>
              <p style="font-size: var(--text-sm); color: var(--text-secondary); margin: 0;">{ct.desc}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Top Providers -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-sm);">Top Internet Providers to Check At Your Address</h2>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-xl);">
          These are the most popular providers. Enter your ZIP code above to see which ones serve your address.
        </p>
        <div class="grid grid-3" style="gap: var(--space-md);">
          {partners.slice(0, 9).map(p => (
            <div class="card" style="padding: var(--space-lg);">
              <div class="flex items-center gap-sm" style="margin-bottom: var(--space-md);">
                <span style="font-weight: 700;">{p.name}</span>
                <span class="badge badge-green" style="font-size: 0.6rem;">Partner</span>
              </div>
              <div class="grid grid-2" style="gap: var(--space-xs); margin-bottom: var(--space-md);">
                <div style="font-size: var(--text-xs); color: var(--text-tertiary);">
                  Speeds to <strong style="color: var(--text-primary);">{formatSpeed(getMaxSpeed(p))}</strong>
                </div>
                <div style="font-size: var(--text-xs); color: var(--text-tertiary);">
                  From <strong style="color: var(--brand-green);">{formatPrice(getMinPrice(p))}/mo</strong>
                </div>
              </div>
              <div class="flex gap-xs" style="margin-bottom: var(--space-md);">
                {p.types.map(t => <span class={`tag tag-${t}`} style="font-size:0.6rem;">{getTypeLabel(t)}</span>)}
              </div>
              <a href="#get-connected" data-signup-provider={p.slug} class="btn btn-cta btn-sm" style="width: 100%; text-align: center;">
                Check Availability
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Mid-page CTA -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <div class="card" style="padding: var(--space-2xl); text-align: center; background: linear-gradient(135deg, rgba(0,82,255,0.08), rgba(0,213,132,0.08)); border: 1px solid var(--brand-blue);">
          <h2 style="margin-bottom: var(--space-sm);">Can't Find Your Address?</h2>
          <p style="color: var(--text-secondary); margin-bottom: var(--space-lg); max-width: 550px; margin-inline: auto;">
            Our experts can look up internet availability at any US address — including new construction, rural properties, and recently serviced areas not yet in public databases.
          </p>
          <a href="#get-connected" class="btn btn-cta btn-lg">Free Address Lookup</a>
        </div>
      </div>

      <!-- Check by State -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-sm);">Check Internet Availability by State</h2>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-xl);">
          Browse internet providers in your state to see coverage areas, average speeds, and pricing.
        </p>
        <div style="column-count: 4; column-gap: var(--space-lg);">
          {Object.entries(stateNames)
            .sort((a, b) => a[1].localeCompare(b[1]))
            .map(([abbr, name]) => (
              <a href={`/internet-providers/${getStateSlug(abbr)}`} style="display: block; padding: var(--space-xs) 0; font-size: var(--text-sm); color: var(--text-secondary);">{name}</a>
            ))}
        </div>
      </div>

      <!-- Related Resources -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-lg);">Related Resources</h2>
        <div class="grid grid-3" style="gap: var(--space-sm);">
          <a href="/best-internet" class="card" style="padding: var(--space-md); text-decoration: none; font-weight: 500;">Best Internet Providers</a>
          <a href="/cheap-internet" class="card" style="padding: var(--space-md); text-decoration: none; font-weight: 500;">Cheapest Internet Plans</a>
          <a href="/fastest-internet" class="card" style="padding: var(--space-md); text-decoration: none; font-weight: 500;">Fastest Internet Providers</a>
          <a href="/internet-types" class="card" style="padding: var(--space-md); text-decoration: none; font-weight: 500;">Internet Types Explained</a>
          <a href="/speed-test" class="card" style="padding: var(--space-md); text-decoration: none; font-weight: 500;">Internet Speed Test</a>
          <a href="/movers" class="card" style="padding: var(--space-md); text-decoration: none; font-weight: 500;">Internet for Movers</a>
        </div>
      </div>

      <!-- FAQs -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Internet Availability FAQ</h2>
        {faqs.map(faq => (
          <div class="faq-item">
            <button class="faq-question">{faq.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
(function () {
  const params = new URLSearchParams(window.location.search);

  // ── Address-level deep link: /check-availability?lat=X&lng=Y&addr=... ──
  const lat = params.get('lat');
  const lng = params.get('lng');
  const addr = params.get('addr');
  if (lat && lng && addr) {
    const latNum = parseFloat(lat);
    const lngNum = parseFloat(lng);
    if (!isNaN(latNum) && !isNaN(lngNum)) {
      // Update hero heading
      const h1 = document.querySelector('h1');
      if (h1) h1.innerHTML = 'Internet Providers at <span class="gradient-text">Your Address</span>';

      // Hide the generic section heading — ProviderSearch renders the address banner itself
      const heading = document.getElementById('ca-ps-heading');
      if (heading) heading.style.display = 'none';

      // Show the ProviderSearch section
      const wrap = document.getElementById('ca-ps-wrap');
      if (wrap) {
        wrap.style.display = '';
        setTimeout(function () { wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 150);
      }

      // Wait for psGeocode to be ready (ProviderSearch exposes it after init),
      // then call runSearch directly to avoid the race condition with data attributes
      function triggerAddrSearch() {
        var ps = (window as any).psGeocode;
        if (!ps || !ps.runSearch || !ps.container) {
          setTimeout(triggerAddrSearch, 50);
          return;
        }
        ps.runSearch(latNum, lngNum, addr, ps.locals, ps.container, true);
      }
      triggerAddrSearch();
      return;
    }
  }

  // ── ZIP deep link: /check-availability?zip=XXXXX ──
  const zip = params.get('zip');
  if (!zip || !/^[0-9]{5}$/.test(zip)) return;

  // Update hero heading
  const h1 = document.querySelector('h1');
  if (h1) h1.innerHTML = 'Internet Providers Near <span class="gradient-text">' + zip + '</span>';

  // Update section heading
  const title = document.getElementById('ca-ps-title');
  if (title) title.textContent = 'Providers Available in ' + zip;

  // Pre-fill all search inputs
  document.querySelectorAll('input[name="zip"]').forEach(function (el) {
    (el as HTMLInputElement).value = zip;
  });

  // Show the ProviderSearch section
  const wrap = document.getElementById('ca-ps-wrap');
  if (wrap) {
    wrap.style.display = '';
    setTimeout(function () { wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 150);
  }

  // Wait for psGeocode to be ready, then geocode the ZIP and run the search
  function triggerZipSearch() {
    var ps = (window as any).psGeocode;
    if (!ps || !ps.runSearch || !ps.geocodeZip || !ps.container) {
      setTimeout(triggerZipSearch, 50);
      return;
    }
    ps.geocodeZip(zip).then(function (geo: any) {
      if (geo) {
        var loc = 'ZIP ' + zip + (geo.city ? ' \u2014 ' + geo.city + ', ' + geo.state : '');
        ps.runSearch(geo.lat, geo.lng, loc, ps.locals, ps.container, false);
      }
    });
  }
  triggerZipSearch();
})();
</script>
