---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const faqs = [
  { question: 'How can I get help choosing an internet provider?', answer: 'Use our AI chat assistant available 24/7, take our internet quiz, or submit the contact form below. We provide free, personalized recommendations.' },
  { question: 'How quickly will I get a response?', answer: 'Our AI chat assistant responds instantly, 24/7. Contact form submissions are reviewed and responded to within one business day.' },
  { question: 'Does contacting you cost anything?', answer: 'No. All of our services — chat, recommendations, and support — are completely free. We never charge consumers.' },
];
---
<Base
  title="Contact Us"
  description="Get in touch with Internet 4 ALL. Free internet help, order support, provider questions, or general feedback. We're here to help."
  schema={[generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet-4-all.com' }, { name: 'Contact Us', url: 'https://internet-4-all.com/contact' }]), generateFAQSchema(faqs)]}
>
  <section class="section" style="padding-top:var(--space-xl);">
    <div class="container" style="max-width:700px;">
      <Breadcrumb items={[{ name: 'Contact Us' }]} />
      <h1 class="reveal">Contact <span class="gradient-text">Us</span></h1>
      <p class="reveal" style="font-size:var(--text-lg);margin-top:var(--space-md);">We're real people who genuinely want to help you find better internet.</p>

      <!-- Help Card -->
      <div class="card gradient-border reveal" style="padding:var(--space-xl);text-align:center;margin:var(--space-xl) 0;">
        <h2 style="margin-bottom:var(--space-xs);">Get Help</h2>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-md);">The fastest way to get help. Free, no obligation.</p>
        <a href="#get-connected" class="btn btn-cta" style="font-size:var(--text-xl);">
          Get Connected
        </a>
        <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:var(--space-sm);">Available 24/7</p>
      </div>

      <!-- Contact Options -->
      <div class="grid grid-2 reveal" style="margin-bottom:var(--space-xl);">
        <div class="card text-center">
          <h4>Technical Issues</h4>
          <p style="font-size:var(--text-sm);margin-top:var(--space-xs);">Found a bug or inaccurate info? Let us know so we can fix it.</p>
        </div>
        <div class="card text-center">
          <h4>Business Inquiries</h4>
          <p style="font-size:var(--text-sm);margin-top:var(--space-xs);">Interested in becoming a partner provider? Reach out through our form.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="card reveal" style="padding:var(--space-xl);">
        <h3 style="margin-bottom:var(--space-lg);">Send Us a Message</h3>
        <form id="contact-form" style="display:grid;gap:var(--space-md);">
          <div class="grid grid-2" style="gap:var(--space-md);">
            <div>
              <label class="form-label" for="contact-name">Name</label>
              <input type="text" id="contact-name" class="form-input" placeholder="Your name" required />
            </div>
            <div>
              <label class="form-label" for="contact-email">Email (optional)</label>
              <input type="email" id="contact-email" class="form-input" placeholder="you@example.com" />
            </div>
          </div>
          <div>
            <label class="form-label" for="contact-subject">Subject</label>
            <select id="contact-subject" class="form-input" required>
              <option value="">Select a topic...</option>
              <option value="help">I need help finding internet</option>
              <option value="correction">Report incorrect information</option>
              <option value="bug">Website bug / technical issue</option>
              <option value="business">Business inquiry / partnership</option>
              <option value="feedback">General feedback</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="contact-message">Message</label>
            <textarea id="contact-message" class="form-input" rows="5" placeholder="How can we help?" required style="resize:vertical;"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Send Message</button>
        </form>
        <div id="form-success" style="display:none;text-align:center;padding:var(--space-xl);">
          <h3>Message Sent!</h3>
          <p style="font-size:var(--text-sm);margin-top:var(--space-sm);">Thank you for reaching out. For immediate help, <a href="#get-connected" style="color:var(--brand-green);">sign up here</a>.</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal" style="margin-top:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-xl);">Frequently Asked Questions</h2>
        {faqs.map(f => (
          <details class="card" style="padding:var(--space-lg);margin-bottom:var(--space-md);">
            <summary style="cursor:pointer;font-weight:700;">{f.question}</summary>
            <p style="margin-top:var(--space-sm);font-size:var(--text-sm);line-height:1.7;">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <StickyCallBar />

  <script>
    document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = (e.currentTarget as HTMLFormElement).querySelector('[type="submit"]') as HTMLButtonElement;
      const origText = btn?.textContent || 'Send Message';
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

      const name = (document.getElementById('contact-name') as HTMLInputElement).value;
      const email = (document.getElementById('contact-email') as HTMLInputElement).value;
      const subject = (document.getElementById('contact-subject') as HTMLSelectElement).value;
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value;

      try {
        const { submitLead } = await import('@lib/client/submit-lead');
        const ok = await submitLead({
          form_type: 'contact',
          first_name: name,
          email,
          subject,
          message,
          page_url: window.location.href,
        });
        if (!ok) {
          if (btn) { btn.disabled = false; btn.textContent = origText; }
          alert('Something went wrong. Please try again.');
          return;
        }
        document.getElementById('contact-form')!.style.display = 'none';
        document.getElementById('form-success')!.style.display = 'block';
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = origText; }
        alert('Something went wrong. Please try again.');
      }
    });
  </script>
</Base>
