---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SearchBar from '@components/SearchBar.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const partners = getPartnerProviders();
const faqs = [
  { q: 'Are these prices really available in my area?', a: 'Prices shown are starting promotional rates. Actual availability depends on your address. Enter your ZIP code above or sign up to get the exact pricing for your location — it may be even lower than listed.' },
  { q: 'How long do promotional prices last?', a: 'Most promotions run 12-24 months. After that, rates go to standard pricing. Pro tip: Set a calendar reminder and reach out to us when your promo ends — we\'ll find you another deal.' },
  { q: 'Is there a catch?', a: 'No catch from us — Internet 4 ALL is 100% free. Providers may require a contract or have installation fees, which we\'ll disclose before you commit. We only recommend providers we\'d use ourselves.' },
  { q: 'Will I need to pay for a modem/router?', a: 'Some providers include equipment for free, others have a monthly rental fee ($5-$15/mo). You can often save by buying your own compatible modem and router — ask us which ones work best.' },
  { q: 'Can I negotiate a lower price with my current provider?', a: 'Yes! Knowing competitor rates gives you leverage. Use our price data below to negotiate — or skip the hassle and let us find you a new provider deal that\'s already lower.' },
];

// Sort by cheapest promo price
const dealProviders = [...partners].sort((a, b) => {
  const priceA = a.plans[0]?.promoPrice || a.plans[0]?.price || 999;
  const priceB = b.plans[0]?.promoPrice || b.plans[0]?.price || 999;
  return priceA - priceB;
});
---
<Base
  title="Best Internet Deals & Specials (2026) — Affordable Internet Deals Near You"
  description="Your internet bill too high? Find the best internet deals and internet specials near you. Compare affordable internet plans from top providers. Promo rates, price-lock guarantees. Save up to 50%."
  schema={[
    generateBreadcrumbSchema([
      { name: 'Home', url: 'https://internet4all.com' },
      { name: 'Best Deals', url: 'https://internet4all.com/deals' }
    ]),
    generateFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })))
  ]}
>
  <!-- Hero -->
  <section class="hero" style="padding-bottom:var(--space-xl);">
    <div class="container text-center">
      <Breadcrumb items={[{ name: 'Best Deals' }]} />
      <div class="badge reveal" style="margin-bottom:var(--space-md);background:rgba(34,197,94,0.15);color:var(--brand-green);">Save Money</div>
      <h1 class="reveal">Your Bill Too High?<br/><span class="gradient-text">Best Internet Deals &amp; Specials Today.</span></h1>
      <p class="hero-subtitle reveal">Internet prices have jumped 23% since 2022 — but new customer promotions still offer affordable internet deals at half the price. We track the best internet specials near you, updated daily.</p>
      <div class="flex justify-center reveal" style="margin-top:var(--space-xl);">
        <SearchBar placeholder="Enter your ZIP — see deals near you" size="large" />
      </div>
    </div>
  </section>

  <!-- Price Shock Stats -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="stats-bar reveal">
        <div>
          <div class="stat-value" style="color:var(--brand-red);">$73</div>
          <div class="stat-label">Avg. US Internet Bill</div>
        </div>
        <div>
          <div class="stat-value" style="color:var(--brand-green);">$35</div>
          <div class="stat-label">Avg. Deal Starting Price</div>
        </div>
        <div>
          <div class="stat-value" style="color:var(--brand-blue-light);">50%</div>
          <div class="stat-label">Average Savings</div>
        </div>
        <div>
          <div class="stat-value">$456</div>
          <div class="stat-label">Saved Per Year</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deal Cards -->
  <section class="section">
    <div class="container">
      <h2 class="text-center reveal">Today's <span class="gradient-text">Best Prices</span></h2>
      <p class="text-center reveal" style="max-width:500px;margin:var(--space-sm) auto var(--space-xl);">Sorted by lowest price. New customer promo rates — call for exact pricing at your address.</p>
      <div class="grid grid-2">
        {dealProviders.map((p, i) => {
          const cheapest = p.plans[0];
          const fastest = p.plans[p.plans.length - 1];
          const savings = cheapest.price - (cheapest.promoPrice || cheapest.price);
          return (
            <div class={`card reveal`} style={`transition-delay:${i * 60}ms;`}>
              <div class="flex items-center" style="gap:var(--space-md);margin-bottom:var(--space-md);">
                {i === 0 && <span class="badge" style="background:rgba(34,197,94,0.15);color:var(--brand-green);font-size:var(--text-xs);">Best Price</span>}
                <div>
                  <h4>{p.name}</h4>
                  <span style="font-size:var(--text-xs);color:var(--text-muted);">{p.types.join(' / ')}</span>
                </div>
              </div>
              <div class="flex" style="gap:var(--space-xl);flex-wrap:wrap;margin-bottom:var(--space-md);">
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Starting at</div>
                  <div style="font-size:var(--text-2xl);font-weight:900;color:var(--brand-green);">
                    {formatPrice(cheapest.promoPrice || cheapest.price)}<span style="font-size:var(--text-xs);font-weight:400;">/mo</span>
                  </div>
                  {savings > 0 && <div style="font-size:var(--text-xs);color:var(--text-muted);text-decoration:line-through;">{formatPrice(cheapest.price)}/mo regular</div>}
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Speeds</div>
                  <div style="font-weight:700;">{formatSpeed(cheapest.speed)} – {formatSpeed(fastest.speed)}</div>
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Contract</div>
                  <div style="font-weight:700;">{cheapest.contract}</div>
                </div>
              </div>
              <!-- Plans -->
              <div style="border-top:1px solid var(--border);padding-top:var(--space-md);margin-bottom:var(--space-md);">
                {p.plans.map(plan => (
                  <div class="flex items-center" style="justify-content:space-between;padding:var(--space-xs) 0;font-size:var(--text-sm);">
                    <span>{plan.name}</span>
                    <span style="font-weight:700;">{formatPrice(plan.promoPrice || plan.price)}/mo — {formatSpeed(plan.speed)}</span>
                  </div>
                ))}
              </div>
              <a href="#get-connected" class="btn btn-cta" style="width:100%;text-align:center;">
                Get This Deal
              </a>
              <a href={`/deals/${p.slug}`} style="display:block;text-align:center;margin-top:var(--space-sm);font-size:var(--text-sm);color:var(--brand-blue);font-weight:600;">View {p.name} Deal Details →</a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Bill Spike Alert -->
  <section class="section">
    <div class="container container--narrow">
      <div class="card" style="border:2px solid rgba(255,45,74,0.3);background:rgba(255,45,74,0.04);padding:var(--space-2xl);">
        <div style="display:flex;align-items:flex-start;gap:var(--space-lg);flex-wrap:wrap;">
          <div style="flex-shrink:0;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
          <div style="flex:1;">
            <h3 style="color:var(--brand-red);margin-bottom:var(--space-sm);">Bill Spike Alert: You Have Rights When Your Rate Increases</h3>
            <p style="color:var(--text-secondary);margin-bottom:var(--space-md);">Under FCC broadband transparency rules, your provider must give you advance notice of any rate increase. <strong>If your bill went up and you weren't adequately notified, you may have grounds to cancel without an early termination fee</strong> — regardless of your contract status.</p>
            <ul style="color:var(--text-secondary);font-size:var(--text-sm);padding-left:var(--space-lg);display:flex;flex-direction:column;gap:8px;">
              <li>Review the notice you received — was it clear and timely?</li>
              <li>Contact your provider's billing department and reference the rate change notice</li>
              <li>If they won't waive the ETF, escalate to their retention or cancellation department</li>
              <li>File an FCC complaint at fcc.gov/consumers/guides if your rights were violated</li>
            </ul>
            <div style="display:flex;gap:var(--space-sm);flex-wrap:wrap;margin-top:var(--space-lg);">
              <a href="/switch" class="btn btn-primary">Compare Alternatives Now</a>
              <a href="/switch/spectrum-alternatives" class="btn btn-secondary">Spectrum Alternatives</a>
              <a href="/switch/xfinity-alternatives" class="btn btn-secondary">Xfinity Alternatives</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Save money tips -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">5 Ways to <span class="gradient-text">Lower Your Internet Bill</span></h2>
      <div class="grid grid-1" style="max-width:700px;margin:0 auto;">
        {[
          { num: '1', title: 'Switch to a new provider', desc: 'New customer promos give you the lowest rates. Most of the deals above are cheaper than what you\'re paying now.' },
          { num: '2', title: 'Negotiate with your current provider', desc: 'Call and say "I\'m thinking of switching to [competitor] for $X/month." They\'ll often match or beat it.' },
          { num: '3', title: 'Downgrade your speed tier', desc: 'Most households don\'t need gigabit. If you\'re paying for 1 Gbps but only use 100 Mbps, downgrade and save $20-40/mo.' },
          { num: '4', title: 'Buy your own modem/router', desc: 'Equipment rental adds $10-15/month. A good modem costs ~$80 and pays for itself in 6 months.' },
          { num: '5', title: 'Bundle or remove extras', desc: 'Drop services you don\'t use (TV, phone line). Or bundle services with one provider for a multi-service discount.' },
          { num: '6', title: 'Check if you qualify for an affordable internet program', desc: 'The federal Lifeline program gives qualifying low-income households $9.25/mo off internet permanently. Spectrum Internet Assist ($19.99/mo) and Xfinity Internet Essentials ($9.95/mo) are also actively enrolling.' },
        ].map((tip, i) => (
          <div class={`card reveal flex items-center`} style={`gap:var(--space-lg);transition-delay:${i * 60}ms;`}>
            <div style="min-width:48px;height:48px;border-radius:50%;background:var(--gradient-primary);display:grid;place-items:center;font-weight:900;font-size:var(--text-lg);">{tip.num}</div>
            <div>
              <h4 style="margin-bottom:var(--space-xs);">{tip.title}</h4>
              <p style="font-size:var(--text-sm);">{tip.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width:740px;">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">Deals <span class="gradient-text">FAQ</span></h2>
      <div class="faq-list">
        {faqs.map(f => (
          <div class="faq-item reveal">
            <button class="faq-question">{f.q}</button>
            <div class="faq-answer"><div class="faq-answer-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Pages -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">More Ways to <span class="gradient-text">Save & Compare</span></h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md);">
        <a href="/providers" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
          <h4 style="font-size: var(--text-base);">All Providers</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Compare every provider at your address</p>
        </a>
        <a href="/compare" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><path d="M3 6l4 6-4 6"/><path d="M21 6l-4 6 4 6"/><line x1="3" y1="18" x2="21" y2="18"/></svg></div>
          <h4 style="font-size: var(--text-base);">Compare Plans</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Side-by-side provider comparison</p>
        </a>
        <a href="/cheap-internet" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></div>
          <h4 style="font-size: var(--text-base);">Cheap Internet</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Plans under $30/month</p>
        </a>
        <a href="/fastest-internet" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
          <h4 style="font-size: var(--text-base);">Fastest Internet</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Gigabit and multi-gig speeds</p>
        </a>
        <a href="/no-contract-internet" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 019.9-1"/></svg></div>
          <h4 style="font-size: var(--text-base);">No-Contract Plans</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Cancel anytime, no early fees</p>
        </a>
        <a href="/bill-analyzer" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
          <h4 style="font-size: var(--text-base);">Bill Analyzer</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Find hidden fees in your bill</p>
        </a>
        <a href="/speed-test" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
          <h4 style="font-size: var(--text-base);">Speed Test</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Are you getting what you pay for?</p>
        </a>
        <a href="/switch" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg></div>
          <h4 style="font-size: var(--text-base);">Switch Provider</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Hassle-free provider switching</p>
        </a>
        <a href="/affordable-internet" class="card text-center reveal" style="padding: var(--space-lg); text-decoration: none;">
          <div style="margin-bottom:var(--space-sm);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
          <h4 style="font-size: var(--text-base);">Affordable Internet</h4>
          <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Plans from $9.95/mo for qualified households</p>
        </a>
      </div>
    </div>
  </section>



  <StickyCallBar text="Stop overpaying. Call for today's best deal." />
</Base>
