---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SearchBar from '@components/SearchBar.astro';
import CallbackForm from '@components/CallbackForm.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice, MAIN_PHONE } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const partners = getPartnerProviders().slice(0, 6);
const faqs = [
  { q: 'Can I get internet if I have bad credit?', a: 'Yes! Several providers offer no credit check options or prepaid internet plans. Call us and we\'ll find options that work for you regardless of credit history.' },
  { q: 'I\'m behind on my internet bill — can I still get service?', a: 'If your current provider disconnected you, you may need to pay the outstanding balance before reconnecting. However, you can sign up with a different provider for a fresh start. Call us for options.' },
  { q: 'What\'s the fastest way to get internet set up?', a: 'Self-install kits ship in 2-3 days. Professional installation can be scheduled within 3-5 business days. Some 5G home internet providers can activate same-day with a delivered gateway device.' },
  { q: 'Do I need to own a home to get internet?', a: 'No — renters, apartment dwellers, and anyone with a physical address can get internet service. Some options like 5G home internet don\'t even require a wired connection to the building.' },
  { q: 'What if I live in a rural area with limited options?', a: 'We specialize in finding solutions for underserved areas. Options include satellite internet (Starlink, Viasat, HughesNet), fixed wireless, T-Mobile/Verizon 5G home internet, and DSL. Call us — we\'ll find something.' },
  { q: 'Are there programs to help with the cost of internet?', a: 'Yes! The FCC\'s Affordable Connectivity Program (ACP) provided $30/month discount. While ACP funding has ended, many providers offer their own low-income programs. Ask us about Spectrum Internet Assist, AT&T Access, and similar programs.' },
];
---
<Base
  title="Get Connected — Set Up Internet Service Today, Even From Scratch"
  description="No internet? Need to get connected? We'll help you find available providers, compare plans, and get set up fast. Options for any budget and location."
  schema={[
    generateBreadcrumbSchema([
      { name: 'Home', url: 'https://internet4all.com' },
      { name: 'Get Connected', url: 'https://internet4all.com/get-connected' }
    ]),
    generateFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })))
  ]}
>
  <!-- Hero -->
  <section class="hero" style="padding-bottom:var(--space-xl);">
    <div class="container text-center">
      <Breadcrumb items={[{ name: 'Get Connected' }]} />
      <div class="badge reveal" style="margin-bottom:var(--space-md);background:rgba(139,92,246,0.15);color:var(--brand-purple);">🔌 Get Online</div>
      <h1 class="reveal">Need Internet?<br/><span class="gradient-text">We'll Get You Connected.</span></h1>
      <p class="hero-subtitle reveal">Whether you're setting up for the first time, reconnecting after a gap, or just need <em>something</em> that works — we've got you.</p>
      <div class="flex justify-center reveal" style="margin-top:var(--space-xl);">
        <SearchBar placeholder="Enter your ZIP — see what's available" size="large" />
      </div>
      <div class="reveal" style="margin-top:var(--space-md);">
        <a href={`tel:${MAIN_PHONE.replace(/[^0-9]/g, '')}`} class="btn btn-cta" style="font-size:var(--text-lg);">
          📞 Call Now — Get Online Today
        </a>
        <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:var(--space-xs);">Free help. No pressure. We'll find you the best option.</p>
      </div>
    </div>
  </section>

  <!-- Situations -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal">We Help With <span class="gradient-text">Every Situation</span></h2>
      <div class="grid grid-3" style="margin-top:var(--space-xl);">
        {[
          { icon: '🆕', title: 'First Time Setup', desc: 'Never had internet at this address? We\'ll walk you through every step from choosing a provider to getting connected.' },
          { icon: '🔌', title: 'Disconnected Service', desc: 'Service got cut off? We\'ll help you reconnect with your current provider or find a new one — no judgment.' },
          { icon: '📡', title: 'Rural / Limited Options', desc: 'Think you can\'t get good internet? Satellite, 5G, and fixed wireless now reach places cable doesn\'t.' },
          { icon: '💳', title: 'No Credit Check', desc: 'Some providers don\'t check credit. We know which ones and can get you started with minimal hassle.' },
          { icon: '🏢', title: 'Apartment / Rental', desc: 'Renting and need internet fast? Many providers offer self-install so you can be online same-week.' },
          { icon: '👨‍👩‍👧‍👦', title: 'Low-Income Options', desc: 'Affordable internet programs exist. We\'ll find programs and plans that fit your budget.' },
        ].map((s, i) => (
          <div class={`card reveal`} style={`transition-delay:${i * 70}ms;`}>
            <div style="font-size:1.8rem;margin-bottom:var(--space-sm);">{s.icon}</div>
            <h4 style="margin-bottom:var(--space-xs);">{s.title}</h4>
            <p style="font-size:var(--text-sm);">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How Fast -->
  <section class="section">
    <div class="container">
      <h2 class="text-center reveal">How <span class="gradient-text">Fast</span> Can You Get Online?</h2>
      <div class="grid grid-3" style="margin-top:var(--space-xl);">
        <div class="card text-center reveal reveal-delay-1" style="border-top:3px solid var(--brand-green);">
          <div style="font-size:var(--text-3xl);font-weight:900;color:var(--brand-green);">Same Day</div>
          <h4 style="margin:var(--space-sm) 0 var(--space-xs);">5G Home Internet</h4>
          <p style="font-size:var(--text-sm);">T-Mobile and Verizon ship a gateway device. Plug it in and you're online. No installation appointment needed.</p>
        </div>
        <div class="card text-center reveal reveal-delay-2" style="border-top:3px solid var(--brand-blue-light);">
          <div style="font-size:var(--text-3xl);font-weight:900;color:var(--brand-blue-light);">2-3 Days</div>
          <h4 style="margin:var(--space-sm) 0 var(--space-xs);">Self Install</h4>
          <p style="font-size:var(--text-sm);">Many cable and DSL providers ship a self-install kit. Follow simple instructions and be online in 30 minutes.</p>
        </div>
        <div class="card text-center reveal reveal-delay-3" style="border-top:3px solid var(--brand-purple);">
          <div style="font-size:var(--text-3xl);font-weight:900;color:var(--brand-purple);">3-7 Days</div>
          <h4 style="margin:var(--space-sm) 0 var(--space-xs);">Pro Install</h4>
          <p style="font-size:var(--text-sm);">Fiber and some cable plans need a technician visit. We'll help you schedule the earliest available slot.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Start Providers -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal">Get Started With <span class="gradient-text">Top Providers</span></h2>
      <div class="grid grid-2" style="margin-top:var(--space-xl);">
        {partners.map((p, i) => {
          const cheapest = p.plans[0];
          return (
            <div class={`card reveal`} style={`transition-delay:${i * 60}ms;`}>
              <div class="flex items-center" style="justify-content:space-between;margin-bottom:var(--space-md);">
                <div>
                  <h4>{p.name}</h4>
                  <span style="font-size:var(--text-xs);color:var(--text-muted);">{p.types.join(' / ')}</span>
                </div>
                <div style="text-align:right;">
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">From</div>
                  <div style="font-size:var(--text-xl);font-weight:900;color:var(--brand-green);">{formatPrice(cheapest.promoPrice || cheapest.price)}<span style="font-size:var(--text-xs);font-weight:400;">/mo</span></div>
                </div>
              </div>
              <div class="flex items-center" style="gap:var(--space-md);margin-bottom:var(--space-md);">
                <div class="badge" style="font-size:var(--text-xs);">Up to {formatSpeed(p.plans[p.plans.length - 1].speed)}</div>
                <div class="badge" style="font-size:var(--text-xs);">{cheapest.contract}</div>
                <div class="badge" style="font-size:var(--text-xs);">{cheapest.dataCap}</div>
              </div>
              <a href={`tel:${p.phone.replace(/[^0-9]/g, '')}`} class="btn btn-call" style="width:100%;text-align:center;">
                📞 Get {p.name} Today
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Reassurance -->
  <section class="section">
    <div class="container">
      <div class="card gradient-border text-center" style="padding:var(--space-2xl);">
        <h2 class="reveal">Everyone <span class="gradient-text">Deserves Internet</span></h2>
        <p class="reveal" style="font-size:var(--text-lg);max-width:560px;margin:var(--space-md) auto 0;">No matter your situation — bad credit, rural address, tight budget, or just not sure where to start — we'll find you an option. That's our promise.</p>
        <div class="reveal" style="margin-top:var(--space-xl);">
          <a href={`tel:${MAIN_PHONE.replace(/[^0-9]/g, '')}`} class="btn btn-cta" style="font-size:var(--text-lg);">
            📞 {MAIN_PHONE}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:740px;">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">Getting Connected <span class="gradient-text">FAQ</span></h2>
      <div class="faq-list">
        {faqs.map(f => (
          <div class="faq-item reveal">
            <button class="faq-question">{f.q}</button>
            <div class="faq-answer"><div class="faq-answer-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container" style="max-width:650px;">
      <CallbackForm providerName="Internet 4 ALL" phone={MAIN_PHONE} />
    </div>
  </section>

  <StickyCallBar text="Need internet? We'll get you online today." />
</Base>
