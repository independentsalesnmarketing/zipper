---
import Base from '@layouts/Base.astro';
import SearchBar from '@components/SearchBar.astro';
import ProviderCard from '@components/ProviderCard.astro';
import CallbackForm from '@components/CallbackForm.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed } from '@lib/providers';
import { generateFAQSchema } from '@lib/utils';

const allProviders = getAllProviders();
const partners = getPartnerProviders();
const topProviders = partners.slice(0, 6);

const faqs = [
  { question: 'How does Internet 4 ALL work?', answer: 'We compare internet providers available at your address. Enter your ZIP code and we show you every option — plans, prices, speeds, and ratings. When you\'re ready, call our experts and they\'ll set everything up for you.' },
  { question: 'Is this service really free?', answer: 'Yes, 100% free for you. We partner with top internet providers who compensate us for connecting you with their service. You pay the same price (or less with our exclusive deals) as going direct.' },
  { question: 'How do you rank internet providers?', answer: 'Our ranking algorithm considers speed, price, technology type (fiber > cable > DSL), customer ratings, data caps, contract terms, and real-time availability at your address via the FCC Broadband Map.' },
  { question: 'Can I keep my current phone number when switching?', answer: 'In most cases, yes. When you call us, our specialists will handle the entire switching process including number porting if applicable.' },
  { question: 'What if I\'m moving to a new address?', answer: 'Perfect timing! Enter your new ZIP code and we\'ll show you all available providers at your new address. Our moving specialists can have internet ready the day you arrive.' },
  { question: 'Do you offer customer support?', answer: 'Absolutely. Call our team at 1-888-555-0123 Mon-Fri 8AM-10PM EST, Sat-Sun 9AM-8PM EST. We\'re real people who know internet service inside and out.' },
];
---
<Base
  title="Internet 4 ALL — Find the Best Internet Providers in Your Area"
  description="Compare internet providers, plans, and prices near you. Fiber, cable, 5G, and satellite options. Call now for exclusive deals. Free comparison tool."
  schema={[generateFAQSchema(faqs)]}
>
  <!-- Hero -->
  <section class="hero-clean">
    <div class="hero-background"></div>
    <div class="container">
      <div class="hero-center reveal">
        <div class="hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Trusted by 500,000+ Americans
        </div>
        <h1 class="hero-title">
          Find the Best Internet Providers for Your Area
        </h1>
        <p class="hero-subtitle">
          Compare speeds, prices, and ratings instantly. See all available providers at your address with real FCC data.
        </p>
      </div>

      <div class="hero-search reveal">
        <SearchBar size="large" placeholder="Enter your ZIP code" />
        <p class="hero-hint">No signup required • See all options in 10 seconds</p>
      </div>

      <!-- Provider Logos Section -->
      <div class="providers-logos reveal" style="margin-top: var(--space-2xl);">
        <p style="font-size: var(--text-sm); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-lg);">Compare from 18+ providers</p>
        <div class="logos-grid">
          {allProviders.map((p) => (
            <div class="logo-item">
              {p.logo ? (
                <img src={p.logo} alt={p.name} loading="lazy" />
              ) : (
                <span class="logo-fallback">{p.name.charAt(0)}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What brings you here? (Trigger Grid) -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <h2>What's Your Situation?</h2>
        <p class="section-subtitle">Select your scenario below — we'll guide you to the perfect solution</p>
      </div>
      <div class="trigger-grid" style="margin-top: var(--space-2xl);">
        <a href="/movers" class="trigger-card trigger-card--moving reveal reveal-delay-1">
          <div class="trigger-icon">🏠</div>
          <h4>I'm Moving</h4>
          <p>Get internet set up at your new place before you arrive</p>
          <div class="card-meta">Save time • Same-day setup options</div>
        </a>
        <a href="/switch" class="trigger-card trigger-card--switch reveal reveal-delay-2">
          <div class="trigger-icon">⚡</div>
          <h4>I Need Faster Internet</h4>
          <p>Upgrade to blazing speeds — or switch away from your current provider</p>
          <div class="card-meta">Compare speeds instantly • No contracts</div>
        </a>
        <a href="/deals" class="trigger-card trigger-card--price reveal reveal-delay-3">
          <div class="trigger-icon">💰</div>
          <h4>My Bill Is Too High</h4>
          <p>Slash your monthly bill without losing quality or speed</p>
          <div class="card-meta">Save up to $50/month • See deals now</div>
        </a>
        <a href="/get-connected" class="trigger-card trigger-card--disconnected reveal reveal-delay-4">
          <div class="trigger-icon">📡</div>
          <h4>I Need Internet ASAP</h4>
          <p>Get connected today with emergency & same-day installation options</p>
          <div class="card-meta">Priority support • Fastest available</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Top Providers -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="text-center reveal">
        <h2>Top-Rated Internet Providers</h2>
        <p class="hero-subtitle" style="max-width: 550px;">Top providers ranked by speed, value, and customer satisfaction.</p>
      </div>
      <div class="flex flex-col gap-md" style="margin-top: var(--space-2xl);">
        {topProviders.map((p, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms;`}>
            <ProviderCard
              provider={p}
              rank={i + 1}
              badge={i === 0 ? 'best-overall' : i === 1 ? 'best-speed' : i === 2 ? 'best-value' : undefined}
            />
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top: var(--space-xl);">
        <a href="/providers" class="btn btn-secondary btn-lg">View All Providers →</a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <h2>Find Your Perfect Internet in 3 Steps</h2>
        <p class="section-subtitle">No hassle, no hidden fees — just fast internet for less money</p>
      </div>
      <div class="how-it-works-grid" style="margin-top: var(--space-2xl);">
        <div class="step-card reveal reveal-delay-1">
          <div class="step-number step-number-1">1</div>
          <h4>Enter Your ZIP Code</h4>
          <p>Tell us where you're located. We instantly check which providers are available at your exact address using real-time FCC Broadband Map data.</p>
          <div class="step-highlight">✓ 98% US Coverage</div>
        </div>
        <div class="step-card reveal reveal-delay-2">
          <div class="step-number step-number-2">2</div>
          <h4>Compare All Available Plans</h4>
          <p>See every option side-by-side: download speeds, prices, reviews, data caps, contract terms, and exclusive deals. Make an informed decision in seconds.</p>
          <div class="step-highlight">✓ 15+ Providers Available</div>
        </div>
        <div class="step-card reveal reveal-delay-3">
          <div class="step-number step-number-3">3</div>
          <h4>Call Our Expert & Get Connected</h4>
          <p>A specialist walks you through everything. We handle setup, installation scheduling, even porting your current number. You're online the same day.</p>
          <div class="step-highlight">✓ Same-Day Installation</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="text-center reveal">
        <h2>We're Not Just Another Comparison Site</h2>
        <p class="section-subtitle">Here's what sets Internet 4 ALL apart from BroadbandNow, AllConnect, and others</p>
      </div>
      <div class="comparison-grid" style="margin-top: var(--space-2xl);">
        <div class="comparison-item reveal reveal-delay-1">
          <div class="comparison-icon">🎯</div>
          <h4>100% Free Service</h4>
          <p>You never pay us a dime. We earn from provider partnerships, and you get the best prices anyway.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-2">
          <div class="comparison-icon">⚡</div>
          <h4>Real-Time Availability</h4>
          <p>We use live FCC data to show EXACTLY which providers serve your address. No guessing or surprises.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-3">
          <div class="comparison-icon">💬</div>
          <h4>Expert Human Support</h4>
          <p>Not a chatbot. Real broadband specialists who know fiber, cable, 5G, satellite—and which is best for you.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-4">
          <div class="comparison-icon">🎁</div>
          <h4>Exclusive Deals Only Here</h4>
          <p>Partner with us and save up to $50/month on plans you won't find available elsewhere.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-5">
          <div class="comparison-icon">⏱️</div>
          <h4>Fastest Setup Process</h4>
          <p>From search to installed in one day. We handle all the paperwork, switching, and coordination.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-6">
          <div class="comparison-icon">🏆</div>
          <h4>Transparent Ranking</h4>
          <p>Our algorithm considers speed, price, technology type, ratings, and real availability at your address.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Callback Form -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container container--narrow">
      <div class="reveal">
        <CallbackForm />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="text-center reveal">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div style="margin-top: var(--space-2xl);">
        {faqs.map(faq => (
          <div class="faq-item reveal">
            <button class="faq-question">{faq.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <StickyCallBar />
</Base>
