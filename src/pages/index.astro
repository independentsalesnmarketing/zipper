---
import Base from '@layouts/Base.astro';
import SearchBar from '@components/SearchBar.astro';
import ProviderCard from '@components/ProviderCard.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed } from '@lib/providers';
import { generateFAQSchema } from '@lib/utils';
import { stateNames } from '@lib/providers';

const allProviders = getAllProviders();
const partners = getPartnerProviders();
const topProviders = partners.slice(0, 6);
const heroLogos = [...partners, ...allProviders.filter(p => !p.isPartner)].slice(0, 12);

// All states for browse section
const allStates = Object.entries(stateNames)
  .map(([abbr, name]) => ({
    abbr,
    name,
    slug: name.toLowerCase().replace(/\s+/g, '-'),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const faqs = [
  {
    question: 'What is the cheapest internet provider available?',
    answer: 'The cheapest internet plans start at $20–$30/mo: Xfinity Connect ($19.99/mo for seniors via ACP), Optimum Fiber 300 ($25/mo for 12 months), and T-Mobile 5G (~$25/mo with wireless bundle). Prices vary by location — enter your ZIP to see which low-cost plans are available at your exact address.',
  },
  {
    question: 'Which internet provider has the fastest speeds?',
    answer: 'Fiber providers offer the fastest speeds. AT&T Fiber, Verizon Fios, and Ziply Fiber reach up to 5–8 Gbps in top markets. For cable, Xfinity and Spectrum offer up to 2 Gbps. Fiber also delivers symmetrical upload speeds — critical for video conferencing, uploading large files, and gaming.',
  },
  {
    question: 'Which internet providers have no data caps?',
    answer: 'All major fiber providers offer unlimited data: AT&T Fiber, Verizon Fios, Google Fiber, Frontier Fiber, Optimum Fiber, EarthLink Fiber, and Ziply Fiber. Spectrum and Xfinity have no data caps on most plans. Starlink and HughesNet satellite plans apply soft caps or deprioritization after a monthly threshold.',
  },
  {
    question: 'How do I switch internet providers without downtime?',
    answer: 'Schedule your new provider\'s installation 1–2 days before canceling your current service. Both can run simultaneously for a brief overlap period. Our specialists handle the full transition — coordinating installation, equipment return, and cancellation — so most customers experience zero downtime during the switch.',
  },
  {
    question: 'How much internet speed do I need for streaming and gaming?',
    answer: 'Netflix 4K requires 25 Mbps; streaming on multiple devices needs 50–100 Mbps. Online gaming needs at least 25 Mbps with low latency, but 100–300 Mbps is recommended for multi-device households. Upload speed matters for gaming: aim for 10 Mbps minimum. Fiber is the best choice for both use cases.',
  },
  {
    question: 'What is the difference between fiber and cable internet?',
    answer: 'Fiber uses light-transmitting glass cables for symmetrical speeds up to 8 Gbps with near-zero latency. Cable uses coaxial lines for faster downloads (up to 2 Gbps) but slower uploads (typically 50 Mbps). Fiber is more reliable and future-proof; cable is more widely available and sufficient for most households.',
  },
  {
    question: 'Can I get internet service without a contract?',
    answer: 'Yes — Spectrum, T-Mobile 5G, and Starlink are all contract-free. Xfinity, AT&T Fiber, and most fiber providers offer no-contract options at a small monthly premium. Satellite providers are generally contract-free as well. Call our team to identify which no-contract plans are available at your address today.',
  },
  {
    question: 'Do internet providers charge installation fees?',
    answer: 'Installation fees range from $0 to $100 depending on the provider and plan. Xfinity self-install kits are free. AT&T Fiber waives the $99 installation fee on select plans. Many providers run promotions with free professional installation. Our agents can identify which current offers eliminate setup costs for your area.',
  },
  {
    question: 'How does Internet 4 ALL work — is it really free?',
    answer: 'Yes, 100% free. We compare every internet provider at your address using real FCC Broadband Map data, then connect you with the best option via our expert team. We earn a referral fee from providers when you sign up — you pay the same price (or less with exclusive deals) as going direct.',
  },
  {
    question: 'How do you rank internet providers?',
    answer: 'Our algorithm weights five factors: Speed & Performance (25%), Value for Money (25%), Reliability (20%), Customer Satisfaction (15%), and Coverage (15%). Ratings draw from FCC Broadband data, ACSI scores, BBB complaint data, and independent speed test results. Partnerships never influence ratings. Read our full methodology →',
  },
];
---
<Base
  title="Internet 4 ALL — Find the Best Internet Providers in Your Area | Free Comparison"
  description="Find internet providers near you — compare 25+ ISPs at your address using real FCC data. See fiber, cable, 5G, WiFi, and satellite options. Free comparison service with exclusive deals. Save up to $50/month."
  ogImage="/logo.svg"
  schema={[generateFAQSchema(faqs)]}
>
  <!-- Hero -->
  <section class="hero-clean">
    <div class="hero-background"></div>
    <div class="container">
      <div class="hero-center reveal">
        <div class="hero-badge" title="Based on cumulative service transactions and customer feedback since 2023">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Trusted by 500,000+ Americans
        </div>
        <h1 class="hero-title">
          Find the Best <span class="gradient-text">Internet Providers</span> in Your Area
        </h1>
        <p class="hero-subtitle">
          Unlock the fastest speeds and cheapest deals in your ZIP code—100% free.
        </p>
      </div>

      <!-- Search Bar (centered, prominent) -->
      <div class="hero-search reveal" style="margin-bottom: var(--space-xl);">
        <SearchBar size="large" placeholder="Enter your ZIP code" />
        <p class="hero-hint">No signup required &bull; See all options in 10 seconds</p>
      </div>

      <!-- Provider logos row (no text, clean horizontal strip) -->
      <div class="hero-logos-strip reveal">
        {heroLogos.slice(0, 10).map((p) => (
          <a href={`/provider/${p.slug}`} class="hero-logo-chip" title={p.name}>
            {p.logo ? (
              <img src={p.logo} alt={p.name} loading="lazy" width="64" height="64" />
            ) : (
              <span class="logo-fallback">{p.name.charAt(0)}</span>
            )}
          </a>
        ))}
      </div>

      <div class="text-center reveal" style="margin-top: var(--space-lg);">
        <p style="font-size: var(--text-sm); color: rgba(255,255,255,0.6); margin-bottom: var(--space-sm);">Compare from {allProviders.length}+ providers</p>
        <a href="/providers" class="btn btn-secondary" style="background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.25);color:#fff;">See All Providers &rarr;</a>
      </div>
    </div>
  </section>

  <!-- What brings you here? (Trigger Grid) -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <h2>What's Your Situation?</h2>
        <p class="section-subtitle">Select your scenario below — we'll guide you to the perfect solution</p>
      </div>
      <div class="trigger-grid" style="margin-top: var(--space-2xl);">
        <a href="/movers" class="trigger-card trigger-card--moving reveal reveal-delay-1">
          <div class="trigger-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h4>I'm Moving</h4>
          <p>Get internet set up at your new place before you arrive</p>
          <div class="card-meta">Save time • Same-day setup options</div>
        </a>
        <a href="/switch" class="trigger-card trigger-card--switch reveal reveal-delay-2">
          <div class="trigger-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h4>I Need Faster Internet</h4>
          <p>Upgrade to blazing speeds — or switch away from your current provider</p>
          <div class="card-meta">Compare speeds instantly • No contracts</div>
        </a>
        <a href="/deals" class="trigger-card trigger-card--price reveal reveal-delay-3">
          <div class="trigger-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h4>My Bill Is Too High</h4>
          <p>Slash your monthly bill without losing quality or speed</p>
          <div class="card-meta">Save up to $50/month • See deals now</div>
        </a>
        <a href="/get-connected" class="trigger-card trigger-card--disconnected reveal reveal-delay-4">
          <div class="trigger-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1.42 9a16 16 0 0121.16 0"/><path d="M5 12.55a11 11 0 0114.08 0"/><path d="M10.54 15.1a6 6 0 012.92 0"/><circle cx="12" cy="20" r="1" fill="currentColor"/></svg>
          </div>
          <h4>I Need Internet ASAP</h4>
          <p>Get connected today with emergency & same-day installation options</p>
          <div class="card-meta">Priority support • Fastest available</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Top Providers -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="text-center reveal">
        <h2>Top-Rated Internet Providers</h2>
        <p class="hero-subtitle" style="max-width: 550px;">Top providers ranked by speed, value, and customer satisfaction.</p>
      </div>
      <div class="flex flex-col gap-md" style="margin-top: var(--space-2xl);">
        {topProviders.map((p, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms;`}>
            <ProviderCard
              provider={p}
              rank={i + 1}
              badge={i === 0 ? 'best-overall' : i === 1 ? 'best-speed' : i === 2 ? 'best-value' : undefined}
            />
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top: var(--space-xl);">
        <a href="/providers" class="btn btn-secondary btn-lg">View All Providers →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <h2>Trusted by Over 500,000 Americans</h2>
        <p class="section-subtitle">Real customers, real results, real savings</p>
      </div>
      <div style="margin-top: var(--space-2xl); display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-lg);">
        <div class="reveal reveal-delay-1">
          <div style="background: var(--bg-secondary); padding: var(--space-lg); border-radius: var(--radius-lg); display: flex; flex-direction: column; height: 100%;">
            <div style="display: flex; gap: 0.25rem; margin-bottom: var(--space-md);">
              {'★★★★★'.split('').map((star) => (<span style="color: var(--brand-amber); font-size: 1.25rem;">{star}</span>))}
            </div>
            <p style="flex: 1; margin-bottom: var(--space-md);">"Switched from cable to fiber and saved $40/month! The whole process took less than an hour. Best decision ever."</p>
            <div>
              <p style="font-weight: 600; margin-bottom: 0.25rem;">Sarah M.</p>
              <p style="font-size: var(--text-sm); color: var(--text-tertiary);">Denver, CO</p>
            </div>
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <div style="background: var(--bg-secondary); padding: var(--space-lg); border-radius: var(--radius-lg); display: flex; flex-direction: column; height: 100%;">
            <div style="display: flex; gap: 0.25rem; margin-bottom: var(--space-md);">
              {'★★★★★'.split('').map((star) => (<span style="color: var(--brand-amber); font-size: 1.25rem;">{star}</span>))}
            </div>
            <p style="flex: 1; margin-bottom: var(--space-md);">"The experts were so helpful! They compared options and found me a plan that actually meets my needs. No upselling, just honest advice."</p>
            <div>
              <p style="font-weight: 600; margin-bottom: 0.25rem;">Marcus T.</p>
              <p style="font-size: var(--text-sm); color: var(--text-tertiary);">Austin, TX</p>
            </div>
          </div>
        </div>
        <div class="reveal reveal-delay-3">
          <div style="background: var(--bg-secondary); padding: var(--space-lg); border-radius: var(--radius-lg); display: flex; flex-direction: column; height: 100%;">
            <div style="display: flex; gap: 0.25rem; margin-bottom: var(--space-md);">
              {'★★★★★'.split('').map((star) => (<span style="color: var(--brand-amber); font-size: 1.25rem;">{star}</span>))}
            </div>
            <p style="flex: 1; margin-bottom: var(--space-md);">"Got connected in 2 days during my move. Was terrified I'd have to wait weeks, but they made it seamless. Highly recommend!"</p>
            <div>
              <p style="font-weight: 600; margin-bottom: 0.25rem;">Jessica L.</p>
              <p style="font-size: var(--text-sm); color: var(--text-tertiary);">Portland, OR</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <h2>Find Your Perfect Internet in 3 Steps</h2>
        <p class="section-subtitle">No hassle, no hidden fees — just fast internet for less money</p>
      </div>
      <div class="how-it-works-grid" style="margin-top: var(--space-2xl);">
        <div class="step-card reveal reveal-delay-1">
          <div class="step-number step-number-1">1</div>
          <h4>Enter Your ZIP Code</h4>
          <p>Tell us where you're located. We instantly check which providers are available at your exact address using real-time FCC Broadband Map data.</p>
          <div class="step-highlight">✓ 98% US Coverage</div>
        </div>
        <div class="step-card reveal reveal-delay-2">
          <div class="step-number step-number-2">2</div>
          <h4>Compare All Available Plans</h4>
          <p>See every option side-by-side: download speeds, prices, reviews, data caps, contract terms, and exclusive deals. Make an informed decision in seconds.</p>
          <div class="step-highlight">✓ 15+ Providers Available</div>
        </div>
        <div class="step-card reveal reveal-delay-3">
          <div class="step-number step-number-3">3</div>
          <h4>Call Our Expert & Get Connected</h4>
          <p>A specialist walks you through everything. We handle setup, installation scheduling, even porting your current number. You're online the same day.</p>
          <div class="step-highlight">✓ Same-Day Installation</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="text-center reveal">
        <h2>We're Not Just Another Comparison Site</h2>
        <p class="section-subtitle">Here's what sets Internet 4 ALL apart from BroadbandNow, AllConnect, and others</p>
      </div>
      <div class="comparison-grid" style="margin-top: var(--space-2xl);">
        <div class="comparison-item reveal reveal-delay-1">
          <div class="comparison-icon">🎯</div>
          <h4>100% Free Service</h4>
          <p>You never pay us a dime. We earn from provider partnerships, and you get the best prices anyway.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-2">
          <div class="comparison-icon">⚡</div>
          <h4>Real-Time Availability</h4>
          <p>We use live FCC data to show EXACTLY which providers serve your address. No guessing or surprises.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-3">
          <div class="comparison-icon">💬</div>
          <h4>Expert Human Support</h4>
          <p>Not a chatbot. Real broadband specialists who know fiber, cable, 5G, satellite—and which is best for you.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-4">
          <div class="comparison-icon">🎁</div>
          <h4>Exclusive Deals Only Here</h4>
          <p>Partner with us and save up to $50/month on plans you won't find available elsewhere.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-5">
          <div class="comparison-icon">⏱️</div>
          <h4>Fastest Setup Process</h4>
          <p>From search to installed in one day. We handle all the paperwork, switching, and coordination.</p>
        </div>
        <div class="comparison-item reveal reveal-delay-6">
          <div class="comparison-icon">🏆</div>
          <h4>Transparent Ranking</h4>
          <p>Our algorithm considers speed, price, technology type, ratings, and real availability at your address.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore More -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <h2>Explore Internet Options</h2>
        <p class="section-subtitle">Everything you need to find, compare, and connect to the best internet</p>
      </div>
      <div style="margin-top: var(--space-2xl); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-lg);">
        <div class="card reveal reveal-delay-1" style="padding: var(--space-lg);">
          <h4 style="margin-bottom: var(--space-md);">🔍 Compare & Save</h4>
          <div style="display: flex; flex-direction: column; gap: var(--space-sm);">
            <a href="/compare" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Compare Providers Side-by-Side →</a>
            <a href="/deals" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Today's Best Deals →</a>
            <a href="/cheap-internet" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Cheapest Internet Plans →</a>
            <a href="/fastest-internet" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Fastest Internet Providers →</a>
            <a href="/best-internet" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Best Internet Providers →</a>
          </div>
        </div>
        <div class="card reveal reveal-delay-2" style="padding: var(--space-lg);">
          <h4 style="margin-bottom: var(--space-md);">🌐 Internet Types</h4>
          <div style="display: flex; flex-direction: column; gap: var(--space-sm);">
            <a href="/internet-types/fiber" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Fiber Internet →</a>
            <a href="/internet-types/cable" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Cable Internet →</a>
            <a href="/internet-types/5g" style="color: var(--brand-blue-light); font-size: var(--text-sm);">5G Home Internet →</a>
            <a href="/internet-types/dsl" style="color: var(--brand-blue-light); font-size: var(--text-sm);">DSL Internet →</a>
            <a href="/internet-types/satellite" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Satellite Internet →</a>
            <a href="/home-internet" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Home Internet Guide →</a>
            <a href="/wireless-internet" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Wireless Internet →</a>
          </div>
        </div>
        <div class="card reveal reveal-delay-3" style="padding: var(--space-lg);">
          <h4 style="margin-bottom: var(--space-md);">👥 Internet For You</h4>
          <div style="display: flex; flex-direction: column; gap: var(--space-sm);">
            <a href="/internet-for/gaming" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Best Internet for Gaming →</a>
            <a href="/internet-for/streaming" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Best Internet for Streaming →</a>
            <a href="/internet-for/work-from-home" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Internet for Working from Home →</a>
            <a href="/internet-for/seniors" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Internet for Seniors →</a>
            <a href="/internet-for/students" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Internet for Students →</a>
            <a href="/internet-for/rural" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Internet for Rural Areas →</a>
            <a href="/internet-for/large-households" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Internet for Large Households →</a>
          </div>
        </div>
        <div class="card reveal reveal-delay-4" style="padding: var(--space-lg);">
          <h4 style="margin-bottom: var(--space-md);">🛠️ Tools & Resources</h4>
          <div style="display: flex; flex-direction: column; gap: var(--space-sm);">
            <a href="/speed-test" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Speed Test →</a>
            <a href="/quiz" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Internet Quiz →</a>
            <a href="/bill-analyzer" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Bill Analyzer →</a>
            <a href="/check-availability" style="color: var(--brand-blue-light); font-size: var(--text-sm);">Check Availability →</a>
            <a href="/resources" style="color: var(--brand-blue-light); font-size: var(--text-sm);">All Resources & Guides →</a>
            <a href="/about" style="color: var(--brand-blue-light); font-size: var(--text-sm);">About Internet 4 ALL →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Browse by State -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="text-center reveal">
        <h2>Find Internet Providers in Your State</h2>
        <p class="section-subtitle">Browse all 50 states plus DC to see what's available in your area</p>
      </div>
      <div class="states-grid" style="margin-top: var(--space-2xl);">
        {allStates.map((s) => (
          <a href={`/internet-providers/${s.slug}`} class="state-link reveal">
            <span class="state-abbr">{s.abbr}</span>
            <span class="state-name">{s.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="text-center reveal">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div style="margin-top: var(--space-2xl);">
        {faqs.map(faq => (
          <div class="faq-item reveal">
            <button class="faq-question">{faq.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <StickyCallBar />
</Base>
