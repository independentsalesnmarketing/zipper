  MD:{abbr:'MD',medianIncome:90203,broadbandPct:90.6,avgDownload:158.4,underservedPct:9.4,population:6177224},
  MA:{abbr:'MA',medianIncome:89645,broadbandPct:91.4,avgDownload:162.4,underservedPct:8.6,population:7029917},
  MI:{abbr:'MI',medianIncome:63498,broadbandPct:85.4,avgDownload:122.6,underservedPct:14.6,population:10037261},
