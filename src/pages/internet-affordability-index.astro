  HI:{abbr:'HI',medianIncome:84857,broadbandPct:89.4,avgDownload:128.7,underservedPct:10.6,population:1455271},
  ID:{abbr:'ID',medianIncome:62899,broadbandPct:84.2,avgDownload:108.3,underservedPct:15.8,population:1939033},
  IL:{abbr:'IL',medianIncome:72205,broadbandPct:87.8,avgDownload:145.2,underservedPct:12.2,population:12812508},
  IN:{abbr:'IN',medianIncome:61944,broadbandPct:84.6,avgDownload:118.4,underservedPct:15.4,population:6833037},
