  NE:{abbr:'NE',medianIncome:66644,broadbandPct:85.8,avgDownload:122.4,underservedPct:14.2,population:1963692},
  NV:{abbr:'NV',medianIncome:65686,broadbandPct:86.4,avgDownload:142.8,underservedPct:13.6,population:3104614},
