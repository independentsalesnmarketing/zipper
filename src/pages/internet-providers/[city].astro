          <p style="font-weight:700;font-size:var(--text-md);margin-bottom:var(--space-sm);">Sign Up Online</p>
          <a href="#get-connected" class="btn btn-cta btn-lg" style="width:100%;">Start Sign-Up</a>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:var(--space-xs);">Quick, easy, no obligation</p>
        </div>
        <div style="text-align:center;">
          <p style="font-weight:700;font-size:var(--text-md);margin-bottom:var(--space-sm);">Prefer to Talk?</p>
          <a href={formatPhoneForTel(MAIN_PHONE)} class="btn btn-secondary btn-lg" style="width:100%;">Call {MAIN_PHONE}</a>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:var(--space-xs);">Mon–Fri 8AM–10PM &middot; Sat 9AM–7PM ET</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       STEP 10: ZIP CODES + NEARBY CITIES AS PILLS
       ═══════════════════════════════════════════ -->
  {cityData.zipCodes.length > 0 && (
    <div class="reveal" style="margin-bottom:var(--space-2xl);">
      <div class="card" style="padding:var(--space-xl);border:2px solid rgba(0,82,255,0.12);background:linear-gradient(135deg,rgba(0,82,255,0.02),rgba(0,213,132,0.02));">
        <div style="display:flex;align-items:center;gap:var(--space-sm);margin-bottom:var(--space-sm);">
          <span style="font-size:var(--text-2xl);">📍</span>
          <h2 style="margin:0;">Find Internet for Your Exact ZIP Code</h2>
        </div>
        <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);line-height:1.7;">
          {cityData.name} has <strong>{cityData.zipCodes.length} ZIP codes</strong> — internet availability and pricing can vary between them. Select your ZIP for a personalized provider guide with address-level coverage verification.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-xs);">
          {cityData.zipCodes.slice(0, 60).map(zip => (
            <a href={`/internet-providers/zip/${zip}`} style="padding:8px 16px;border-radius:var(--radius-full);background:var(--white);color:var(--text-primary);font-weight:600;font-size:var(--text-sm);text-decoration:none;border:2px solid var(--border);transition:all 0.2s;min-width:70px;text-align:center;" class="hover-lift">{zip}</a>
          ))}
          {cityData.zipCodes.length > 60 && <span style="padding:8px 16px;font-size:var(--text-sm);color:var(--text-tertiary);font-weight:500;">+{cityData.zipCodes.length - 60} more</span>}
        </div>
        <div style="margin-top:var(--space-lg);">
          <form id="zip-search-form" style="display:flex;gap:var(--space-sm);max-width:360px;">
            <input id="zip-input" type="text" maxlength="5" pattern="[0-9]{5}" placeholder="Enter your ZIP code" style="flex:1;padding:var(--space-sm) var(--space-md);border:2px solid var(--border);border-radius:var(--radius-md);font-size:var(--text-base);" />
            <button type="submit" class="btn btn-primary">Go</button>
          </form>
        </div>
      </div>
    </div>
  )}

  {nearbyCities.length > 0 && (
    <div class="reveal" style="margin-bottom:var(--space-2xl);">
      <h2 style="margin-bottom:var(--space-sm);">Internet Providers in Nearby Cities</h2>
      <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-md);">Compare internet options in communities near {cityData.name}, {stateName}.</p>
      <div class="nearby-pills">
        {nearbyCities.map(city => (
          <a href={`/internet-providers/${city.slug}`} class="nearby-pill">
            <span class="np-name">{city.name}, {city.state}</span>
            <span class="np-pop">{city.population.toLocaleString()} residents</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {otherCities.length > 0 && (
    <div class="reveal" style="margin-bottom:var(--space-2xl);">
      <h2 style="margin-bottom:var(--space-sm);">Other Cities in {stateName}</h2>
      <div class="grid grid-4 gap-sm" style="margin-bottom:var(--space-md);">
        {otherCities.map(city => (
          <a href={`/internet-providers/${city.slug}`} style="display:block;padding:var(--space-xs) 0;font-size:var(--text-sm);color:var(--text-secondary);">{city.name}</a>
        ))}
      </div>
      <a href={`/internet-providers/${stateSlug}`} class="btn btn-secondary">View All {stateName} Providers &#8594;</a>
    </div>
  )}

  <!-- FAQ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <h2 style="margin-bottom:var(--space-xl);">Frequently Asked Questions — {cityData.name}, {stateName} Internet</h2>
    {faqs.map(faq => (
      <div class="faq-item">
        <button class="faq-question">{faq.question}</button>
        <div class="faq-answer"><div class="faq-answer-inner">{faq.answer}</div></div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════
       STEP 15: EDITORIAL DISCLAIMER + METHODOLOGY
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <div style="padding:var(--space-lg);border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-secondary);">
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.8;margin-bottom:var(--space-sm);">
        <strong>Editorial Disclosure:</strong> Our rankings use FCC broadband data, independently verified speed tests, and customer reviews collected from public sources. We may earn a commission when you sign up through our partner links — this helps keep our comparison service free. Partners are indicated with a phone icon. Our recommendations are based on objective criteria and are not influenced by partner status. <a href="/methodology" style="color:var(--brand-blue);">Read our full methodology →</a>
      </p>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin:0;">
        Last updated: {lastUpdatedDisplay} · Data for {cityData.name}, {stateName} ({cityData.zipCodes.length} ZIP codes) · Coverage may vary by address
      </p>
    </div>
  </div>

</div>
</section>

<script>
  // ZIP search form handler
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('zip-search-form') as HTMLFormElement;
    const input = document.getElementById('zip-input') as HTMLInputElement;
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const zip = input.value.trim();
        if (/^\d{5}$/.test(zip)) {
          window.location.href = `/internet-providers/zip/${zip}`;
        }
      });
    }

    // Plan accordion
    document.querySelectorAll('.plan-acc-header').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.plan-acc-item');
        if (item) item.classList.toggle('open');
      });
    });

    // FAQ accordion
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        if (item) item.classList.toggle('open');
      });
    });
  });
</script>
</Base>
