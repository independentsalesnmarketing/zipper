<script>
  // ZIP search form handler
  document.addEventListener('DOMContentLoaded', () => {
    // ZIP search form handler (top availability section)
    const form = document.getElementById('zip-search-form') as HTMLFormElement;
    const input = document.getElementById('zip-input') as HTMLInputElement;
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const zip = input.value.trim();
        if (/^\d{5}$/.test(zip)) {
          if (typeof window.showPageLoader === 'function') window.showPageLoader('Finding providers in ' + zip + '…');
          window.location.href = `/internet-providers/zip/${zip}`;
        }
      });
    }

    // ZIP search form handler (bottom ZIP codes section)
    const formBottom = document.getElementById('zip-search-form-bottom') as HTMLFormElement;
    const inputBottom = document.getElementById('zip-input-bottom') as HTMLInputElement;
    if (formBottom && inputBottom) {
      formBottom.addEventListener('submit', (e) => {
        e.preventDefault();
        const zip = inputBottom.value.trim();
        if (/^\d{5}$/.test(zip)) {
          if (typeof window.showPageLoader === 'function') window.showPageLoader('Finding providers in ' + zip + '…');
          window.location.href = `/internet-providers/zip/${zip}`;
        }
      });
    }

    // Plan accordion
    document.querySelectorAll('.plan-acc-header').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.plan-acc-item');
        if (item) item.classList.toggle('open');
      });
    });

  });
</script>
</Base>
