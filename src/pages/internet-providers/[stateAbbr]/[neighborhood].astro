---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import ProviderCard from '@components/ProviderCard.astro';
import ProviderSearch from '@components/ProviderSearch.astro';
import { getProvidersByState, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, getTypeColor } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema, generateItemListSchema } from '@lib/utils';
import { getStateName, getStateSlug, cities } from '@data/locations';
import { getStateCensus, formatPercent, formatPopulation } from '@data/census';
import { getConfirmedProviders, getConfirmedFiberProviders, getZipCoverageSummary } from '@lib/zip-lookup';
import { neighborhoodPages, getNeighborhoodsByState, type NeighborhoodPage } from '@data/neighborhood-pages';
import { zipNeighborhoods } from '@data/neighborhoods';
import type { Provider, Plan } from '@lib/providers';

export function getStaticPaths() {
  return neighborhoodPages.map(nh => ({
    params: { stateAbbr: nh.st.toLowerCase(), neighborhood: nh.s },
    props: { nhData: nh },
  }));
}

interface Props { nhData: NeighborhoodPage; }
const { nhData } = Astro.props;

const stateName = getStateName(nhData.st);
const stateSlug = getStateSlug(nhData.st);
const year = new Date().getFullYear();
const lastUpdated = new Date().toISOString().split('T')[0];
const lastUpdatedDisplay = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const census = getStateCensus(nhData.st);

// Parent city info
const parentCity = cities.find(c => c.slug === nhData.pcs);
const parentCityName = nhData.pc || parentCity?.name || '';
const parentPopStr = parentCity?.population?.toLocaleString() || '';

// ── Provider data (state-level, same as city/ZIP pages) ──
const stateProviders = getProvidersByState(nhData.st);
const partners: Provider[] = stateProviders.filter(p => p.isPartner);
const providers: Provider[] = [...stateProviders].sort((a, b) => {
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  const sc = (p: Provider) => p.rating * 2 + (getMaxSpeed(p) > 500 ? 2 : 0) + (p.types.includes('fiber') ? 1 : 0);
  return sc(b) - sc(a);
});

// ── ZIP-specific confirmed coverage (pick a primary ZIP for accurate results) ──
const zipCoverageSummary = getZipCoverageSummary(nhData.z);
const sortedZipCoverage = [...zipCoverageSummary].sort((a, b) => {
  const byProviders = b.providers.length - a.providers.length;
  if (byProviders !== 0) return byProviders;
  const aFiber = a.providers.filter(p => p.fiber).length;
  const bFiber = b.providers.filter(p => p.fiber).length;
  const byFiber = bFiber - aFiber;
  if (byFiber !== 0) return byFiber;
  return a.zip.localeCompare(b.zip);
});
const primaryZip = sortedZipCoverage[0]?.zip || nhData.z[0];
const primaryConfirmedEntries = getConfirmedProviders(primaryZip);
const primaryConfirmedIds = new Set(primaryConfirmedEntries.map(c => c.id));
const primaryConfirmedFiberIds = new Set(getConfirmedFiberProviders(primaryZip));
const hasConfirmedData = primaryConfirmedIds.size > 0;
const confirmedProviders = providers.filter(p => primaryConfirmedIds.has(p.id));
const confirmedFiberProviders = providers.filter(p => primaryConfirmedFiberIds.has(p.id));
const hasConfirmedFiber = confirmedFiberProviders.length > 0;

// ── Type breakdowns ──
const fiberProviders = providers.filter(p => p.types.includes('fiber'));
const cableProviders = providers.filter(p => p.types.includes('cable'));
const fiveGProviders = providers.filter(p => p.types.includes('5g'));
const satelliteProviders = providers.filter(p => p.types.includes('satellite'));
const dslProviders = providers.filter(p => p.types.includes('dsl'));

// ── Computed stats (awards from partners only) ──
const fastest: Provider | null = partners.length ? partners.reduce((a, b) => getMaxSpeed(a) > getMaxSpeed(b) ? a : b) : null;
const cheapest: Provider | null = partners.length ? partners.reduce((a, b) => getMinPrice(a) < getMinPrice(b) ? a : b) : null;
const topRated: Provider | null = partners.length ? partners.reduce((a, b) => a.rating > b.rating ? a : b) : null;
const maxSpd = fastest ? getMaxSpeed(fastest) : (providers.length ? Math.max(...providers.map(p => getMaxSpeed(p))) : 0);
const minPrc = cheapest ? getMinPrice(cheapest) : (providers.length ? Math.min(...providers.map(p => getMinPrice(p))) : 0);
const avgPrice = providers.length ? Math.round(providers.reduce((s, p) => s + getMinPrice(p), 0) / providers.length) : 0;

// ── Grade ──
const gradeScore = (fiberProviders.length >= 3 ? 40 : fiberProviders.length >= 1 ? 25 : 0)
  + (providers.length >= 6 ? 30 : providers.length >= 4 ? 20 : providers.length >= 2 ? 10 : 0)
  + (cableProviders.length >= 2 ? 20 : cableProviders.length >= 1 ? 10 : 0)
  + (fiveGProviders.length >= 1 ? 10 : 0);
const grade = gradeScore >= 80 ? 'A' : gradeScore >= 60 ? 'B' : gradeScore >= 40 ? 'C' : gradeScore >= 20 ? 'D' : 'F';

// ── Ranked providers ──
const rankedBySpeed: Provider[] = [...providers].sort((a, b) => {
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  return getMaxSpeed(b) - getMaxSpeed(a);
});

// ── ZIP coverage summary for this neighborhood ──
const hasZipCoverage = zipCoverageSummary.length > 0;

// ── Connection types ──
const connectionTypes = [
  { type: 'fiber', label: 'Fiber', providers: fiberProviders, link: '/internet-types/fiber' },
  { type: 'cable', label: 'Cable', providers: cableProviders, link: '/internet-types/cable' },
  { type: 'dsl', label: 'DSL', providers: dslProviders, link: '/internet-types/dsl' },
  { type: '5g', label: '5G Home', providers: fiveGProviders, link: '/internet-types/5g' },
  { type: 'satellite', label: 'Satellite', providers: satelliteProviders, link: '/internet-types/satellite' },
].filter(ct => ct.providers.length > 0);

// ── Narrative paths (2026 Helpful Content: explicit page differentiation) ──
type NarrativePathKey = 'fiber-confirmed' | 'fiber-possible' | 'cable-primary' | 'limited-options';
const narrativePath: NarrativePathKey = hasConfirmedFiber
  ? 'fiber-confirmed'
  : fiberProviders.length > 0
    ? 'fiber-possible'
    : cableProviders.length > 0
      ? 'cable-primary'
      : 'limited-options';

const narrativeByPath: Record<NarrativePathKey, { title: string; summary: string }> = {
  'fiber-confirmed': {
    title: `Fiber Is Confirmed in ${nhData.n}`,
    summary: `This neighborhood follows a fiber-first broadband profile in ZIP ${primaryZip}, where FCC-confirmed records show ${confirmedFiberProviders.length} fiber provider${confirmedFiberProviders.length !== 1 ? 's' : ''}.`,
  },
  'fiber-possible': {
    title: `Fiber Is Expanding in ${nhData.n}`,
    summary: `Fiber is marketed in the broader area, but confirmation varies by block. This page uses ZIP ${primaryZip} as the baseline and keeps all recommendations tied to verified ZIP-level evidence.`,
  },
  'cable-primary': {
    title: `Cable-Led Broadband in ${nhData.n}`,
    summary: `This neighborhood is primarily cable and wireless today, with competitive speed options but uneven fiber depth by street.`,
  },
  'limited-options': {
    title: `Coverage-Limited Market in ${nhData.n}`,
    summary: `This is a lower-choice access pattern where plan quality and pricing can vary heavily between nearby ZIPs, so ZIP-specific verification matters most.`,
  },
};

const narrativeTitle = narrativeByPath[narrativePath].title;
const narrativeSummary = narrativeByPath[narrativePath].summary;

// ── Information-gain sections ──
const providerComparisonRows = rankedBySpeed.slice(0, 10).map((p) => ({
  id: p.id,
  name: p.name,
  confirmedInPrimaryZip: primaryConfirmedIds.has(p.id),
  hasFiber: p.types.includes('fiber'),
  maxSpeed: getMaxSpeed(p),
  minPrice: getMinPrice(p),
  rating: p.rating,
  reviewCount: p.reviewCount,
  typeSummary: p.types.slice(0, 3).map(t => t.toUpperCase()).join(' • '),
}));

const useCaseRows = [
  {
    useCase: 'Single user + basic streaming',
    speed: '50-100 Mbps',
    upload: '10+ Mbps',
    fit: 'Email, web, 1-2 HD streams',
  },
  {
    useCase: 'Remote work + family streaming',
    speed: '200-500 Mbps',
    upload: '20-50 Mbps',
    fit: 'Video calls, cloud backups, 4K streaming',
  },
  {
    useCase: 'Gaming + heavy smart-home usage',
    speed: '500 Mbps-1 Gbps',
    upload: '50+ Mbps (prefer fiber)',
    fit: 'Low latency sessions and many connected devices',
  },
  {
    useCase: 'Creator / power household',
    speed: '1-2 Gbps',
    upload: '500 Mbps+ (symmetrical ideal)',
    fit: 'Large uploads, live streaming, frequent transfers',
  },
];

const budgetGuideRows = [
  {
    tier: 'Budget Saver',
    monthly: `${formatPrice(Math.max(25, Math.min(minPrc || 45, 60)))}/mo`,
    expectation: 'Basic browsing and standard streaming',
    strategy: 'Target intro offers and no-contract plans in your ZIP.',
  },
  {
    tier: 'Balanced Home',
    monthly: `${formatPrice(Math.max(45, Math.min((avgPrice || 70), 95)))}/mo`,
    expectation: 'Reliable work + entertainment mix',
    strategy: 'Prioritize consistent speeds over headline gig offers.',
  },
  {
    tier: 'Performance First',
    monthly: `${formatPrice(Math.max(75, Math.min((avgPrice || 95) + 25, 140)))}/mo`,
    expectation: 'High-demand, low-latency, multi-user homes',
    strategy: 'Compare upload speed and equipment fees before ordering.',
  },
];

const movingChecklist = [
  `Check your exact address in ${nhData.n} at least 2 weeks before move-in.`,
  `Compare at least 2 wired options in ZIP ${primaryZip} before selecting a plan.`,
  'Ask for total monthly cost including router, install, and autopay terms.',
  'Schedule install before utility turn-on day to avoid connectivity gaps.',
  'Keep old service active until new line is tested for at least 24 hours.',
];

// ── Nearby neighborhoods (same state, from parent city ZIPs) ──
const stateNhs = getNeighborhoodsByState(nhData.st);
const nearbyNhs = stateNhs
  .filter(n => n.s !== nhData.s && n.z.some(z => nhData.z.includes(z)))
  .slice(0, 12);
const nearbyNhsDetailed = nearbyNhs.map((n) => {
  const sharedZips = n.z.filter((z) => nhData.z.includes(z));
  return {
    ...n,
    sharedZips,
    sharedZipCount: sharedZips.length,
    topZip: sharedZips[0] || n.z[0],
  };
});

// ── Contextual descriptions ──
const isPartOfLargerCity = nhData.m || (parentCityName && parentCityName.toLowerCase() !== nhData.n.toLowerCase());
const locationDesc = isPartOfLargerCity
  ? `${nhData.n} is a neighborhood in the ${nhData.m || parentCityName}, ${stateName} area`
  : `${nhData.n} is a community in ${stateName}`;
const popDesc = nhData.pop ? ` with a population of approximately ${nhData.pop.toLocaleString()}` : '';
const techSummary = hasConfirmedFiber
  ? `Fiber internet is confirmed available from ${confirmedFiberProviders.slice(0, 2).map(p => p.name).join(' and ')}.`
  : fiberProviders.length > 0
    ? `Fiber internet may be available from ${fiberProviders.slice(0, 2).map(p => p.name).join(' and ')}.`
    : `Cable and wireless internet are the primary broadband options.`;

// ── FAQs ──
const faqs = [
  {
    question: `What internet providers are available in ${nhData.n}, ${stateName}?`,
    answer: hasConfirmedData
      ? `${confirmedProviders.length} providers have confirmed coverage in ${nhData.n} based on ZIP ${primaryZip}: ${confirmedProviders.slice(0, 4).map(p => p.name).join(', ')}. ${providers.length} total providers serve the broader area across ${connectionTypes.map(ct => ct.label.toLowerCase()).join(', ')} connections. ${topRated ? `${topRated.name} is the highest rated at ${topRated.rating}/5 stars.` : ''} Enter your address above for ZIP-level verified results.`
      : `The ${nhData.n} area is served by ${providers.length} internet providers including ${providers.slice(0, 3).map(p => p.name).join(', ')}. ${topRated ? `${topRated.name} has the highest customer rating at ${topRated.rating}/5 stars.` : ''} Exact availability depends on your street address — enter your ZIP code above for verified results.`,
  },
  {
    question: `What is the fastest internet in ${nhData.n}, ${stateName}?`,
    answer: `${fastest ? `${fastest.name} offers the fastest advertised speeds in the ${nhData.n} area — up to ${formatSpeed(maxSpd)}.` : 'Speeds vary by provider.'} ${fiberProviders.length > 0 ? `Fiber internet from ${fiberProviders.slice(0, 2).map(p => p.name).join(' and ')} delivers symmetric speeds ideal for streaming, gaming, and remote work.` : 'Cable internet provides the fastest wired speeds available.'} Check your exact address above for verified speed data.`,
  },
  {
    question: `What is the cheapest internet plan in ${nhData.n}, ${stateName}?`,
    answer: `Plans start at ${cheapest ? formatPrice(minPrc) : '$25'}/mo${cheapest ? ` with ${cheapest.name}` : ''} in the ${nhData.n} area. The average starting price across all ${providers.length} providers is $${avgPrice}/mo. Sign up above — our experts regularly find savings of $20–50/mo versus ordering directly.`,
  },
  {
    question: `Is fiber internet available in ${nhData.n}, ${stateName}?`,
    answer: hasConfirmedFiber
      ? `Yes — fiber internet is confirmed available in ${nhData.n} from ${confirmedFiberProviders.slice(0, 3).map(p => p.name).join(', ')} based on ZIP ${primaryZip}. Fiber offers symmetric upload/download speeds and the lowest latency. Enter your address above to check availability at your specific location.`
      : fiberProviders.length > 0
        ? `Fiber may be available in parts of ${nhData.n} from ${fiberProviders.slice(0, 2).map(p => p.name).join(', ')}. Coverage varies by street — enter your address above to verify.`
        : `Fiber availability in ${nhData.n} is currently limited. Cable and 5G home internet are excellent alternatives. New fiber deployments are underway across ${stateName}.`,
  },
  {
    question: `What ZIP codes cover ${nhData.n}, ${stateName}?`,
    answer: `${nhData.n} is served by ${nhData.z.length} ZIP code${nhData.z.length !== 1 ? 's' : ''}: ${nhData.z.slice(0, 6).join(', ')}${nhData.z.length > 6 ? ` and ${nhData.z.length - 6} more` : ''}. This page defaults to ZIP ${primaryZip} for reliable ZIP-level coverage context. Choose a different ZIP above for address-specific results.`,
  },
  {
    question: `How do I switch internet providers in ${nhData.n}?`,
    answer: `Switching is straightforward: 1) Enter your ZIP code above to compare all options at your address. 2) Our experts match you with the best plan. 3) Schedule installation — most providers offer setup within 1–3 business days. 4) Cancel your old service once the new one is active. Our comparison service is completely free.`,
  },
  {
    question: `What internet speed do I need in ${nhData.n}?`,
    answer: `Light use (email, browsing): 25–50 Mbps. Streaming & video calls: 100–200 Mbps. Gaming & remote work: 200–500 Mbps. Large households with 5+ devices: 500 Mbps–1 Gbps. ${census ? `The average download speed in ${stateName} is ${census.avgDownload} Mbps.` : ''} Sign up above for a free, personalized recommendation.`,
  },
];

// ── Schema markup ──
const productSchemas = (hasConfirmedData ? confirmedProviders : providers).slice(0, 8).map(p => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.name} Internet in ${nhData.n}, ${stateName}`,
  image: p.logo || undefined,
  description: p.description,
  brand: { '@type': 'Brand', name: p.name },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: p.rating.toFixed(1),
    reviewCount: p.reviewCount,
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: getMinPrice(p).toFixed(2),
    highPrice: Math.max(...p.plans.map(pl => pl.price)).toFixed(2),
    priceCurrency: 'USD',
    offerCount: p.plans.length,
    availability: 'https://schema.org/InStock',
  },
}));

const breadcrumbItems = [
  { name: 'Home', url: 'https://internet4all.com' },
  { name: stateName, url: `https://internet4all.com/internet-providers/${stateSlug}` },
  ...(parentCity ? [{ name: parentCityName, url: `https://internet4all.com/internet-providers/${nhData.pcs}` }] : []),
  { name: nhData.n, url: `https://internet4all.com/internet-providers/${nhData.st.toLowerCase()}/${nhData.s}` },
];

const schemas = [
  generateBreadcrumbSchema(breadcrumbItems),
  generateFAQSchema(faqs),
  generateItemListSchema(providerComparisonRows.map((r) => ({
    name: `${r.name} internet in ${nhData.n}`,
    url: `https://internet4all.com/provider/${providers.find(p => p.id === r.id)?.slug || ''}`,
    description: `${r.confirmedInPrimaryZip ? 'Confirmed in ZIP ' + primaryZip : 'Not FCC-confirmed in ZIP ' + primaryZip} • Up to ${formatSpeed(r.maxSpeed)} • from ${formatPrice(r.minPrice)}/mo`,
  })).filter((r) => !r.url.endsWith('/'))),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `How to choose internet in ${nhData.n}, ${stateName}`,
    description: `ZIP-first process for selecting the best internet plan in ${nhData.n}.`,
    totalTime: 'P2D',
    step: [
      { '@type': 'HowToStep', name: 'Run ZIP check', text: `Verify your exact address in ZIP ${primaryZip} or your nearest ZIP on this page.` },
      { '@type': 'HowToStep', name: 'Compare total cost', text: 'Compare full monthly cost including equipment, installation, and post-promo pricing.' },
      { '@type': 'HowToStep', name: 'Compare speed profile', text: 'Match download and upload speeds to your household use-case, not just advertised max speed.' },
      { '@type': 'HowToStep', name: 'Schedule overlap', text: 'Activate new service before cancelling existing service to avoid downtime.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Internet Providers in ${nhData.n}, ${stateName}`,
    dateModified: lastUpdated,
    url: `https://internet4all.com/internet-providers/${nhData.st.toLowerCase()}/${nhData.s}`,
    about: {
      '@type': 'Place',
      name: nhData.n,
      description: narrativeSummary,
      address: {
        '@type': 'PostalAddress',
        addressLocality: nhData.n,
        addressRegion: nhData.st,
        addressCountry: 'US',
      },
      ...(isPartOfLargerCity ? {
        containedInPlace: {
          '@type': 'City',
          name: nhData.m || parentCityName,
          address: { '@type': 'PostalAddress', addressRegion: nhData.st },
        },
      } : {}),
      ...(nhData.lat && nhData.lng ? {
        geo: { '@type': 'GeoCoordinates', latitude: nhData.lat, longitude: nhData.lng },
      } : {}),
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.nh-hero-brief', '.nh-key-takeaway'],
    },
  },
  ...productSchemas,
];
---
<Base
  title={`Internet Providers in ${nhData.n}, ${stateName} (${year}) — Compare Plans & Save`}
  description={hasConfirmedData
    ? `${confirmedProviders.length} confirmed internet providers in ${nhData.n}, ${stateName} (ZIP ${primaryZip}). ${providers.length} total options. Speeds to ${formatSpeed(maxSpd)}, plans from ${formatPrice(minPrc)}/mo. ${hasConfirmedFiber ? 'Fiber available. ' : ''}Compare & save.`
    : `Find ${providers.length} internet providers in ${nhData.n}, ${stateName}. Speeds to ${formatSpeed(maxSpd)}, plans from ${formatPrice(minPrc)}/mo. ${fiberProviders.length} fiber, ${cableProviders.length} cable options. Compare & save.`}
  schema={schemas}
>
<StickyCallBar text={`Best internet deals in ${nhData.n} — get connected`} />

<section class="section" style="padding-top:var(--space-xl);">
<div class="container">

  <Breadcrumb items={[
    { name: stateName, url: `/internet-providers/${stateSlug}` },
    ...(parentCity ? [{ name: parentCityName, url: `/internet-providers/${nhData.pcs}` }] : []),
    { name: nhData.n },
  ]} />

  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <div class="reveal nh-hero-wrap" style="margin-bottom:var(--space-xl);">
    <div class="nh-hero-grid">
      <div class="nh-hero-main">
        <div class="nh-hero-pills">
          <span class="nh-pill nh-pill-confirmed">
            <span style="color:var(--brand-green);">&#10003;</span>
            {hasConfirmedData ? `${confirmedProviders.length} confirmed in ${primaryZip}` : `${partners.length} recommended`} providers
          </span>
          <span class="nh-pill">Grade <strong>{grade}</strong></span>
          <span class="nh-pill">Updated {lastUpdatedDisplay}</span>
        </div>
        <h1 class="nh-hero-title">
          Internet Providers in <span class="gradient-text">{nhData.n}, {stateName}</span>
        </h1>
        <p class="nh-hero-brief">
          {locationDesc}{popDesc}. {techSummary} Plans start at <strong>{formatPrice(minPrc)}/mo</strong> with speeds up to <strong>{formatSpeed(maxSpd)}</strong>.
        </p>
        <div class="nh-key-takeaway">
          <strong>{narrativeTitle}:</strong> {narrativeSummary}
        </div>
      </div>
      <aside class="nh-hero-side" aria-label="Neighborhood broadband snapshot">
        <h2 class="nh-side-title">Neighborhood Broadband Snapshot</h2>
        <div class="nh-snapshot-grid">
          <div class="nh-kpi">
            <div class="nh-kpi-label">Baseline ZIP</div>
            <div class="nh-kpi-value">{primaryZip}</div>
          </div>
          <div class="nh-kpi">
            <div class="nh-kpi-label">Max Speed</div>
            <div class="nh-kpi-value">{formatSpeed(maxSpd)}</div>
          </div>
          <div class="nh-kpi">
            <div class="nh-kpi-label">Starting Price</div>
            <div class="nh-kpi-value">{formatPrice(minPrc)}/mo</div>
          </div>
          <div class="nh-kpi">
            <div class="nh-kpi-label">Coverage ZIPs</div>
            <div class="nh-kpi-value">{nhData.z.length}</div>
          </div>
        </div>
        <p class="nh-side-note">
          {nhData.z.length > 1
            ? `This neighborhood spans ${nhData.z.length} ZIP codes. Switch ZIP below to align results with your exact address.`
            : `Results are anchored to ZIP ${primaryZip} and can be refined for exact address coverage below.`}
        </p>
      </aside>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       TRUST BAR
       ═══════════════════════════════════════════ -->
  <div class="trust-bar reveal" style="margin-bottom:var(--space-lg);">
    <div class="trust-item">
      <svg class="trust-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span><strong>{nhData.z.length}</strong> ZIP Codes</span>
    </div>
    <div class="trust-item">
      <svg class="trust-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0114.08 0"/><path d="M1.42 9a16 16 0 0121.16 0"/><path d="M8.53 16.11a6 6 0 016.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
      <span><strong>{hasConfirmedData ? confirmedProviders.length : providers.length}</strong> {hasConfirmedData ? `Confirmed (ZIP ${primaryZip})` : 'Available'} Providers</span>
    </div>
    <div class="trust-item">
