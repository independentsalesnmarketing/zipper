      <div class="nearby-pills">
        {nearbyNhs.map(n => (
          <a href={`/internet-providers/${n.st.toLowerCase()}/${n.s}`} class="nearby-pill">
            <span class="np-name">{n.n}, {n.st}</span>
            <span class="np-pop">{n.z.length} ZIP code{n.z.length !== 1 ? 's' : ''}</span>
          </a>
        ))}
      </div>
      <div style="margin-top:var(--space-lg);overflow-x:auto;-webkit-overflow-scrolling:touch;">
        <table class="compare-table" style="min-width:720px;">
          <thead>
            <tr>
              <th>Nearby Neighborhood</th>
              <th>Shared ZIPs with {nhData.n}</th>
              <th>Total ZIPs</th>
              <th>Quick Link</th>
            </tr>
          </thead>
          <tbody>
            {nearbyNhsDetailed.map((n) => (
              <tr>
                <td><strong>{n.n}, {n.st}</strong></td>
                <td>{n.sharedZipCount > 0 ? n.sharedZips.slice(0, 4).join(', ') : '—'}</td>
                <td>{n.z.length}</td>
                <td><a href={`/internet-providers/${n.st.toLowerCase()}/${n.s}`} style="color:var(--brand-blue);font-weight:600;">View page &rarr;</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Parent city + state links -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <h2 style="margin-bottom:var(--space-sm);">More Coverage Areas</h2>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-sm);">
      {parentCity && (
        <a href={`/internet-providers/${nhData.pcs}`} class="btn btn-secondary">
          All {parentCityName} Providers &#8594;
        </a>
      )}
      <a href={`/internet-providers/${stateSlug}`} class="btn btn-secondary">
        All {stateName} Providers &#8594;
      </a>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       FAQ
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <h2 style="margin-bottom:var(--space-xl);">Frequently Asked Questions — {nhData.n}, {stateName} Internet</h2>
    {faqs.map(faq => (
      <div class="faq-item">
        <button class="faq-question">{faq.question}</button>
        <div class="faq-answer"><div class="faq-answer-inner">{faq.answer}</div></div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════
       DISCLAIMER
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <div style="padding:var(--space-lg);border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-secondary);">
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.8;margin-bottom:var(--space-sm);">
        <strong>Editorial Disclosure:</strong> Our rankings use FCC broadband data, independently verified speed tests, and customer reviews collected from public sources. We may earn a commission when you sign up through our partner links — this helps keep our comparison service free. Partners are indicated with a phone icon. Our recommendations are based on objective criteria and are not influenced by partner status. <a href="/methodology" style="color:var(--brand-blue);">Read our full methodology &rarr;</a>
      </p>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.8;">
        Provider availability, speeds, and pricing can change. The information on this page is updated regularly but may not reflect the latest changes from providers. Always verify details directly. Data sourced from GeoNames (CC BY 4.0), US Census Bureau, and FCC Broadband Data. Last updated {lastUpdatedDisplay}.
      </p>
    </div>
  </div>

</div>
</section>

<style>
  .nh-hero-wrap {
    position: relative;
    border-radius: calc(var(--radius-lg) + 8px);
    overflow: hidden;
    border: 1px solid rgba(0, 82, 255, 0.16);
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(0, 82, 255, 0.12) 0%, rgba(0, 82, 255, 0.04) 32%, rgba(0, 82, 255, 0) 70%),
      radial-gradient(100% 90% at 100% 0%, rgba(0, 213, 132, 0.12) 0%, rgba(0, 213, 132, 0.04) 35%, rgba(0, 213, 132, 0) 74%),
      var(--surface-primary);
    box-shadow: 0 12px 40px rgba(7, 18, 38, 0.08);
  }

  .nh-hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    gap: var(--space-xl);
    padding: var(--space-xl);
  }

  .nh-hero-main {
    position: relative;
    z-index: 1;
  }

  .nh-hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .nh-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.85);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    backdrop-filter: blur(4px);
  }

  .nh-pill-confirmed {
    border-color: rgba(0, 213, 132, 0.32);
    color: var(--text-primary);
    background: rgba(0, 213, 132, 0.1);
  }

  .nh-hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
  }

  .nh-hero-brief {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: var(--text-secondary);
    max-width: 760px;
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .nh-key-takeaway {
    margin-top: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 82, 255, 0.2);
    background: linear-gradient(135deg, rgba(0, 82, 255, 0.06), rgba(0, 213, 132, 0.03));
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--text-primary);
  }

  .nh-hero-side {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 82, 255, 0.2);
    background: rgba(255, 255, 255, 0.86);
    padding: var(--space-lg);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .nh-side-title {
    margin: 0 0 var(--space-md) 0;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .nh-snapshot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .nh-kpi {
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-primary);
    opacity: 0;
    transform: translateY(8px);
    animation: nhKpiIn 520ms ease forwards;
  }

  .nh-kpi:nth-child(1) { animation-delay: 80ms; }
  .nh-kpi:nth-child(2) { animation-delay: 140ms; }
  .nh-kpi:nth-child(3) { animation-delay: 200ms; }
  .nh-kpi:nth-child(4) { animation-delay: 260ms; }

  @keyframes nhKpiIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .nh-kpi-label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nh-kpi-value {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--text-primary);
  }

  .nh-side-note {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .nh-hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .nh-hero-side {
      max-width: 680px;
    }
  }

  @media (max-width: 640px) {
    .nh-hero-grid {
      padding: var(--space-lg);
    }

    .nh-snapshot-grid {
      grid-template-columns: 1fr;
    }

    .nh-hero-title {
      line-height: 1.12;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nh-kpi {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script define:vars={{ allowedNeighborhoodZips: nhData.z, defaultZip: primaryZip }}>
  const allowedZipSet = new Set(allowedNeighborhoodZips);
  const params = new URLSearchParams(window.location.search);
  const queryZip = params.get('zip');
  const selectedZip = queryZip && allowedZipSet.has(queryZip) ? queryZip : defaultZip;

  const bottomInput = document.getElementById('zip-input-bottom') as HTMLInputElement | null;
  const ctaInput = document.getElementById('zip-input-cta') as HTMLInputElement | null;
  if (bottomInput) bottomInput.value = selectedZip;
  if (ctaInput) ctaInput.value = selectedZip;
  const activeZipLabel = document.getElementById('active-zip-label');
  if (activeZipLabel) activeZipLabel.textContent = selectedZip;

  // Highlight active ZIP chips
  document.querySelectorAll('[data-neighborhood-zip]').forEach((el) => {
    const zip = (el as HTMLElement).getAttribute('data-neighborhood-zip') || '';
    if (zip === selectedZip) {
      (el as HTMLElement).style.borderColor = 'rgba(0,213,132,0.45)';
      (el as HTMLElement).style.background = 'rgba(0,213,132,0.08)';
    }
  });

  function handleZipSearch(formId: string, inputId: string) {
    const form = document.getElementById(formId);
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    if (!form || !input) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const zip = input.value.trim();
      if (/^\d{5}$/.test(zip)) {
        window.location.href = `/internet-providers/zip/${zip}`;
      }
    });
  }
  handleZipSearch('zip-search-form-bottom', 'zip-input-bottom');
  handleZipSearch('zip-search-form-cta', 'zip-input-cta');

  // If page was opened with ?zip=XXXXX, rerun ProviderSearch with that ZIP so
  // neighborhood page uses the same live BroadbandMap flow as ZIP pages.
  function runSelectedZipSearch() {
    const ps = (window as any).psGeocode;
    if (!ps || !ps.geocodeZip || !ps.runSearch || !ps.locals || !ps.container) return false;
    ps.geocodeZip(selectedZip).then((geo: any) => {
      if (!geo) return;
      const loc = `ZIP ${selectedZip}` + (geo.city ? ` — ${geo.city}, ${geo.state}` : '');
      ps.runSearch(geo.lat, geo.lng, loc, ps.locals, ps.mainPhone, ps.container);
    });
    return true;
  }
  if (selectedZip !== defaultZip) {
    let tries = 0;
    const t = setInterval(() => {
      tries++;
      if (runSelectedZipSearch() || tries > 30) clearInterval(t);
    }, 150);
  }

  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      if (item) item.classList.toggle('active');
    });
  });

  // Reveal on scroll
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }});
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>
</Base>
