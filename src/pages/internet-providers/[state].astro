    <h2 style="margin-bottom:var(--space-lg);">Internet Providers in Other States</h2>
    <div style="column-count:4;column-gap:var(--space-lg);">
      {Object.entries(stateNames)
        .filter(([abbr]) => abbr !== stateData.abbr)
        .sort((a, b) => a[1].localeCompare(b[1]))
        .map(([abbr, name]) => (
          <a href={`/internet-providers/${getStateSlug(abbr)}`} style="display:block;padding:var(--space-xs) 0;font-size:var(--text-sm);color:var(--text-secondary);">{name}</a>
        ))}
