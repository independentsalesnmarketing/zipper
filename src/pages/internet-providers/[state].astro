  <!-- NEARBY STATES -->
  {(() => {
    const regionGroups: string[][] = [
      ['ME','NH','VT','MA','RI','CT'],
      ['NY','NJ','PA','DE','MD','DC'],
      ['VA','WV','NC','SC','GA','FL'],
      ['KY','TN','AL','MS','LA','AR'],
      ['OH','MI','IN','IL','WI','MN'],
      ['ND','SD','NE','KS','MO','IA'],
      ['TX','OK','NM','AZ','CO','UT'],
      ['MT','ID','WY','NV','OR','WA'],
      ['CA','HI','AK'],
    ];
    const nearbyAbbrs = regionGroups
      .find(g => g.includes(stateData.abbr))
      ?.filter(a => a !== stateData.abbr) || [];
    if (!nearbyAbbrs.length) return null;
    return (
      <div class="reveal" style="margin-bottom:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-sm);">Nearby States — Internet Providers</h2>
        <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);">Browse providers in states near {stateData.name}.</p>
        <div class="grid grid-3" style="gap:var(--space-sm);">
          {nearbyAbbrs.map(abbr => (
            <a href={`/internet-providers/${getStateSlug(abbr)}`} class="card" style="padding:var(--space-md);text-decoration:none;display:flex;justify-content:space-between;align-items:center;">
              <span style="font-weight:600;color:var(--text-primary);">{stateNames[abbr]}</span>
              <span style="font-size:var(--text-sm);color:var(--text-tertiary);">View →</span>
            </a>
          ))}
        </div>
      </div>
