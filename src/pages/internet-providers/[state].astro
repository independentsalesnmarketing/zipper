  <!-- ═══════════════════════════════════════════
       STEP 15: DISCLAIMER + METHODOLOGY
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <div style="padding:var(--space-lg);border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-secondary);">
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.8;margin-bottom:var(--space-sm);">
        <strong>Editorial Disclosure:</strong> Our rankings use FCC broadband data, independently verified speed tests, and customer reviews. We may earn a commission when you sign up through partner links — keeping our comparison service free. Recommendations are based on objective criteria. <a href="/methodology" style="color:var(--brand-blue);">Read our full methodology →</a>
      </p>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin:0;">
        Last updated: {lastUpdatedDisplay} · Data for {stateData.name} ({providers.length} providers, {cities.length} cities) · Coverage may vary by address
      </p>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:var(--space-sm);margin-bottom:0;">
        <strong>Last reviewed by our editorial team:</strong> {lastUpdatedDisplay}. Provider pricing, speed, and availability data verified against official sources and FCC Broadband Data Collection.
      </p>
    </div>
  </div>

</div>
</section>

<script>
  function initStatePage() {
    // ZIP search form handler
    const form = document.getElementById('zip-search-form') as HTMLFormElement;
    const input = document.getElementById('zip-input') as HTMLInputElement;
    if (form && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const zip = input.value.trim();
        if (/^\d{5}$/.test(zip)) {
          if (typeof window.showPageLoader === 'function') window.showPageLoader('Finding providers in ' + zip + '…');
          window.location.href = `/internet-providers/zip/${zip}`;
        }
      });
    }

    // Plan accordion
    document.querySelectorAll('.plan-acc-header').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.plan-acc-item');
        if (item) item.classList.toggle('open');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatePage);
  } else {
    initStatePage();
  }
</script>
</Base>
