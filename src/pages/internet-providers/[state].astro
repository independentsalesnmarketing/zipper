  <!-- CTA -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <div class="card" style="padding:var(--space-2xl);text-align:center;background:linear-gradient(135deg,rgba(0,82,255,0.08),rgba(0,213,132,0.08));border:1px solid var(--brand-blue);">
      <h2 style="margin-bottom:var(--space-sm);">Find Your Perfect Internet Plan in {stateData.name}</h2>
      <p style="color:var(--text-secondary);margin-bottom:var(--space-lg);max-width:550px;margin-inline:auto;">Our experts compare every provider so you don't have to. Sign up now for exclusive deals not available elsewhere.</p>
