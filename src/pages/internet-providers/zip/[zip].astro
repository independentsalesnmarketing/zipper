        <p style="font-size:var(--text-sm);color:var(--text-tertiary);">Browse all {stateName} cities and providers &rarr;</p>
      </a>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       NEARBY ZIP CODES — explore surrounding area
       ═══════════════════════════════════════════ -->
  {siblingZips.length > 0 && (
    <div class="reveal" style="margin-bottom:var(--space-2xl);">
      <div style="display:flex;align-items:center;gap:var(--space-sm);margin-bottom:var(--space-sm);">
        <h3 style="margin:0;font-size:var(--text-lg);">Nearby ZIP Codes &amp; Areas</h3>
        <span style="font-size:var(--text-xs);color:var(--text-tertiary);">{zipCount} ZIPs in {zipData.city} area</span>
      </div>
      <p style="font-size:var(--text-sm);color:var(--text-secondary);margin-bottom:var(--space-md);">Compare internet availability in ZIP codes near {zipData.zip} in {zipData.city} and surrounding communities.</p>
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-xs);">
        {siblingZips.map(z => (
          <a href={`/internet-providers/zip/${z}`} style="padding:6px 14px;border-radius:var(--radius-full);background:var(--surface-secondary);color:var(--text-primary);font-weight:600;font-size:var(--text-sm);text-decoration:none;border:1px solid var(--border);transition:all 0.2s;" class="hover-lift">
            {z}
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- FAQ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <h2 style="margin-bottom:var(--space-lg);">Frequently Asked Questions — Internet in {zipData.zip}, {zipData.city}, {stateName}</h2>
    {faqs.map(faq => (
      <div class="faq-item">
        <button class="faq-question">{faq.question}</button>
        <div class="faq-answer"><div class="faq-answer-inner">{faq.answer}</div></div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════
       STEP 15: DISCLAIMER + METHODOLOGY
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <div style="padding:var(--space-lg);border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface-secondary);">
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);line-height:1.8;margin-bottom:var(--space-sm);">
        <strong>Editorial Disclosure:</strong> Our rankings use FCC broadband data, independently verified speed tests, and customer reviews. We may earn a commission when you sign up through partner links — keeping our comparison service free. Recommendations are based on objective criteria. <a href="/methodology" style="color:var(--brand-blue);">Read our full methodology →</a>
      </p>
      <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin:0;">
        Last updated: {lastUpdatedDisplay} · Data for ZIP {zipData.zip} in {zipData.city}, {stateName} ({allProviders.length} providers) · Coverage may vary by address
      </p>
    </div>
  </div>

</div>
</section>

<style>
  #hero-refine {
    position: relative;
  }

  #hero-refine .ps-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    pointer-events: none;
    width: 16px;
    height: 16px;
  }

  #hero-refine-input:focus {
    outline: none;
    border-color: var(--brand-blue) !important;
    box-shadow: 0 0 0 3px rgba(0,82,255,0.15) !important;
  }

  #hero-refine-suggest {
    list-style: none;
    margin: 0;
    padding: 4px 0;
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--white);
    border: 2px solid var(--brand-blue);
    border-radius: var(--radius-md);
    max-height: 280px;
    overflow-y: auto;
    box-shadow: 0 12px 32px rgba(0,0,0,0.15);
  }

  #hero-refine-suggest li {
    padding: var(--space-sm) var(--space-lg);
    cursor: pointer;
    font-size: var(--text-base);
    color: var(--text-primary);
    transition: background 0.1s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #hero-refine-suggest li:hover,
  #hero-refine-suggest li.active {
    background: rgba(0,82,255,0.06);
    color: var(--brand-blue);
  }

  #hero-refine-suggest .sg-main {
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    #hero-refine {
      min-width: 280px;
    }
  }

  @media (max-width: 900px) {
    .zip-hero {
      flex-direction: column;
      gap: var(--space-lg) !important;
    }

    #hero-refine {
      min-width: auto;
      width: 100%;
      max-width: 350px;
    }
  }

  @media (max-width: 600px) {
    #hero-refine {
      min-width: auto;
      width: 100%;
    }

    #hero-refine > div {
      padding: var(--space-md) !important;
    }

    #hero-refine input,
    #hero-refine button {
      font-size: var(--text-sm) !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Plan accordion
    document.querySelectorAll('.plan-acc-header').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.plan-acc-item');
        if (item) item.classList.toggle('open');
      });
    });
    // FAQ accordion
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        if (item) item.classList.toggle('open');
      });
    });

    // Update hero when ProviderSearch returns results for a different location
    window.addEventListener('ps:results', ((e: CustomEvent) => {
      const { count, location } = e.detail;
      const badgeText = document.getElementById('hero-badge-text');
      const heroLoc = document.getElementById('hero-location');
      const heroCity = document.getElementById('hero-city');
      if (badgeText) badgeText.textContent = `${count} verified providers in ${location}`;
      // Parse location to update headline
      // location is like "ZIP 10001 — New York, NY" or "ZIP 10001"
      const zipMatch = location.match(/ZIP\s+(\d{5})/);
      const cityMatch = location.match(/—\s*(.+)/);
      if (zipMatch && heroLoc) heroLoc.textContent = zipMatch[1];
      if (cityMatch && heroCity) heroCity.textContent = cityMatch[1].trim();
    }) as EventListener);

    // Hero refinement search (for ZIP pages)
    const heroRefineForm = document.getElementById('hero-refine-form') as HTMLFormElement;
    const heroRefineInput = document.getElementById('hero-refine-input') as HTMLInputElement;
    const heroRefineSuggest = document.getElementById('hero-refine-suggest') as HTMLUListElement;

    if (heroRefineForm && heroRefineInput && (window as any).psGeocode) {
      const { geocodeZip, geocodeAddr, runSearch, mainPhone, locals, container } = (window as any).psGeocode;
      let heroAcTimer: ReturnType<typeof setTimeout>;
      let heroAcItems: {display:string,zip:string,lat:number,lng:number}[] = [];
      let heroAcIdx = -1;

      // Fetch suggestions
      async function fetchHeroSuggestions(q: string) {
        if (q.length<4) return [];
        try {
          const r = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=6&countrycodes=us&addressdetails=1`,{headers:{'User-Agent':'Internet4ALL/1.0'},signal:AbortSignal.timeout(5000)});
          if (!r.ok) return [];
          const d = await r.json();
          return d.map((x:any)=>{
            const addr = x.address || {};
            const zip = addr.postcode || '';
            const parts: string[] = [];
            if (addr.house_number && addr.road) parts.push(addr.house_number + ' ' + addr.road);
            else if (addr.road) parts.push(addr.road);
            else if (addr.neighbourhood) parts.push(addr.neighbourhood);
            if (addr.city || addr.town || addr.village || addr.hamlet) parts.push(addr.city || addr.town || addr.village || addr.hamlet);
            if (addr.state) parts.push(addr.state);
            if (zip) parts.push(zip);
            const display = parts.length ? parts.join(', ') : (x.display_name || '').split(',').slice(0,4).join(', ');
            return {display, zip, lat:+x.lat, lng:+x.lon};
          });
        } catch { return []; }
      }

      // Show/hide suggestions
      function showHeroSugs(items: typeof heroAcItems) {
        heroAcItems = items; heroAcIdx = -1;
        if (!items.length) { heroRefineSuggest.style.display='none'; return; }
        heroRefineSuggest.innerHTML = items.map((s,i)=>`<li data-i="${i}"><div class="sg-main">${s.display}</div></li>`).join('');
        heroRefineSuggest.style.display = 'block';
      }

      function closeHeroSugs() { heroRefineSuggest.style.display='none'; heroAcItems=[]; heroAcIdx=-1; }

      function selectHeroSug(i: number) {
        const s = heroAcItems[i]; if (!s) return;
        heroRefineInput.value = s.display;
        closeHeroSugs();
        // Run search
        const loc = s.display;
        runSearch(s.lat, s.lng, loc, locals, mainPhone, container);
      }

      // Form submit
      heroRefineForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = heroRefineInput.value.trim();
        if (!q) return;
        if (/^\d{5}$/.test(q)) {
          geocodeZip(q).then((geo: any) => {
            if (geo) {
              const loc = `ZIP ${q}` + (geo.city ? ` — ${geo.city}, ${geo.state}` : '');
              runSearch(geo.lat, geo.lng, loc, locals, mainPhone, container);
            }
          });
        } else {
          geocodeAddr(q).then((geo: any) => {
            if (geo) {
              const loc = geo.display.split(',').slice(0,3).join(',');
              runSearch(geo.lat, geo.lng, loc, locals, mainPhone, container);
            }
          });
        }
      });

      // Autocomplete
      heroRefineInput.addEventListener('input', () => {
        clearTimeout(heroAcTimer);
        const v = heroRefineInput.value.trim();
        if (v.length<4 || /^\d{5}$/.test(v)) { closeHeroSugs(); return; }
        heroAcTimer = setTimeout(async () => {
          const items = await fetchHeroSuggestions(v);
          if (document.activeElement===heroRefineInput && heroRefineInput.value.trim().length>=4) showHeroSugs(items);
        }, 350);
      });

      heroRefineInput.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!heroAcItems.length) return;
        if (e.key==='ArrowDown') { e.preventDefault(); heroAcIdx=Math.min(heroAcIdx+1,heroAcItems.length-1); updHeroActive(); }
        else if (e.key==='ArrowUp') { e.preventDefault(); heroAcIdx=Math.max(heroAcIdx-1,0); updHeroActive(); }
        else if (e.key==='Enter'&&heroAcIdx>=0) { e.preventDefault(); selectHeroSug(heroAcIdx); }
        else if (e.key==='Escape') closeHeroSugs();
      });

      function updHeroActive() {
        heroRefineSuggest.querySelectorAll('li').forEach((li,i)=>li.classList.toggle('active',i===heroAcIdx));
      }

      heroRefineSuggest.addEventListener('mousedown', (e: MouseEvent) => {
        const li = (e.target as HTMLElement).closest('li');
        if (li) selectHeroSug(parseInt(li.getAttribute('data-i')||'0'));
      });

      heroRefineInput.addEventListener('blur', ()=>setTimeout(closeHeroSugs, 200));
    }
  });
</script>
</Base>
