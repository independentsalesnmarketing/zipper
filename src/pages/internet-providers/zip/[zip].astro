<script>
  function initZipPage() {
    // Plan accordion
    document.querySelectorAll('.plan-acc-header').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.plan-acc-item');
        if (item) item.classList.toggle('open');
      });
    });
    // Update badge count when ProviderSearch returns live results
    window.addEventListener('ps:results', ((e: CustomEvent) => {
      const { count, location } = e.detail;
      const badgeText = document.getElementById('hero-badge-text');
      if (badgeText) badgeText.textContent = `${count} verified providers in ${location}`;
    }) as EventListener);

    // Hero refinement search (for ZIP pages)
    function initHeroRefine() {
      const heroRefineForm = document.getElementById('hero-refine-form') as HTMLFormElement;
      const heroRefineInput = document.getElementById('hero-refine-input') as HTMLInputElement;
      const heroRefineSuggest = document.getElementById('hero-refine-suggest') as HTMLUListElement;

      if (!heroRefineForm || !heroRefineInput || !heroRefineSuggest) return;
      if (!(window as any).psGeocode) {
        // Retry if psGeocode not ready yet
        setTimeout(initHeroRefine, 100);
        return;
      }

      const { geocodeZip, geocodeAddr, runSearch, locals, container } = (window as any).psGeocode;
      let heroAcTimer: ReturnType<typeof setTimeout>;
      let heroAcItems: {display:string,zip:string,lat:number,lng:number}[] = [];
      let heroAcIdx = -1;

      // Fetch suggestions
      async function fetchHeroSuggestions(q: string) {
        if (q.length<4) return [];
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 5000);
          const r = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=6&countrycodes=us&addressdetails=1`,{
            headers:{'User-Agent':'Internet-4-ALL/1.0'},
            signal: controller.signal
          });
          clearTimeout(timeoutId);
          if (!r.ok) return [];
          const d = await r.json();
          return d.map((x:any)=>{
            const addr = x.address || {};
            const zip = addr.postcode || '';
            const parts: string[] = [];
            if (addr.house_number && addr.road) parts.push(addr.house_number + ' ' + addr.road);
            else if (addr.road) parts.push(addr.road);
            else if (addr.neighbourhood) parts.push(addr.neighbourhood);
            if (addr.city || addr.town || addr.village || addr.hamlet) parts.push(addr.city || addr.town || addr.village || addr.hamlet);
            if (addr.state) parts.push(addr.state);
            if (zip) parts.push(zip);
            const display = parts.length ? parts.join(', ') : (x.display_name || '').split(',').slice(0,4).join(', ');
            return {display, zip, lat:+x.lat, lng:+x.lon};
          });
        } catch (e) {
          console.debug('Suggestion fetch error (non-critical):', e);
          return [];
        }
      }

      // Show/hide suggestions
      function showHeroSugs(items: typeof heroAcItems) {
        heroAcItems = items; heroAcIdx = -1;
        if (!items.length) { heroRefineSuggest.style.display='none'; return; }
        heroRefineSuggest.innerHTML = items.map((s,i)=>`<li data-i="${i}"><div class="sg-main">${s.display}</div></li>`).join('');
        heroRefineSuggest.style.display = 'block';
      }

      function closeHeroSugs() { heroRefineSuggest.style.display='none'; heroAcItems=[]; heroAcIdx=-1; }

      function selectHeroSug(i: number) {
        const s = heroAcItems[i]; if (!s) return;
        heroRefineInput.value = s.display;
        closeHeroSugs();
        if (s.zip && /^\d{5}$/.test(s.zip)) {
          window.location.href = `/internet-providers/zip/${s.zip}`;
        } else {
          window.location.href = `/check-availability?q=${encodeURIComponent(s.display)}`;
        }
      }

      // Form submit — always navigate to the ZIP page
      heroRefineForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = heroRefineInput.value.trim();
        if (!q) return;
        if (/^\d{5}$/.test(q)) {
          window.location.href = `/internet-providers/zip/${q}`;
        } else {
          geocodeAddr(q).then((geo: any) => {
            if (geo?.zip && /^\d{5}$/.test(geo.zip)) {
              window.location.href = `/internet-providers/zip/${geo.zip}`;
            } else {
              window.location.href = `/check-availability?q=${encodeURIComponent(q)}`;
            }
          });
        }
      });

      // Autocomplete
      heroRefineInput.addEventListener('input', () => {
        clearTimeout(heroAcTimer);
        const v = heroRefineInput.value.trim();
        if (v.length<4 || /^\d{5}$/.test(v)) { closeHeroSugs(); return; }
        heroAcTimer = setTimeout(async () => {
          const items = await fetchHeroSuggestions(v);
          if (document.activeElement===heroRefineInput && heroRefineInput.value.trim().length>=4) showHeroSugs(items);
        }, 350);
      });

      heroRefineInput.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!heroAcItems.length) return;
        if (e.key==='ArrowDown') { e.preventDefault(); heroAcIdx=Math.min(heroAcIdx+1,heroAcItems.length-1); updHeroActive(); }
        else if (e.key==='ArrowUp') { e.preventDefault(); heroAcIdx=Math.max(heroAcIdx-1,0); updHeroActive(); }
        else if (e.key==='Enter'&&heroAcIdx>=0) { e.preventDefault(); selectHeroSug(heroAcIdx); }
        else if (e.key==='Escape') closeHeroSugs();
      });

      function updHeroActive() {
        heroRefineSuggest.querySelectorAll('li').forEach((li,i)=>li.classList.toggle('active',i===heroAcIdx));
      }

      heroRefineSuggest.addEventListener('mousedown', (e: MouseEvent) => {
        const li = (e.target as HTMLElement).closest('li');
        if (li) selectHeroSug(parseInt(li.getAttribute('data-i')||'0'));
      });

      heroRefineInput.addEventListener('blur', ()=>setTimeout(closeHeroSugs, 200));
    }

    // Initialize hero refine search
    initHeroRefine();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZipPage);
  } else {
    initZipPage();
  }
</script>
</Base>
