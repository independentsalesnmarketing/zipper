---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ProviderSearch from '@components/ProviderSearch.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import ProviderCard from '@components/ProviderCard.astro';
import { getProvidersByState, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, getTypeColor } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import { getZipPages, getStateName, getStateSlug, cities, type ZipData } from '@data/locations';
import { getStateCensus } from '@data/census';
import { buildZipMeta } from '@lib/location-meta';
import { getConfirmedProviders, getConfirmedFiberProviders, getOptimumTier, getOptimumRegion, getNearestFiberZip } from '@lib/zip-lookup';
import { zipNeighborhoods } from '@data/neighborhoods';
import type { Provider, Plan } from '@lib/providers';

export function getStaticPaths() {
  return getZipPages().map(z => ({
    params: { zip: z.zip },
    props: { zipData: z },
  }));
}

interface Props { zipData: ZipData; }
const { zipData } = Astro.props;

const parentCity = cities.find(c => c.slug === zipData.citySlug);
const stateName = getStateName(zipData.state);
const stateSlug = getStateSlug(zipData.state);
const year = new Date().getFullYear();
const lastUpdated = new Date().toISOString().split('T')[0];
const lastUpdatedDisplay = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

// ── Neighborhood enrichment (maps ZIPs to real community names) ──
const nhData = zipNeighborhoods[zipData.zip];
const neighborhoods = nhData?.n?.filter(Boolean) || [];
const metroParent = nhData?.m;
const metroSlug = nhData?.ms;
const hasNeighborhoods = neighborhoods.length > 0;
function slugify(name: string) {
  return name.toLowerCase().replace(/['']/g, '').replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/(^-|-$)/g, '');
}

// State-level providers for SEO fallback
const stateProviders = getProvidersByState(zipData.state);
const partners = stateProviders.filter(p => p.isPartner);
const allProviders = [...stateProviders].sort((a, b) => {
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  const scoreDiff = (b.rating + (getMaxSpeed(b) > 500 ? 1 : 0)) - (a.rating + (getMaxSpeed(a) > 500 ? 1 : 0));
  return scoreDiff;
});
const fiberProviders = allProviders.filter(p => p.types.includes('fiber'));
const cableProviders = allProviders.filter(p => p.types.includes('cable'));
const dslProviders = allProviders.filter(p => p.types.includes('dsl'));
const fiveGProviders = allProviders.filter(p => p.types.includes('5g'));
const satelliteProviders = allProviders.filter(p => p.types.includes('satellite'));

// ── ZIP-level confirmed coverage (from ZIP data files) ──
const confirmedEntries = getConfirmedProviders(zipData.zip);
const confirmedIds = new Set(confirmedEntries.map(c => c.id));
const hasConfirmedData = confirmedEntries.length > 0;
const confirmedProviders = allProviders.filter(p => confirmedIds.has(p.id));
const confirmedPartners = confirmedProviders.filter(p => p.isPartner);
const stateOnlyProviders = allProviders.filter(p => !confirmedIds.has(p.id) && !p.coverage.includes('Nationwide'));
const nationwideProviders = allProviders.filter(p => p.coverage.includes('Nationwide'));
const confirmedFiberIds = getConfirmedFiberProviders(zipData.zip);
const confirmedFiberProviders = confirmedFiberIds.map(id => allProviders.find(p => p.id === id)).filter((p): p is Provider => !!p);
const hasConfirmedFiber = confirmedFiberProviders.length > 0;
const optimumTier = getOptimumTier(zipData.zip);
const optimumRegion = getOptimumRegion(zipData.zip);

// Re-sort with confirmed providers first when data exists
const sortedProviders = hasConfirmedData ? [
  ...confirmedProviders.filter(p => p.isPartner).sort((a, b) => b.rating - a.rating),
  ...confirmedProviders.filter(p => !p.isPartner).sort((a, b) => b.rating - a.rating),
  ...stateOnlyProviders.filter(p => p.isPartner).sort((a, b) => b.rating - a.rating),
  ...stateOnlyProviders.filter(p => !p.isPartner).sort((a, b) => b.rating - a.rating),
  ...nationwideProviders.sort((a, b) => b.rating - a.rating),
] : allProviders;

// Provider coverage status map
const coverageStatus = new Map<string, 'confirmed' | 'statewide' | 'nationwide'>();
for (const p of allProviders) {
  if (confirmedIds.has(p.id)) coverageStatus.set(p.id, 'confirmed');
  else if (p.coverage.includes('Nationwide')) coverageStatus.set(p.id, 'nationwide');
  else coverageStatus.set(p.id, 'statewide');
}

// Altafiber & T-Mobile Fiber detection for editorial
const isAltafiberZip = confirmedIds.has('altafiber');
const isTMobileFiberZip = confirmedIds.has('tmobile');
// Award candidates: use confirmed partners if available, otherwise all partners (Step 9)
const awardCandidates = confirmedPartners.length > 0 ? confirmedPartners : partners;
const fastest = awardCandidates.length ? awardCandidates.reduce((a, b) => getMaxSpeed(a) > getMaxSpeed(b) ? a : b) : null;
const cheapest = awardCandidates.length ? awardCandidates.reduce((a, b) => getMinPrice(a) < getMinPrice(b) ? a : b) : null;
const topRated = awardCandidates.length ? awardCandidates.reduce((a, b) => a.rating > b.rating ? a : b) : null;
const maxSpd = fastest ? getMaxSpeed(fastest) : (allProviders.length ? Math.max(...allProviders.map(p => getMaxSpeed(p))) : 0);
const minPrc = cheapest ? getMinPrice(cheapest) : (allProviders.length ? Math.min(...allProviders.map(p => getMinPrice(p))) : 0);
const avgPrice = allProviders.length ? Math.round(allProviders.reduce((s, p) => s + getMinPrice(p), 0) / allProviders.length) : 0;

// Optimum speed override for this specific ZIP's tier (Step 11)
function getDisplaySpeed(p: Provider): number {
  if (p.id === 'optimum' && optimumTier) {
    if (optimumTier === '8 GIG') return 8000;
    if (optimumTier === '1 GIG') return 1000;
    if (optimumTier === '500 MEG') return 500;
  }
  return getMaxSpeed(p);
}

// Unique descriptive blurb based on ZIP characteristics
const zipNum = parseInt(zipData.zip.substring(0, 3));
const region = zipNum < 200 ? 'the Northeast' : zipNum < 300 ? 'the Mid-Atlantic' : zipNum < 400 ? 'the Southeast' : zipNum < 500 ? 'the Midwest' : zipNum < 600 ? 'the Central United States' : zipNum < 700 ? 'the Plains states' : zipNum < 800 ? 'the South Central region' : zipNum < 900 ? 'the Mountain West' : 'the Western United States';
const hasFiber = fiberProviders.length > 0;
const hasCable = cableProviders.length > 0;

// Step 6: techSummary uses confirmed coverage data when available
function listProviderNames(provs: Provider[]): string {
  if (!provs.length) return '';
  if (provs.length === 1) return provs[0].name;
  if (provs.length === 2) return `${provs[0].name} and ${provs[1].name}`;
  return provs.slice(0, -1).map(p => p.name).join(', ') + ', and ' + provs[provs.length - 1].name;
}
const techSummary = hasConfirmedData
  ? hasConfirmedFiber
    ? `${listProviderNames(confirmedFiberProviders)} Fiber ${confirmedFiberProviders.length === 1 ? 'is' : 'are'} confirmed available in ${zipData.zip}, with speeds up to ${formatSpeed(maxSpd)}.`
    : confirmedProviders.length > 0
      ? `${listProviderNames(confirmedProviders)} ${confirmedProviders.length === 1 ? 'is' : 'are'} confirmed in ${zipData.zip}. ${hasFiber ? `Fiber internet is available in parts of ${zipData.city}.` : 'Cable and wireless options serve this area.'}`
      : hasFiber && hasCable
        ? `Both fiber and cable internet are available in parts of ${zipData.city}, delivering speeds from ${formatSpeed(maxSpd)} down to budget-friendly plans.`
        : `Internet service is available in ${zipData.zip} through regional and nationwide providers.`
  : hasFiber && hasCable
    ? `Both fiber and cable internet are available in parts of ${zipData.city}, delivering speeds from ${formatSpeed(maxSpd)} down to budget-friendly plans.`
    : hasFiber
      ? `Fiber internet is available in parts of ${zipData.city}, making it one of the better-connected areas in ${stateName}.`
      : hasCable
        ? `Cable internet is the primary high-speed option in ${zipData.city}, with wireless and satellite filling coverage gaps.`
        : `Wireless and satellite internet serve as the main options in this area of ${stateName}.`;

const popStr = parentCity?.population ? parentCity.population.toLocaleString() : '';
const cityZips = parentCity?.zipCodes || [];
const zipCount = cityZips.length;

// ── Proximity-based nearby ZIPs using Haversine distance ──
function haversineMiles(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 3959;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
let siblingZips: string[] = [];
if (parentCity?.lat && parentCity?.lng) {
  const pLat = parentCity.lat;
  const pLng = parentCity.lng;
  // Nearby cities within 20 miles, sorted by proximity
  const nearbyCityZips = cities
    .filter(c => c.slug !== zipData.citySlug && c.lat && c.lng)
    .map(c => ({ city: c, dist: haversineMiles(pLat, pLng, c.lat!, c.lng!) }))
    .filter(({ dist }) => dist <= 20)
    .sort((a, b) => a.dist - b.dist)
    .flatMap(({ city }) => city.zipCodes);
  const sameCityZips = cityZips.filter(z => z !== zipData.zip);
  siblingZips = [...new Set([...sameCityZips, ...nearbyCityZips])].slice(0, 12);
} else {
  siblingZips = cityZips.filter(z => z !== zipData.zip).slice(0, 12);
}

// ── Census & hyperlocal data ──
const census = getStateCensus(zipData.state);
const cityPopulation = parentCity?.population || 0;
const areaType = cityPopulation > 500000 ? 'urban' : cityPopulation > 50000 ? 'suburban' : cityPopulation > 10000 ? 'small-city' : 'rural';
const areaLabel = areaType === 'urban' ? 'Urban Metro Area' : areaType === 'suburban' ? 'Suburban Area' : areaType === 'small-city' ? 'Small City' : 'Rural Community';
const connectivityGrade = census ? (census.broadbandPct >= 90 ? 'A' : census.broadbandPct >= 85 ? 'B' : census.broadbandPct >= 80 ? 'C' : census.broadbandPct >= 75 ? 'D' : 'F') : 'B';
const zipAreaDesc = areaType === 'urban'
  ? `ZIP code ${zipData.zip} is in the ${zipData.city} metropolitan area — a densely populated urban zone with strong infrastructure competition among providers. Urban areas typically enjoy the most options and fastest speeds.`
  : areaType === 'suburban'
    ? `ZIP code ${zipData.zip} is in suburban ${zipData.city}, where a mix of cable, fiber, and wireless providers compete for households. Suburban areas like yours often get the best balance of speed, price, and reliability.`
    : areaType === 'small-city'
      ? `ZIP code ${zipData.zip} is in ${zipData.city}, a smaller community where 2–4 providers typically serve each address. You may have fewer choices than urban areas, but local competition keeps quality solid.`
      : `ZIP code ${zipData.zip} is in a rural area near ${zipData.city}. Broadband options may be more limited, but fixed wireless, satellite, and expanding fiber networks are improving coverage year over year.`;

// Step 8: Append confirmed competition context
const competitionNote = hasConfirmedData
  ? confirmedProviders.length === 1
    ? ` Internet options in ${zipData.zip} are limited, with ${confirmedProviders[0].name} as the primary confirmed provider.`
    : confirmedProviders.length <= 3
      ? ` ${confirmedProviders.length} providers compete for customers in ${zipData.zip}, which helps keep prices competitive.`
      : ` ${zipData.zip} is one of the most competitive ZIP codes in ${zipData.city}, with ${confirmedProviders.length} confirmed providers.`
  : '';
const zipAreaDescFull = zipAreaDesc + competitionNote;

// ── "Best For" awards — from confirmed partners or all partners (Step 9) ──
const bestGaming = awardCandidates.length ? awardCandidates.reduce((a, b) => {
  const sA = getMaxSpeed(a) * 0.7 + getMaxUpload(a) * 0.3;
  const sB = getMaxSpeed(b) * 0.7 + getMaxUpload(b) * 0.3;
  return sA > sB ? a : b;
}) : null;
const bestStreaming = awardCandidates.length ? awardCandidates.reduce((a, b) => {
  const sA = getMaxSpeed(a) * 0.5 + (a.plans.some(pl => pl.dataCap === 'Unlimited') ? 100 : 0) + a.rating * 10;
  const sB = getMaxSpeed(b) * 0.5 + (b.plans.some(pl => pl.dataCap === 'Unlimited') ? 100 : 0) + b.rating * 10;
  return sA > sB ? a : b;
}) : null;
const bestWFH = awardCandidates.length ? awardCandidates.reduce((a, b) => {
  const sA = getMaxUpload(a) * 0.6 + a.rating * 20 + (a.types.includes('fiber') ? 50 : 0);
  const sB = getMaxUpload(b) * 0.6 + b.rating * 20 + (b.types.includes('fiber') ? 50 : 0);
  return sA > sB ? a : b;
}) : null;
const awards = [
  { label: 'Best Overall', provider: topRated, reason: topRated ? `${topRated.rating}★ highest rated` : '' },
  { label: 'Fastest', provider: fastest, reason: fastest ? `Up to ${formatSpeed(getMaxSpeed(fastest))}` : '' },
  { label: 'Best Value', provider: cheapest, reason: cheapest ? `From ${formatPrice(getMinPrice(cheapest))}/mo` : '' },
  { label: 'Best for Gaming', provider: bestGaming, reason: bestGaming ? `${formatSpeed(getMaxSpeed(bestGaming))} ↓ / ${formatSpeed(getMaxUpload(bestGaming))} ↑` : '' },
  { label: 'Best for Streaming', provider: bestStreaming, reason: bestStreaming ? `${formatSpeed(getMaxSpeed(bestStreaming))}, unlimited data` : '' },
  { label: 'Best for Home Office', provider: bestWFH, reason: bestWFH ? `${formatSpeed(getMaxUpload(bestWFH))} upload` : '' },
].filter(a => a.provider);

// ── Ranked lists (Step 9) — confirmed partners first, then partners ──
const rankedBySpeed: Provider[] = [...allProviders].sort((a, b) => {
  if (hasConfirmedData) {
    const aConf = confirmedIds.has(a.id);
    const bConf = confirmedIds.has(b.id);
    if (aConf && !bConf) return -1;
    if (!aConf && bConf) return 1;
  }
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  return getMaxSpeed(b) - getMaxSpeed(a);
});
const rankedByPrice: Provider[] = [...allProviders].sort((a, b) => {
  if (hasConfirmedData) {
    const aConf = confirmedIds.has(a.id);
    const bConf = confirmedIds.has(b.id);
    if (aConf && !bConf) return -1;
    if (!aConf && bConf) return 1;
  }
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  return getMinPrice(a) - getMinPrice(b);
});

// ── Connection types (Step 11) ──
const connectionTypes = [
  { type: 'fiber', label: 'Fiber', icon: '', providers: fiberProviders, link: '/internet-types/fiber' },
  { type: 'cable', label: 'Cable', icon: '', providers: cableProviders, link: '/internet-types/cable' },
  { type: 'dsl', label: 'DSL', icon: '', providers: dslProviders, link: '/internet-types/dsl' },
  { type: '5g', label: '5G Home', icon: '', providers: fiveGProviders, link: '/internet-types/5g' },
  { type: 'satellite', label: 'Satellite', icon: '', providers: satelliteProviders, link: '/internet-types/satellite' },
].filter(ct => ct.providers.length > 0);

const faqs = [
  { question: `What internet providers serve ZIP code ${zipData.zip} in ${zipData.city}, ${stateName}?`, answer: hasConfirmedData ? `${confirmedProviders.length} providers have confirmed coverage in ZIP ${zipData.zip}: ${confirmedProviders.slice(0, 4).map(p => p.name).join(', ')}. ${allProviders.length} total providers serve the ${zipData.city} area across ${hasFiber ? 'fiber, ' : ''}${hasCable ? 'cable, ' : ''}wireless, and satellite connections. ${topRated ? `${topRated.name} is the highest rated at ${topRated.rating}/5 stars.` : ''} Use the address checker above for verified, address-level results.` : `Internet availability at ${zipData.zip} in ${zipData.city}, ${stateName} depends on your exact street address. The area is served by ${allProviders.length} providers offering ${hasFiber ? 'fiber, ' : ''}${hasCable ? 'cable, ' : ''}wireless, and satellite connections. ${topRated ? `${topRated.name} is the highest rated at ${topRated.rating}/5 stars.` : ''} Use the address checker above for verified, address-level results — or sign up for instant expert help.` },
  { question: `How do I find the best internet deal in ${zipData.zip}, ${zipData.city}?`, answer: `Enter your address above to see every provider at your location, then sign up for free help. We compare all available plans and regularly find savings of $20–50/month versus ordering directly from provider websites. The service is completely free with no obligation.` },
  { question: `What's the fastest internet available in ${zipData.zip}, ${zipData.city}, ${stateName}?`, answer: `Maximum advertised speeds in the ${zipData.city} ${zipData.zip} area reach ${formatSpeed(maxSpd)}${fiberProviders.length > 0 ? ` via fiber from ${fiberProviders.slice(0, 2).map(p => p.name).join(' and ')}` : ''}. Actual speeds at your address depend on which providers have infrastructure on your street. Check your exact address above for verified speed data.` },
  { question: `What is the cheapest internet in ${zipData.zip}, ${zipData.city}?`, answer: `${cheapest ? `${cheapest.name} offers the lowest starting price near ${zipData.zip} at ${formatPrice(minPrc)}/mo.` : 'Prices vary by address.'} The average starting price across all providers is about $${avgPrice}/mo. Sign up above for exclusive promotions that can save you $20–50/mo.` },
  { question: `Can I get same-week internet installation in ${zipData.zip}?`, answer: `Most providers offer installation within 1–3 business days in ${zipData.city}. Self-install kits — common with 5G home internet and some cable plans — arrive within days and set up in under 30 minutes. Sign up above to check the earliest available installation date at your address.` },
  { question: `Is fiber internet available in ZIP code ${zipData.zip}?`, answer: hasConfirmedFiber ? `Yes — fiber internet is confirmed available in ${zipData.zip} from ${confirmedFiberProviders.map(p => p.name).join(' and ')}. Our coverage data verifies fiber infrastructure in this ZIP code. Fiber offers symmetric speeds ideal for remote work, gaming, and streaming. Enter your address above to check availability at your specific location.` : hasFiber ? `Fiber internet is available in parts of ${zipData.zip} (${zipData.city}, ${stateName}) from ${fiberProviders.slice(0, 3).map(p => p.name).join(', ')}. Availability varies by street — enter your address above to verify.` : `Fiber availability in ${zipData.zip} is limited. Cable internet and 5G home internet are excellent alternatives with speeds suitable for most households. New fiber deployments are underway across ${stateName}.` },
  { question: `What internet speed do I need for my household in ${zipData.city}?`, answer: `Light use (email, browsing): 25–50 Mbps. Streaming & video calls: 100–200 Mbps. Gaming & remote work: 200–500 Mbps. Large households with 5+ devices: 500 Mbps–1 Gbps. Our experts provide free, personalized speed recommendations when you sign up above.` },
  { question: `Are there no-contract internet options in ${zipData.zip}?`, answer: `Yes — ${fiveGProviders.length > 0 ? `5G home internet from ${fiveGProviders.slice(0, 2).map(p => p.name).join(' and ')} requires no annual contract.` : 'Several providers offer no-contract plans.'} Many cable and fiber providers also offer month-to-month options, though you may pay a slightly higher rate versus a 1-year agreement. Enter your address above to filter by contract terms.` },
  { question: `What is the cheapest internet plan available in ${zipData.zip}, ${zipData.city}?`, answer: `${cheapest ? `The most affordable option starts at ${formatPrice(minPrc)}/mo from ${cheapest.name}.` : `Plans start at ${formatPrice(minPrc)}/mo.`} Qualifying households may also save with low-income programs like Spectrum Internet Assist or the FCC Lifeline program. Visit our <a href="/cheap-internet">cheap internet guide</a> for more details.` },
];

// ── Schemas: BreadcrumbList + FAQPage + WebPage + Product/Offer JSON-LD ──
const schemaProviders = hasConfirmedData
  ? [...confirmedProviders, ...nationwideProviders.filter(p => !confirmedIds.has(p.id))].slice(0, 8)
  : allProviders.slice(0, 8);
const productSchemas = schemaProviders.map(p => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.name} Internet in ${zipData.city}, ${stateName} (${zipData.zip})`,
  image: p.logo || undefined,
  description: p.description,
  brand: { '@type': 'Brand', name: p.name },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: p.rating.toFixed(1),
    reviewCount: p.reviewCount,
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: getMinPrice(p).toFixed(2),
    highPrice: Math.max(...p.plans.map(pl => pl.price)).toFixed(2),
    priceCurrency: 'USD',
    offerCount: p.plans.length,
    availability: 'https://schema.org/InStock',
  },
}));

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet-4-all.com' },
    { name: stateName, url: `https://internet-4-all.com/internet-providers/${stateSlug}` },
    { name: zipData.city, url: `https://internet-4-all.com/internet-providers/${zipData.citySlug}` },
    { name: `ZIP ${zipData.zip}`, url: `https://internet-4-all.com/internet-providers/zip/${zipData.zip}` },
  ]),
  generateFAQSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Internet Providers in ${zipData.zip} — ${zipData.city}, ${zipData.state}`,
    dateModified: lastUpdated,
    url: `https://internet-4-all.com/internet-providers/zip/${zipData.zip}`,
  },
  ...productSchemas,
];

const meta = buildZipMeta(`/internet-providers/zip/${zipData.zip}`, zipData.zip, zipData.city, zipData.state, stateName);
---
<Base
  noSuffix
  title={meta.title}
  description={meta.description}
  schema={schemas}
>
<StickyCallBar text={`Best deals in ${zipData.zip} — get connected`} />

<section class="section" style="padding-top:var(--space-xl);">
<div class="container">
  <Breadcrumb items={[
    { name: stateName, url: `/internet-providers/${stateSlug}` },
    { name: zipData.city, url: `/internet-providers/${zipData.citySlug}` },
    { name: `ZIP ${zipData.zip}` },
  ]} />

  <!-- ═══════════════════════════════════════════
       HERO — with refinement search on right
       ═══════════════════════════════════════════ -->
  <div class="reveal zip-hero-wrap" style="margin-bottom:var(--space-lg);">
    <div class="zip-hero">
      <!-- Left: Hero content -->
      <div style="flex:1;min-width:0;">
        <div class="zip-hero-pills">
          <span id="hero-badge" class="zip-pill zip-pill-confirmed">
            <span style="color:var(--brand-green);">&#10003;</span> <span id="hero-badge-text">{partners.length} recommended providers near {zipData.zip}</span>
          </span>
          <span class="zip-pill">Updated {lastUpdatedDisplay}</span>
        </div>
        <h1 id="hero-title" class="zip-hero-title">
          Internet Providers in <span class="gradient-text" id="hero-location">{zipData.zip}</span> — <span id="hero-city">{zipData.city}, {stateName}</span>
        </h1>
        {neighborhoods.length > 0 && (
          <p id="hero-neighborhoods" class="zip-hero-nhs">
            <span id="hero-neighborhoods-label">Neighborhoods served:</span>{' '}
            <span id="hero-neighborhoods-links">{neighborhoods.map((nh, i) => (
              <>
                <a href={`/internet-providers/${zipData.state.toLowerCase()}/${slugify(nh)}?zip=${zipData.zip}`} style="color:var(--brand-blue);font-weight:600;">{nh}</a>{i < neighborhoods.length - 1 ? ', ' : ''}
              </>
            ))}</span>
          </p>
        )}
        <p class="zip-hero-brief">
          Verified coverage for {zipData.city}, {stateName} ({zipData.zip}). {techSummary}
          {' '}Plans start at <strong>{formatPrice(minPrc)}/mo</strong> with speeds up to <strong>{formatSpeed(maxSpd)}</strong>.
        </p>
      </div>

      <!-- Right: Refinement search (ZIP page only) -->
      <div id="hero-refine" class="zip-hero-side">
        <div style="padding:var(--space-lg);background:linear-gradient(135deg,rgba(0,82,255,0.05),rgba(0,213,132,0.05));border:2px solid rgba(0,82,255,0.15);border-radius:var(--radius-lg);">
        <div style="margin-bottom:var(--space-md);">
          <p style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);margin-bottom:var(--space-xs);">Try Different Address</p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);">Search another ZIP or address</p>
        </div>
