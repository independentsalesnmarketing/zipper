---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ProviderSearch from '@components/ProviderSearch.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import ProviderCard from '@components/ProviderCard.astro';
import { getProvidersByState, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, getTypeColor, MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel, generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import { getZipPages, getStateName, getStateSlug, cities, type ZipData } from '@data/locations';
import { getStateCensus } from '@data/census';
import type { Provider, Plan } from '@lib/providers';

export function getStaticPaths() {
  return getZipPages().map(z => ({
    params: { zip: z.zip },
    props: { zipData: z },
  }));
}

interface Props { zipData: ZipData; }
const { zipData } = Astro.props;

const parentCity = cities.find(c => c.slug === zipData.citySlug);
const stateName = getStateName(zipData.state);
const stateSlug = getStateSlug(zipData.state);
const year = new Date().getFullYear();
const lastUpdated = new Date().toISOString().split('T')[0];
const lastUpdatedDisplay = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

// State-level providers for SEO fallback
const stateProviders = getProvidersByState(zipData.state);
const partners = stateProviders.filter(p => p.isPartner);
const allProviders = [...stateProviders].sort((a, b) => {
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  const scoreDiff = (b.rating + (getMaxSpeed(b) > 500 ? 1 : 0)) - (a.rating + (getMaxSpeed(a) > 500 ? 1 : 0));
  return scoreDiff;
});
const fiberProviders = allProviders.filter(p => p.types.includes('fiber'));
const cableProviders = allProviders.filter(p => p.types.includes('cable'));
const dslProviders = allProviders.filter(p => p.types.includes('dsl'));
const fiveGProviders = allProviders.filter(p => p.types.includes('5g'));
const satelliteProviders = allProviders.filter(p => p.types.includes('satellite'));
const fastest = partners.length ? partners.reduce((a, b) => getMaxSpeed(a) > getMaxSpeed(b) ? a : b) : null;
const cheapest = partners.length ? partners.reduce((a, b) => getMinPrice(a) < getMinPrice(b) ? a : b) : null;
const topRated = partners.length ? partners.reduce((a, b) => a.rating > b.rating ? a : b) : null;
const maxSpd = fastest ? getMaxSpeed(fastest) : (allProviders.length ? Math.max(...allProviders.map(p => getMaxSpeed(p))) : 0);
const minPrc = cheapest ? getMinPrice(cheapest) : (allProviders.length ? Math.min(...allProviders.map(p => getMinPrice(p))) : 0);
const avgPrice = allProviders.length ? Math.round(allProviders.reduce((s, p) => s + getMinPrice(p), 0) / allProviders.length) : 0;

// Unique descriptive blurb based on ZIP characteristics
const zipNum = parseInt(zipData.zip.substring(0, 3));
const region = zipNum < 200 ? 'the Northeast' : zipNum < 300 ? 'the Mid-Atlantic' : zipNum < 400 ? 'the Southeast' : zipNum < 500 ? 'the Midwest' : zipNum < 600 ? 'the Central United States' : zipNum < 700 ? 'the Plains states' : zipNum < 800 ? 'the South Central region' : zipNum < 900 ? 'the Mountain West' : 'the Western United States';
const hasFiber = fiberProviders.length > 0;
const hasCable = cableProviders.length > 0;
const techSummary = hasFiber && hasCable
  ? `Both fiber and cable internet are available in parts of ${zipData.city}, delivering speeds from ${formatSpeed(maxSpd)} down to budget-friendly plans.`
  : hasFiber
    ? `Fiber internet is available in parts of ${zipData.city}, making it one of the better-connected areas in ${stateName}.`
    : hasCable
      ? `Cable internet is the primary high-speed option in ${zipData.city}, with wireless and satellite filling coverage gaps.`
      : `Wireless and satellite internet serve as the main options in this area of ${stateName}.`;

const popStr = parentCity?.population ? parentCity.population.toLocaleString() : '';
const cityZips = parentCity?.zipCodes || [];
const zipCount = cityZips.length;

// ── Proximity-based nearby ZIPs using Haversine distance ──
function haversineMiles(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 3959;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
let siblingZips: string[] = [];
if (parentCity?.lat && parentCity?.lng) {
  const pLat = parentCity.lat;
  const pLng = parentCity.lng;
  // Nearby cities within 20 miles, sorted by proximity
  const nearbyCityZips = cities
    .filter(c => c.slug !== zipData.citySlug && c.lat && c.lng)
    .map(c => ({ city: c, dist: haversineMiles(pLat, pLng, c.lat, c.lng) }))
    .filter(({ dist }) => dist <= 20)
    .sort((a, b) => a.dist - b.dist)
    .flatMap(({ city }) => city.zipCodes);
  const sameCityZips = cityZips.filter(z => z !== zipData.zip);
  siblingZips = [...new Set([...sameCityZips, ...nearbyCityZips])].slice(0, 12);
} else {
  siblingZips = cityZips.filter(z => z !== zipData.zip).slice(0, 12);
}

// ── Census & hyperlocal data ──
const census = getStateCensus(zipData.state);
const cityPopulation = parentCity?.population || 0;
const areaType = cityPopulation > 500000 ? 'urban' : cityPopulation > 50000 ? 'suburban' : cityPopulation > 10000 ? 'small-city' : 'rural';
const areaLabel = areaType === 'urban' ? 'Urban Metro Area' : areaType === 'suburban' ? 'Suburban Area' : areaType === 'small-city' ? 'Small City' : 'Rural Community';
const connectivityGrade = census ? (census.broadbandPct >= 90 ? 'A' : census.broadbandPct >= 85 ? 'B' : census.broadbandPct >= 80 ? 'C' : census.broadbandPct >= 75 ? 'D' : 'F') : 'B';
const zipAreaDesc = areaType === 'urban'
  ? `ZIP code ${zipData.zip} is in the ${zipData.city} metropolitan area — a densely populated urban zone with strong infrastructure competition among providers. Urban areas typically enjoy the most options and fastest speeds.`
  : areaType === 'suburban'
    ? `ZIP code ${zipData.zip} is in suburban ${zipData.city}, where a mix of cable, fiber, and wireless providers compete for households. Suburban areas like yours often get the best balance of speed, price, and reliability.`
    : areaType === 'small-city'
      ? `ZIP code ${zipData.zip} is in ${zipData.city}, a smaller community where 2–4 providers typically serve each address. You may have fewer choices than urban areas, but local competition keeps quality solid.`
      : `ZIP code ${zipData.zip} is in a rural area near ${zipData.city}. Broadband options may be more limited, but fixed wireless, satellite, and expanding fiber networks are improving coverage year over year.`;

// ── "Best For" awards — PARTNERS ONLY (Step 5) ──
const bestGaming = partners.length ? partners.reduce((a, b) => {
  const sA = getMaxSpeed(a) * 0.7 + getMaxUpload(a) * 0.3;
  const sB = getMaxSpeed(b) * 0.7 + getMaxUpload(b) * 0.3;
  return sA > sB ? a : b;
}) : null;
const bestStreaming = partners.length ? partners.reduce((a, b) => {
  const sA = getMaxSpeed(a) * 0.5 + (a.plans.some(pl => pl.dataCap === 'Unlimited') ? 100 : 0) + a.rating * 10;
  const sB = getMaxSpeed(b) * 0.5 + (b.plans.some(pl => pl.dataCap === 'Unlimited') ? 100 : 0) + b.rating * 10;
  return sA > sB ? a : b;
}) : null;
const bestWFH = partners.length ? partners.reduce((a, b) => {
  const sA = getMaxUpload(a) * 0.6 + a.rating * 20 + (a.types.includes('fiber') ? 50 : 0);
  const sB = getMaxUpload(b) * 0.6 + b.rating * 20 + (b.types.includes('fiber') ? 50 : 0);
  return sA > sB ? a : b;
}) : null;
const awards = [
  { label: 'Best Overall', provider: topRated, reason: topRated ? `${topRated.rating}★ highest rated` : '' },
  { label: 'Fastest', provider: fastest, reason: fastest ? `Up to ${formatSpeed(getMaxSpeed(fastest))}` : '' },
  { label: 'Best Value', provider: cheapest, reason: cheapest ? `From ${formatPrice(getMinPrice(cheapest))}/mo` : '' },
  { label: 'Best for Gaming', provider: bestGaming, reason: bestGaming ? `${formatSpeed(getMaxSpeed(bestGaming))} ↓ / ${formatSpeed(getMaxUpload(bestGaming))} ↑` : '' },
  { label: 'Best for Streaming', provider: bestStreaming, reason: bestStreaming ? `${formatSpeed(getMaxSpeed(bestStreaming))}, unlimited data` : '' },
  { label: 'Best for Home Office', provider: bestWFH, reason: bestWFH ? `${formatSpeed(getMaxUpload(bestWFH))} upload` : '' },
].filter(a => a.provider);

// ── Ranked lists (Step 9) — partners first ──
const rankedBySpeed: Provider[] = [...allProviders].sort((a, b) => {
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  return getMaxSpeed(b) - getMaxSpeed(a);
});
const rankedByPrice: Provider[] = [...allProviders].sort((a, b) => {
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  return getMinPrice(a) - getMinPrice(b);
});

// ── Connection types (Step 11) ──
const connectionTypes = [
  { type: 'fiber', label: 'Fiber', icon: '', providers: fiberProviders, link: '/internet-types/fiber' },
  { type: 'cable', label: 'Cable', icon: '', providers: cableProviders, link: '/internet-types/cable' },
  { type: 'dsl', label: 'DSL', icon: '', providers: dslProviders, link: '/internet-types/dsl' },
  { type: '5g', label: '5G Home', icon: '', providers: fiveGProviders, link: '/internet-types/5g' },
  { type: 'satellite', label: 'Satellite', icon: '', providers: satelliteProviders, link: '/internet-types/satellite' },
].filter(ct => ct.providers.length > 0);

const faqs = [
  { question: `What internet providers serve ZIP code ${zipData.zip} in ${zipData.city}, ${stateName}?`, answer: `Internet availability at ${zipData.zip} in ${zipData.city}, ${stateName} depends on your exact street address. The area is served by ${allProviders.length} providers offering ${hasFiber ? 'fiber, ' : ''}${hasCable ? 'cable, ' : ''}wireless, and satellite connections. ${topRated ? `${topRated.name} is the highest rated at ${topRated.rating}/5 stars.` : ''} Use the address checker above for verified, address-level results — or call ${MAIN_PHONE} for instant expert help.` },
  { question: `How do I find the best internet deal in ${zipData.zip}, ${zipData.city}?`, answer: `Enter your address above to see every provider at your location, then call our experts at ${MAIN_PHONE}. We compare all available plans and regularly find savings of $20–50/month versus ordering directly from provider websites. The service is completely free with no obligation.` },
  { question: `What's the fastest internet available in ${zipData.zip}, ${zipData.city}, ${stateName}?`, answer: `Maximum advertised speeds in the ${zipData.city} ${zipData.zip} area reach ${formatSpeed(maxSpd)}${fiberProviders.length > 0 ? ` via fiber from ${fiberProviders.slice(0, 2).map(p => p.name).join(' and ')}` : ''}. Actual speeds at your address depend on which providers have infrastructure on your street. Check your exact address above for verified speed data.` },
  { question: `What is the cheapest internet in ${zipData.zip}, ${zipData.city}?`, answer: `${cheapest ? `${cheapest.name} offers the lowest starting price near ${zipData.zip} at ${formatPrice(minPrc)}/mo.` : 'Prices vary by address.'} The average starting price across all providers is about $${avgPrice}/mo. Call ${MAIN_PHONE} for exclusive promotions that can save you $20–50/mo.` },
  { question: `Can I get same-week internet installation in ${zipData.zip}?`, answer: `Most providers offer installation within 1–3 business days in ${zipData.city}. Self-install kits — common with 5G home internet and some cable plans — arrive within days and set up in under 30 minutes. Call ${MAIN_PHONE} to check the earliest available installation date at your address.` },
  { question: `Is fiber internet available in ZIP code ${zipData.zip}?`, answer: hasFiber ? `Yes! Fiber internet is available in parts of ${zipData.zip} (${zipData.city}, ${stateName}) from ${fiberProviders.slice(0, 3).map(p => p.name).join(', ')}. Fiber offers symmetric speeds ideal for remote work, gaming, and streaming. Availability varies by street — enter your address above to verify.` : `Fiber availability in ${zipData.zip} is limited. Cable internet and 5G home internet are excellent alternatives with speeds suitable for most households. New fiber deployments are underway across ${stateName}.` },
  { question: `What internet speed do I need for my household in ${zipData.city}?`, answer: `Light use (email, browsing): 25–50 Mbps. Streaming & video calls: 100–200 Mbps. Gaming & remote work: 200–500 Mbps. Large households with 5+ devices: 500 Mbps–1 Gbps. Our experts provide free, personalized speed recommendations when you call ${MAIN_PHONE}.` },
];

// ── Schemas: BreadcrumbList + FAQPage + WebPage + Product/Offer JSON-LD (Step 1) ──
const productSchemas = allProviders.slice(0, 8).map(p => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.name} Internet in ${zipData.city}, ${stateName} (${zipData.zip})`,
  image: p.logo || undefined,
  description: p.description,
  brand: { '@type': 'Brand', name: p.name },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: p.rating.toFixed(1),
    reviewCount: p.reviewCount,
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: getMinPrice(p).toFixed(2),
    highPrice: Math.max(...p.plans.map(pl => pl.price)).toFixed(2),
    priceCurrency: 'USD',
    offerCount: p.plans.length,
    availability: 'https://schema.org/InStock',
  },
}));

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet4all.com' },
    { name: stateName, url: `https://internet4all.com/internet-providers/${stateSlug}` },
    { name: zipData.city, url: `https://internet4all.com/internet-providers/${zipData.citySlug}` },
    { name: `ZIP ${zipData.zip}`, url: `https://internet4all.com/internet-providers/zip/${zipData.zip}` },
  ]),
  generateFAQSchema(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `Internet Providers in ZIP ${zipData.zip} — ${zipData.city}, ${zipData.state}`,
    dateModified: lastUpdated,
    url: `https://internet4all.com/internet-providers/zip/${zipData.zip}`,
  },
  ...productSchemas,
];
---
<Base
  title={`Internet Providers in ${zipData.zip} — ${zipData.city}, ${stateName} (${year}) | Compare & Save`}
  description={`Find ${allProviders.length} internet providers at ZIP ${zipData.zip} in ${zipData.city}, ${stateName}. Verified FCC coverage data, speeds to ${formatSpeed(maxSpd)}, plans from ${formatPrice(minPrc)}/mo. Fiber, cable, 5G & satellite.`}
  schema={schemas}
>
<StickyCallBar text={`Best deals in ${zipData.zip} — call now`} />

<section class="section" style="padding-top:var(--space-xl);">
<div class="container">
  <Breadcrumb items={[
    { name: stateName, url: `/internet-providers/${stateSlug}` },
    { name: zipData.city, url: `/internet-providers/${zipData.citySlug}` },
    { name: `ZIP ${zipData.zip}` },
  ]} />

  <!-- ═══════════════════════════════════════════
       HERO — with refinement search on right
       ═══════════════════════════════════════════ -->
  <div class="reveal zip-hero" style="margin-bottom:var(--space-lg);display:flex;gap:var(--space-2xl);align-items:flex-start;">
    <!-- Left: Hero content -->
    <div style="flex:1;min-width:0;">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-sm);margin-bottom:var(--space-md);">
        <span id="hero-badge" style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;background:rgba(0,213,132,0.12);border:1px solid rgba(0,213,132,0.3);border-radius:var(--radius-full);font-size:var(--text-sm);font-weight:600;">
          <span style="color:var(--brand-green);">&#10003;</span> <span id="hero-badge-text">{partners.length} recommended providers near {zipData.zip}</span>
        </span>
        <span style="font-size:var(--text-xs);color:var(--text-tertiary);">Updated {lastUpdatedDisplay}</span>
      </div>
      <h1 id="hero-title" style="font-size:var(--text-4xl);margin-bottom:var(--space-sm);">
        Internet Providers in <span class="gradient-text" id="hero-location">{zipData.zip}</span> — <span id="hero-city">{zipData.city}, {stateName}</span>
      </h1>
      <p style="font-size:var(--text-lg);color:var(--text-secondary);max-width:680px;line-height:1.7;">
        Verified coverage for {zipData.city}, {stateName} ({zipData.zip}). {techSummary}
        Plans start at <strong>{formatPrice(minPrc)}/mo</strong> with speeds up to <strong>{formatSpeed(maxSpd)}</strong>.
      </p>
    </div>

    <!-- Right: Refinement search (ZIP page only) -->
    <div id="hero-refine" style="flex-shrink:0;min-width:300px;">
      <div style="padding:var(--space-lg);background:linear-gradient(135deg,rgba(0,82,255,0.05),rgba(0,213,132,0.05));border:2px solid rgba(0,82,255,0.15);border-radius:var(--radius-lg);">
        <div style="margin-bottom:var(--space-md);">
          <p style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);margin-bottom:var(--space-xs);">Try Different Address</p>
          <p style="font-size:var(--text-xs);color:var(--text-tertiary);">Search another ZIP or address</p>
        </div>
        <form id="hero-refine-form" class="ps-form" style="gap:var(--space-xs);">
          <div class="ps-input-group" style="position:relative;">
            <svg class="ps-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <input
              id="hero-refine-input"
              type="text"
              placeholder="Enter ZIP code or address"
              autocomplete="off"
              spellcheck="false"
              style="width:100%;padding:var(--space-sm) var(--space-md) var(--space-sm) 36px;border:2px solid var(--border);border-radius:var(--radius-md);font-size:var(--text-base);background:var(--surface);color:var(--text-primary);transition:border-color 0.2s;"
            />
            <ul id="hero-refine-suggest" class="ps-suggest" style="display:none;"></ul>
          </div>
          <button type="submit" class="btn btn-cta" style="width:100%;padding:10px 16px;font-size:var(--text-base);font-weight:800;">Search</button>
        </form>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       STEP 4: PROVIDER SEARCH (keep full on ZIP pages)
       ═══════════════════════════════════════════ -->
  <div class="reveal">
    <ProviderSearch
      cityName={zipData.city}
      state={zipData.state}
      stateName={stateName}
      zip={zipData.zip}
      lat={parentCity?.lat}
      lng={parentCity?.lng}
      autoSearch
    />
  </div>

  <!-- ═══════════════════════════════════════════
       STATIC FALLBACK — hidden by JS when live results load
       ═══════════════════════════════════════════ -->
  <div id="static-providers" class="reveal" style="margin-bottom:var(--space-2xl);">
    <div style="display:flex;align-items:center;gap:var(--space-sm);margin-bottom:var(--space-md);">
      <h2 style="font-size:var(--text-xl);margin:0;">Providers Serving {zipData.city}, {stateName} ({zipData.zip})</h2>
      <span style="font-size:var(--text-xs);padding:3px 10px;background:var(--surface-secondary);border-radius:var(--radius-full);color:var(--text-tertiary);">State-level data</span>
    </div>
    <p style="color:var(--text-tertiary);font-size:var(--text-sm);margin-bottom:var(--space-md);">
      These providers serve {stateName} and may cover your address. Use the search above for address-verified results.
    </p>
    <div class="flex flex-col gap-md">
      {allProviders.slice(0, 6).map((p, i) => (
        <ProviderCard provider={p} rank={i + 1} badge={p === fastest ? 'best-speed' : p === cheapest ? 'best-value' : p === topRated && i === 0 ? 'best-overall' : undefined} />
      ))}
    </div>
    {allProviders.length > 6 && (
      <div style="text-align:center;margin-top:var(--space-md);">
        <a href={`/internet-providers/${zipData.citySlug}`} class="btn btn-secondary">See All {allProviders.length} Providers in {zipData.city} &rarr;</a>
      </div>
    )}
  </div>

  <!-- ═══════════════════════════════════════════
       STEP 5: "BEST FOR" AWARD GRID
       ═══════════════════════════════════════════ -->
  {awards.length > 0 && (
    <div class="reveal" style="margin-bottom:var(--space-2xl);">
      <h2 style="margin-bottom:var(--space-sm);">Best Internet Providers Near {zipData.zip}, {zipData.city}</h2>
      <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);">Our picks for {year} based on speed, price, ratings, and reliability in the {zipData.city}, {stateName} area.</p>
      <div class="award-grid">
        {awards.map(a => a.provider && (
          <div class="award-card">
            <div class="award-label">{a.label}</div>
            <div class="award-provider">
              {a.provider.logo && <img src={a.provider.logo} alt={a.provider.name} width="48" height="48" loading="lazy" class="award-logo" />}
              <span class="award-name">{a.provider.name}</span>
            </div>
            <div class="award-reason">{a.reason}</div>
            <a href="#get-connected" class="btn btn-cta btn-sm" style="margin-top:var(--space-sm);width:100%;" data-signup-provider={a.provider?.slug}>Sign Up</a>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- ═══════════════════════════════════════════
       STEP 11: CONNECTION TYPE BADGE LINKS
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <h2 style="margin-bottom:var(--space-sm);">Internet Types Available in {zipData.zip}, {zipData.city}</h2>
    <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-md);">
      {connectionTypes.length} connection technologies serve the {zipData.city}, {stateName} area.
    </p>
    <div class="connection-badges">
      {connectionTypes.map(ct => (
        <a href={ct.link} class={`connection-badge badge-${ct.type}`}>
          <span class="cb-icon">{ct.icon}</span>
          <span class="cb-label">{ct.label}</span>
          <span class="cb-count">{ct.providers.length} provider{ct.providers.length !== 1 ? 's' : ''}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       STEP 6: SPEED COMPARISON TABLE (with logos)
       ═══════════════════════════════════════════ -->
  <div class="reveal" style="margin-bottom:var(--space-2xl);">
    <h2 style="margin-bottom:var(--space-xs);">{zipData.city}, {stateName} ({zipData.zip}) Internet Comparison</h2>
    <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);">All {allProviders.length} providers sorted by rating. Availability varies by address within {zipData.zip}.</p>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
      <table class="compare-table" style="min-width:900px;">
        <thead>
          <tr>
            <th style="min-width:180px;">Provider</th>
            <th>Type</th>
            <th>Max Speed</th>
            <th>Upload</th>
            <th>Starting Price</th>
            <th>Data Cap</th>
            <th>Rating</th>
          </tr>
        </thead>
        <tbody>
          {allProviders.map(p => (
            <tr class={p === fastest ? 'row-highlight-speed' : p === cheapest ? 'row-highlight-value' : ''}>
              <td>
                <div style="display:flex;align-items:center;gap:var(--space-sm);">
