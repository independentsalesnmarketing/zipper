---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { generateBreadcrumbSchema } from '@lib/utils';

const year = new Date().getFullYear();

const types = [
  { icon: '⚡', name: 'Fiber', slug: 'fiber', speed: '100 Mbps – 8 Gbps', price: '$30 – $300/mo', availability: '~43% of US', latency: 'Ultra-low (1-5ms)', bestFor: 'Gamers, remote workers, large households', color: 'var(--brand-green)' },
  { icon: '📡', name: 'Cable', slug: 'cable', speed: '25 Mbps – 1.2 Gbps', price: '$20 – $120/mo', availability: '~88% of US', latency: 'Low (10-30ms)', bestFor: 'Most households, streaming, families', color: 'var(--brand-blue)' },
  { icon: '📱', name: '5G Home Internet', slug: '5g', speed: '50 Mbps – 1 Gbps', price: '$25 – $80/mo', availability: 'Expanding (urban/suburban)', latency: 'Low (15-40ms)', bestFor: 'Renters, cord-cutters, no-contract', color: 'var(--brand-purple)' },
  { icon: '📞', name: 'DSL', slug: 'dsl', speed: '1 Mbps – 100 Mbps', price: '$20 – $65/mo', availability: '~90% of US', latency: 'Moderate (25-50ms)', bestFor: 'Budget users, light browsing', color: '#f59e0b' },
  { icon: '🛰️', name: 'Satellite', slug: 'satellite', speed: '25 Mbps – 500 Mbps', price: '$50 – $165/mo', availability: '100% of US', latency: 'High (20-600ms)', bestFor: 'Rural, remote, anywhere', color: '#ef4444' },
  { icon: '📶', name: 'Fixed Wireless', slug: 'fixed-wireless', speed: '10 Mbps – 500 Mbps', price: '$30 – $100/mo', availability: 'Rural/suburban', latency: 'Moderate (15-50ms)', bestFor: 'Rural alternative to satellite', color: '#8b5cf6' },
];

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet-4-all.com' },
    { name: 'Internet Types', url: 'https://internet-4-all.com/internet-types' },
  ]),
];
---
<Base
  title={`Internet Types: Fiber vs Cable vs 5G (${year})`}
  description="Fiber vs cable vs 5G vs satellite vs DSL — compare speeds, prices, reliability & availability. Find which internet type is best for your home."
  schema={schemas}
>
  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container">
      <Breadcrumb items={[{ name: 'Internet Types' }]} />

      <div class="reveal" style="max-width: 800px;">
        <h1 style="font-size: var(--text-4xl); line-height: 1.1; margin-bottom: var(--space-md);">Internet Types: <span class="gradient-text">Fiber vs Cable vs 5G</span></h1>
        <p style="font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.7;">Not all internet connections are created equal. From blazing-fast fiber optic to available-everywhere satellite, here's everything you need to know about each internet technology to make the right choice.</p>
      </div>

      <!-- Comparison Table -->
      <div class="card reveal" style="margin-top: var(--space-2xl); padding: var(--space-xl); overflow-x: auto;">
        <h2 style="margin-bottom: var(--space-lg);">Internet Types at a Glance</h2>
        <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 700px;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border);">
              <th style="text-align: left; padding: var(--space-sm) var(--space-md);">Type</th>
              <th style="text-align: left; padding: var(--space-sm) var(--space-md);">Speed Range</th>
              <th style="text-align: left; padding: var(--space-sm) var(--space-md);">Price</th>
              <th style="text-align: left; padding: var(--space-sm) var(--space-md);">Availability</th>
              <th style="text-align: left; padding: var(--space-sm) var(--space-md);">Latency</th>
              <th style="text-align: left; padding: var(--space-sm) var(--space-md);">Best For</th>
            </tr>
          </thead>
          <tbody>
            {types.map(t => (
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: var(--space-sm) var(--space-md);">
                  <a href={`/internet-types/${t.slug}`} style={`text-decoration: none; font-weight: 700; color: ${t.color};`}>
                    {t.name}
                  </a>
                </td>
                <td style="padding: var(--space-sm) var(--space-md);">{t.speed}</td>
                <td style="padding: var(--space-sm) var(--space-md);">{t.price}</td>
                <td style="padding: var(--space-sm) var(--space-md);">{t.availability}</td>
                <td style="padding: var(--space-sm) var(--space-md);">{t.latency}</td>
                <td style="padding: var(--space-sm) var(--space-md); font-size: var(--text-xs);">{t.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- CTA -->
      <div class="card reveal" style="margin-top: var(--space-xl); padding: var(--space-xl); text-align: center; background: linear-gradient(135deg, rgba(0, 82, 255, 0.05), rgba(0, 213, 132, 0.05)); border-color: rgba(0, 82, 255, 0.2);">
        <h3>Not Sure Which Type Is Right for You?</h3>
        <p style="color: var(--text-secondary); margin-top: var(--space-xs);">Our experts will check what's available at your address and recommend the best option for your needs and budget.</p>
        <a href="#get-connected" class="btn btn-cta mt-lg" style="font-size: var(--text-lg);">
          Find the Right Plan
        </a>
      </div>

      <!-- Individual type cards -->
      <div class="reveal" style="margin-top: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Explore Each Internet Type</h2>
        <div class="grid grid-2" style="gap: var(--space-lg);">
          {types.map(t => (
            <a href={`/internet-types/${t.slug}`} class="card" style="padding: var(--space-xl); text-decoration: none;">
              <h3 style={`margin-top: var(--space-sm); color: ${t.color};`}>{t.name}</h3>
              <div style="margin-top: var(--space-md); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xs); font-size: var(--text-sm);">
                <div><span style="color: var(--text-tertiary);">Speed:</span> <strong>{t.speed}</strong></div>
                <div><span style="color: var(--text-tertiary);">Price:</span> <strong>{t.price}</strong></div>
              </div>
              <p style="margin-top: var(--space-sm); font-size: var(--text-sm); color: var(--text-secondary);">Best for: {t.bestFor}</p>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <StickyCallBar />
</Base>
