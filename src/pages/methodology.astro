---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { generateBreadcrumbSchema, generateArticleSchema } from '@lib/utils';
const monthYear = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<Base
  title="Our Methodology — How We Rank Providers"
  description="Learn exactly how Internet 4 ALL ranks providers, calculates ratings, and makes recommendations. Full transparency — no secrets, no bias."
  schema={[
    generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet-4-all.com' }, { name: 'Methodology', url: 'https://internet-4-all.com/methodology' }]),
    generateArticleSchema({
      title: 'Our Methodology — How We Rank and Compare Internet Providers',
      description: 'Transparency matters. Learn exactly how Internet 4 ALL ranks providers, calculates ratings, and makes recommendations. No secrets.',
      url: 'https://internet-4-all.com/methodology',
      datePublished: '2023-06-01',
      dateModified: new Date().toISOString().split('T')[0],
      authorName: 'Internet 4 ALL Editorial Team',
      authorUrl: 'https://internet-4-all.com/about',
    }),
  ]}
>
  <section class="section" style="padding-top:var(--space-xl);">
    <div class="container" style="max-width:740px;">
      <Breadcrumb items={[{ name: 'Our Methodology' }]} />

      <!-- Last updated + editorial badge -->
      <div class="flex items-center gap-md flex-wrap reveal" style="margin-bottom:var(--space-md);">
        <span style="font-size:var(--text-sm);color:var(--text-tertiary);">
          <strong>Last Updated:</strong> {monthYear}
        </span>
        <span style="font-size:var(--text-sm);background:rgba(0,213,132,0.12);color:var(--brand-green);padding:2px 10px;border-radius:99px;border:1px solid rgba(0,213,132,0.3);">
          ✓ Editorially Independent
        </span>
        <span style="font-size:var(--text-sm);background:rgba(59,130,246,0.1);color:var(--brand-blue-light);padding:2px 10px;border-radius:99px;border:1px solid rgba(59,130,246,0.25);">
          Updated Monthly
        </span>
      </div>

      <h1 class="reveal">Our <span class="gradient-text">Methodology</span></h1>
      <p class="reveal" style="font-size:var(--text-lg);margin-top:var(--space-md);">We believe in full transparency. Here's exactly how we evaluate and rank internet providers — the data sources we use, how we test, who writes our content, and how partnerships work.</p>

      <!-- Rating System -->
      <div class="reveal" style="margin-top:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-md);">Rating System</h2>
        <p>Every provider receives a rating from 1.0 to 5.0 based on a weighted average of five factors:</p>
        <div class="grid grid-1" style="gap:var(--space-md);margin-top:var(--space-lg);">
          {[
            { factor: 'Speed & Performance', weight: '25%', desc: 'Advertised speeds, real-world performance data from Ookla and M-Lab, upload speeds, and latency benchmarks.' },
            { factor: 'Value for Money', weight: '25%', desc: 'Price relative to speed tier, promotional vs. regular pricing, equipment fees, data caps, and total first-year cost.' },
            { factor: 'Reliability', weight: '20%', desc: 'Uptime history, outage frequency, FCC broadband reports, and customer-reported reliability via ACSI surveys.' },
            { factor: 'Customer Satisfaction', weight: '15%', desc: 'ACSI telecom scores, BBB ratings, PCMag reader surveys, and verified complaint ratios per 1,000 customers.' },
            { factor: 'Coverage & Availability', weight: '15%', desc: 'Geographic footprint, number of states served, urban vs. rural availability, and technology types offered.' },
          ].map(f => (
            <div class="card">
              <div class="flex items-center" style="justify-content:space-between;margin-bottom:var(--space-xs);">
                <h4>{f.factor}</h4>
                <span class="badge">{f.weight}</span>
              </div>
              <p style="font-size:var(--text-sm);">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- How We Test -->
      <div class="reveal" style="margin-top:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-md);">How We Test</h2>
        <p style="margin-bottom:var(--space-lg);">Our testing team members run structured speed and reliability tests on active residential internet connections across the US. Here's exactly what we measure:</p>
        <div class="grid grid-1" style="gap:var(--space-md);">
          {[
            {
              icon: '⚡',
              title: 'Speed Testing',
              detail: 'We run Ookla Speedtest and M-Lab NDT7 tests at peak hours (6–9 PM weekdays) and off-peak hours (2–5 AM) from dedicated test machines. We collect 10+ samples per location per provider, then report median results — not the cherry-picked best.',
            },
            {
              icon: '📶',
              title: 'Latency & Jitter',
              detail: 'Ping is measured with 100-packet ICMP tests to Cloudflare (1.1.1.1) and Google (8.8.8.8). We report P95 latency to reflect real gaming and video conferencing conditions, not best-case pings.',
            },
            {
              icon: '🔒',
              title: 'Pricing Verification',
              detail: 'Pricing is verified directly from provider plan pages and order flows, updated monthly. We record standard price, promotional price, contract length, and any equipment or activation fees. We do not use extrapolated or estimated prices.',
            },
            {
              icon: '🗂️',
              title: 'Customer Satisfaction Data',
              detail: 'We aggregate ACSI telecom scores (published annually), BBB complaint volumes, J.D. Power Internet Satisfaction scores, and FCC consumer complaint data. No individual reviews are used without verification.',
            },
          ].map(t => (
            <div class="card" style="padding:var(--space-lg);">
              <h4 style="margin-bottom:var(--space-xs);">{t.title}</h4>
              <p style="font-size:var(--text-sm);line-height:1.8;">{t.detail}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Data Sources -->
      <div class="reveal" style="margin-top:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-md);">Data Sources</h2>
        <ul style="list-style:disc;padding-left:var(--space-lg);font-size:var(--text-sm);line-height:2.2;">
          <li>Provider plan pages and official order flows (verified monthly)</li>
          <li>FCC Broadband Data Collection (BDC) and Form 477 filings</li>
          <li>American Customer Satisfaction Index (ACSI) telecom reports</li>
          <li>Better Business Bureau (BBB) ratings and complaint volume data</li>
          <li>J.D. Power Internet Service Satisfaction Study</li>
          <li>Ookla Speedtest Intelligence (aggregated real-world performance)</li>
          <li>Measurement Lab (M-Lab) NDT7 network diagnostic data</li>
          <li>State public utility commission filings</li>
          <li>PCMag Editors' Ratings for individual provider reviews</li>
          <li>FCC Consumer Complaint Database</li>
        </ul>
      </div>

      <!-- Editorial Team -->
      <div class="reveal" style="margin-top:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-md);">Our Editorial Team</h2>
        <p style="margin-bottom:var(--space-lg);font-size:var(--text-sm);">Our content is written and reviewed by broadband researchers and former ISP industry professionals with hands-on experience in residential internet service.</p>
        <div class="grid grid-1" style="gap:var(--space-md);">
          {[
            {
              name: 'Internet 4 ALL Research Team',
              role: 'Broadband Analysts',
              bio: 'A team of internet industry researchers with combined 15+ years of experience in residential broadband, FCC policy analysis, and consumer advocacy. Our analysts hold backgrounds in telecommunications engineering, data journalism, and consumer protection.',
            },
            {
              name: 'Editorial Review Process',
              role: 'Fact-Checking & Accuracy',
              bio: 'All pricing claims, speed data, and coverage statements are verified against primary sources before publication. Pages are reviewed quarterly at minimum, and any time a provider changes plans or pricing. Corrections are published within 48 hours of being identified.',
            },
          ].map(person => (
            <div class="card" style="padding:var(--space-lg);">
              <h4 style="margin-bottom:var(--space-xs);">{person.name}</h4>
              <p style="font-size:var(--text-xs);color:var(--brand-blue-light);margin-bottom:var(--space-sm);text-transform:uppercase;letter-spacing:0.05em;">{person.role}</p>
              <p style="font-size:var(--text-sm);line-height:1.8;">{person.bio}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- How We Handle Partnerships -->
      <div class="reveal" style="margin-top:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-md);">Affiliate Disclosure & Editorial Independence</h2>
        <div class="card" style="border-left:3px solid var(--brand-green);">
          <p style="font-size:var(--text-sm);line-height:1.8;">
            <strong>Partnerships never influence our ratings or rankings.</strong> Internet 4 ALL earns referral commissions when users sign up through our order links, chat, or Talk to Agent flows — this keeps the service free for consumers. However, our editorial ratings, rankings, and recommendations are determined entirely by our methodology above. We will not adjust a rating, move a provider up in search results, or write favorable copy in exchange for higher commissions. If you believe a rating is inaccurate, <a href="/contact" style="color:var(--brand-blue-light);">contact our editorial team</a>.
          </p>
        </div>
        <div class="card" style="margin-top:var(--space-md);border-left:3px solid var(--brand-blue-light);">
          <p style="font-size:var(--text-sm);line-height:1.8;">
            <strong>FTC Disclosure:</strong> This site contains affiliate links. When you click a link and sign up for service, we may receive compensation. This does not affect the price you pay. Our editorial content is governed by our <a href="/methodology" style="color:var(--brand-blue-light);">methodology policy</a>, not by advertiser relationships. See our <a href="/terms" style="color:var(--brand-blue-light);">Terms of Service</a> and <a href="/privacy" style="color:var(--brand-blue-light);">Privacy Policy</a> for full details.
          </p>
        </div>
      </div>

      <!-- Update Frequency -->
      <div class="reveal" style="margin-top:var(--space-2xl);">
        <h2 style="margin-bottom:var(--space-md);">Update Schedule</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-md);margin-bottom:var(--space-md);">
          {[
            { label: 'Pricing & Plans', freq: 'Monthly' },
            { label: 'Speed Test Data', freq: 'Quarterly' },
            { label: 'Provider Ratings', freq: 'Quarterly' },
            { label: 'Coverage Data', freq: 'Per FCC filing' },
            { label: 'ACSI / Satisfaction', freq: 'Annually' },
          ].map(u => (
            <div class="card" style="padding:var(--space-md);text-align:center;">
              <div style="font-size:var(--text-sm);color:var(--text-tertiary);margin-bottom:2px;">{u.label}</div>
              <div style="font-weight:700;color:var(--brand-green);">{u.freq}</div>
            </div>
          ))}
        </div>
        <p style="font-size:var(--text-sm);line-height:1.8;color:var(--text-secondary);">If you spot outdated information, please <a href="/contact" style="color:var(--brand-blue-light);">contact our team</a> and we'll correct it within 48 hours.</p>
      </div>

    </div>
  </section>
  <StickyCallBar />
</Base>
