---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SearchBar from '@components/SearchBar.astro';
import CallbackForm from '@components/CallbackForm.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice, renderStars, MAIN_PHONE } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const partners = getPartnerProviders().slice(0, 6);
const faqs = [
  { q: 'How far in advance should I set up internet before moving?', a: 'We recommend scheduling your new internet install 2-3 weeks before your move date. This ensures a technician can come on or near move-in day so you\'re never without service.' },
  { q: 'Can I transfer my current internet to my new address?', a: 'Many providers allow you to transfer service. However, your current provider may not serve your new area. Call us and we\'ll check availability at your new address and help you transfer or find a better option.' },
  { q: 'What if my current provider doesn\'t serve my new address?', a: 'No worries — that\'s exactly what we\'re here for! Enter your new ZIP code above and we\'ll show you every provider available at your new home, with exclusive deals for new customers.' },
  { q: 'Do I need to cancel my old service myself?', a: 'Yes. Contact your current provider to cancel once your new service is active. Return any equipment to avoid charges. We recommend keeping old service active until your new connection is confirmed working.' },
  { q: 'Are there special deals for people who just moved?', a: 'Absolutely! New customers almost always get the best promotional pricing. Many of our partner providers offer exclusive move-in deals with discounted rates for 12-24 months. Call us to hear about current offers.' },
];
---
<Base
  title="Moving? Set Up Internet at Your New Home — Best Moving Deals"
  description="Moving to a new home? Set up internet before you arrive. Compare providers at your new address and get exclusive move-in deals. Free setup assistance."
  schema={[
    generateBreadcrumbSchema([
      { name: 'Home', url: 'https://internet4all.com' },
      { name: 'Moving', url: 'https://internet4all.com/movers' }
    ]),
    generateFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })))
  ]}
>
  <!-- Hero -->
  <section class="hero" style="padding-bottom:var(--space-xl);">
    <div class="container text-center">
      <Breadcrumb items={[{ name: 'Moving' }]} />
      <div class="badge reveal" style="margin-bottom:var(--space-md);">🏠 Moving Made Easy</div>
      <h1 class="reveal">Moving? Get Internet <span class="gradient-text">Ready Before You Arrive</span></h1>
      <p class="hero-subtitle reveal">Don't spend your first night in a new home without WiFi. We'll find the best provider at your new address — and get you connected fast.</p>
      <div class="flex justify-center reveal" style="margin-top:var(--space-xl);">
        <SearchBar placeholder="Enter your NEW ZIP code" size="large" />
      </div>
    </div>
  </section>

  <!-- Moving Checklist -->
  <section class="section">
    <div class="container">
      <h2 class="text-center reveal">Your Internet Moving <span class="gradient-text">Checklist</span></h2>
      <p class="text-center reveal" style="max-width:500px;margin:var(--space-sm) auto var(--space-xl);">Follow these steps to ensure a seamless internet transition.</p>
      <div class="grid grid-3">
        <div class="card reveal reveal-delay-1" style="position:relative;padding-top:var(--space-xl);">
          <div style="position:absolute;top:-18px;left:var(--space-lg);width:36px;height:36px;border-radius:50%;background:var(--gradient-primary);display:grid;place-items:center;font-weight:800;font-size:var(--text-sm);">1</div>
          <h4 style="margin-bottom:var(--space-sm);">Check Availability</h4>
          <p style="font-size:var(--text-sm);">Enter your <strong>new ZIP code</strong> to see which providers serve your new area. Compare speeds and prices before you commit.</p>
        </div>
        <div class="card reveal reveal-delay-2" style="position:relative;padding-top:var(--space-xl);">
          <div style="position:absolute;top:-18px;left:var(--space-lg);width:36px;height:36px;border-radius:50%;background:var(--gradient-secondary);display:grid;place-items:center;font-weight:800;font-size:var(--text-sm);">2</div>
          <h4 style="margin-bottom:var(--space-sm);">Schedule Install</h4>
          <p style="font-size:var(--text-sm);">Call us or request a callback. We'll help you choose the best plan and <strong>schedule installation for move-in day</strong>.</p>
        </div>
        <div class="card reveal reveal-delay-3" style="position:relative;padding-top:var(--space-xl);">
          <div style="position:absolute;top:-18px;left:var(--space-lg);width:36px;height:36px;border-radius:50%;background:var(--gradient-accent);display:grid;place-items:center;font-weight:800;font-size:var(--text-sm);">3</div>
          <h4 style="margin-bottom:var(--space-sm);">Cancel Old Service</h4>
          <p style="font-size:var(--text-sm);">Once your new internet is working, cancel your old service and <strong>return any equipment</strong> to avoid extra charges.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Exclusive Moving Deals -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal">Exclusive <span class="gradient-text">Move-In Deals</span></h2>
      <p class="text-center reveal" style="max-width:560px;margin:var(--space-sm) auto var(--space-xl);">New customers get the best prices. Here are top deals from our partner providers.</p>
      <div class="grid grid-2">
        {partners.map((p, i) => {
          const best = p.plans[0];
          return (
            <div class={`card reveal`} style={`transition-delay:${i * 80}ms;`}>
              <div class="flex items-center" style="gap:var(--space-md);margin-bottom:var(--space-md);">
                <div style="width:56px;height:56px;border-radius:var(--radius-md);background:var(--bg-tertiary);display:grid;place-items:center;font-weight:800;font-size:var(--text-lg);color:var(--brand-blue-light);">{p.name.charAt(0)}</div>
                <div>
                  <h4>{p.name}</h4>
                  <p style="font-size:var(--text-xs);color:var(--text-muted);">New customer pricing</p>
                </div>
              </div>
              <div class="flex" style="gap:var(--space-lg);flex-wrap:wrap;margin-bottom:var(--space-md);">
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Starting at</div>
                  <div style="font-size:var(--text-xl);font-weight:800;color:var(--brand-green);">{formatPrice(best.promoPrice || best.price)}<span style="font-size:var(--text-xs);font-weight:400;">/mo</span></div>
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Speeds up to</div>
                  <div style="font-size:var(--text-xl);font-weight:800;">{formatSpeed(p.plans[p.plans.length - 1].speed)}</div>
                </div>
              </div>
              <a href={`tel:${p.phone.replace(/[^0-9]/g, '')}`} class="btn btn-call" style="width:100%;text-align:center;">
                📞 Call for Move-In Deal
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Why call us -->
  <section class="section">
    <div class="container">
      <div class="card gradient-border" style="padding:var(--space-2xl);text-align:center;">
        <h2 class="reveal" style="margin-bottom:var(--space-md);">Why Call <span class="gradient-text">Internet 4 ALL</span> When Moving?</h2>
        <div class="grid grid-3" style="margin-top:var(--space-xl);text-align:left;">
          <div class="reveal reveal-delay-1">
            <h5 style="color:var(--brand-green);margin-bottom:var(--space-xs);">✅ One call, all providers</h5>
            <p style="font-size:var(--text-sm);">Instead of calling 5 different companies, call us once. We'll compare every option at your new address.</p>
          </div>
          <div class="reveal reveal-delay-2">
            <h5 style="color:var(--brand-blue-light);margin-bottom:var(--space-xs);">✅ Exclusive move-in prices</h5>
            <p style="font-size:var(--text-sm);">Our partner rates are often lower than what you'll find on provider websites. New customers get the best deals.</p>
          </div>
          <div class="reveal reveal-delay-3">
            <h5 style="color:var(--brand-purple);margin-bottom:var(--space-xs);">✅ Same-week installation</h5>
            <p style="font-size:var(--text-sm);">We prioritize movers. Most installations can be scheduled within 3-5 business days of your call.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:740px;">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">Moving Internet <span class="gradient-text">FAQ</span></h2>
      <div class="faq-list">
        {faqs.map(f => (
          <div class="faq-item reveal">
            <button class="faq-question">{f.q}</button>
            <div class="faq-answer"><div class="faq-answer-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container" style="max-width:650px;">
      <CallbackForm providerName="Internet 4 ALL (Movers)" phone={MAIN_PHONE} />
    </div>
  </section>

  <StickyCallBar text="Moving soon? Get set up now." />
</Base>
