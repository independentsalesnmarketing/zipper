  'xfinity': { primary: '#6023E1', light: '#ede6fc', dark: '#4a1bb3' },
  'tmobile-5g': { primary: '#E20074', light: '#fde0ef', dark: '#b5005c' },
  'cox': { primary: '#0D47A1', light: '#e3ecf8', dark: '#09357a' },
  'ziply': { primary: '#00A651', light: '#e0f5ec', dark: '#00803e' },
  'starlink': { primary: '#000000', light: '#f0f0f0', dark: '#000000' },
  'viasat': { primary: '#0066CC', light: '#e0effa', dark: '#004d99' },
  'hughesnet': { primary: '#003366', light: '#e0eaf3', dark: '#002244' },
  'wow': { primary: '#0077C8', light: '#e0f0fa', dark: '#005c9b' },
  'fidium': { primary: '#1B3C6E', light: '#e5eaf2', dark: '#132b4f' },
  'google-fiber': { primary: '#4285F4', light: '#e8f0fe', dark: '#3266c2' },
