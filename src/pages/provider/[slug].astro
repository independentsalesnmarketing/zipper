      background: white !important;
      color: #0b1736 !important;
      font-weight: 800 !important;
    }
    .provider-hero .btn-cta:hover {
      background: var(--brandLight) !important;
      color: #08102a !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    }
    .provider-hero .btn-secondary {
      background: rgba(0,0,0,0.16) !important;
      border-color: rgba(255,255,255,0.4) !important;
      color: white !important;
    }
    .provider-hero .btn-secondary:hover {
      background: rgba(0,0,0,0.28) !important;
      border-color: rgba(255,255,255,0.6) !important;
    }
    .provider-hero .stats-bar {
      border-top-color: rgba(255,255,255,0.15) !important;
      background: rgba(255,255,255,0.08);
      border-radius: var(--radius-md);
      padding: var(--space-lg);
      margin-left: calc(-1 * var(--space-lg));
      margin-right: calc(-1 * var(--space-lg));
      margin-bottom: calc(-1 * var(--space-lg));
    }
    .provider-hero .stat-value,
    .provider-hero .stat-value.brand-stat-value { color: white !important; }
    .provider-hero .stat-label { color: rgba(255,255,255,0.7) !important; }
    .provider-hero .brand-logo-wrap {
      background: white;
      border: 2px solid rgba(255,255,255,0.3);
    }
    .provider-hero .brand-logo-wrap {
      width: 128px;
      height: 128px;
      border-radius: var(--radius-xl);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }
    .provider-hero .brand-logo-wrap img {
      width: 128px;
      height: 128px;
      object-fit: contain;
      padding: 12px;
    }
    .provider-hero .brand-logo-wrap .brand-logo-fallback {
      font-weight: 900;
      font-size: 3rem;
      color: #334155;
      line-height: 1;
    }

    @media (max-width: 640px) {
      .provider-hero .brand-logo-wrap {
        width: 96px;
        height: 96px;
