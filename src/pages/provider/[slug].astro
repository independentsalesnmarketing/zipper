---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, getTypeColor, renderStars, stateNames } from '@lib/providers';
import { generateProductSchema, generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import type { Provider } from '@lib/providers';

export function getStaticPaths() {
  const providers = getAllProviders();
  return providers.map(p => ({
    params: { slug: p.slug },
    props: { provider: p },
  }));
}

interface Props { provider: Provider; }
const { provider } = Astro.props;

const minPrice = getMinPrice(provider);
const maxSpeed = getMaxSpeed(provider);
const maxUpload = getMaxUpload(provider);
const year = new Date().getFullYear();

// Brand colors for each provider
const brandColors: Record<string, { primary: string; light: string; dark: string }> = {
  'spectrum': { primary: '#0052FF', light: '#e6eeff', dark: '#003bba' },
  'verizon': { primary: '#CD040B', light: '#fce8e9', dark: '#9b0308' },
  'att-fiber': { primary: '#009FDB', light: '#e0f4fc', dark: '#007bad' },
  'frontier': { primary: '#FF0037', light: '#ffe6ec', dark: '#cc002c' },
  'att-air': { primary: '#009FDB', light: '#e0f4fc', dark: '#007bad' },
  'tmobile-fiber': { primary: '#E20074', light: '#fde0ef', dark: '#b5005c' },
  'windstream': { primary: '#00B2E4', light: '#e0f6fd', dark: '#008bb3' },
  'optimum': { primary: '#0097D5', light: '#e0f3fb', dark: '#0076a8' },
  'earthlink': { primary: '#009933', light: '#e0f5e8', dark: '#007526' },
  'brightspeed': { primary: '#00A5E0', light: '#e0f4fd', dark: '#0082b3' },
  'altafiber': { primary: '#1C3D69', light: '#e5eaf1', dark: '#142d4f' },
  'xfinity': { primary: '#6023E1', light: '#ede6fc', dark: '#4a1bb3' },
  'tmobile-5g': { primary: '#E20074', light: '#fde0ef', dark: '#b5005c' },
  'cox': { primary: '#0D47A1', light: '#e3ecf8', dark: '#09357a' },
  'ziply': { primary: '#00A651', light: '#e0f5ec', dark: '#00803e' },
  'starlink': { primary: '#000000', light: '#f0f0f0', dark: '#000000' },
  'viasat': { primary: '#0066CC', light: '#e0effa', dark: '#004d99' },
  'hughesnet': { primary: '#003366', light: '#e0eaf3', dark: '#002244' },
  'wow': { primary: '#0077C8', light: '#e0f0fa', dark: '#005c9b' },
  'fidium': { primary: '#1B3C6E', light: '#e5eaf2', dark: '#132b4f' },
  'google-fiber': { primary: '#4285F4', light: '#e8f0fe', dark: '#3266c2' },
  'geolinks': { primary: '#00AEEF', light: '#e0f5fd', dark: '#0089bd' },
  'uscellular': { primary: '#1A1A6C', light: '#e5e5f2', dark: '#121250' },
  'mediacom': { primary: '#00529B', light: '#e0edf7', dark: '#003d74' },
};
const brand = brandColors[provider.slug] || { primary: '#0052FF', light: '#e6eeff', dark: '#003bba' };

// Technology descriptions
const techDescriptions: Record<string, string> = {
  'fiber': 'fiber-optic infrastructure that transmits data using light pulses through glass strands, delivering the fastest and most reliable residential internet speeds available',
  'cable': 'cable infrastructure using coaxial lines shared with TV service, offering fast download speeds with widespread availability across urban and suburban areas',
  '5g': '5G wireless technology that beams high-speed internet directly to your home without the need for wired infrastructure, perfect for quick setup and areas without cable or fiber',
  'satellite': 'satellite technology that beams internet from orbiting satellites, making it available virtually anywhere including the most rural and remote locations',
  'dsl': 'DSL technology that delivers internet over existing telephone lines, providing reliable service in areas where fiber and cable have not yet reached',
  'fixed-wireless': 'fixed wireless technology that uses radio signals transmitted from towers to a receiver at your home, bridging the gap between wired and mobile internet',
};
const primaryType = provider.types[0] || 'cable';
const techDesc = techDescriptions[primaryType] || 'broadband technology delivering reliable internet service to homes and businesses';

// Determine popular use cases
const speedTier = maxSpeed >= 2000 ? 'ultra-high' : maxSpeed >= 1000 ? 'gigabit' : maxSpeed >= 300 ? 'high' : maxSpeed >= 100 ? 'moderate' : 'basic';
const useCases = {
  'ultra-high': ['4K/8K streaming on 10+ devices', 'professional content creation', 'competitive gaming', 'running a home business', 'smart home with 50+ devices'],
  'gigabit': ['4K streaming on multiple screens', 'working from home with video calls', 'online gaming', 'large file downloads', 'smart home automation'],
  'high': ['HD/4K streaming', 'video conferencing', 'online gaming', 'multiple connected devices', 'social media and browsing'],
  'moderate': ['HD streaming', 'web browsing', 'email and social media', 'casual gaming', 'video calls'],
  'basic': ['web browsing and email', 'social media', 'SD video streaming', 'online shopping', 'light video calls'],
};

const faqs = [
  { question: `Is ${provider.name} available in my area?`, answer: `${provider.name} is available in ${provider.coverage.includes('Nationwide') ? 'all 50 states' : provider.coverage.length + ' states: ' + provider.coverage.join(', ')}. Enter your ZIP code above to check exact availability at your address.` },
  { question: `What is ${provider.name}'s fastest plan?`, answer: `${provider.name}'s fastest plan offers up to ${formatSpeed(maxSpeed)} download speed. Prices start at ${formatPrice(minPrice)}/mo.` },
  { question: `Does ${provider.name} have data caps?`, answer: provider.plans[0]?.dataCap === 'Unlimited' ? `No, ${provider.name} offers unlimited data on all plans — no throttling, no overage fees.` : `${provider.name} plans include data allowances. See plan details above for specific caps.` },
  { question: `Does ${provider.name} require a contract?`, answer: provider.plans[0]?.contract === 'None' ? `No, ${provider.name} does not require annual contracts. You can cancel anytime.` : `Some ${provider.name} plans require a contract. Check plan details above.` },
  { question: `How does ${provider.name} compare to other providers?`, answer: `${provider.name} offers speeds up to ${formatSpeed(maxSpeed)} starting at ${formatPrice(minPrice)}/mo with a ${provider.rating.toFixed(1)}/5 rating from ${provider.reviewCount.toLocaleString()} reviews. Compare plans side-by-side on our comparison page.` },
  { question: `What technology does ${provider.name} use?`, answer: `${provider.name} uses ${provider.types.map(t => getTypeLabel(t)).join(' and ')} technology. ${primaryType === 'fiber' ? 'Fiber provides the fastest, most reliable connection with symmetrical upload/download speeds.' : primaryType === '5g' ? '5G home internet offers fast wireless speeds without requiring a wired connection.' : 'This provides reliable coverage for most internet activities.'}` },
];

const schemas = [
  generateProductSchema(provider),
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet4all.com' },
    { name: 'Providers', url: 'https://internet4all.com/providers' },
    { name: provider.name, url: `https://internet4all.com/provider/${provider.slug}` },
  ]),
  generateFAQSchema(faqs),
];
---
<Base
  title={`${provider.name} Internet Plans, Prices & Reviews (${year})`}
  description={`${provider.name} offers internet speeds up to ${formatSpeed(maxSpeed)} starting at ${formatPrice(minPrice)}/mo. Read reviews, compare plans, and sign up for exclusive deals.`}
  schema={schemas}
>
  <style define:vars={{ brandPrimary: brand.primary, brandLight: brand.light, brandDark: brand.dark }}>
    .provider-hero { border-top: 4px solid var(--brandPrimary); }
    .provider-hero .btn-cta { background: var(--brandPrimary) !important; }
    .provider-hero .btn-cta:hover { background: var(--brandDark) !important; }
    .provider-hero .btn-secondary { border-color: var(--brandPrimary); color: var(--brandPrimary); }
    .provider-hero .btn-secondary:hover { background: var(--brandLight); }
    .brand-plan-card { border-top: 3px solid var(--brandPrimary); }
    .brand-plan-card .btn-cta { background: var(--brandPrimary) !important; }
    .brand-plan-card .btn-cta:hover { background: var(--brandDark) !important; }
    .brand-plan-card--featured { border-color: var(--brandPrimary); box-shadow: 0 4px 24px color-mix(in srgb, var(--brandPrimary) 20%, transparent); }
    .brand-section-heading { color: var(--brandPrimary); }
    .brand-tag { background: var(--brandLight); color: var(--brandDark); border: 1px solid color-mix(in srgb, var(--brandPrimary) 20%, transparent); }
    .brand-stat-value { color: var(--brandPrimary); }
  </style>

  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container">
      <Breadcrumb items={[
        { name: 'Providers', url: '/providers' },
        { name: provider.name },
      ]} />

      <!-- Provider Header -->
      <div class="card provider-hero" style="margin-bottom: var(--space-2xl); padding: var(--space-2xl);">
        <div class="flex items-center gap-lg flex-wrap">
          <div style="width:72px;height:72px;border-radius:var(--radius-lg);background:var(--gray-50);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;overflow:hidden;">
            {provider.logo ? (
              <img src={provider.logo} alt={`${provider.name} logo`} width="72" height="72" style="padding:8px; object-fit:contain;" />
            ) : (
              <span style="font-weight:800;font-size:var(--text-2xl);color:var(--text-tertiary);">{provider.name.charAt(0)}</span>
            )}
          </div>
          <div style="flex:1; min-width: 0;">
            <div class="flex items-center gap-sm flex-wrap">
              <h1 style="font-size: var(--text-3xl);">{provider.name}</h1>
            </div>
            <div class="flex items-center gap-md flex-wrap mt-sm">
              {provider.types.map(t => (
                <span class={`tag tag-${t}`}>{getTypeLabel(t)}</span>
              ))}
              <span class="rating">
                <span class="star-filled">{'★'.repeat(Math.floor(provider.rating))}</span>
                <span class="star-empty">{'☆'.repeat(5 - Math.floor(provider.rating))}</span>
                <span class="rating-value">{provider.rating}</span>
                <span class="rating-count">({provider.reviewCount.toLocaleString()} reviews)</span>
              </span>
            </div>
          </div>
          <div class="flex gap-sm">
            <a href="#get-connected" class="btn btn-cta" data-signup-provider={provider.slug}>
              Sign Up Online
            </a>
            {provider.isPartner && (
              <a href="#provider-plans" class="btn btn-secondary">
                View Plans
              </a>
            )}
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="stats-bar" style="margin-top: var(--space-xl); border-top-color: var(--border);">
          <div class="stat-item">
            <div class="stat-value brand-stat-value">{formatSpeed(maxSpeed)}</div>
            <div class="stat-label">Max Download</div>
          </div>
          <div class="stat-item">
            <div class="stat-value brand-stat-value">{formatSpeed(maxUpload)}</div>
            <div class="stat-label">Max Upload</div>
          </div>
          <div class="stat-item">
            <div class="stat-value brand-stat-value">{formatPrice(minPrice)}</div>
            <div class="stat-label">Starting Price</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">{provider.plans[0]?.dataCap || 'N/A'}</div>
            <div class="stat-label">Data Cap</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">{provider.plans[0]?.contract || 'None'}</div>
            <div class="stat-label">Contract</div>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="reveal" style="margin-bottom: var(--space-2xl);">
        <p style="font-size: var(--text-lg); color: var(--text-secondary); max-width: 800px;">{provider.description}</p>
      </div>

      <!-- Overview / About Section — SEO content -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-lg);">{provider.name} Internet Overview ({year})</h2>
        <div class="card" style="padding: var(--space-xl);">
          <p style="margin-bottom: var(--space-md); line-height: 1.8; color: var(--text-secondary);">
            {provider.name} delivers internet service using {techDesc}. With plans ranging from {formatPrice(minPrice)}/mo to {formatPrice(provider.plans[provider.plans.length - 1]?.promoPrice || provider.plans[provider.plans.length - 1]?.price || 0)}/mo, {provider.name} caters to a wide range of households — from light users who mainly browse and stream to power users running smart homes and home offices.
          </p>
          <p style="margin-bottom: var(--space-md); line-height: 1.8; color: var(--text-secondary);">
            Download speeds range from {formatSpeed(provider.plans[0]?.speed || 0)} on the entry-level plan up to {formatSpeed(maxSpeed)} on the top tier{maxUpload >= 100 ? `, with upload speeds reaching ${formatSpeed(maxUpload)}` : ''}. {provider.plans[0]?.dataCap === 'Unlimited' ? `All plans include unlimited data with no overage fees or throttling.` : `Data allowances vary by plan — check individual plan details for caps.`}
          </p>
          <div style="margin-top: var(--space-lg);">
            <h4 style="margin-bottom: var(--space-sm);">Best For:</h4>
            <div class="flex flex-wrap gap-sm">
              {(useCases[speedTier] || useCases['moderate']).map(use => (
                <span class="brand-tag" style="padding: 4px 12px; border-radius: 99px; font-size: var(--text-sm);">{use}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Plans -->
      <div id="provider-plans" class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} Internet Plans</h2>
        <div class="grid grid-3">
          {provider.plans.map((plan, i) => (
            <div class={`plan-card brand-plan-card ${i === Math.floor(provider.plans.length / 2) ? 'brand-plan-card--featured' : ''}`}>
              {i === Math.floor(provider.plans.length / 2) && (
                <div style="display:flex;justify-content:center;margin-bottom:var(--space-sm);">
                  <span class="badge badge-blue">Most Popular</span>
                </div>
              )}
              <div class="plan-name">{plan.name}</div>
              <div class="plan-speed">{formatSpeed(plan.speed)}</div>
              <div class="plan-speed-unit">download · {formatSpeed(plan.uploadSpeed)} upload</div>
              <div class="plan-price">
                {formatPrice(plan.promoPrice)} <span>/mo</span>
              </div>
              {plan.promoPrice < plan.price && (
                <div class="plan-original-price">Reg. {formatPrice(plan.price)}/mo</div>
              )}
              <div style="font-size: var(--text-xs); color: var(--text-tertiary); padding: var(--space-sm) 0; border-bottom: 1px solid var(--border); margin-bottom: var(--space-sm);">
                {plan.contract} contract · {plan.dataCap} data
              </div>
              <ul class="plan-features">
                {plan.features.map(f => <li>{f}</li>)}
              </ul>
              {provider.isPartner && (
                <a href="#get-connected" class="btn btn-cta w-full" style="margin-top: auto; padding-top: var(--space-md);" data-signup-provider={provider.slug}>
                  Get This Plan
                </a>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Technology Deep-Dive — SEO content -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} Technology & Network</h2>
        <div class="grid grid-2" style="gap: var(--space-lg);">
          <div class="card" style="padding: var(--space-xl);">
            <h4 class="brand-section-heading" style="margin-bottom: var(--space-md);">Connection Types</h4>
            <div class="flex flex-col gap-md">
              {provider.types.map(t => (
                <div style="display:flex;align-items:flex-start;gap:var(--space-sm);">
                  <span class="brand-tag" style="padding:4px 10px;border-radius:var(--radius-sm);font-size:var(--text-xs);font-weight:700;white-space:nowrap;">{getTypeLabel(t)}</span>
                  <span style="font-size:var(--text-sm);color:var(--text-secondary);line-height:1.6;">
                    {t === 'fiber' ? 'Delivers the fastest speeds with symmetrical upload/download and lowest latency.' : t === 'cable' ? 'Uses existing coaxial infrastructure for fast download speeds and wide availability.' : t === '5g' ? 'Wireless broadband with no wiring required — quick self-install and growing coverage.' : t === 'satellite' ? 'Reaches virtually anywhere, including remote and rural locations.' : t === 'dsl' ? 'Reliable service over phone lines, available in most areas.' : 'Tower-based wireless for areas without wired infrastructure.'}
                  </span>
                </div>
              ))}
            </div>
          </div>
          <div class="card" style="padding: var(--space-xl);">
            <h4 class="brand-section-heading" style="margin-bottom: var(--space-md);">Key Features</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-sm);">
              <li style="display:flex;align-items:center;gap:var(--space-sm);font-size:var(--text-sm);">
                <span style="color:var(--brand-green);font-weight:700;">✓</span>
                Speeds up to {formatSpeed(maxSpeed)} download
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-sm);font-size:var(--text-sm);">
                <span style="color:var(--brand-green);font-weight:700;">✓</span>
                Upload speeds up to {formatSpeed(maxUpload)}
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-sm);font-size:var(--text-sm);">
                <span style="color:var(--brand-green);font-weight:700;">✓</span>
                {provider.plans[0]?.dataCap === 'Unlimited' ? 'Unlimited data — no caps or throttling' : `Data plans from ${provider.plans[0]?.dataCap}`}
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-sm);font-size:var(--text-sm);">
                <span style="color:var(--brand-green);font-weight:700;">✓</span>
                {provider.plans[0]?.contract === 'None' ? 'No annual contracts required' : `${provider.plans[0]?.contract} contract options`}
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-sm);font-size:var(--text-sm);">
                <span style="color:var(--brand-green);font-weight:700;">✓</span>
                {provider.plans.length} plan{provider.plans.length !== 1 ? 's' : ''} starting at {formatPrice(minPrice)}/mo
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-sm);font-size:var(--text-sm);">
                <span style="color:var(--brand-green);font-weight:700;">✓</span>
                {provider.rating.toFixed(1)}/5 from {provider.reviewCount.toLocaleString()} reviews
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Pros & Cons -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} Pros & Cons</h2>
        <div class="pros-cons">
          <div class="card">
            <h4 style="color: var(--brand-green); margin-bottom: var(--space-md);">✓ Pros</h4>
            <ul class="pros-list">
              {provider.pros.map(p => <li>{p}</li>)}
            </ul>
          </div>
          <div class="card">
            <h4 style="color: var(--brand-red); margin-bottom: var(--space-md);">✕ Cons</h4>
            <ul class="cons-list">
              {provider.cons.map(c => <li>{c}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Coverage -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} Coverage & Availability</h2>
        <div class="card" style="padding: var(--space-xl);">
          <p style="margin-bottom: var(--space-md); line-height: 1.7;">{provider.name} is available in {provider.coverage.includes('Nationwide') ? 'all 50 states across the US, making it one of the most widely available providers.' : `${provider.coverage.length} states across the US.`} {provider.coverage.includes('Nationwide') ? 'Coverage quality and plan availability may vary by location.' : 'Service availability varies by address within covered states.'}</p>
          {!provider.coverage.includes('Nationwide') && (
            <div class="flex flex-wrap gap-sm" style="margin-bottom: var(--space-md);">
              {provider.coverage.map(state => (
                <a href={`/cheap-internet/${state.toLowerCase()}`} class="brand-tag" style="padding:4px 12px;border-radius:99px;font-size:var(--text-sm);text-decoration:none;">{stateNames[state] || state}</a>
              ))}
            </div>
          )}
          <p style="font-size: var(--text-sm); color: var(--text-tertiary);">Enter your ZIP code on our <a href="/providers" style="color:var(--brand-blue);">providers page</a> to check exact availability at your address.</p>
        </div>
      </div>

      <!-- Customer Experience — SEO content -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} Customer Experience</h2>
        <div class="grid grid-3" style="gap: var(--space-lg);">
          <div class="card" style="padding: var(--space-xl); text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom:var(--space-sm);">⭐</div>
            <div class="brand-stat-value" style="font-size: var(--text-3xl); font-weight: 900;">{provider.rating.toFixed(1)}/5</div>
            <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">from {provider.reviewCount.toLocaleString()} reviews</div>
            {provider.reviewSource && provider.reviewUrl && (
              <a href={provider.reviewUrl} target="_blank" rel="noopener noreferrer" style="font-size: var(--text-xs); color: var(--text-tertiary); margin-top: var(--space-xs); display: block;">{provider.reviewSource}</a>
            )}
          </div>
          <div class="card" style="padding: var(--space-xl); text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom:var(--space-sm);">📋</div>
            <div class="brand-stat-value" style="font-size: var(--text-3xl); font-weight: 900;">{provider.plans[0]?.contract === 'None' ? 'No' : provider.plans[0]?.contract}</div>
            <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Contract Required</div>
          </div>
          <div class="card" style="padding: var(--space-xl); text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom:var(--space-sm);">📊</div>
            <div class="brand-stat-value" style="font-size: var(--text-3xl); font-weight: 900;">{provider.plans.length}</div>
            <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">Plans Available</div>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} FAQ</h2>
        {faqs.map(faq => (
          <div class="faq-item">
            <button class="faq-question">{faq.question}</button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.answer}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Related Resources -->
      <div class="reveal" style="margin-bottom: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">More {provider.name} Resources</h2>
        <div class="grid grid-3" style="gap: var(--space-md);">
          <a href={`/speed-test/${provider.slug}`} class="card" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">⚡</div>
            <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">{provider.name} Speed Test</h4>
            <p style="font-size: var(--text-sm); color: var(--text-secondary);">Test your current {provider.name} speed and see if you're getting what you pay for →</p>
          </a>
          <a href="/compare" class="card" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">📊</div>
            <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">Compare Providers</h4>
            <p style="font-size: var(--text-sm); color: var(--text-secondary);">See how {provider.name} stacks up against Spectrum, Xfinity, AT&T, and more →</p>
          </a>
          <a href="/best-internet" class="card" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">🏆</div>
            <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">Best Internet Providers</h4>
            <p style="font-size: var(--text-sm); color: var(--text-secondary);">See where {provider.name} ranks among the top providers of {year} →</p>
          </a>
          {getAllProviders().filter(p => p.isPartner && p.id !== provider.id).slice(0, 3).map(p => {
            const [first, second] = [provider, p].sort((x, y) => x.name.localeCompare(y.name));
            return (
              <a href={`/compare/${first.slug}-vs-${second.slug}`} class="card" style="padding: var(--space-lg); text-decoration: none;">
                <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">⚖️</div>
                <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">{provider.name} vs {p.name}</h4>
                <p style="font-size: var(--text-sm); color: var(--text-secondary);">Side-by-side: speed, price, plans, ratings →</p>
              </a>
            );
          })}
          {provider.types.map(t => (
            <a href={`/internet-types/${t}`} class="card" style="padding: var(--space-lg); text-decoration: none;">
              <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">{t === 'fiber' ? 'Fiber' : t === 'cable' ? 'Cable' : t === '5g' ? '5G Home' : t === 'satellite' ? 'Satellite' : t === 'dsl' ? 'DSL' : 'Fixed Wireless'} Internet Guide</h4>
              <p style="font-size: var(--text-sm); color: var(--text-secondary);">How {provider.name}'s {t} technology works, speeds, and what to expect →</p>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <StickyCallBar text={`Get ${provider.name} — exclusive deals available.`} />
</Base>
