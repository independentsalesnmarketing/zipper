  // Astound Broadband — navy blue
  'astound': { primary: '#1B3C7C', light: '#e5eaf3', dark: '#122a58' },
  // Consolidated Communications — blue
  'consolidated-communications': { primary: '#004B8D', light: '#e0eaf4', dark: '#003568' },
  // Lumen — bold red/black brand
  'lumen': { primary: '#CC0000', light: '#fce0e0', dark: '#990000' },
  // Metronet — green
  'metronet': { primary: '#00A651', light: '#e0f5ec', dark: '#007A3D' },
  // Sparklight — blue/teal
  'sparklight': { primary: '#007ABC', light: '#e0f1f9', dark: '#005c8f' },
};
const brand = brandColors[provider.slug] || { primary: '#0052FF', light: '#e6eeff', dark: '#003bba' };
const heroBg = provider.slug === 'brightspeed' ? '#1F1F1F' : brand.primary;

// Technology descriptions
const techDescriptions: Record<string, string> = {
  'fiber': 'fiber-optic infrastructure that transmits data using light pulses through glass strands, delivering the fastest and most reliable residential internet speeds available',
  'cable': 'cable infrastructure using coaxial lines shared with TV service, offering fast download speeds with widespread availability across urban and suburban areas',
  '5g': '5G wireless technology that beams high-speed internet directly to your home without the need for wired infrastructure, perfect for quick setup and areas without cable or fiber',
  'satellite': 'satellite technology that beams internet from orbiting satellites, making it available virtually anywhere including the most rural and remote locations',
  'dsl': 'DSL technology that delivers internet over existing telephone lines, providing reliable service in areas where fiber and cable have not yet reached',
  'fixed-wireless': 'fixed wireless technology that uses radio signals transmitted from towers to a receiver at your home, bridging the gap between wired and mobile internet',
};
const primaryType = provider.types[0] || 'cable';
const techDesc = techDescriptions[primaryType] || 'broadband technology delivering reliable internet service to homes and businesses';

// Determine popular use cases
const speedTier = maxSpeed >= 2000 ? 'ultra-high' : maxSpeed >= 1000 ? 'gigabit' : maxSpeed >= 300 ? 'high' : maxSpeed >= 100 ? 'moderate' : 'basic';
const useCases = {
  'ultra-high': ['4K/8K streaming on 10+ devices', 'professional content creation', 'competitive gaming', 'running a home business', 'smart home with 50+ devices'],
  'gigabit': ['4K streaming on multiple screens', 'working from home with video calls', 'online gaming', 'large file downloads', 'smart home automation'],
  'high': ['HD/4K streaming', 'video conferencing', 'online gaming', 'multiple connected devices', 'social media and browsing'],
  'moderate': ['HD streaming', 'web browsing', 'email and social media', 'casual gaming', 'video calls'],
  'basic': ['web browsing and email', 'social media', 'SD video streaming', 'online shopping', 'light video calls'],
};

const baseFaqs = [
  { question: `Is ${provider.name} available in my area?`, answer: `${provider.name} is available in ${provider.coverage.includes('Nationwide') ? 'all 50 states' : provider.coverage.length + ' states: ' + provider.coverage.join(', ')}. Enter your ZIP code above to check exact availability at your address.` },
  { question: `What is ${provider.name}'s fastest plan?`, answer: `${provider.name}'s fastest plan offers up to ${formatSpeed(maxSpeed)} download speed. Prices start at ${formatPrice(minPrice)}/mo.` },
  { question: `Does ${provider.name} have data caps?`, answer: provider.plans[0]?.dataCap === 'Unlimited' ? `No, ${provider.name} offers unlimited data on all plans — no throttling, no overage fees.` : `${provider.name} plans include data allowances. See plan details above for specific caps.` },
  { question: `Does ${provider.name} require a contract?`, answer: provider.plans[0]?.contract === 'None' ? `No, ${provider.name} does not require annual contracts. You can cancel anytime.` : `Some ${provider.name} plans require a contract. Check plan details above.` },
  { question: `How does ${provider.name} compare to other providers?`, answer: `${provider.name} offers speeds up to ${formatSpeed(maxSpeed)} starting at ${formatPrice(minPrice)}/mo with a ${provider.rating.toFixed(1)}/5 rating from ${provider.reviewCount.toLocaleString()} reviews. Compare plans side-by-side on our comparison page.` },
  { question: `What technology does ${provider.name} use?`, answer: `${provider.name} uses ${provider.types.map(t => getTypeLabel(t)).join(' and ')} technology. ${primaryType === 'fiber' ? 'Fiber provides the fastest, most reliable connection with symmetrical upload/download speeds.' : primaryType === '5g' ? '5G home internet offers fast wireless speeds without requiring a wired connection.' : 'This provides reliable coverage for most internet activities.'}` },
];

const keywordFaqs = keywordClusters.longTail.length
  ? [
      {
        question: `How do I check ${provider.name} availability by address?`,
        answer: `Use our ZIP search to check ${provider.name} service at your exact address in seconds. Availability can vary by neighborhood even within the same city.`,
      },
      {
        question: `What are the best ${provider.name} internet plans for gaming and streaming?`,
        answer: `For gaming and 4K streaming, most homes should target plans in the 300 Mbps to ${formatSpeed(maxSpeed)} range, especially with multiple connected devices.`,
      },
      {
        question: `How much does ${provider.name} internet cost per month?`,
        answer: `${provider.name} plans start around ${formatPrice(minPrice)}/mo and increase with speed tiers, equipment options, and promotional periods.`,
      },
    ]
  : [];

const faqs = [...baseFaqs, ...keywordFaqs];

const providerReviews = [
  {
    author: 'Internet 4 ALL Editorial Team',
    rating: Math.min(5, Math.round(provider.rating)),
    body: `${provider.name} offers ${primaryType === 'fiber' ? 'symmetrical fiber speeds' : primaryType === '5g' ? 'fast 5G home internet' : primaryType === 'satellite' ? 'satellite coverage with wide reach' : 'reliable broadband service'} with plans from ${formatPrice(minPrice)}/mo. Speeds up to ${formatSpeed(maxSpeed)} make it ${speedTier === 'gigabit' || speedTier === 'ultra-high' ? 'an excellent choice for heavy users, gamers, and large households' : speedTier === 'high' ? 'a strong option for streaming and work-from-home setups' : 'suitable for everyday browsing, streaming, and video calls'}.`,
  },
];

const schemas = [
  generateProductSchema({
    ...provider,
    additionalProperties: [
      { name: 'Connection Type', value: provider.types.map(t => getTypeLabel(t)).join(', ') },
      { name: 'Max Download Speed', value: formatSpeed(maxSpeed) },
      { name: 'Max Upload Speed', value: formatSpeed(maxUpload) },
      { name: 'Starting Price', value: `${formatPrice(minPrice)}/mo` },
      { name: 'Coverage Area', value: provider.coverage.slice(0, 5).join(', ') },
    ],
    reviews: providerReviews,
  }),
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet-4-all.com' },
    { name: 'Providers', url: 'https://internet-4-all.com/providers' },
    { name: provider.name, url: `https://internet-4-all.com/provider/${provider.slug}` },
  ]),
  generateFAQSchema(faqs),
  generateSpeakableSchema(['.provider-hero h1', '.faq-answer-inner'], `https://internet-4-all.com/provider/${provider.slug}`),
  generateFactCheckSchema({
    url: `https://internet-4-all.com/provider/${provider.slug}`,
    claim: `${provider.name} internet offers speeds up to ${formatSpeed(maxSpeed)} with plans starting at ${formatPrice(minPrice)}/mo`,
    ratingValue: 5,
    bestRating: 5,
  }),
];
---
<Base
  title={`${provider.name} Internet Plans & Pricing (${year})`}
  description={`${provider.name} internet: speeds up to ${formatSpeed(maxSpeed)}, plans from ${formatPrice(minPrice)}/mo. Compare ${primarySeoPhrase}, read reviews, check availability at your address, and sign up for the best deal.`}
  schema={schemas}
>
  <style define:vars={{ brandPrimary: brand.primary, brandLight: brand.light, brandDark: brand.dark, brandHero: heroBg }}>
    /* Immersive brand hero */
    .provider-hero {
      border-top: none !important;
      background: var(--brandHero) !important;
      color: white !important;
      border-color: transparent !important;
    }
    .provider-hero h1 { color: white !important; }
    .provider-hero .tag {
      background: rgba(255,255,255,0.18) !important;
      color: white !important;
      border: 1px solid rgba(255,255,255,0.25) !important;
    }
    .provider-hero .rating .star-filled,
    .provider-hero .star-filled { color: #ffd700 !important; }
    .provider-hero .rating .star-empty,
    .provider-hero .star-empty { color: rgba(255,255,255,0.3) !important; }
