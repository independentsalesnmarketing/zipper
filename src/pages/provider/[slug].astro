---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import CoverageMap from '@components/CoverageMap.astro';
import { existsSync, readFileSync } from 'node:fs';
import { getAllProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, getTypeColor, renderStars, stateNames } from '@lib/providers';
import { getCityPages, getStateSlug } from '@data/locations';
import { generateProductSchema, generateBreadcrumbSchema, generateFAQSchema, generateSpeakableSchema, generateFactCheckSchema } from '@lib/utils';
import type { Provider } from '@lib/providers';

export function getStaticPaths() {
  const providers = getAllProviders();
  return providers.map(p => ({
    params: { slug: p.slug },
    props: { provider: p },
  }));
}

interface Props { provider: Provider; }
const { provider } = Astro.props;

const minPrice = getMinPrice(provider);
const maxSpeed = getMaxSpeed(provider);
const maxUpload = getMaxUpload(provider);
const year = new Date().getFullYear();

const keywordFileBySlug: Record<string, string> = {
