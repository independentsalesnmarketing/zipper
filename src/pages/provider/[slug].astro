          <a href={`/speed-test/${provider.slug}`} class="card" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">⚡</div>
            <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">{provider.name} Speed Test</h4>
            <p style="font-size: var(--text-sm); color: var(--text-secondary);">Test your current {provider.name} speed and see if you're getting what you pay for →</p>
          </a>
          <a href="/compare" class="card" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">📊</div>
            <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">Compare Providers</h4>
            <p style="font-size: var(--text-sm); color: var(--text-secondary);">See how {provider.name} stacks up against Spectrum, Xfinity, AT&T, and more →</p>
          </a>
          <a href="/best-internet" class="card" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">🏆</div>
            <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">Best Internet Providers</h4>
            <p style="font-size: var(--text-sm); color: var(--text-secondary);">See where {provider.name} ranks among the top providers of {year} →</p>
          </a>
          {getAllProviders().filter(p => p.isPartner && p.id !== provider.id).slice(0, 3).map(p => {
            const [first, second] = [provider, p].sort((x, y) => x.name.localeCompare(y.name));
            return (
              <a href={`/compare/${first.slug}-vs-${second.slug}`} class="card" style="padding: var(--space-lg); text-decoration: none;">
                <div style="font-size: 1.5rem; margin-bottom: var(--space-xs);">⚖️</div>
                <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">{provider.name} vs {p.name}</h4>
                <p style="font-size: var(--text-sm); color: var(--text-secondary);">Side-by-side: speed, price, plans, ratings →</p>
              </a>
            );
          })}
          {provider.types.map(t => (
            <a href={`/internet-types/${t}`} class="card" style="padding: var(--space-lg); text-decoration: none;">
              <h4 style="color: var(--text-primary); margin-bottom: var(--space-xs);">{t === 'fiber' ? 'Fiber' : t === 'cable' ? 'Cable' : t === '5g' ? '5G Home' : t === 'satellite' ? 'Satellite' : t === 'dsl' ? 'DSL' : 'Fixed Wireless'} Internet Guide</h4>
              <p style="font-size: var(--text-sm); color: var(--text-secondary);">How {provider.name}'s {t} technology works, speeds, and what to expect →</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Last Reviewed -->
      <p style="font-size: var(--text-xs); color: var(--text-tertiary); margin-bottom: var(--space-2xl);">
        <strong>Last reviewed by our editorial team:</strong> {new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}. Provider pricing, speed, and availability data verified against official {provider.name} sources.
      </p>

    </div>
  </section>

  <StickyCallBar text={`Get ${provider.name} — exclusive deals available.`} />
</Base>
