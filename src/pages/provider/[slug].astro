  'att-air': ['at&t', 'att', 'internet air'],
  earthlink: ['earthlink'],
  optimum: ['optimum', 'altice'],
  'tmobile-fiber': ['t mobile', 'tmobile'],
  verizon: ['verizon', '5g home internet', 'verizon 5g', 'verizon home internet'],
  xfinity: ['xfinity', 'comcast', 'xfi'],
  cox: ['cox', 'cox communications'],
  starlink: ['starlink', 'spacex'],
  'google-fiber': ['google fiber'],
  mediacom: ['mediacom'],
  wow: ['wow', 'wideopenwest'],
  fidium: ['fidium', 'consolidated communications'],
  ziply: ['ziply'],
  hughesnet: ['hughesnet', 'hughes net'],
  viasat: ['viasat', 'exede'],
  'tmobile-5g': ['tmobile home internet', 't mobile home internet', '5g home internet'],
  uscellular: ['uscellular', 'us cellular'],
  geolinks: ['geolinks'],
  astound: ['astound', 'wave broadband', 'rcn', 'grande communications', 'entouch'],
  'consolidated-communications': ['consolidated communications', 'consolidated', 'fidium', 'consolidated telephone'],
  lumen: ['lumen', 'centurylink', 'century link', 'quantum fiber'],
  metronet: ['metronet'],
  sparklight: ['sparklight', 'cable one', 'cableone'],
};

function getProviderKeywordClusters(slug: string, providerName: string) {
  const keywordFile = keywordFileBySlug[slug];
  if (!keywordFile) {
    return { shortTail: [] as string[], longTail: [] as string[] };
  }

  const keywordPath = new URL(`../../../${keywordFile}`, import.meta.url);
  if (!existsSync(keywordPath)) {
    return { shortTail: [] as string[], longTail: [] as string[] };
  }

  const includeIntent = /\b(internet|fiber|broadband|wifi|isp|availability|speed|plans?|pricing|price|deals?|address|zip|gig|mbps|streaming|gaming|upload|download|latency|modem|router|no contract|business internet)\b/i;
  const excludeNoise = /\b(customer service|support|phone number|phone service|tv|television|mobile phones?|cell phone|iphone|android|store|career|jobs?|login|pay bill|prepaid|retailers?)\b/i;
  const brandTokens = (brandTokensBySlug[slug] || [providerName.toLowerCase()]).map(t => t.toLowerCase());

  const lines = readFileSync(keywordPath, 'utf-8').split('\n').slice(1).filter(Boolean);
  const terms = lines
    .map((line) => (line.split('\t')[0] || '').trim().toLowerCase())
    .filter((term) => term && includeIntent.test(term) && !excludeNoise.test(term))
    .filter((term) => brandTokens.some(token => term.includes(token)));

  const deduped = Array.from(new Set(terms));
  const shortTail = deduped
    .filter(t => t.split(/\s+/).length <= 3)
    .slice(0, 8);
  const longTail = deduped
    .filter(t => t.split(/\s+/).length >= 4)
    .sort((a, b) => b.split(/\s+/).length - a.split(/\s+/).length)
    .slice(0, 14);

  return { shortTail, longTail };
}

const keywordClusters = getProviderKeywordClusters(provider.slug, provider.name);
const primarySeoPhrase = keywordClusters.longTail[0] || `${provider.name.toLowerCase()} internet plans by address`;

const _kw = [...keywordClusters.shortTail, ...keywordClusters.longTail];

const tileSlugByProvider: Record<string, string> = {
  'att-fiber':    'att',
  'frontier':     'frontier',
  'optimum':      'optimum',
  'kinetic':      'windstream',
  'altafiber':    'cincinnati-bell',
  'spectrum':     'charter',
  'xfinity':      'xfinity',
  'cox':          'cox-cable',
  'google-fiber': 'google-fiber',
  'mediacom':     'mediacom',
  'wow':          'wow',
  'astound':      'rcn',
  'lumen':        'centurylink',
};
const providerTileSlug = tileSlugByProvider[provider.slug] ?? null;
const hasMap = !!providerTileSlug;
const kwHasAvailability = _kw.some(t => /availab|zip|address|area|map/i.test(t));
const kwHasDeals       = _kw.some(t => /deal|new customer|pricing|promo/i.test(t));
const kwHasGaming      = _kw.some(t => /gaming|streaming|latency/i.test(t));
const kwHasNoContract  = _kw.some(t => /no.?contract/i.test(t));
const kwHasEquipment   = _kw.some(t => /modem|router/i.test(t));
const kwHasGig         = _kw.some(t => /\bgig\b|\d+\s*gig/i.test(t));
const kwShowSection    = kwHasAvailability || kwHasDeals || kwHasGaming || _kw.length > 0;

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function parseTopCitiesFromResearch(md: string, providerHeading: string): string[] {
  const headingRe = new RegExp(`^###\\s+${escapeRegExp(providerHeading)}\\s*$`, 'm');
  const headingMatch = md.match(headingRe);
  if (!headingMatch || headingMatch.index === undefined) return [];

  const sectionStart = headingMatch.index;
  const remaining = md.slice(sectionStart + headingMatch[0].length);
  const nextHeadingIdx = remaining.search(/^###\s+/m);
  const section = nextHeadingIdx === -1 ? remaining : remaining.slice(0, nextHeadingIdx);

  const topCitiesLabelRe = /\*\*Top\s+\d+\s+Serviceable\s+Cities:\*\*/m;
  const topCitiesLabelMatch = section.match(topCitiesLabelRe);
  if (!topCitiesLabelMatch || topCitiesLabelMatch.index === undefined) return [];

  const afterLabel = section.slice(topCitiesLabelMatch.index + topCitiesLabelMatch[0].length).trimStart();
  const firstLine = (afterLabel.split('\n')[0] || '').trim();
  if (!firstLine) return [];

  return firstLine
    .replace(/\.$/, '')
    .split(';')
    .map(c => c.trim())
    .filter(Boolean);
}

const researchHeadingBySlug: Record<string, string> = {
  'spectrum': 'Spectrum (Charter Communications)',
  'xfinity': 'Xfinity (Comcast)',
  'cox': 'Cox Communications',
  'optimum': 'Optimum (Altice)',
  'wow': 'WOW! (WideOpenWest)',
  'mediacom': 'Mediacom',
  'att-fiber': 'AT&T Fiber',
  'verizon': 'Verizon 5G Home Internet',
  'frontier': 'Frontier Fiber',
  'google-fiber': 'Google Fiber (GFiber)',
  'ziply': 'Ziply Fiber',
  'fidium': 'Fidium Fiber',
  'altafiber': 'altafiber',
  'brightspeed': 'Brightspeed',
  'tmobile-5g': 'T-Mobile 5G Home Internet',
  'att-air': 'AT&T Internet Air',
  'starlink': 'Starlink (SpaceX)',
  'viasat': 'Viasat',
  'hughesnet': 'HughesNet',
  'geolinks': 'GeoLinks',
  'uscellular': 'U.S. Cellular',
  'tmobile-fiber': 'T-Mobile Fiber',
  'kinetic': 'Kinetic by Windstream',
  'earthlink': 'EarthLink',
  'astound': 'Astound Broadband',
  'consolidated-communications': 'Consolidated Communications',
  'lumen': 'Lumen (CenturyLink)',
  'metronet': 'Metronet',
  'sparklight': 'Sparklight (Cable One)',
};

const researchMd = readFileSync(new URL('../../../ISP_info_March_2026.md', import.meta.url), 'utf-8');
const researchHeading = researchHeadingBySlug[provider.slug];
const topCities = researchHeading ? parseTopCitiesFromResearch(researchMd, researchHeading).slice(0, 50) : [];

function normalizeCityName(value: string): string {
  return value
    .toLowerCase()
    .replace(/\./g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function cityNameCandidates(name: string): string[] {
  const base = name.trim();
  return [
    base,
    base.replace(/\bSt\b/gi, 'Saint'),
    base.replace(/\bSt\.?\b/gi, 'Saint'),
    base.replace(/\bSaint\b/gi, 'St'),
    base.replace(/\bFt\.?\b/gi, 'Fort'),
    base.replace(/\bFort\b/gi, 'Ft'),
    base.replace(/\bMt\.?\b/gi, 'Mount'),
    base.replace(/\bMount\b/gi, 'Mt'),
  ];
}

const citySlugByKey = new Map<string, string>();
for (const city of getCityPages()) {
  citySlugByKey.set(`${normalizeCityName(city.name)}|${city.state}`, city.slug);
}

const topCityLinks = topCities.map((entry) => {
  const label = entry.trim();
  const cleaned = label.replace(/\s*\([^)]*\)\s*/g, ' ').replace(/\s+/g, ' ').trim();
  const match = cleaned.match(/^(.+?),\s*([A-Z]{2})$/);

  if (!match) return { label, href: '/providers' };

  const cityName = match[1].trim();
  const stateAbbr = match[2].trim();

  let citySlug: string | undefined;
  for (const candidate of cityNameCandidates(cityName)) {
    const key = `${normalizeCityName(candidate)}|${stateAbbr}`;
    citySlug = citySlugByKey.get(key);
    if (citySlug) break;
  }

  if (citySlug) {
    return { label, href: `/internet-providers/${citySlug}` };
  }

  const stateHref = stateNames[stateAbbr] ? `/internet-providers/${getStateSlug(stateAbbr)}` : '/providers';
  return { label, href: stateHref };
});

// Brand colors for each provider
const brandColors: Record<string, { primary: string; light: string; dark: string }> = {
  'spectrum': { primary: '#0052FF', light: '#e6eeff', dark: '#003bba' },
  'verizon': { primary: '#CD040B', light: '#fce8e9', dark: '#9b0308' },
  'att-fiber': { primary: '#009FDB', light: '#e0f4fc', dark: '#007bad' },
  'frontier': { primary: '#FF0037', light: '#ffe6ec', dark: '#cc002c' },
  'att-air': { primary: '#009FDB', light: '#e0f4fc', dark: '#007bad' },
  'tmobile-fiber': { primary: '#E20074', light: '#fde0ef', dark: '#b5005c' },
  // Kinetic by Windstream — purple + teal direction
  'kinetic': { primary: '#6A3FB0', light: '#efe9fb', dark: '#0A8E9A' },
  // Optimum brand palette
