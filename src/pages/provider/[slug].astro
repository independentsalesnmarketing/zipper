  optimum: 'OptimumKeywords.txt',
  'tmobile-fiber': 'T-FiberKeywords.txt',
  verizon: 'Verizon5GKeywords.txt',
  xfinity: 'XfinityKeywords.txt',
  cox: 'CoxKeywords.txt',
  starlink: 'StarlinkKeywords.txt',
  'google-fiber': 'GoogleFiberKeywords.txt',
