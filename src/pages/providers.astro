---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SearchBar from '@components/SearchBar.astro';
import ProviderCard from '@components/ProviderCard.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed } from '@lib/providers';
import { generateBreadcrumbSchema, generateItemListSchema, generateFAQSchema } from '@lib/utils';

const allProviders = getAllProviders().sort((a, b) => {
  // Providers with logos first, then partners first, then by rating
  if (a.logo && !b.logo) return -1;
  if (!a.logo && b.logo) return 1;
  if (a.isPartner && !b.isPartner) return -1;
  if (!a.isPartner && b.isPartner) return 1;
  return b.rating - a.rating;
});
const breadcrumbs = [{ name: 'Providers', url: '/providers' }];

const year = new Date().getFullYear();
const month = new Date().toLocaleString('en-US', { month: 'long' });
const partners = allProviders.filter(p => p.isPartner);
const fiberProviders = allProviders.filter(p => p.types.includes('fiber'));
const lowestPrice = Math.min(...allProviders.map(p => getMinPrice(p)));
const fastestSpeed = Math.max(...allProviders.map(p => getMaxSpeed(p)));
const totalStates = [...new Set(allProviders.flatMap(p => p.coverage))].length;

const faqs = [
  { question: 'How do I find internet providers at my address?', answer: 'Enter your 5-digit ZIP code in the search bar above. We check real-time FCC broadband data to show you every provider available at your exact location — including speeds, prices, and plan details.' },
  { question: 'What types of internet are available?', answer: 'The main types are: Fiber (fastest, lowest latency, best for gaming/streaming), Cable (widely available, fast downloads), 5G Home Internet (wireless, no installation), DSL (available over phone lines), and Satellite (available everywhere, including rural). Use the filter buttons above to narrow by type.' },
  { question: `What is the cheapest internet plan in ${year}?`, answer: `The most affordable plans start as low as $${lowestPrice.toFixed(2)}/mo. Budget-friendly options include Metronet Fiber 100 ($24.95/mo), Kinetic Fiber 100 ($24.99/mo), and Optimum Fiber 300 ($25/mo). Low-income households may qualify for even cheaper plans through provider discount programs.` },
  { question: `What is the fastest internet available in ${year}?`, answer: `The fastest residential internet reaches up to ${formatSpeed(fastestSpeed)}. Providers like Optimum (8 Gig), AT&T Fiber (5 Gig), and Frontier (7 Gig) lead in raw speed. However, most households only need 100–300 Mbps. Fiber provides the most consistent real-world speeds.` },
  { question: 'How many internet providers does the average American have access to?', answer: 'The FCC reports the average US address has access to 3–5 broadband providers. Urban areas typically have more options (5–8+), while rural areas may only have 1–2. Entering your ZIP above gives you the exact count for your location.' },
  { question: 'Should I choose fiber or cable internet?', answer: 'Fiber is better in almost every way: symmetrical speeds, lower latency, no data caps, and no slowdowns during peak hours. The only downside is availability — fiber covers roughly 43% of US addresses. If fiber is available at your address, it\'s almost always the best choice. Cable is an excellent runner-up with wide availability.' },
  { question: 'What internet speed do I need?', answer: '1–2 people, basic browsing: 25–50 Mbps. Small family, streaming + work from home: 100–200 Mbps. Large family, gaming + 4K streaming: 300–500 Mbps. Power users, content creators: 500–1000 Mbps. Most households are well-served by 100–300 Mbps.' },
  { question: 'Are there internet plans with no contract?', answer: `Yes — the majority of providers now offer no-contract plans. All ${partners.length} of our recommended partners offer month-to-month options with no early termination fees. Spectrum, Frontier, AT&T Fiber, and Optimum are all fully contract-free.` },
];

// Pass serializable provider data to client script for API matching
const providerDataForClient = allProviders.map(p => ({
  id: p.id, name: p.name, slug: p.slug, types: p.types, rating: p.rating,
  reviewCount: p.reviewCount, isPartner: p.isPartner, phone: p.phone,
  logo: p.logo, coverage: p.coverage,
  maxSpeed: getMaxSpeed(p), minPrice: getMinPrice(p),
  plans: p.plans.map(pl => ({ speed: pl.speed, uploadSpeed: pl.uploadSpeed, price: pl.price, promoPrice: pl.promoPrice })),
}));

// State → provider mapping for local fallback
import { stateProviders } from '@lib/providers';
const stateProvidersForClient = stateProviders;

// ZIP3 prefix → state mapping for local fallback
