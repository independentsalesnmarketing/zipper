<script define:vars={{ providerDataForClient, stateProvidersForClient, zip3ToState }}>
  // ========================================
  // BroadbandMap API Integration (ported)
  // ========================================

  const NAME_MAP = {
    'charter': 'spectrum', 'charter communications': 'spectrum', 'charter communications inc': 'spectrum', 'spectrum': 'spectrum',
    'at&t': 'att', 'att': 'att', 'at&t inc': 'att', 'at&t services': 'att', 'at&t corp': 'att', 'bellsouth': 'att', 'at&t internet': 'att', 'at&t fiber': 'att',
