    't-mobile fiber': 'tmobile', 'metronet': 'metronet', 'metronet holdings': 'metronet', 'metronet inc': 'metronet', 'metronet communications': 'metronet',
    't-mobile': 'tmobile-5g', 'tmobile': 'tmobile-5g', 't-mobile usa': 'tmobile-5g', 't-mobile us': 'tmobile-5g', 't-mobile home internet': 'tmobile-5g', 't-mobile 5g home internet': 'tmobile-5g',
    'verizon': 'verizon', 'verizon communications': 'verizon', 'verizon fios': 'verizon', 'verizon business': 'verizon', 'mci': 'verizon',
    'windstream': 'kinetic', 'windstream holdings': 'kinetic', 'windstream communications': 'kinetic', 'kinetic': 'kinetic', 'kinetic by windstream': 'kinetic',
    'altice': 'optimum', 'altice usa': 'optimum', 'optimum': 'optimum', 'optimum by altice': 'optimum', 'cablevision': 'optimum', 'suddenlink': 'optimum', 'suddenlink communications': 'optimum',
    'frontier': 'frontier', 'frontier communications': 'frontier', 'frontier communications corp': 'frontier',
    'earthlink': 'earthlink', 'earthlink inc': 'earthlink', 'earthlink llc': 'earthlink',
    'brightspeed': 'brightspeed', 'lumen': 'lumen', 'lumen technologies': 'lumen', 'centurylink': 'lumen', 'centurytel': 'lumen',
    'altafiber': 'altafiber', 'alta fiber': 'altafiber', 'cincinnati bell': 'altafiber', 'cincinnati bell inc': 'altafiber', 'hawaiian telcom': 'altafiber',
    'xfinity': 'xfinity', 'comcast': 'xfinity', 'comcast cable': 'xfinity', 'comcast communications': 'xfinity', 'xfinity internet': 'xfinity',
    'starlink': 'starlink', 'starlink services': 'starlink', 'spacex': 'starlink', 'space exploration technologies': 'starlink',
    'viasat': 'viasat', 'viasat inc': 'viasat', 'exede': 'viasat',
    'hughesnet': 'hughesnet', 'hughes network systems': 'hughesnet', 'hughes': 'hughesnet',
    'ziply': 'ziply', 'ziply fiber': 'ziply',
    'cox': 'cox', 'cox communications': 'cox', 'cox cable': 'cox',
    'minternet': 'mintmobile', 'mint mobile': 'mintmobile', 'mint': 'mintmobile',
  };

  const localProviders = providerDataForClient;

  function fetchWithTimeout(url, timeout) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);
    return fetch(url, { signal: controller.signal }).then(r => { clearTimeout(timer); return r; }).catch(e => { clearTimeout(timer); throw e; });
  }

  async function geocodeZip(zip) {
    try {
      const resp = await fetchWithTimeout(`https://api.zippopotam.us/us/${zip}`, 6000);
      if (resp.ok) {
        const data = await resp.json();
        if (data.places && data.places.length > 0) {
          return { lat: parseFloat(data.places[0].latitude), lng: parseFloat(data.places[0].longitude), city: data.places[0]['place name'] || 'Your Area', state: data.places[0]['state abbreviation'] || '' };
        }
      }
    } catch (e) { console.warn('[Geo] zippopotam failed:', e.message); }
    try {
      const resp = await fetchWithTimeout(`https://nominatim.openstreetmap.org/search?postalcode=${zip}&country=US&format=json&limit=1`, 8000);
      if (resp.ok) {
        const data = await resp.json();
        if (data && data.length > 0) {
          const parts = (data[0].display_name || '').split(',').map(s => s.trim());
          return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon), city: parts[0] || 'Your Area', state: parts.length >= 2 ? parts[parts.length - 2] : '' };
        }
      }
    } catch (e) { console.warn('[Geo] Nominatim failed:', e.message); }
    return null;
  }

  function mapTechnology(tech) {
    if (!tech) return null;
    const t = tech.toLowerCase();
    if (t.includes('fiber') || t === 'fttp' || t === 'ftth' || t === 'fttb') return 'fiber';
    if (t.includes('cable') || t.includes('docsis') || t === 'hfc' || t.includes('coax')) return 'cable';
    if (t.includes('dsl') || t.includes('adsl') || t.includes('vdsl') || t.includes('copper')) return 'dsl';
    if (t.includes('5g') || t.includes('nr') || t.includes('fixed wireless') || t.includes('fixed_wireless') || t.includes('mmwave')) return '5g';
    if (t.includes('satellite')) return 'satellite';
    if (t.includes('wireless') || t.includes('lte') || t.includes('4g') || t.includes('cellular')) return '5g';
    return null;
  }

  function normalizeApiResponse(data) {
    const records = Array.isArray(data) ? data : (data?.results || data?.data || data?.providers || []);
    const byProvider = new Map();
    records.forEach(rec => {
      const name = rec.provider || rec.provider_name || rec.name || rec.brand_name || '';
      if (!name) return;
      const key = name.toLowerCase().trim();
      if (!byProvider.has(key)) byProvider.set(key, { rawName: name, technologies: [], maxDownload: 0, maxUpload: 0 });
      const entry = byProvider.get(key);
      const tech = (rec.technology || rec.tech || rec.technology_type || '').toLowerCase();
      const mapped = mapTechnology(tech);
      if (mapped && !entry.technologies.includes(mapped)) entry.technologies.push(mapped);
      const dl = parseFloat(rec.max_download_mbps || rec.max_download_speed || rec.max_download || rec.download_speed || rec.max_advertised_download_speed || 0) || 0;
      const ul = parseFloat(rec.max_upload_mbps || rec.max_upload_speed || rec.max_upload || rec.upload_speed || rec.max_advertised_upload_speed || 0) || 0;
      if (dl > entry.maxDownload) entry.maxDownload = dl;
      if (ul > entry.maxUpload) entry.maxUpload = ul;
    });
    return Array.from(byProvider.values()).map(e => ({
      rawName: e.rawName, types: e.technologies.length > 0 ? e.technologies : ['cable'], maxSpeed: e.maxDownload, maxUpload: e.maxUpload
    }));
  }

  function matchProviderName(rawName) {
    if (!rawName) return null;
    const lower = rawName.toLowerCase().trim();
    if (NAME_MAP[lower]) return NAME_MAP[lower];
    for (const [key, id] of Object.entries(NAME_MAP)) {
      if (lower.includes(key) || key.includes(lower)) return id;
    }
    const match = localProviders.find(p => lower.includes(p.id) || lower.includes(p.name.toLowerCase()) || p.name.toLowerCase().includes(lower));
    return match ? match.id : null;
  }

  function enrichAndRank(apiProviders) {
    const matchedIds = new Set();
    const enriched = [];

    // First pass: match API providers to local database
    apiProviders.forEach(apiP => {
      const id = matchProviderName(apiP.rawName);
      const local = id ? localProviders.find(p => p.id === id) : null;
      if (local) {
        matchedIds.add(local.id);
        enriched.push({
          ...local,
          apiConfirmed: true,
          // Use API-confirmed types — this is what's actually available at this address
          apiTypes: apiP.types,
          // Use API speed as the truth for this location (don't inflate with national max)
          maxSpeed: apiP.maxSpeed || local.maxSpeed || 0,
          apiSpeed: apiP.maxSpeed
        });
      } else {
        // Non-partner provider from the API — include them for honest results
        enriched.push({
          id: apiP.rawName.toLowerCase().replace(/[^a-z0-9]/g, '-'),
          name: apiP.rawName,
          types: apiP.types,
          maxSpeed: apiP.maxSpeed || 0,
          minPrice: 0,
          rating: null,
          isPartner: false,
          apiConfirmed: true,
          apiTypes: apiP.types,
          apiSpeed: apiP.maxSpeed,
          slug: null,
          phone: null,
          logo: null,
          plans: [],
        });
      }
    });

    // DO NOT add nationwide providers that the API didn’t confirm.
    // The API already returns what’s really available at this location.
    // Adding unconfirmed nationwide providers is what made results look the same everywhere.

    // Score and sort: HARD PARTITION — partners ALWAYS before non-partners
    enriched.sort((a, b) => {
      // Hard partition: partners always first, period
      if (a.isPartner && !b.isPartner) return -1;
      if (!a.isPartner && b.isPartner) return 1;

      // Within the same tier (both partner or both non-partner), use scoring
      let sa = 0, sb = 0;
      // API-confirmed gets a boost
      if (a.apiConfirmed) sa += 15; if (b.apiConfirmed) sb += 15;
      // Technology scoring — use API-confirmed types
      var aTypes = a.apiTypes || a.types;
      var bTypes = b.apiTypes || b.types;
      if (aTypes.includes('fiber')) sa += 15; if (bTypes.includes('fiber')) sb += 15;
      if (aTypes.includes('5g')) sa += 10; if (bTypes.includes('5g')) sb += 10;
      if (aTypes.includes('cable')) sa += 8; if (bTypes.includes('cable')) sb += 8;
      // Speed scoring — use API speeds (the truth for this location)
      const aSpeed = a.apiSpeed || a.maxSpeed || 0;
      const bSpeed = b.apiSpeed || b.maxSpeed || 0;
      sa += Math.min(14, Math.floor(aSpeed / 200)); sb += Math.min(14, Math.floor(bSpeed / 200));
      // Rating
      if (a.rating) sa += Math.floor(a.rating * 2); if (b.rating) sb += Math.floor(b.rating * 2);
      return sb - sa;
    });

    return enriched;
  }

  // ========================================
  // DOM Interaction
  // ========================================

  const providerList = document.getElementById('provider-list');
  const providerListContainer = document.getElementById('provider-list-container');
  const locationBanner = document.getElementById('location-banner');
  const locationCity = document.getElementById('location-city');
  const locationCount = document.getElementById('location-count');
  const loadingState = document.getElementById('loading-state');
  const noResults = document.getElementById('no-results');
  const showAllBtn = document.getElementById('show-all-btn');
  const scrollBtn = document.getElementById('scroll-to-results');
  const allItems = document.querySelectorAll('.provider-item');

  function showLoading() {
    if (loadingState) loadingState.style.display = '';
    if (providerListContainer) providerListContainer.style.display = 'none';
    if (scrollBtn) scrollBtn.style.display = 'flex';
  }

  function hideLoading() {
    if (loadingState) loadingState.style.display = 'none';
    if (providerListContainer) providerListContainer.style.display = '';
    if (scrollBtn) scrollBtn.style.display = 'none';
    // Auto-scroll to results
    setTimeout(() => {
      if (locationBanner && locationBanner.style.display !== 'none') {
        locationBanner.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (providerListContainer) {
        providerListContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }, 300);
  }

  function showAllProviders() {
    allItems.forEach(function(el) { el.style.display = ''; });
    if (noResults) noResults.style.display = 'none';
    if (locationBanner) locationBanner.style.display = 'none';
  }

  function filterByIds(matchedIds) {
    var visibleCount = 0;
    allItems.forEach(function(el) {
      var id = el.getAttribute('data-provider-id');
      var show = matchedIds.indexOf(id) !== -1;
      el.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    return visibleCount;
  }

  // Local fallback: derive provider IDs from ZIP using state mapping
  function getLocalProviderIds(zip) {
    var prefix = zip.substring(0, 3);
    var state = zip3ToState[prefix];
    if (!state) return [];
    var ids = stateProvidersForClient[state];
    if (!ids || ids.length === 0) return [];
    // Filter to only IDs that exist in our local provider database
    return ids.filter(function(id) {
      return localProviders.some(function(p) { return p.id === id; });
    });
  }

  // Track which provider IDs are currently matched by search (null = no search active)
  var _currentMatchedIds = null;
  var _mapInstance = null;
  var _currentGeo = null;

  // Initialize or update map
  function initializeMap(lat, lng, city, zip) {
    const mapContainer = document.getElementById('map-container');
    const mapEl = document.getElementById('map');

    if (!mapContainer || !mapEl) return;

    // Show map container
    mapContainer.style.display = '';

    // Load Leaflet if not already loaded
    if (!window.L) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
      document.head.appendChild(link);

      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
      script.onload = () => {
        createMap(lat, lng, city, zip);
      };
      document.head.appendChild(script);
    } else {
      createMap(lat, lng, city, zip);
    }
  }

  function createMap(lat, lng, city, zip) {
    const mapEl = document.getElementById('map');
    if (!mapEl) return;

    // Clear existing map
    if (_mapInstance) {
      _mapInstance.remove();
    }

    // Create new map
    _mapInstance = window.L.map('map').setView([lat, lng], 11);

    // Add tile layer
    window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(_mapInstance);

    // Add marker for location with ZIP code badge
    const marker = window.L.marker([lat, lng], {
      title: city,
      icon: window.L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
      })
    }).addTo(_mapInstance).bindPopup(`<div style="text-align:center;"><div style="background:#0052ff;color:white;padding:8px 16px;border-radius:8px;font-weight:700;font-size:16px;margin-bottom:8px;">${zip}</div><strong>${city}</strong><br>Service area</div>`);

    // Open popup by default
    marker.openPopup();

    // Display ZIP code in the badge
    const zipBadge = document.getElementById('map-zip-badge');
    const zipDisplay = document.getElementById('map-zip-display');
    if (zipBadge && zipDisplay) {
      zipDisplay.textContent = zip;
      zipBadge.style.display = '';
    }
  }

  async function searchByZip(zip) {
    showLoading();

    try {
      const geo = await geocodeZip(zip);
      if (!geo || geo.lat === null) {
        hideLoading();
        var localIds = getLocalProviderIds(zip);
        if (localIds.length > 0) {
          _currentMatchedIds = localIds;
          var cnt = filterByIds(localIds);
          if (locationBanner) locationBanner.style.display = '';
          if (locationCount) locationCount.textContent = cnt + ' provider' + (cnt !== 1 ? 's' : '') + ' found at ZIP ' + zip;
        } else {
          showAllProviders();
        }
        return;
      }

      // Store geolocation data for map
      _currentGeo = geo;

      // Initialize map
      initializeMap(geo.lat, geo.lng, `${geo.city}, ${geo.state}`, zip);

      // Show location banner
      if (locationBanner && locationCity && locationCount) {
        locationCity.textContent = `${geo.city}, ${geo.state}`;
        locationBanner.style.display = '';
      }

      // Call BroadbandMap API
      let apiProviders = [];
      try {
        const resp = await fetchWithTimeout(`https://broadbandmap.com/api/v1/location/internet?lat=${geo.lat}&lng=${geo.lng}`, 10000);
        if (resp.ok) {
          const data = await resp.json();
          apiProviders = normalizeApiResponse(data);
        }
      } catch (e) {
        console.warn('[API] BroadbandMap failed:', e.message);
      }

      if (apiProviders.length > 0) {
        const ranked = enrichAndRank(apiProviders);
        // Separate providers that exist in DOM vs API-only providers
        const knownIds = ranked.filter(p => p.slug || localProviders.find(lp => lp.id === p.id)).map(p => p.id);
        const apiOnlyProviders = ranked.filter(p => !p.slug && !localProviders.find(lp => lp.id === p.id));

        hideLoading();
        _currentMatchedIds = knownIds;
        const count = filterByIds(knownIds);

        // Update each card's displayed speed and types to match API data
        var typeLabelsMap = { fiber:'Fiber', cable:'Cable', '5g':'5G', dsl:'DSL', satellite:'Satellite' };
        ranked.forEach(p => {
          if (!p.apiTypes || !p.id) return;
          var el = providerList.querySelector('[data-provider-id="' + p.id + '"]');
          if (!el) return;

          // Update displayed speed to use API speed
          var apiSpd = p.apiSpeed || 0;
          if (apiSpd > 0) {
            var speedEl = el.querySelector('.pc-speed');
            if (speedEl) {
              if (apiSpd >= 1000) {
                speedEl.innerHTML = (apiSpd / 1000).toFixed(apiSpd % 1000 === 0 ? 0 : 1) + '<span class="pc-speed-unit">Gbps</span>';
              } else {
                speedEl.innerHTML = apiSpd + '<span class="pc-speed-unit">Mbps</span>';
              }
            }
            // Update data attribute for sorting
            el.setAttribute('data-speed', String(apiSpd));
          }

          // Update displayed technology tags to match API-confirmed types
          var tagsEl = el.querySelector('.pc-tags');
          if (tagsEl && p.apiTypes.length > 0) {
            tagsEl.innerHTML = p.apiTypes.map(function(t) {
              return '<span class="tag tag-' + t + '">' + (typeLabelsMap[t] || t) + '</span>';
            }).join('');
            el.setAttribute('data-types', p.apiTypes.join(','));
          }
        });

        // Re-order DOM to match ranking — partners ALWAYS first
        if (providerList) {
          knownIds.forEach(id => {
            const el = providerList.querySelector(`[data-provider-id="${id}"]`);
            if (el) providerList.appendChild(el);
          });
        }

        // Inject API-only providers (not in our database) AFTER all known providers
        if (apiOnlyProviders.length > 0 && providerList) {
          var typeLabels = { fiber:'Fiber', cable:'Cable', '5g':'5G Home', dsl:'DSL', satellite:'Satellite' };
          apiOnlyProviders.forEach(p => {
            var speedStr = p.maxSpeed >= 1000 ? (p.maxSpeed/1000).toFixed(p.maxSpeed%1000===0?0:1) : String(p.maxSpeed);
            var speedUnit = p.maxSpeed >= 1000 ? 'Gbps' : 'Mbps';
            var tagsHtml = p.types.map(t => `<span class="tag tag-${t}">${typeLabels[t] || t}</span>`).join('');
            var el = document.createElement('div');
            el.className = 'provider-item';
            el.setAttribute('data-types', p.types.join(','));
            el.setAttribute('data-speed', String(p.maxSpeed || 0));
            el.setAttribute('data-price', '0');
            el.setAttribute('data-rating', '0');
            el.setAttribute('data-partner', '0');
            el.innerHTML = `<div class="provider-card">
  <div class="pc-main">
    <div class="pc-logo">
      <span style="font-weight:700; font-size: var(--text-lg); color: var(--brand-blue);">${p.name.charAt(0)}</span>
    </div>
    <div class="pc-info">
      <span class="pc-name">${p.name}</span>
      <div class="pc-tags">${tagsHtml}</div>
      <div class="pc-stats">
        <div class="pc-stat-group">
          <span class="pc-stat-label">Max Speed</span>
          <span class="pc-stat-value pc-speed">${speedStr}<span class="pc-speed-unit">${speedUnit}</span></span>
        </div>
        <div class="pc-stat-group">
          <span class="pc-stat-label">Starting At</span>
          <span class="pc-stat-value pc-price">N/A</span>
        </div>
      </div>
    </div>
  </div>
  <div class="pc-actions">
    <span class="btn btn-secondary" style="opacity:0.5;pointer-events:none;">No Plans Available</span>
  </div>
</div>`;
            providerList.appendChild(el);
          });
        }

        if (locationCount) locationCount.textContent = `${count + apiOnlyProviders.length} provider${(count + apiOnlyProviders.length) !== 1 ? 's' : ''} found at ZIP ${zip} — Live data`;

        if (count === 0 && apiOnlyProviders.length === 0) {
          showAllProviders();
          if (noResults) noResults.style.display = '';
        }
      } else {
        // API returned nothing — use local state-level data
        hideLoading();
        var localIds = getLocalProviderIds(zip);
        if (localIds.length > 0) {
          _currentMatchedIds = localIds;
          var cnt2 = filterByIds(localIds);
          if (locationCount) locationCount.textContent = cnt2 + ' provider' + (cnt2 !== 1 ? 's' : '') + ' found at ZIP ' + zip + ' — Regional data';
          if (locationBanner) locationBanner.style.display = '';
          // Re-order DOM: partners first
          if (providerList) {
            localIds.forEach(function(id) {
              var el = providerList.querySelector('[data-provider-id="' + id + '"]');
              if (el) providerList.appendChild(el);
            });
          }
        } else {
          showAllProviders();
          if (locationCount) locationCount.textContent = 'Could not verify provider availability — showing all providers.';
          if (locationBanner) locationBanner.style.display = '';
        }
      }
    } catch (e) {
      console.error('[Search] Error:', e);
      hideLoading();
      var localIds = getLocalProviderIds(zip);
      if (localIds.length > 0) {
        _currentMatchedIds = localIds;
        filterByIds(localIds);
        if (locationBanner) locationBanner.style.display = '';
        if (locationCount) locationCount.textContent = 'Regional data for ZIP ' + zip;
      } else {
        showAllProviders();
      }
    }
  }

  // Check for ZIP in URL params on page load
  const params = new URLSearchParams(window.location.search);
  const zip = params.get('zip');
  if (zip && /^\d{5}$/.test(zip)) {
    // Pre-fill the search input
    var input = document.querySelector('.search-bar input[name="zip"]');
    if (input) input.value = zip;
    searchByZip(zip);
  }

  // Intercept search form submission to stay on page
  const searchForm = document.querySelector('.search-bar');
  if (searchForm) {
    // Mark form so SearchBar's default navigation handler is skipped
    searchForm.setAttribute('data-handled', '');
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      e.stopImmediatePropagation();
      var input = searchForm.querySelector('input[name="zip"]');
      var val = input && input.value ? input.value.trim() : '';
      if (val && /^\d{5}$/.test(val)) {
        window.history.replaceState({}, '', `/providers?zip=${val}`);
        searchByZip(val);
      }
    });
  }

  // Show all button
  if (showAllBtn) {
    showAllBtn.addEventListener('click', () => {
      showAllProviders();
    });
  }

  // Scroll to results button
  if (scrollBtn) {
    scrollBtn.addEventListener('click', () => {
      if (locationBanner && locationBanner.style.display !== 'none') {
        locationBanner.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (providerListContainer) {
        providerListContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Hide button when user scrolls down
    window.addEventListener('scroll', () => {
      if (scrollBtn.style.display !== 'none') {
        const container = locationBanner && locationBanner.style.display !== 'none' ? locationBanner : providerListContainer;
        if (container) {
          const rect = container.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            scrollBtn.style.display = 'none';
          }
        }
      }
    });
  }

  // Filtering — track which IDs are active from search
  var filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filterBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var filter = btn.getAttribute('data-filter') || 'all';

      allItems.forEach(function(item) {
        var types = item.getAttribute('data-types') || '';
        var matchesFilter = filter === 'all' || types.indexOf(filter) !== -1;
        var id = item.getAttribute('data-provider-id');
        
        if (_currentMatchedIds) {
          // Search is active: show only if in matched IDs AND matches filter
          var inSearch = _currentMatchedIds.indexOf(id) !== -1;
          item.style.display = (inSearch && matchesFilter) ? '' : 'none';
        } else {
          // No search: just filter
          item.style.display = matchesFilter ? '' : 'none';
        }
      });
    });
  });

  // Sorting
  var sortSelect = document.getElementById('sort-select');
  if (sortSelect && providerList) {
    sortSelect.addEventListener('change', () => {
      const items = Array.from(providerList.querySelectorAll('.provider-item'));
      items.sort((a, b) => {
        const av = (k) => parseFloat(a.getAttribute(`data-${k}`) || '0');
        const bv = (k) => parseFloat(b.getAttribute(`data-${k}`) || '0');
        switch (sortSelect.value) {
          case 'speed': return bv('speed') - av('speed');
          case 'price': return av('price') - bv('price');
          case 'rating': return bv('rating') - av('rating');
          default:
            const al = parseInt(a.getAttribute('data-has-logo') || '0');
            const bl = parseInt(b.getAttribute('data-has-logo') || '0');
            if (bl !== al) return bl - al;
            const ap = parseInt(a.getAttribute('data-partner') || '0');
            const bp = parseInt(b.getAttribute('data-partner') || '0');
            if (bp !== ap) return bp - ap;
            return bv('rating') - av('rating');
        }
      });
      items.forEach(el => providerList.appendChild(el));
    });
  }
</script>
