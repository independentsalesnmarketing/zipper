---
<Base
  title="Internet Providers in My Area — All Local ISPs Near Me"
  description="Compare 25+ internet providers independently rated on speed, price, and reliability. See every ISP in your area — fiber, cable, 5G, and wireless."
  schema={[
    generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet-4-all.com' }, { name: 'Providers', url: 'https://internet-4-all.com/providers' }]),
    generateItemListSchema(allProviders.map(p => ({
      name: p.name,
      url: `https://internet-4-all.com/provider/${p.slug}`,
      description: p.description,
    }))),
    generateFAQSchema(faqs),
  ]}
>
  <!-- ===== HERO + SEARCH ===== -->
  <section class="section" style="padding-top: var(--space-xl); padding-bottom: var(--space-lg);">
    <div class="container">
      <Breadcrumb items={breadcrumbs} />

      <div class="text-center" style="margin-bottom: var(--space-xl);">
        <div class="badge badge-blue reveal" style="margin-bottom: var(--space-md);">Updated {month} {year}</div>
        <h1 class="reveal">Compare Internet Providers <span class="light-gradient-text">in Your Area</span></h1>
        <p class="hero-subtitle reveal" style="max-width: 640px; margin-inline:auto;">Enter your ZIP code to see every provider, plan, and price available at your address — powered by live FCC broadband data.</p>
        <div class="reveal" style="display:flex; justify-content:center; margin-top: var(--space-lg);">
          <SearchBar size="large" placeholder="Enter 5-digit ZIP code" />
        </div>
      </div>

      <!-- Trust stats bar -->
      <div class="reveal" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); margin-bottom: var(--space-xl); text-align: center;">
        <div style="padding: var(--space-md); background: var(--bg-secondary); border-radius: var(--radius-lg);">
          <div style="font-size: var(--text-2xl); font-weight: 800; color: var(--brand-blue);">All</div>
          <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em;">Major Providers</div>
        </div>
        <div style="padding: var(--space-md); background: var(--bg-secondary); border-radius: var(--radius-lg);">
          <div style="font-size: var(--text-2xl); font-weight: 800; color: var(--brand-blue);">Live</div>
          <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em;">FCC Data</div>
        </div>
        <div style="padding: var(--space-md); background: var(--bg-secondary); border-radius: var(--radius-lg);">
          <div style="font-size: var(--text-2xl); font-weight: 800; color: var(--brand-blue);">{formatPrice(lowestPrice)}<span style="font-size: var(--text-sm); font-weight: 600;">/mo</span></div>
          <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em;">Lowest Price</div>
        </div>
        <div style="padding: var(--space-md); background: var(--bg-secondary); border-radius: var(--radius-lg);">
          <div style="font-size: var(--text-2xl); font-weight: 800; color: var(--brand-blue);">{totalStates}</div>
          <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em;">States Covered</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROVIDER LOGOS (visible immediately) ===== -->
  <section style="padding: var(--space-lg) 0; background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="container">
      <div class="text-center reveal" style="margin-bottom: var(--space-md);">
        <p style="font-size: var(--text-sm); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.08em;">Trusted by millions — every major provider, one place</p>
      </div>
      <div class="logos-grid reveal">
        {allProviders.map((p) => (
          <a href={`/provider/${p.slug}`} class="logo-item" title={p.name}>
            {p.logo ? (
              <img src={p.logo} alt={p.name} loading="lazy" />
            ) : (
              <span class="logo-fallback">{p.name.charAt(0)}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SEARCH RESULTS (hidden until search) ===== -->
  <section class="section" id="results-section">
    <div class="container">
      <!-- Location banner (hidden until search) -->
      <div id="location-banner" class="card results-banner" style="display:none; text-align:center; margin-bottom: var(--space-xl); padding: var(--space-lg); animation: slideInDown 0.6s ease-out;">
        <h3 id="location-text" style="font-size: var(--text-xl);">Showing providers for <strong id="location-city" style="color: var(--brand-blue);"></strong></h3>
        <p id="location-count" class="text-secondary text-sm mt-sm"></p>
      </div>

      <!-- Loading state -->
      <div id="loading-state" style="display:none; margin-top: var(--space-lg);">
        <div style="text-align: center; padding: var(--space-2xl); background: var(--bg-secondary); border-radius: var(--radius-lg);">
          <div style="display: inline-block; margin-bottom: var(--space-lg);">
            <div style="width: 48px; height: 48px; border: 4px solid var(--border); border-top: 4px solid var(--brand-blue); border-radius: 50%; animation: spin 1s linear infinite;"></div>
          </div>
          <p style="font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-sm);">Finding Providers...</p>
          <p style="color: var(--text-secondary); font-size: var(--text-sm);">Searching FCC data for available options in your area</p>
        </div>
      </div>

      <!-- Filters -->
      <div id="filters-bar" class="flex items-center justify-between flex-wrap gap-md" style="margin-bottom: var(--space-lg);">
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="fiber">Fiber</button>
          <button class="filter-btn" data-filter="cable">Cable</button>
          <button class="filter-btn" data-filter="5g">5G</button>
          <button class="filter-btn" data-filter="dsl">DSL</button>
          <button class="filter-btn" data-filter="satellite">Satellite</button>
        </div>
        <div class="flex gap-sm items-center">
          <span class="text-sm text-tertiary">Sort:</span>
          <select class="sort-select" id="sort-select">
            <option value="recommended">Recommended</option>
            <option value="speed">Fastest Speed</option>
            <option value="price">Lowest Price</option>
            <option value="rating">Highest Rated</option>
          </select>
        </div>
      </div>

      <!-- Provider List (server-rendered, all providers) -->
      <div id="provider-list-container" style="display:none; animation: slideInUp 0.8s ease-out;">
        <div id="results-header" style="margin-bottom: var(--space-lg); padding-bottom: var(--space-lg); border-bottom: 2px solid var(--border);">
          <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-sm);">Available Providers</h2>
          <p class="text-secondary">Select a provider to view detailed plans and pricing</p>
        </div>
        <div id="provider-list" class="flex flex-col gap-md">
          {allProviders.map((p, i) => (
            <div class="provider-item reveal" data-provider-id={p.id} data-types={p.types.join(',')} data-speed={getMaxSpeed(p)} data-price={getMinPrice(p)} data-rating={p.rating} data-partner={p.isPartner ? '1' : '0'} data-has-logo={p.logo ? '1' : '0'} style={`transition-delay: ${Math.min(i * 60, 400)}ms;`}>
              <ProviderCard provider={p} rank={i + 1} />
            </div>
          ))}
        </div>
      </div>

      <div id="no-results" class="card text-center" style="display:none; padding: var(--space-3xl);">
        <h3>No Providers Found</h3>
        <p style="margin-top:var(--space-sm);">No providers matched your ZIP code. Showing all available providers instead.</p>
        <button id="show-all-btn" class="btn btn-primary" style="margin-top: var(--space-md);">Show All Providers</button>
      </div>
    </div>
  </section>

  <!-- ===== MAP (hidden until search) ===== -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <div id="map-container" style="display:none;">
