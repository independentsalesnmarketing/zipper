---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice, MAIN_PHONE } from '@lib/providers';
import { generateBreadcrumbSchema } from '@lib/utils';

const partners = getPartnerProviders();
---
<Base
  title="Internet Needs Quiz — Find Your Perfect Plan in 60 Seconds"
  description="Answer 5 quick questions and get a personalized internet plan recommendation based on your household size, usage, and budget."
  schema={[generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet4all.com' }, { name: 'Internet Quiz', url: 'https://internet4all.com/quiz' }])]}
>
  <section class="section" style="padding-top:var(--space-xl);">
    <div class="container" style="max-width:700px;">
      <Breadcrumb items={[{ name: 'Internet Quiz' }]} />

      <div class="text-center reveal">
        <div class="badge" style="margin-bottom:var(--space-md);">❓ 60-Second Quiz</div>
        <h1>What Internet Plan <span class="gradient-text">Do You Need?</span></h1>
        <p class="hero-subtitle" style="max-width:480px;margin:var(--space-sm) auto 0;">Answer 5 quick questions. We'll recommend the perfect speed and plan for your household.</p>
      </div>

      <!-- Quiz Container -->
      <div id="quiz" class="reveal" style="margin-top:var(--space-2xl);">
        <!-- Progress Bar -->
        <div style="margin-bottom:var(--space-xl);">
          <div class="flex items-center" style="justify-content:space-between;margin-bottom:var(--space-xs);">
            <span id="quiz-step" style="font-size:var(--text-sm);font-weight:700;">Question 1 of 5</span>
            <span id="quiz-pct" style="font-size:var(--text-sm);color:var(--text-muted);">0%</span>
          </div>
          <div class="progress-bar"><div id="quiz-bar" class="progress-fill" style="width:0%;"></div></div>
        </div>

        <!-- Questions -->
        <div id="q-container">
          <!-- Q1 -->
          <div class="quiz-question card" data-q="1">
            <h3 style="margin-bottom:var(--space-lg);">How many people are in your household?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);">
              <button class="quiz-opt btn btn-secondary" data-value="1">Just me</button>
              <button class="quiz-opt btn btn-secondary" data-value="2">2 people</button>
              <button class="quiz-opt btn btn-secondary" data-value="3">3-4 people</button>
              <button class="quiz-opt btn btn-secondary" data-value="5">5+ people</button>
            </div>
          </div>
          <!-- Q2 -->
          <div class="quiz-question card" data-q="2" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">What do you mainly use the internet for?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);">
              <button class="quiz-opt btn btn-secondary" data-value="basic">Email & browsing</button>
              <button class="quiz-opt btn btn-secondary" data-value="streaming">Streaming (Netflix, YouTube)</button>
              <button class="quiz-opt btn btn-secondary" data-value="gaming">Gaming</button>
              <button class="quiz-opt btn btn-secondary" data-value="wfh">Work from home</button>
            </div>
          </div>
          <!-- Q3 -->
          <div class="quiz-question card" data-q="3" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">How many devices connect to your WiFi?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);">
              <button class="quiz-opt btn btn-secondary" data-value="3">1-3 devices</button>
              <button class="quiz-opt btn btn-secondary" data-value="7">4-7 devices</button>
              <button class="quiz-opt btn btn-secondary" data-value="12">8-12 devices</button>
              <button class="quiz-opt btn btn-secondary" data-value="20">13+ devices</button>
            </div>
          </div>
          <!-- Q4 -->
          <div class="quiz-question card" data-q="4" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">Do multiple people stream or game at the same time?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);">
              <button class="quiz-opt btn btn-secondary" data-value="0">Almost never</button>
              <button class="quiz-opt btn btn-secondary" data-value="1">Sometimes</button>
              <button class="quiz-opt btn btn-secondary" data-value="2">Often</button>
              <button class="quiz-opt btn btn-secondary" data-value="3">All the time</button>
            </div>
          </div>
          <!-- Q5 -->
          <div class="quiz-question card" data-q="5" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">What's your monthly budget for internet?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);">
              <button class="quiz-opt btn btn-secondary" data-value="30">Under $30/mo</button>
              <button class="quiz-opt btn btn-secondary" data-value="50">$30-$50/mo</button>
              <button class="quiz-opt btn btn-secondary" data-value="75">$50-$75/mo</button>
              <button class="quiz-opt btn btn-secondary" data-value="999">$75+/mo (I want the best)</button>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div id="quiz-results" style="display:none;"></div>
      </div>

    </div>
  </section>

  <StickyCallBar text="Need help choosing? Talk to an expert." />

<script define:vars={{ partners: partners.map(p => ({ name: p.name, slug: p.slug, phone: p.phone, types: p.types, plans: p.plans })), mainPhone: MAIN_PHONE }}>
(function() {
  const answers = {};
  let current = 1;
  const total = 5;

  document.querySelectorAll('.quiz-opt').forEach(btn => {
    btn.addEventListener('click', function() {
      const q = parseInt(this.closest('.quiz-question').dataset.q);
      answers[q] = this.dataset.value;
      
      // Highlight selected
      this.closest('.quiz-question').querySelectorAll('.quiz-opt').forEach(b => b.classList.remove('btn-primary'));
      this.classList.add('btn-primary');
      this.classList.remove('btn-secondary');
      
      setTimeout(() => {
        if (q < total) {
          // Next question
          document.querySelector(`.quiz-question[data-q="${q}"]`).style.display = 'none';
          document.querySelector(`.quiz-question[data-q="${q + 1}"]`).style.display = 'block';
          current = q + 1;
          document.getElementById('quiz-step').textContent = `Question ${current} of ${total}`;
          document.getElementById('quiz-pct').textContent = Math.round((current - 1) / total * 100) + '%';
          document.getElementById('quiz-bar').style.width = ((current - 1) / total * 100) + '%';
        } else {
          // Show results
          showResults();
        }
      }, 300);
    });
  });

  function showResults() {
    document.getElementById('quiz-step').textContent = 'Results';
    document.getElementById('quiz-pct').textContent = '100%';
    document.getElementById('quiz-bar').style.width = '100%';
    document.querySelector(`.quiz-question[data-q="${total}"]`).style.display = 'none';

    // 2026 MODERN ALGORITHM - reflects realistic household needs
    const people = parseInt(answers[1]) || 1;
    const usage = answers[2] || 'basic';
    const devices = parseInt(answers[3]) || 3;
    const concurrent = parseInt(answers[4]) || 0;
    const budget = parseInt(answers[5]) || 50;

    // Core calculation: Start with usage-based minimum, then layer household complexity
    let baseSpeed = 50; // baseline for any household

    // Usage-based boost (2026 reality: streaming/work need real speeds)
    if (usage === 'streaming') baseSpeed = 300;  // 4K streaming, multiple streams
    else if (usage === 'gaming') baseSpeed = 500;   // comp gaming needs 200+ upload + low latency
    else if (usage === 'wfh') baseSpeed = 200;    // video calls, file uploads, multitasking
    else baseSpeed = 100;  // browsing still needs decent speed in 2026

    // Household size multiplier (bigger households = concurrent demand)
    let householdMultiplier = 1;
    if (people === 1) householdMultiplier = 0.85;     // Solo users can go lower
    else if (people === 2) householdMultiplier = 1.0; // baseline
    else if (people === 3) householdMultiplier = 1.25;
    else if (people === 4) householdMultiplier = 1.4;
    else householdMultiplier = 1.7; // 5+ people - everyone streaming at once

    // Device stress (WiFi congestion)
    let deviceStress = 1;
    if (devices <= 3) deviceStress = 0.95;
    else if (devices <= 7) deviceStress = 1.1;
    else if (devices <= 12) deviceStress = 1.25;
    else deviceStress = 1.4; // 13+ devices

    // Concurrent usage (are people actually using internet at same time?)
    let concurrentLoad = 1;
    if (concurrent === 0) concurrentLoad = 0.8;  // almost never - off-peak usage
    else if (concurrent === 1) concurrentLoad = 1.0;  // sometimes - mixed usage
    else if (concurrent === 2) concurrentLoad = 1.35; // often - regular multi-user
    else concurrentLoad = 1.75; // all the time - heavy multi-user household

    // Calculate final recommendation
    let recSpeed = baseSpeed * householdMultiplier * deviceStress * concurrentLoad;
    recSpeed = Math.max(25, Math.min(recSpeed, 2000));

    // Snap to real-world available tiers (from provider data)
    const commonSpeeds = [25, 50, 100, 200, 300, 500, 1000, 2000];
    let tier = commonSpeeds.find(t => t >= recSpeed) || 2000;

    // For modern 2026 households: push toward gigabit if they can afford it
    if (budget >= 75 && people >= 3) tier = Math.max(tier, 500);
    if (budget >= 90 && people >= 2) tier = Math.max(tier, 1000);

    // Category labeling
    let grade, gradeColor, label;
    if (tier <= 50) {
      grade = 'Basic';
      gradeColor = 'var(--brand-green)';
      label = 'Email, light browsing, single user';
    } else if (tier <= 100) {
      grade = 'Standard';
      gradeColor = 'var(--brand-blue-light)';
      label = 'Streaming one device, light multitasking';
    } else if (tier <= 300) {
      grade = 'Power';
      gradeColor = 'var(--brand-purple)';
      label = '4K streaming, gaming, video calls, 4-6 devices';
    } else if (tier <= 500) {
      grade = 'Extreme';
      gradeColor = 'var(--brand-blue)';
      label = 'Heavy usage: multiple 4K streams, gaming, WFH - 5+ device households';
    } else {
      grade = 'Gigabit';
      gradeColor = 'var(--gradient-primary)';
      label = 'Maximum performance: future-proofed, 10+ devices, intensive users';
    }

    // Find best matching plans
    const allMatches = [];

    partners.forEach(p => {
      // Look for plans that meet speed requirement
      const bestFit = p.plans.find(pl => pl.speed >= tier);
      const nextBest = p.plans.sort((a, b) => Math.abs(a.speed - tier) - Math.abs(b.speed - tier))[0];
      const chosen = bestFit || nextBest;

      if (chosen) {
        const price = chosen.promoPrice || chosen.price;
        const meetsSpeed = chosen.speed >= tier;
        const withinBudget = price <= budget;

        let matchQuality = 0;
        if (meetsSpeed && withinBudget) matchQuality = 3; // perfect
        else if (meetsSpeed && !withinBudget) matchQuality = 2; // speed good, budget high
        else if (!meetsSpeed && withinBudget) matchQuality = 1; // budget good, speed low
        else matchQuality = 0;

        allMatches.push({
          provider: p,
          plan: chosen,
          price,
          matchQuality,
          meetsSpeed,
          withinBudget
        });
      }
    });

    // Sort: perfect matches first, then speed-good, then budget-good
    allMatches.sort((a, b) => b.matchQuality - a.matchQuality || a.price - b.price);

    let html = `
      <div class="card" style="text-align:center;padding:var(--space-2xl);margin-bottom:var(--space-xl);border-top:3px solid ${gradeColor};">
        <div style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-xs);">We recommend</div>
        <div style="font-size:clamp(2.5rem,6vw,4rem);font-weight:900;background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">${tier} Mbps</div>
        <div style="font-size:var(--text-lg);font-weight:700;margin:var(--space-xs) 0;">${grade} Internet</div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);">${label}</p>
        <div style="margin-top:var(--space-lg);padding-top:var(--space-lg);border-top:1px solid var(--border);">
          <div style="display:flex;justify-content:center;gap:var(--space-xl);flex-wrap:wrap;font-size:var(--text-sm);">
            <div><strong>${people}</strong> ${people === 1 ? 'person' : 'people'}</div>
            <div><strong>${devices}</strong> devices</div>
            <div><strong>Mainly ${usage === 'basic' ? 'browsing' : usage === 'streaming' ? '4K streaming' : usage === 'gaming' ? 'gaming' : 'remote work'}</strong></div>
          </div>
        </div>
      </div>
    `;

    if (allMatches.length > 0) {
      const perfect = allMatches.filter(m => m.matchQuality === 3);
      const good = allMatches.filter(m => m.matchQuality >= 2);
      const topMatches = perfect.length > 0 ? perfect : good.length > 0 ? good : allMatches;

      html += `
        <h3 style="margin-bottom:var(--space-lg);">
          ${perfect.length > 0 ? 'Perfect Matches' : 'Top Plans'} From Our Partners
        </h3>
      `;

      topMatches.slice(0, 4).forEach((m, idx) => {
        const badge = m.matchQuality === 3 ? '✓ Best Match' : m.meetsSpeed ? '⚡ Meets Speed' : '💰 Great Price';
        const badgeColor = m.matchQuality === 3 ? 'var(--brand-green)' : m.meetsSpeed ? 'var(--brand-blue)' : 'var(--brand-amber)';

        html += `
          <div class="card" style="margin-bottom:var(--space-md);border-left:3px solid ${badgeColor};">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-md);">
              <div style="flex:1;">
                <div style="font-size:var(--text-xs);color:${badgeColor};font-weight:700;text-transform:uppercase;margin-bottom:var(--space-xs);">${badge}</div>
                <h4 style="margin:0 0 var(--space-xs) 0;">${m.provider.name}</h4>
                <div style="font-size:var(--text-sm);color:var(--text-secondary);">
                  <strong>${m.plan.speed >= 1000 ? (m.plan.speed / 1000) + ' Gbps' : m.plan.speed + ' Mbps'}</strong>
                  <span style="color:var(--text-tertiary);">  · ${m.plan.name}</span>
                </div>
                <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:4px;">
                  ${m.plan.contract || 'No contract'} · ${m.plan.dataCap || 'Unlimited data'}
                </div>
              </div>
              <div style="text-align:right;white-space:nowrap;">
                <div style="font-size:var(--text-2xl);font-weight:900;color:var(--brand-green);">$${m.price.toFixed(0)}</div>
                <div style="font-size:var(--text-xs);color:var(--text-tertiary);">/month</div>
                <a href="#get-connected" class="btn btn-cta" style="margin-top:var(--space-sm);display:inline-block;" data-signup-provider="${m.provider.slug}">Sign Up</a>
              </div>
            </div>
          </div>
        `;
      });
    } else {
      html += `
        <div class="card text-center" style="padding:var(--space-xl);">
          <p style="margin-bottom:var(--space-md);">No exact matches, but our experts can find you the perfect plan.</p>
          <div style="display:flex;flex-direction:column;gap:var(--space-md);align-items:center;">
            <a href="#get-connected" class="btn btn-primary" style="min-width:220px;">Chat with an Expert</a>
          </div>
        </div>
      `;
    }

    html += `
      <div class="text-center" style="margin-top:var(--space-xl);">
        <button id="quiz-restart" class="btn btn-secondary">↩ Retake Quiz</button>
      </div>
    `;

    const resultsEl = document.getElementById('quiz-results');
    resultsEl.innerHTML = html;
    resultsEl.style.display = 'block';

    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      resultsEl.style.display = 'none';
      resultsEl.innerHTML = '';
      document.querySelector('.quiz-question[data-q="1"]').style.display = 'block';
      document.querySelectorAll('.quiz-opt').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-secondary');
      });
      current = 1;
      document.getElementById('quiz-step').textContent = 'Question 1 of 5';
      document.getElementById('quiz-pct').textContent = '0%';
      document.getElementById('quiz-bar').style.width = '0%';
      Object.keys(answers).forEach(k => delete answers[k]);
    });
  }
})();
</script>
</Base>
