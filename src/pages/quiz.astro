---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice } from '@lib/providers';
import { generateBreadcrumbSchema } from '@lib/utils';

const partners = getPartnerProviders();
---
<Base
  title="Find Your Best Internet Provider — Quick Quiz"
  description="Answer a few quick questions about your home and usage — we'll match you with the best internet providers and plans available at your address. Takes 60 seconds."
  schema={[generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet-4-all.com' }, { name: 'Internet Quiz', url: 'https://internet-4-all.com/quiz' }])]}
>
  <section class="section" style="padding-top:var(--space-xl);">
    <div class="container" style="max-width:700px;">
      <Breadcrumb items={[{ name: 'Internet Quiz' }]} />

      <div class="text-center reveal">
        <div class="badge" style="margin-bottom:var(--space-md);">❓ 60-Second Quiz</div>
        <h1>What Internet Plan <span class="gradient-text">Do You Need?</span></h1>
        <p class="hero-subtitle" style="max-width:480px;margin:var(--space-sm) auto 0;">Answer 5 quick questions. We'll recommend the perfect speed and plan for your household.</p>
      </div>

      <!-- Quiz Container -->
      <div id="quiz" class="reveal" style="margin-top:var(--space-2xl);">
        <!-- Progress Bar -->
        <div style="margin-bottom:var(--space-xl);">
          <div class="flex items-center" style="justify-content:space-between;margin-bottom:var(--space-xs);">
            <span id="quiz-step" style="font-size:var(--text-sm);font-weight:700;">Question 1 of 5</span>
            <span id="quiz-pct" style="font-size:var(--text-sm);color:var(--text-muted);">20%</span>
          </div>
          <div class="progress-bar"><div id="quiz-bar" class="progress-fill" style="width:20%;"></div></div>
        </div>

        <!-- Questions -->
        <div id="q-container">
          <!-- Q1 -->
          <div class="quiz-question card" data-q="1">
            <h3 style="margin-bottom:var(--space-lg);">How many people are in your household?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);" role="radiogroup" aria-label="Household size">
              <button class="quiz-opt btn btn-secondary" data-value="1" aria-pressed="false">Just me</button>
              <button class="quiz-opt btn btn-secondary" data-value="2" aria-pressed="false">2 people</button>
              <button class="quiz-opt btn btn-secondary" data-value="3" aria-pressed="false">3-4 people</button>
              <button class="quiz-opt btn btn-secondary" data-value="5" aria-pressed="false">5+ people</button>
            </div>
          </div>
          <!-- Q2 -->
          <div class="quiz-question card" data-q="2" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">What do you mainly use the internet for?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);" role="radiogroup" aria-label="Primary internet use">
              <button class="quiz-opt btn btn-secondary" data-value="basic" aria-pressed="false">Email & browsing</button>
              <button class="quiz-opt btn btn-secondary" data-value="streaming" aria-pressed="false">Streaming (Netflix, YouTube)</button>
              <button class="quiz-opt btn btn-secondary" data-value="gaming" aria-pressed="false">Gaming</button>
              <button class="quiz-opt btn btn-secondary" data-value="wfh" aria-pressed="false">Work from home</button>
            </div>
          </div>
          <!-- Q3 -->
          <div class="quiz-question card" data-q="3" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">How many devices connect to your WiFi?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);" role="radiogroup" aria-label="Number of devices">
              <button class="quiz-opt btn btn-secondary" data-value="3" aria-pressed="false">1-3 devices</button>
              <button class="quiz-opt btn btn-secondary" data-value="7" aria-pressed="false">4-7 devices</button>
              <button class="quiz-opt btn btn-secondary" data-value="12" aria-pressed="false">8-12 devices</button>
              <button class="quiz-opt btn btn-secondary" data-value="20" aria-pressed="false">13+ devices</button>
            </div>
          </div>
          <!-- Q4 -->
          <div class="quiz-question card" data-q="4" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">Do multiple people stream or game at the same time?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);" role="radiogroup" aria-label="Simultaneous usage">
              <button class="quiz-opt btn btn-secondary" data-value="0" aria-pressed="false">Almost never</button>
              <button class="quiz-opt btn btn-secondary" data-value="1" aria-pressed="false">Sometimes</button>
              <button class="quiz-opt btn btn-secondary" data-value="2" aria-pressed="false">Often</button>
              <button class="quiz-opt btn btn-secondary" data-value="3" aria-pressed="false">All the time</button>
            </div>
          </div>
          <!-- Q5 -->
          <div class="quiz-question card" data-q="5" style="display:none;">
            <h3 style="margin-bottom:var(--space-lg);">What's your monthly budget for internet?</h3>
            <div class="grid grid-2" style="gap:var(--space-sm);" role="radiogroup" aria-label="Monthly budget">
              <button class="quiz-opt btn btn-secondary" data-value="30" aria-pressed="false">Under $30/mo</button>
              <button class="quiz-opt btn btn-secondary" data-value="50" aria-pressed="false">$30-$50/mo</button>
              <button class="quiz-opt btn btn-secondary" data-value="75" aria-pressed="false">$50-$75/mo</button>
              <button class="quiz-opt btn btn-secondary" data-value="999" aria-pressed="false">$75+/mo (I want the best)</button>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div id="quiz-results" style="display:none;"></div>
      </div>

    </div>
  </section>

  <StickyCallBar text="Need help choosing? Talk to an expert." />

<script define:vars={{ partners: partners.map(p => ({ name: p.name, slug: p.slug, phone: p.phone, types: p.types, plans: p.plans })) }}>
(function() {
  const quizRoot = document.getElementById('quiz');
  if (!quizRoot) return;

  const answers = {};
  let current = 1;
  const total = 5;

  document.querySelectorAll('.quiz-opt').forEach(btn => {
    btn.addEventListener('click', function() {
      const q = parseInt(this.closest('.quiz-question').dataset.q);
      answers[q] = this.dataset.value;
      
      // Highlight selected
      this.closest('.quiz-question').querySelectorAll('.quiz-opt').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-secondary');
        b.setAttribute('aria-pressed', 'false');
      });
      this.classList.add('btn-primary');
      this.classList.remove('btn-secondary');
      this.setAttribute('aria-pressed', 'true');
      
      setTimeout(() => {
        if (q < total) {
          // Next question
          document.querySelector(`.quiz-question[data-q="${q}"]`).style.display = 'none';
          document.querySelector(`.quiz-question[data-q="${q + 1}"]`).style.display = 'block';
          current = q + 1;
          document.getElementById('quiz-step').textContent = `Question ${current} of ${total}`;
          document.getElementById('quiz-pct').textContent = Math.round(current / total * 100) + '%';
          document.getElementById('quiz-bar').style.width = (current / total * 100) + '%';
        } else {
          // Show results
          showResults();
        }
      }, 300);
    });
  });

  function showResults() {
    document.getElementById('quiz-step').textContent = 'Results';
    document.getElementById('quiz-pct').textContent = '100%';
    document.getElementById('quiz-bar').style.width = '100%';
    document.querySelector(`.quiz-question[data-q="${total}"]`).style.display = 'none';

    // Calculate recommended speed
    const people = parseInt(answers[1]) || 1;
    const usage = answers[2] || 'basic';
    const devices = parseInt(answers[3]) || 3;
    const concurrent = parseInt(answers[4]) || 0;
    const budget = parseInt(answers[5]) || 50;

    let baseSpeed = 25;
    if (usage === 'streaming') baseSpeed = 50;
    if (usage === 'gaming') baseSpeed = 100;
    if (usage === 'wfh') baseSpeed = 75;

    let recSpeed = baseSpeed * people;
    recSpeed += devices * 5;
    recSpeed += concurrent * 50;
    recSpeed = Math.max(25, Math.min(recSpeed, 2000));

    // Round to common tiers
    const tiers = [25, 50, 100, 200, 300, 500, 1000, 2000];
    let tier = tiers.find(t => t >= recSpeed) || 2000;

    // Grade
    let grade, gradeColor, label;
    if (tier <= 50) { grade = 'Basic'; gradeColor = 'var(--brand-green)'; label = 'Light browsing, email, social media'; }
    else if (tier <= 100) { grade = 'Standard'; gradeColor = 'var(--brand-blue-light)'; label = 'Streaming, video calls, moderate use'; }
    else if (tier <= 300) { grade = 'Power'; gradeColor = 'var(--brand-purple)'; label = 'Multiple users, gaming, HD streaming'; }
    else if (tier <= 500) { grade = 'Heavy'; gradeColor = 'var(--brand-blue)'; label = 'Large household, 4K streaming, competitive gaming'; }
    else { grade = 'Ultra'; gradeColor = 'var(--gradient-primary)'; label = 'Maximum performance, future-proof'; }

    // Find matching plans from partners
    const matches = [];
    partners.forEach(p => {
      const plan = p.plans.find(pl => pl.speed >= tier && (pl.promoPrice || pl.price) <= budget);
      const any = p.plans.find(pl => pl.speed >= tier);
      if (plan) {
        matches.push({ provider: p, plan, exact: true });
      } else if (any) {
        matches.push({ provider: p, plan: any, exact: false });
      }
    });
    matches.sort((a, b) => (a.plan.promoPrice || a.plan.price) - (b.plan.promoPrice || b.plan.price));

    let html = `
      <div class="card" style="text-align:center;padding:var(--space-2xl);margin-bottom:var(--space-xl);border-top:3px solid ${gradeColor};">
        <div style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-xs);">We recommend</div>
        <div style="font-size:clamp(2.5rem,6vw,4rem);font-weight:900;background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">${tier} Mbps</div>
        <div style="font-size:var(--text-lg);font-weight:700;margin:var(--space-xs) 0;">${grade} Internet</div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);">${label}</p>
        <div style="margin-top:var(--space-lg);padding-top:var(--space-lg);border-top:1px solid var(--border);">
          <div style="display:flex;justify-content:center;gap:var(--space-xl);flex-wrap:wrap;font-size:var(--text-sm);">
            <div><strong>${people}</strong> ${people === 1 ? 'person' : 'people'}</div>
            <div><strong>${devices}</strong> devices</div>
            <div><strong>$${budget === 999 ? '75+' : budget}</strong>/mo budget</div>
          </div>
        </div>
      </div>
    `;

    if (matches.length > 0) {
      html += `<h3 style="margin-bottom:var(--space-lg);">Matching Plans From Our Partners</h3>`;
      matches.slice(0, 4).forEach(m => {
        const price = m.plan.promoPrice || m.plan.price;
        html += `
          <div class="card" style="margin-bottom:var(--space-md);${m.exact ? '' : 'opacity:0.85;'}">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-md);">
              <div>
                <h4>${m.provider.name}</h4>
                <div style="font-size:var(--text-sm);">${m.plan.name} — <strong>${m.plan.speed >= 1000 ? (m.plan.speed / 1000) + ' Gbps' : m.plan.speed + ' Mbps'}</strong></div>
                ${!m.exact ? '<div style="font-size:var(--text-xs);color:var(--brand-yellow);">Exceeds budget — but meets speed needs</div>' : ''}
              </div>
              <div style="text-align:right;">
                <div style="font-size:var(--text-xl);font-weight:900;color:var(--brand-green);">$${price.toFixed(2)}<span style="font-size:var(--text-xs);font-weight:400;">/mo</span></div>
                <a href="#get-connected" class="btn btn-cta" data-signup-provider="${m.provider.slug}" style="margin-top:var(--space-xs);font-size:var(--text-sm);">Get This Plan</a>
              </div>
            </div>
          </div>
        `;
      });
    } else {
      html += `
        <div class="card text-center" style="padding:var(--space-xl);">
          <p>We didn't find an exact match within your speed + budget range. Sign up above — we'll find creative solutions!</p>
          <a href="#get-connected" class="btn btn-cta" style="margin-top:var(--space-md);font-size:var(--text-lg);">Get Connected</a>
        </div>
      `;
    }

    html += `
      <div class="text-center" style="margin-top:var(--space-xl);">
        <button id="quiz-restart" class="btn btn-secondary">↩ Retake Quiz</button>
      </div>
    `;

    const resultsEl = document.getElementById('quiz-results');
    resultsEl.innerHTML = html;
    resultsEl.style.display = 'block';

    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      resultsEl.style.display = 'none';
      resultsEl.innerHTML = '';
      Object.keys(answers).forEach((k) => delete answers[k]);
      document.querySelector('.quiz-question[data-q="1"]').style.display = 'block';
      document.querySelectorAll('.quiz-opt').forEach(b => {
        b.classList.remove('btn-primary');
        b.classList.add('btn-secondary');
      });
      current = 1;
      document.getElementById('quiz-step').textContent = 'Question 1 of 5';
      document.getElementById('quiz-pct').textContent = '0%';
      document.getElementById('quiz-bar').style.width = '0%';
    });
  }
})();
</script>

<style>
  @media (max-width: 640px) {
    #quiz .grid-2 {
      grid-template-columns: 1fr !important;
    }

    #quiz .quiz-opt {
      min-height: 46px;
      font-size: var(--text-sm);
    }

    #quiz-results .card [style*="justify-content:space-between"] {
      flex-direction: column;
      align-items: flex-start !important;
    }

    #quiz-results .card [style*="text-align:right"] {
      text-align: left !important;
      width: 100%;
    }

    #quiz-results .btn {
      width: 100%;
    }
  }
</style>
</Base>
