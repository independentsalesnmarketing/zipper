---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import SearchBar from '@components/SearchBar.astro';
import { generateBreadcrumbSchema } from '@lib/utils';

const guides = [
  { title: 'How to Choose the Right Internet Provider', desc: 'Everything to consider — speed, price, technology, contracts, and data caps.', icon: '📋', href: '/resources' },
  { title: 'Fiber vs Cable vs DSL vs 5G: What\'s the Difference?', desc: 'Understand the pros and cons of each internet technology type.', icon: '🔌', href: '/resources' },
  { title: 'How Much Internet Speed Do I Need?', desc: 'Calculate your ideal speed based on your household size and usage habits.', icon: '⚡', href: '/resources' },
  { title: 'How to Lower Your Internet Bill', desc: 'Proven strategies to negotiate a better rate or switch to save money.', icon: '💰', href: '/deals' },
  { title: 'The Ultimate Guide to Moving Your Internet', desc: 'Step-by-step: transfer, cancel, or set up new internet when you move.', icon: '🏠', href: '/movers' },
  { title: 'How to Switch Internet Providers Without Downtime', desc: 'Seamless switching — overlapping service, equipment returns, and more.', icon: '🔄', href: '/switch' },
  { title: 'Internet for Rural Areas: Your Best Options', desc: 'Satellite, fixed wireless, and new 5G options for underserved areas.', icon: '🌾', href: '/resources' },
  { title: 'Work From Home Internet Requirements', desc: 'What speed and features you need for reliable remote work.', icon: '💻', href: '/resources' },
  { title: 'Gaming Internet: What You Actually Need', desc: 'Ping, jitter, and speed requirements for competitive and casual gaming.', icon: '🎮', href: '/resources' },
];

const tools = [
  { title: 'Speed Test', desc: 'Check your actual download and upload speeds.', icon: '📊', href: '/speed-test' },
  { title: 'Internet Quiz', desc: 'Answer 5 questions and get a personalized recommendation.', icon: '❓', href: '/quiz' },
  { title: 'Bill Analyzer', desc: 'Upload your bill — we\'ll find you a better deal.', icon: '🧾', href: '/bill-analyzer' },
  { title: 'Provider Compare', desc: 'Compare providers side-by-side.', icon: '⚖️', href: '/compare' },
];
---
<Base
  title="Internet Resources & Guides — How to Choose, Save, and Get Connected"
  description="Expert guides on choosing internet providers, understanding speeds, lowering your bill, and getting connected. Free tools and resources."
  schema={[generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet4all.com' }, { name: 'Resources', url: 'https://internet4all.com/resources' }])]}
>
  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container">
      <Breadcrumb items={[{ name: 'Resources' }]} />

      <div class="text-center reveal">
        <h1>Internet <span class="gradient-text">Resources</span> & Guides</h1>
        <p class="hero-subtitle" style="max-width:550px;margin-inline:auto;">Everything you need to make smart decisions about your internet service.</p>
      </div>

      <!-- Quick Actions -->
      <div class="flex justify-center reveal" style="margin-top: var(--space-xl); margin-bottom: var(--space-3xl);">
        <SearchBar placeholder="Enter your ZIP to get started" />
      </div>

      <!-- Free Tools -->
      <div class="reveal" style="margin-bottom:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-xl);">Free Tools</h2>
        <div class="grid grid-4">
          {tools.map((tool, i) => (
            <a href={tool.href} class={`card text-center reveal reveal-delay-${i + 1}`} style="cursor:pointer;">
              <div style="font-size:2rem;margin-bottom:var(--space-sm);">{tool.icon}</div>
              <h4 style="font-size:var(--text-base);">{tool.title}</h4>
              <p style="font-size:var(--text-sm);margin-top:var(--space-xs);">{tool.desc}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Guides -->
      <div class="reveal">
        <h2 style="margin-bottom:var(--space-xl);">Guides & Articles</h2>
        <div class="grid grid-3">
          {guides.map((guide, i) => (
            <a href={guide.href} class={`card reveal`} style={`cursor:pointer;transition-delay:${Math.min(i * 70, 400)}ms;`}>
              <div style="font-size:1.8rem;margin-bottom:var(--space-md);">{guide.icon}</div>
              <h4 style="font-size:var(--text-lg);">{guide.title}</h4>
              <p style="font-size:var(--text-sm);margin-top:var(--space-sm);">{guide.desc}</p>
              <span style="display:inline-flex;align-items:center;gap:0.3em;margin-top:var(--space-md);font-size:var(--text-sm);color:var(--brand-blue-light);">
                Read More →
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Internet by Type -->
      <div class="reveal" style="margin-top:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-xl);">Browse by Internet Type</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-md);">
          <a href="/internet-types/fiber" class="card text-center" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size:1.5rem;margin-bottom:var(--space-sm);">⚡</div>
            <h4 style="font-size: var(--text-sm);">Fiber Internet</h4>
          </a>
          <a href="/internet-types/cable" class="card text-center" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size:1.5rem;margin-bottom:var(--space-sm);">📡</div>
            <h4 style="font-size: var(--text-sm);">Cable Internet</h4>
          </a>
          <a href="/internet-types/5g" class="card text-center" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size:1.5rem;margin-bottom:var(--space-sm);">📱</div>
            <h4 style="font-size: var(--text-sm);">5G Home Internet</h4>
          </a>
          <a href="/internet-types/dsl" class="card text-center" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size:1.5rem;margin-bottom:var(--space-sm);">🔌</div>
            <h4 style="font-size: var(--text-sm);">DSL Internet</h4>
          </a>
          <a href="/internet-types/satellite" class="card text-center" style="padding: var(--space-lg); text-decoration: none;">
            <div style="font-size:1.5rem;margin-bottom:var(--space-sm);">🛰️</div>
            <h4 style="font-size: var(--text-sm);">Satellite Internet</h4>
          </a>
        </div>
      </div>

      <!-- Internet For You -->
      <div class="reveal" style="margin-top:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-xl);">Internet for Your Needs</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-md);">
          <a href="/internet-for/gaming" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🎮 Best for Gaming</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Low latency, high speed picks</p>
          </a>
          <a href="/internet-for/streaming" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">📺 Best for Streaming</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Buffer-free 4K streaming</p>
          </a>
          <a href="/internet-for/work-from-home" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">💻 Work From Home</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Reliable remote work speeds</p>
          </a>
          <a href="/internet-for/seniors" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">👴 For Seniors</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Simple, affordable plans</p>
          </a>
          <a href="/internet-for/students" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🎓 For Students</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Budget-friendly student picks</p>
          </a>
          <a href="/internet-for/rural" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🌾 For Rural Areas</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Options beyond city limits</p>
          </a>
          <a href="/internet-for/large-households" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🏠 Large Households</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Plans for 5+ people</p>
          </a>
          <a href="/internet-for/smart-home" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🏡 Smart Home</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Connect all your devices</p>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="reveal" style="margin-top:var(--space-3xl);">
        <h2 style="margin-bottom:var(--space-xl);">Quick Links</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-md);">
          <a href="/providers" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🔍 All Providers</h4>
          </a>
          <a href="/compare" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">⚖️ Compare Plans</h4>
          </a>
          <a href="/deals" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">💰 Best Deals</h4>
          </a>
          <a href="/cheap-internet" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🏷️ Cheap Internet</h4>
          </a>
          <a href="/fastest-internet" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">⚡ Fastest Internet</h4>
          </a>
          <a href="/home-internet" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">🏠 Home Internet</h4>
          </a>
          <a href="/wireless-internet" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">📶 Wireless Internet</h4>
          </a>
          <a href="/about" class="card" style="padding: var(--space-md); text-decoration: none;">
            <h4 style="font-size: var(--text-sm);">ℹ️ About Us</h4>
          </a>
        </div>
      </div>
    </div>
  </section>

  <StickyCallBar />
</Base>
