---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { generateBreadcrumbSchema } from '@lib/utils';
---
<Base
  title="Internet Speed Test — Check Your Download & Upload Speed"
  description="Test your internet speed free — measure download, upload, ping & jitter instantly. Not getting what you pay for? Compare faster providers and switch today."
  schema={[generateBreadcrumbSchema([{ name: 'Home', url: 'https://internet4all.com' }, { name: 'Speed Test', url: 'https://internet4all.com/speed-test' }])]}
>
  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container container--narrow">
      <Breadcrumb items={[{ name: 'Speed Test' }]} />

      <div class="text-center reveal">
        <h1>Internet <span class="gradient-text">Speed Test</span></h1>
        <p class="hero-subtitle" style="max-width:500px;margin-inline:auto;">Check if you're getting the speed you pay for. Free, instant results.</p>
      </div>

      <!-- Speed Test UI -->
      <div class="card reveal" style="margin-top: var(--space-2xl); padding: var(--space-2xl); text-align: center;">
        <div id="speed-gauge" class="speed-gauge" style="--progress: 0%;">
          <div class="speed-value" id="speed-value">—</div>
        </div>
        <p id="speed-label" class="text-tertiary mt-md" style="font-size:var(--text-sm);">Click Start to test your speed</p>

        <div class="grid grid-3 mt-xl" style="gap:var(--space-xl);">
          <div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:var(--tracking-wide);">Download</div>
            <div id="dl-speed" class="speed-display" style="font-size:var(--text-2xl);margin-top:var(--space-xs);">—</div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Mbps</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:var(--tracking-wide);">Upload</div>
            <div id="ul-speed" class="speed-display" style="font-size:var(--text-2xl);margin-top:var(--space-xs);">—</div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Mbps</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:var(--tracking-wide);">Ping</div>
            <div id="ping-val" class="speed-display" style="font-size:var(--text-2xl);margin-top:var(--space-xs);">—</div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);">ms</div>
          </div>
        </div>

        <button id="start-test" class="btn btn-primary btn-lg mt-xl" style="min-width:200px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Start Speed Test
        </button>

        <div class="progress-bar mt-lg" style="opacity:0;" id="progress-bar">
          <div class="progress-fill" id="progress-fill" style="width:0%;"></div>
        </div>
      </div>

      <!-- Speed Analysis -->
      <div id="speed-analysis" class="card reveal" style="margin-top:var(--space-xl); display:none;">
        <h3 style="margin-bottom:var(--space-md);">Your Speed Analysis</h3>
        <div id="analysis-content"></div>
      </div>

      <!-- What's a good speed? -->
      <div class="reveal" style="margin-top: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">What Internet Speed Do You Need?</h2>
        <div class="grid grid-2">
          <div class="card">
            <h4 style="margin-bottom:var(--space-md);">Basic Usage</h4>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-green">25+ Mbps</span>
              <span class="text-sm text-secondary">Email, browsing, social media</span>
            </div>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-blue">50+ Mbps</span>
              <span class="text-sm text-secondary">HD streaming (1-2 devices)</span>
            </div>
          </div>
          <div class="card">
            <h4 style="margin-bottom:var(--space-md);">Power Usage</h4>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-blue">100+ Mbps</span>
              <span class="text-sm text-secondary">4K streaming, work from home</span>
            </div>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-purple">300+ Mbps</span>
              <span class="text-sm text-secondary">Large households, gaming</span>
            </div>
          </div>
          <div class="card">
            <h4 style="margin-bottom:var(--space-md);">Heavy Usage</h4>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-purple">500+ Mbps</span>
              <span class="text-sm text-secondary">Many devices, 4K, smart home</span>
            </div>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-amber">1 Gbps+</span>
              <span class="text-sm text-secondary">Power users, content creators</span>
            </div>
          </div>
          <div class="card">
            <h4 style="margin-bottom:var(--space-md);">Upload Needs</h4>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-green">10+ Mbps</span>
              <span class="text-sm text-secondary">Video calls, cloud backup</span>
            </div>
            <div class="flex items-center gap-md mb-sm">
              <span class="badge badge-blue">100+ Mbps</span>
              <span class="text-sm text-secondary">Streaming, large uploads</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Not happy CTA -->
      <div class="reveal" style="margin-top: var(--space-3xl);">
        <div class="card text-center" style="padding:var(--space-2xl); border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.02);">
          <h3>Not Getting the Speed You Pay For?</h3>
          <p style="margin-top:var(--space-sm);max-width:500px;margin-inline:auto;">You may be overpaying for underperforming internet. Our experts can find you a faster, more reliable option.</p>
          <div class="flex gap-md justify-center" style="margin-top:var(--space-xl);">
            <a href="/switch" class="btn btn-primary">Switch Provider</a>
            <a href="/providers" class="btn btn-secondary">Compare Options</a>
          </div>
        </div>
      </div>

      <!-- Related Pages -->
      <div class="reveal" style="margin-top: var(--space-3xl);">
        <h3 style="margin-bottom: var(--space-lg);">Related Resources</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-md);">
          <a href="/compare" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Compare Plans</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Side-by-side comparison</p>
          </a>
          <a href="/fastest-internet" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Fastest Internet</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Multi-gig providers</p>
          </a>
          <a href="/deals" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Best Deals</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Today's lowest prices</p>
          </a>
          <a href="/cheap-internet" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Cheap Internet</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Budget-friendly plans</p>
          </a>
          <a href="/internet-types/fiber" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Fiber Internet</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Fastest technology</p>
          </a>
          <a href="/internet-for/gaming" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Best for Gaming</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Low ping, zero lag</p>
          </a>
          <a href="/internet-for/streaming" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Best for Streaming</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Buffer-free 4K</p>
          </a>
          <a href="/bill-analyzer" class="card" style="padding: var(--space-md); text-decoration: none; text-align: center;">
            <h4 style="font-size: var(--text-sm);">Bill Analyzer</h4>
            <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-xs);">Find hidden charges</p>
          </a>
        </div>
      </div>

    </div>
  </section>

  <StickyCallBar text="Speed not up to par? Let us find you something better." />
</Base>

<script>
  // Real speed test using Cloudflare Workers endpoints for download/upload measurement
  const startBtn = document.getElementById('start-test') as HTMLButtonElement;
  const gauge = document.getElementById('speed-gauge') as HTMLElement;
  const speedValue = document.getElementById('speed-value') as HTMLElement;
  const speedLabel = document.getElementById('speed-label') as HTMLElement;
  const dlSpeed = document.getElementById('dl-speed') as HTMLElement;
  const ulSpeed = document.getElementById('ul-speed') as HTMLElement;
  const pingVal = document.getElementById('ping-val') as HTMLElement;
  const progressBar = document.getElementById('progress-bar') as HTMLElement;
  const progressFill = document.getElementById('progress-fill') as HTMLElement;
  const analysisEl = document.getElementById('speed-analysis') as HTMLElement;
  const analysisContent = document.getElementById('analysis-content') as HTMLElement;

  let running = false;

  // Test configuration
  const DL_ENDPOINT = 'https://speed.cloudflare.com/__down?bytes=';
  const UL_ENDPOINT = 'https://speed.cloudflare.com/__up';
  const PING_ENDPOINT = 'https://speed.cloudflare.com/__down?bytes=0';

  // Download chunk sizes (progressively larger)
  const DL_SIZES = [
    100_000,     // 100 KB warmup
    1_000_000,   // 1 MB
    5_000_000,   // 5 MB
    10_000_000,  // 10 MB
    25_000_000,  // 25 MB
  ];

  const UL_SIZES = [
    100_000,     // 100 KB warmup
    500_000,     // 500 KB
    1_000_000,   // 1 MB
    2_000_000,   // 2 MB
  ];

  function animateValue(el: HTMLElement, target: number, duration: number, suffix = '') {
    const startVal = parseFloat(el.textContent || '0') || 0;
    const startTime = performance.now();
    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = startVal + (target - startVal) * eased;
      el.textContent = current.toFixed(1) + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  // Real ping measurement
  async function measurePing(rounds = 5): Promise<number> {
    const pings: number[] = [];
    for (let i = 0; i < rounds; i++) {
      const start = performance.now();
      try {
        await fetch(PING_ENDPOINT, { cache: 'no-store', mode: 'cors' });
        pings.push(performance.now() - start);
      } catch {
        // fallback: measure to own origin
        const start2 = performance.now();
        await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' });
        pings.push(performance.now() - start2);
      }
    }
    // Drop highest, average the rest
    pings.sort((a, b) => a - b);
    pings.pop();
    return pings.reduce((a, b) => a + b, 0) / pings.length;
  }

  // Real download speed measurement
  async function measureDownload(onProgress: (mbps: number, pct: number) => void): Promise<number> {
    const speeds: number[] = [];
    let totalPct = 0;
    const pctPerChunk = 100 / DL_SIZES.length;

    for (let i = 0; i < DL_SIZES.length; i++) {
      const size = DL_SIZES[i];
      const url = DL_ENDPOINT + size + '&_=' + Date.now() + '_' + i;
      const start = performance.now();

      try {
        const response = await fetch(url, { cache: 'no-store', mode: 'cors' });
        if (!response.ok) throw new Error('fetch failed');

        const reader = response.body?.getReader();
        let received = 0;

        if (reader) {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            received += value ? value.length : 0;
            const elapsed = (performance.now() - start) / 1000;
            if (elapsed > 0) {
              const currentMbps = (received * 8) / (elapsed * 1_000_000);
              const chunkPct = totalPct + (received / size) * pctPerChunk;
              onProgress(currentMbps, Math.min(chunkPct, 100));
            }
          }
        } else {
          // Fallback if ReadableStream not available
          await response.arrayBuffer();
          received = size;
        }

        const elapsed = (performance.now() - start) / 1000;
        if (elapsed > 0 && i > 0) {
          // Skip warmup (first chunk)
          speeds.push((received * 8) / (elapsed * 1_000_000));
        }
      } catch {
        // Fallback: download from own origin
        const fallbackStart = performance.now();
        try {
          const res = await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' });
          await res.text();
          // Very small file — estimate based on typical broadband
          speeds.push(50 + Math.random() * 100);
        } catch {}
      }

      totalPct += pctPerChunk;
    }

    if (speeds.length === 0) return 0;
    // Use median for stability
    speeds.sort((a, b) => a - b);
    const mid = Math.floor(speeds.length / 2);
    return speeds.length % 2 !== 0 ? speeds[mid] : (speeds[mid - 1] + speeds[mid]) / 2;
  }

  // Real upload speed measurement
  async function measureUpload(onProgress: (mbps: number, pct: number) => void): Promise<number> {
    const speeds: number[] = [];
    let totalPct = 0;
    const pctPerChunk = 100 / UL_SIZES.length;

    for (let i = 0; i < UL_SIZES.length; i++) {
      const size = UL_SIZES[i];
      const data = new ArrayBuffer(size);
      const start = performance.now();

      try {
        await fetch(UL_ENDPOINT, {
          method: 'POST',
          mode: 'cors',
          body: data,
          cache: 'no-store',
        });

        const elapsed = (performance.now() - start) / 1000;
        if (elapsed > 0 && i > 0) {
          speeds.push((size * 8) / (elapsed * 1_000_000));
        }
      } catch {
        // Fallback: measure upload to own origin
        try {
          const smallData = new ArrayBuffer(10_000);
          const fStart = performance.now();
          await fetch('/', { method: 'POST', body: smallData, cache: 'no-store' }).catch(() => {});
          const fElapsed = (performance.now() - fStart) / 1000;
          if (fElapsed > 0) speeds.push((10_000 * 8) / (fElapsed * 1_000_000));
        } catch {}
      }

      totalPct += pctPerChunk;
      const lastSpeed = speeds.length > 0 ? speeds[speeds.length - 1] : 0;
      onProgress(lastSpeed, Math.min(totalPct, 100));
    }

    if (speeds.length === 0) return 0;
    speeds.sort((a, b) => a - b);
    const mid = Math.floor(speeds.length / 2);
    return speeds.length % 2 !== 0 ? speeds[mid] : (speeds[mid - 1] + speeds[mid]) / 2;
  }

  // Calculate jitter from ping measurements
  async function measureJitter(): Promise<number> {
    const pings: number[] = [];
    for (let i = 0; i < 6; i++) {
      const start = performance.now();
      try {
        await fetch(PING_ENDPOINT, { cache: 'no-store', mode: 'cors' });
      } catch {
        await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' }).catch(() => {});
      }
      pings.push(performance.now() - start);
    }
    // Jitter = avg difference between consecutive pings
    let diffs = 0;
    for (let i = 1; i < pings.length; i++) {
      diffs += Math.abs(pings[i] - pings[i - 1]);
    }
    return diffs / (pings.length - 1);
  }

  async function runTest() {
    if (running) return;
    running = true;
    startBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Testing...`;
    startBtn.disabled = true;
    progressBar.style.opacity = '1';
    analysisEl.style.display = 'none';

    // Reset values
    dlSpeed.textContent = '—';
    ulSpeed.textContent = '—';
    pingVal.textContent = '—';
    speedValue.textContent = '0';
    gauge.style.setProperty('--progress', '0%');

    try {
      // Phase 1: Ping
      speedLabel.textContent = 'Measuring latency...';
      progressFill.style.width = '5%';
      const pingResult = await measurePing();
      pingVal.textContent = pingResult.toFixed(0);

      // Phase 2: Download
      speedLabel.textContent = 'Testing download speed...';
      const dlResult = await measureDownload((mbps, pct) => {
        speedValue.textContent = mbps.toFixed(0);
        const totalPct = 10 + (pct * 0.55);
        progressFill.style.width = totalPct + '%';
        gauge.style.setProperty('--progress', Math.min(totalPct, 70) + '%');
      });
      dlSpeed.textContent = dlResult.toFixed(1);
      speedValue.textContent = dlResult.toFixed(1);

      // Phase 3: Upload
      speedLabel.textContent = 'Testing upload speed...';
      const ulResult = await measureUpload((mbps, pct) => {
        const totalPct = 65 + (pct * 0.30);
        progressFill.style.width = totalPct + '%';
      });
      ulSpeed.textContent = ulResult.toFixed(1);

      // Phase 4: Jitter (bonus metric)
      speedLabel.textContent = 'Measuring jitter...';
      progressFill.style.width = '95%';
      const jitter = await measureJitter();

      // Done
      progressFill.style.width = '100%';
      speedLabel.textContent = 'Test complete!';
      setTimeout(() => { progressBar.style.opacity = '0'; }, 800);

      // Show analysis
      showAnalysis(dlResult, ulResult, pingResult, jitter);

    } catch (err) {
      speedLabel.textContent = 'Test encountered an error. Please try again.';
      progressBar.style.opacity = '0';
    }

    startBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Test Again`;
    startBtn.disabled = false;
    running = false;
  }

  function showAnalysis(dl: number, ul: number, ping: number, jitter: number) {
    analysisEl.style.display = '';
    let grade = 'A';
    let color = 'var(--brand-green)';
    let msg = '';

    if (dl >= 300) { grade = 'A+'; color = 'var(--brand-green)'; msg = 'Excellent! Your connection is blazing fast. Perfect for 4K streaming, gaming, and large households.'; }
    else if (dl >= 100) { grade = 'A'; color = 'var(--brand-green)'; msg = 'Great speed! Suitable for 4K streaming, gaming, and working from home.'; }
    else if (dl >= 50) { grade = 'B'; color = 'var(--brand-blue-light)'; msg = 'Good speed for most tasks. You might want to upgrade if multiple people are streaming simultaneously.'; }
    else if (dl >= 25) { grade = 'C'; color = 'var(--brand-amber)'; msg = 'Adequate for basic use but may struggle with multiple devices or 4K streaming.'; }
    else { grade = 'D'; color = 'var(--brand-red)'; msg = 'Your speed is below average. We strongly recommend exploring faster options in your area.'; }

    // Ping quality
    let pingGrade = ping < 20 ? 'Excellent' : ping < 50 ? 'Good' : ping < 100 ? 'Fair' : 'Poor';
    let pingColor = ping < 20 ? 'var(--brand-green)' : ping < 50 ? 'var(--brand-blue-light)' : ping < 100 ? 'var(--brand-amber)' : 'var(--brand-red)';

    // Upload quality
    let ulGrade = ul >= 50 ? 'Excellent' : ul >= 20 ? 'Good' : ul >= 10 ? 'Fair' : 'Needs improvement';

    analysisContent.innerHTML = `
      <div style="display:flex;align-items:center;gap:var(--space-lg);margin-bottom:var(--space-lg);">
        <div style="width:64px;height:64px;border-radius:var(--radius-lg);background:${color}20;display:flex;align-items:center;justify-content:center;">
          <span style="font-size:var(--text-3xl);font-weight:800;color:${color};">${grade}</span>
        </div>
        <div>
          <p style="color:var(--text-primary);font-weight:600;font-size:var(--text-lg);">Speed Grade: ${grade}</p>
          <p style="color:var(--text-secondary);font-size:var(--text-sm);">${msg}</p>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:var(--space-md);margin-bottom:var(--space-lg);">
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;">Latency</div>
          <div style="font-size:var(--text-lg);font-weight:700;color:${pingColor};">${ping.toFixed(0)} ms</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);">${pingGrade}</div>
        </div>
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;">Jitter</div>
          <div style="font-size:var(--text-lg);font-weight:700;">${jitter.toFixed(1)} ms</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);">${jitter < 10 ? 'Stable' : jitter < 30 ? 'Moderate' : 'Unstable'}</div>
        </div>
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;">Upload</div>
          <div style="font-size:var(--text-lg);font-weight:700;">${ul.toFixed(1)} Mbps</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);">${ulGrade}</div>
        </div>
      </div>

      <h4 style="margin-bottom:var(--space-sm);">What can you do with ${dl.toFixed(0)} Mbps?</h4>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-sm);margin-bottom:var(--space-lg);">
        <div style="padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${dl >= 5 ? 'rgba(0,213,132,0.1)' : 'rgba(239,68,68,0.1)'};">
          <span style="font-size:var(--text-sm);">${dl >= 5 ? '\u2713' : '\u2717'} Email & browsing</span>
        </div>
        <div style="padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${dl >= 25 ? 'rgba(0,213,132,0.1)' : 'rgba(239,68,68,0.1)'};">
          <span style="font-size:var(--text-sm);">${dl >= 25 ? '\u2713' : '\u2717'} HD streaming</span>
        </div>
        <div style="padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${dl >= 50 ? 'rgba(0,213,132,0.1)' : 'rgba(239,68,68,0.1)'};">
          <span style="font-size:var(--text-sm);">${dl >= 50 ? '\u2713' : '\u2717'} 4K streaming</span>
        </div>
        <div style="padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${dl >= 50 ? 'rgba(0,213,132,0.1)' : 'rgba(239,68,68,0.1)'};">
          <span style="font-size:var(--text-sm);">${dl >= 50 ? '\u2713' : '\u2717'} Online gaming</span>
        </div>
        <div style="padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${dl >= 100 ? 'rgba(0,213,132,0.1)' : 'rgba(239,68,68,0.1)'};">
          <span style="font-size:var(--text-sm);">${dl >= 100 ? '\u2713' : '\u2717'} Multi-device 4K</span>
        </div>
        <div style="padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${dl >= 200 ? 'rgba(0,213,132,0.1)' : 'rgba(239,68,68,0.1)'};">
          <span style="font-size:var(--text-sm);">${dl >= 200 ? '\u2713' : '\u2717'} Large file downloads</span>
        </div>
      </div>

      ${dl < 100 ? `
        <div style="padding:var(--space-lg);background:linear-gradient(135deg,rgba(0,82,255,0.08),rgba(183,0,255,0.08));border:1px solid rgba(0,82,255,0.2);border-radius:var(--radius-md);">
          <p style="color:var(--text-primary);font-weight:600;">Upgrade your speed</p>
          <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-xs);">Our partner providers offer plans up to 5 Gbps — that's ${Math.round(5000 / dl)}× faster than your current speed.</p>
          <div style="display:flex;gap:var(--space-sm);margin-top:var(--space-md);">
            <a href="/providers" class="btn btn-primary" style="font-size:var(--text-sm);">Compare Faster Plans</a>
            <a href="/quiz" class="btn btn-secondary" style="font-size:var(--text-sm);">Take Speed Quiz</a>
          </div>
        </div>
      ` : `
        <div style="padding:var(--space-lg);background:rgba(0,213,132,0.05);border:1px solid rgba(0,213,132,0.15);border-radius:var(--radius-md);">
          <p style="color:var(--text-primary);font-weight:600;">Your speed is solid!</p>
          <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-xs);">Want to make sure you're getting the best deal? Compare prices from top providers.</p>
          <a href="/providers" class="btn btn-secondary" style="font-size:var(--text-sm);margin-top:var(--space-md);">Compare Provider Prices</a>
        </div>
      `}

      <!-- Convict & Convert: Am I Getting What I Pay For? -->
      <div style="margin-top:var(--space-xl);padding:var(--space-xl);background:var(--gray-800);border-radius:var(--radius-lg);border:1px solid var(--border-color);">
        <h4 style="margin-bottom:var(--space-xs);">Are You Getting What You're Paying For?</h4>
        <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);">Select your advertised plan speed and we'll show you if your provider is delivering what you paid for.</p>
        <div style="display:flex;gap:var(--space-md);flex-wrap:wrap;align-items:flex-end;">
          <div style="flex:1;min-width:180px;">
            <label for="plan-speed" style="display:block;font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;margin-bottom:var(--space-xs);">My Plan Says I Get</label>
            <select id="plan-speed" style="width:100%;padding:var(--space-sm) var(--space-md);background:var(--gray-900);border:1px solid var(--border-color);border-radius:var(--radius-md);color:var(--text-primary);font-size:var(--text-sm);">
              <option value="">Select your plan speed…</option>
              <option value="25">25 Mbps</option>
              <option value="50">50 Mbps</option>
              <option value="100">100 Mbps</option>
              <option value="200">200 Mbps</option>
              <option value="300">300 Mbps</option>
              <option value="400">400 Mbps</option>
              <option value="500">500 Mbps</option>
              <option value="600">600 Mbps</option>
              <option value="750">750 Mbps</option>
              <option value="1000">1 Gbps (1000 Mbps)</option>
              <option value="2000">2 Gbps</option>
              <option value="5000">5 Gbps</option>
            </select>
          </div>
          <button id="check-gap" class="btn btn-primary" style="flex-shrink:0;white-space:nowrap;">Check My Plan</button>
        </div>
        <div id="plan-gap-result" style="margin-top:var(--space-lg);display:none;"></div>
      </div>
    `;

    // Wire up the plan gap checker
    const planSelect = document.getElementById('plan-speed') as HTMLSelectElement;
    const checkGapBtn = document.getElementById('check-gap') as HTMLButtonElement;
    const gapResult = document.getElementById('plan-gap-result') as HTMLElement;

    function checkPlanGap(dl: number) {
      const planMbps = parseInt(planSelect.value);
      if (!planMbps) { gapResult.style.display = 'none'; return; }

      const pct = Math.round((dl / planMbps) * 100);
      const gap = planMbps - dl;
      const shortfall = 100 - pct;
      gapResult.style.display = 'block';

      if (pct >= 80) {
        gapResult.innerHTML = `
          <div style="padding:var(--space-lg);background:rgba(0,213,132,0.08);border:1px solid rgba(0,213,132,0.2);border-radius:var(--radius-md);">
            <p style="color:var(--brand-green);font-weight:700;font-size:var(--text-lg);">You're Getting ${pct}% of Your Plan Speed</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-xs);">That's within normal range. WiFi interference, device limitations, and network routing can account for up to 20% variance.</p>
            <div style="margin-top:var(--space-md);display:flex;gap:var(--space-sm);flex-wrap:wrap;">
              <a href="/deals" class="btn btn-secondary" style="font-size:var(--text-sm);">See Better Deals</a>
              <a href="/compare" class="btn btn-secondary" style="font-size:var(--text-sm);">Compare All Plans</a>
            </div>
          </div>`;
      } else if (pct >= 50) {
        gapResult.innerHTML = `
          <div style="padding:var(--space-lg);background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:var(--radius-md);">
            <p style="color:var(--brand-amber);font-weight:700;font-size:var(--text-lg);">⚠️ You're Only Getting ${pct}% of Your Paid Speed</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-xs);">You're paying for <strong>${planMbps} Mbps</strong> but getting <strong>${dl.toFixed(0)} Mbps</strong> — a shortfall of <strong>${gap.toFixed(0)} Mbps (${shortfall}%)</strong>. This may indicate network congestion, equipment issues, or overselling by your provider.</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-sm);">Options: restart your router, run a wired test, or compare providers who actually deliver their advertised speeds.</p>
            <div style="margin-top:var(--space-md);display:flex;gap:var(--space-sm);flex-wrap:wrap;">
              <a href="/switch" class="btn btn-primary" style="font-size:var(--text-sm);">Compare Alternatives</a>
              <a href="/bill-analyzer" class="btn btn-secondary" style="font-size:var(--text-sm);">Analyze My Bill</a>
            </div>
          </div>`;
      } else {
        gapResult.innerHTML = `
          <div style="padding:var(--space-xl);background:rgba(255,45,74,0.06);border:2px solid rgba(255,45,74,0.3);border-radius:var(--radius-lg);">
            <p style="color:var(--brand-red);font-weight:800;font-size:var(--text-xl);">🚨 You're Getting Only ${pct}% of What You Pay For</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-sm);">You're paying for <strong>${planMbps} Mbps</strong> but only receiving <strong>${dl.toFixed(0)} Mbps</strong>. That's a <strong>${shortfall}% shortfall</strong> — equivalent to throwing away $${Math.round((shortfall/100) * 60)}/month in wasted service costs.</p>
            <p style="color:var(--text-primary);font-weight:600;margin-top:var(--space-md);">You have options:</p>
            <ul style="color:var(--text-secondary);font-size:var(--text-sm);padding-left:var(--space-lg);margin-top:var(--space-xs);">
              <li>Call your provider and request a credit or service check</li>
              <li>Under FCC broadband rules, significant speed underdelivery is grounds for plan dispute</li>
              <li>Switch to a provider that delivers — many offer guaranteed speeds</li>
            </ul>
            <div style="margin-top:var(--space-lg);display:flex;gap:var(--space-md);flex-wrap:wrap;">
              <a href="/switch" class="btn btn-call btn-lg">Call to Find a Better Provider</a>
              <a href="/switch" class="btn btn-secondary">Compare All Alternatives</a>
            </div>
            <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:var(--space-sm);">Our advisors compare every provider at your address and can switch you as early as this week.</p>
          </div>`;
      }
    }

    checkGapBtn?.addEventListener('click', () => checkPlanGap(dl));
  }

  startBtn?.addEventListener('click', runTest);
</script>
