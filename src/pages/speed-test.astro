    animation: ringPulseIdle 2.4s ease-in-out infinite;
  }

  .st-phase-ring.tone-download {
    stroke: rgba(34, 211, 238, 0.95);
    filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.6));
    animation: ringPulseDownload 1.6s ease-in-out infinite;
  }

  .st-phase-ring.tone-upload {
    stroke: rgba(217, 70, 239, 0.95);
    filter: drop-shadow(0 0 10px rgba(217, 70, 239, 0.56));
    animation: ringPulseUpload 1.6s ease-in-out infinite;
  }

  .st-phase-ring.tone-jitter {
    stroke: rgba(251, 191, 36, 0.95);
    filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.52));
    animation: ringPulseJitter 1.1s ease-in-out infinite;
  }

  .st-phase-ring.tone-complete {
    stroke: rgba(74, 222, 128, 0.98);
    filter: drop-shadow(0 0 12px rgba(74, 222, 128, 0.62));
    animation: ringPulseComplete 1s ease-out 2;
  }

  @keyframes ringPulseIdle {
    0%, 100% { stroke-width: 2.2; opacity: 0.72; }
    50% { stroke-width: 2.8; opacity: 0.92; }
  }

  @keyframes ringPulseDownload {
    0%, 100% { stroke-width: 2.4; opacity: 0.85; }
    50% { stroke-width: 3.6; opacity: 1; }
  }

  @keyframes ringPulseUpload {
    0%, 100% { stroke-width: 2.4; opacity: 0.86; }
    50% { stroke-width: 3.6; opacity: 1; }
  }

  @keyframes ringPulseJitter {
    0%, 100% { stroke-width: 2.1; opacity: 0.82; }
    40% { stroke-width: 3.8; opacity: 1; }
    70% { stroke-width: 2.6; opacity: 0.9; }
  }

  @keyframes ringPulseComplete {
    0% { stroke-width: 2.4; opacity: 0.82; }
    40% { stroke-width: 4.4; opacity: 1; }
    100% { stroke-width: 2.6; opacity: 0.94; }
  }

  .st-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -55%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }

  .st-speed-display {
    display: flex;
    align-items: baseline;
    gap: 6px;
    pointer-events: none;
  }

  .st-speed-num {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 30px rgba(34,211,238,0.35);
  }

  .st-speed-unit {
    font-size: clamp(0.85rem, 2vw, 1.1rem);
    font-weight: 700;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .st-go-btn {
    pointer-events: all;
    width: clamp(100px, 22vw, 140px);
    height: clamp(100px, 22vw, 140px);
    border-radius: 50%;
    border: 3px solid rgba(34,211,238,0.5);
    background: radial-gradient(circle, rgba(34,211,238,0.12) 0%, rgba(6,12,31,0.95) 70%);
    color: #ffffff;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 0 40px rgba(34,211,238,0.2), 0 0 80px rgba(34,211,238,0.08), inset 0 0 30px rgba(34,211,238,0.06);
    text-shadow: 0 0 20px rgba(34,211,238,0.6);
  }

  .st-go-btn:hover {
    transform: scale(1.06);
    border-color: rgba(34,211,238,0.8);
    box-shadow: 0 0 60px rgba(34,211,238,0.35), 0 0 120px rgba(34,211,238,0.12), inset 0 0 40px rgba(34,211,238,0.1);
  }

  .st-go-btn:active { transform: scale(0.97); }

  .st-go-again {
    width: auto;
    height: auto;
    border-radius: 999px;
    padding: 8px 22px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    border-width: 1.5px;
    margin-top: 6px;
  }

  .st-phase-status {
    display: flex;
    justify-content: center;
    min-height: 34px;
    margin: 4px 0 10px;
  }

  .st-phase-badge {
    --tone-rgb: 148, 163, 184;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(var(--tone-rgb), 0.42);
    background: linear-gradient(135deg, rgba(var(--tone-rgb), 0.18), rgba(8, 18, 42, 0.82));
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(241, 245, 249, 0.96);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
    backdrop-filter: blur(4px);
    box-shadow: inset 0 0 18px rgba(var(--tone-rgb), 0.14), 0 0 18px rgba(var(--tone-rgb), 0.16);
    transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease, box-shadow 0.25s ease;
  }

  .st-phase-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(120deg, transparent 15%, rgba(255,255,255,0.18) 50%, transparent 85%);
    transform: translateX(-140%);
    animation: phaseSweep 2.6s linear infinite;
    pointer-events: none;
  }

  @keyframes phaseSweep {
    to { transform: translateX(140%); }
  }

  .st-phase-badge.tone-neutral { --tone-rgb: 148, 163, 184; }
  .st-phase-badge.tone-download { --tone-rgb: 34, 211, 238; }
  .st-phase-badge.tone-upload { --tone-rgb: 217, 70, 239; }
  .st-phase-badge.tone-jitter { --tone-rgb: 251, 191, 36; }
  .st-phase-badge.tone-complete { --tone-rgb: 74, 222, 128; }

  .st-phase-badge.tone-complete::after {
    animation-duration: 1.9s;
  }

  .st-phase-rail {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin: var(--space-sm) auto var(--space-md);
    flex-wrap: wrap;
  }

  .st-phase-step {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(148,163,184,0.15);
    color: rgba(255,255,255,0.35);
    background: rgba(15,23,42,0.5);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    transition: all 200ms ease;
  }

  .st-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    transition: background 200ms ease, box-shadow 200ms ease;
  }

  .st-phase-step.is-active {
    color: #ffffff;
    border-color: rgba(34,211,238,0.45);
    background: rgba(34,211,238,0.1);
  }

  .st-phase-step.is-active .st-dot {
    background: #22d3ee;
    box-shadow: 0 0 8px rgba(34,211,238,0.6);
  }

  .st-phase-step.is-done {
    color: rgba(134,239,172,0.8);
    border-color: rgba(74,222,128,0.3);
    background: rgba(22,101,52,0.15);
  }

  .st-phase-step.is-done .st-dot {
    background: #4ade80;
  }

  .st-bar-wrap {
    width: min(480px, 100%);
    height: 3px;
    margin: 0 auto var(--space-sm);
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    overflow: hidden;
    transition: opacity 0.4s;
  }

  .st-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #22d3ee, #818cf8);
    transition: width 0.3s ease-out;
  }

  .st-hint {
    color: rgba(255,255,255,0.4);
    font-size: var(--text-sm);
    margin: 0;
    letter-spacing: 0.01em;
  }

  /* ── Hero result display (DL / UL huge, ping/jitter secondary) ── */
  .st-metrics-hero {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .st-hero-results {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
  }

  .st-hero-result { text-align: center; }

  .st-hero-result-lbl {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: 4px;
  }

  .st-dl-result .st-hero-result-lbl { color: #22d3ee; }
  .st-ul-result .st-hero-result-lbl { color: #d946ef; }

  .st-hero-result-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
  }

  .st-hero-result-row strong {
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .st-dl-result .st-hero-result-row strong {
    text-shadow: 0 0 30px rgba(34,211,238,0.4), 0 0 60px rgba(34,211,238,0.12);
  }

  .st-ul-result .st-hero-result-row strong {
    text-shadow: 0 0 30px rgba(217,70,239,0.4), 0 0 60px rgba(217,70,239,0.12);
  }

  .st-hero-unit {
    font-size: clamp(0.7rem, 1.8vw, 0.95rem);
    font-weight: 700;
    color: rgba(255,255,255,0.35);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .st-hero-divider {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, transparent, rgba(255,255,255,0.15), transparent);
    flex-shrink: 0;
  }

  .st-secondary-results {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
    color: rgba(255,255,255,0.4);
    font-size: var(--text-xs);
  }

  .st-sec-item { display: inline-flex; align-items: baseline; gap: 4px; }

  .st-sec-lbl {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 10px;
  }

  .st-sec-item strong {
    color: rgba(255,255,255,0.55);
    font-weight: 600;
  }

  .st-sec-dot {
    color: rgba(255,255,255,0.12);
    font-size: 16px;
    line-height: 1;
  }

  .st-explainer {
    background: linear-gradient(160deg, rgba(15, 23, 42, 0.95), rgba(8, 13, 30, 0.96)) !important;
    border: 1px solid rgba(96, 165, 250, 0.2) !important;
  }

  .st-explainer-grid {
    margin-top: var(--space-lg);
    gap: var(--space-md);
  }

  .st-explainer-grid > div {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.2);
  }

  /* (st-brand-intents removed – no longer used) */

  .st-faq-wrap {
    display: grid;
    gap: 10px;
  }

  .st-faq-item {
    border: 1px solid rgba(148, 163, 184, 0.26);
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.62);
    padding: 12px 14px;
  }

  .st-faq-item summary {
    font-weight: 700;
    color: #e2e8f0;
    cursor: pointer;
  }

  .st-faq-item p {
    margin-top: 8px;
    color: #cbd5e1;
    font-size: var(--text-sm);
  }

  /* (st-last-updated removed – replaced by st-freshness) */

  /* (old st-toc rules removed – new definitions above) */

  /* HowTo Steps */
  .st-steps-list {
    counter-reset: steps;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .st-steps-list li {
    padding: 10px 0 10px 40px;
    position: relative;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    border-left: 2px solid rgba(96, 165, 250, 0.2);
  }

  .st-steps-list li::before {
    counter-increment: steps;
    content: counter(steps);
    position: absolute;
    left: -12px;
    top: 10px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.2);
    border: 1px solid rgba(96, 165, 250, 0.4);
    color: #93c5fd;
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  /* Connection Type Table */
  .st-conn-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .st-conn-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .st-conn-table th {
    padding: 12px 16px;
    text-align: left;
    background: rgba(30, 41, 59, 0.7);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
  }

  .st-conn-table td {
    padding: 12px 16px;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .st-conn-table tbody tr:hover {
    background: rgba(59, 130, 246, 0.04);
  }

  /* Provider cards */
  .st-prov-card {
    padding: var(--space-lg) !important;
    border-color: rgba(125, 211, 252, 0.15) !important;
    background: linear-gradient(160deg, rgba(8, 47, 73, 0.15), rgba(15, 23, 42, 0.9)) !important;
  }

  .st-prov-card h4 {
    color: #e2e8f0;
    margin-bottom: var(--space-sm);
  }

  /* Throttle lists */
  .st-throttle-list,
  .st-throttle-steps {
    padding-left: var(--space-xl);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .st-throttle-list li,
  .st-throttle-steps li {
    margin-bottom: var(--space-sm);
    line-height: 1.6;
  }

  /* ── Mode label (DOWNLOAD / UPLOAD / STABILITY) ── */
  .st-mode-label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: 2px;
    transition: color 0.3s;
  }
  .st-mode-label.mode-download { color: #22d3ee; }
  .st-mode-label.mode-upload   { color: #d946ef; }
  .st-mode-label.mode-jitter   { color: #fbbf24; }

  /* ── Phase-specific panel border glow ── */
  .st-panel.mode-download {
    border-color: rgba(34,211,238,0.3);
    box-shadow: 0 0 80px rgba(34,211,238,0.1) inset, 0 0 40px rgba(34,211,238,0.05), 0 20px 60px rgba(0,0,0,0.5);
  }
  .st-panel.mode-upload {
    border-color: rgba(217,70,239,0.3);
    box-shadow: 0 0 80px rgba(168,85,247,0.1) inset, 0 0 40px rgba(217,70,239,0.06), 0 20px 60px rgba(0,0,0,0.5);
  }
  .st-panel.mode-jitter {
    border-color: rgba(251,191,36,0.3);
    box-shadow: 0 0 80px rgba(251,191,36,0.08) inset, 0 0 40px rgba(249,115,22,0.05), 0 20px 60px rgba(0,0,0,0.5);
  }

  /* ── Grade badge ── */
  .st-grade-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid #22d3ee;
    background: rgba(6,12,31,0.9);
    color: #22d3ee;
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    box-shadow: 0 0 20px rgba(34,211,238,0.2), inset 0 0 15px rgba(34,211,238,0.08);
    transition: all 0.5s ease;
  }

  /* ── Glowing CTA button ── */
  .btn-cta-glow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: #ffffff;
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 24px rgba(59,130,246,0.35), 0 4px 16px rgba(0,0,0,0.3);
    transition: transform 0.2s, box-shadow 0.2s;
    animation: ctaPulse 2.5s ease-in-out infinite;
  }
  .btn-cta-glow:hover {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 0 36px rgba(59,130,246,0.5), 0 6px 24px rgba(0,0,0,0.3);
  }
  @keyframes ctaPulse {
    0%, 100% { box-shadow: 0 0 24px rgba(59,130,246,0.35), 0 4px 16px rgba(0,0,0,0.3); }
    50% { box-shadow: 0 0 36px rgba(139,92,246,0.5), 0 4px 20px rgba(0,0,0,0.3); }
  }

  /* ── Results Modal ── */
  .st-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 110000;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    animation: modalFadeIn 0.35s ease-out;
  }
  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .st-modal {
    position: relative;
    width: 100%;
    max-width: 480px;
    padding: var(--space-2xl) var(--space-xl);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, #0c1230, #0a0f1e);
    border: 1px solid rgba(34,211,238,0.2);
    box-shadow: 0 0 80px rgba(34,211,238,0.1), 0 30px 80px rgba(0,0,0,0.6);
    text-align: center;
    animation: modalSlideIn 0.4s ease-out;
  }
  @keyframes modalSlideIn {
    from { opacity: 0; transform: translateY(30px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .st-modal-x {
    position: absolute;
    top: 12px;
    right: 14px;
    background: none;
    border: none;
    color: rgba(255,255,255,0.4);
    font-size: 1.6rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s;
  }
  .st-modal-x:hover { color: #fff; }
  .st-modal-grade-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    justify-content: center;
    margin-bottom: var(--space-lg);
  }
  .st-modal-headline {
    font-size: var(--text-base);
    font-weight: 700;
    color: #e2e8f0;
    margin: 0;
    text-align: left;
  }
  .st-modal-speeds {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    margin-bottom: var(--space-md);
  }
  .st-modal-speed { text-align: center; }
  .st-modal-speed-lbl {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin-bottom: 4px;
  }
  .st-modal-dl .st-modal-speed-lbl { color: #22d3ee; }
  .st-modal-ul .st-modal-speed-lbl { color: #d946ef; }
  .st-modal-speed strong {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 900;
    color: #fff;
    line-height: 1;
  }
  .st-modal-dl strong { text-shadow: 0 0 24px rgba(34,211,238,0.4); }
  .st-modal-ul strong { text-shadow: 0 0 24px rgba(217,70,239,0.4); }
  .st-modal-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, rgba(255,255,255,0.15), transparent);
    flex-shrink: 0;
  }
  .st-modal-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    color: rgba(255,255,255,0.4);
    font-size: var(--text-xs);
    margin-bottom: var(--space-lg);
  }
  .st-modal-secondary strong { color: rgba(255,255,255,0.6); font-weight: 600; }
  .st-modal-message {
    color: rgba(255,255,255,0.7);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 var(--space-xl);
    max-width: 380px;
    margin-inline: auto;
  }
  .st-modal-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
  }
  .st-modal-actions .btn { min-width: 260px; }

  /* ── Countdown pop ── */
  .st-phase-badge {
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .st-countdown-pop {
    animation: countdownPop 0.5s ease-out;
  }
  @keyframes countdownPop {
    0% { transform: scale(2); opacity: 0; }
    40% { transform: scale(1); opacity: 1; }
    100% { opacity: 1; }
  }

  /* ── Complete flash ── */
  .st-complete-flash {
    color: #4ade80 !important;
    animation: completeFlash 1.2s ease-out;
  }
  @keyframes completeFlash {
    0% { transform: scale(1.3); opacity: 0; }
    30% { transform: scale(1); opacity: 1; }
    100% { opacity: 1; }
  }

  /* ── Go button pulse while idle ── */
