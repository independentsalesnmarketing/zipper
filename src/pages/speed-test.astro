  :global(main) .badge-green  { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
  :global(main) .badge-amber  { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
  :global(main) .badge-purple { background: rgba(168, 85, 247, 0.15); color: #c084fc; }
  :global(main) .badge-red    { background: rgba(239, 68, 68, 0.15);  color: #f87171; }

  /* btn-secondary needs dark background on this page */
  :global(main) .btn-secondary {
    background: rgba(30, 41, 59, 0.85);
    color: #e2e8f0;
    border-color: rgba(148, 163, 184, 0.3);
