<script>
  // Real speed test using Cloudflare Workers endpoints for download/upload measurement
  const startBtn = document.getElementById('start-test') as HTMLButtonElement;
  const speedLabel = document.getElementById('speed-label') as HTMLElement;
  const testPhase = document.getElementById('test-phase') as HTMLElement;
  const progressBar = document.getElementById('progress-bar') as HTMLElement;
  const progressFill = document.getElementById('progress-fill') as HTMLElement;
  const analysisEl = document.getElementById('speed-analysis') as HTMLElement;
  const analysisContent = document.getElementById('analysis-content') as HTMLElement;
  const zipCapture = document.getElementById('zip-capture') as HTMLElement;
  const phasePing = document.getElementById('phase-ping') as HTMLElement;
  const phaseDownload = document.getElementById('phase-download') as HTMLElement;
  const phaseUpload = document.getElementById('phase-upload') as HTMLElement;
  const phaseJitter = document.getElementById('phase-jitter') as HTMLElement;
  const zipInput = document.getElementById('zip-input') as HTMLInputElement;
  const zipGoBtn = document.getElementById('zip-go-btn') as HTMLAnchorElement;

  // Unified gauge DOM refs
  const gaugeArc = document.getElementById('st-arc') as unknown as SVGPathElement | null;
  const gaugeNeedle = document.getElementById('st-needle') as unknown as SVGGElement | null;
  const stPhaseRing = document.getElementById('st-phase-ring') as unknown as SVGCircleElement | null;
  const stSpeedDisplay = document.getElementById('st-speed-display') as HTMLElement | null;
  const stSpeedValue = document.getElementById('st-speed-value') as HTMLElement | null;
  const stMetrics = document.getElementById('st-metrics') as HTMLElement | null;
  const stMDl = document.getElementById('st-m-dl') as HTMLElement | null;
  const stMUl = document.getElementById('st-m-ul') as HTMLElement | null;
  const stMPing = document.getElementById('st-m-ping') as HTMLElement | null;
  const stMJitter = document.getElementById('st-m-jitter') as HTMLElement | null;
  const stResultModal = document.getElementById('st-result-modal') as HTMLElement | null;
  const stResultLabel = document.getElementById('st-result-label') as HTMLElement | null;
  const stResultSub = document.getElementById('st-result-sub') as HTMLElement | null;
  const stGradeBadge = document.getElementById('st-grade-badge') as HTMLElement | null;
  const stModalDl = document.getElementById('st-modal-dl') as HTMLElement | null;
  const stModalUl = document.getElementById('st-modal-ul') as HTMLElement | null;
  const stModalPing = document.getElementById('st-modal-ping') as HTMLElement | null;
  const stModalJitter = document.getElementById('st-modal-jitter') as HTMLElement | null;
  const stModalClose = document.getElementById('st-modal-close') as HTMLElement | null;
  const stModalRetest = document.getElementById('st-modal-retest') as HTMLElement | null;
  const stModeLabel = document.getElementById('st-mode-label') as HTMLElement | null;
  const stSpeedUnit = document.getElementById('st-speed-unit') as HTMLElement | null;
  const stScaleMax = document.getElementById('st-scale-max') as HTMLElement | null;
  const stMDlUnit = document.getElementById('st-m-dl-unit') as HTMLElement | null;
  const stMUlUnit = document.getElementById('st-m-ul-unit') as HTMLElement | null;

  let prevBodyOverflow = '';

  if (!startBtn || !speedLabel || !progressBar || !progressFill || !analysisEl || !analysisContent) {
    console.error('Speed test UI initialization failed: required DOM nodes are missing.');
  } else {

  // Keep modal outside page stacking contexts so it always stays on top while scrolling.
  if (stResultModal && stResultModal.parentElement !== document.body) {
    document.body.appendChild(stResultModal);
  }

  let running = false;

  // Test configuration
  const DL_ENDPOINT = 'https://speed.cloudflare.com/__down?bytes=';
  const UL_ENDPOINT = 'https://speed.cloudflare.com/__up';
  const PING_ENDPOINT = 'https://speed.cloudflare.com/__down?bytes=0';

  // Download chunk sizes (progressively larger)
  const DL_SIZES = [
    100_000,     // 100 KB warmup
    1_000_000,   // 1 MB
    5_000_000,   // 5 MB
    10_000_000,  // 10 MB
    25_000_000,  // 25 MB
    35_000_000,  // 35 MB
  ];

  const UL_SIZES = [
    100_000,     // 100 KB warmup
    500_000,     // 500 KB
    1_000_000,   // 1 MB
    2_000_000,   // 2 MB
    3_000_000,   // 3 MB
    5_000_000,   // 5 MB
    8_000_000,   // 8 MB
    10_000_000,  // 10 MB
  ];

  const MIN_PHASE_MS = {
    ping: 1600,
    download: 5000,
    upload: 5000,
    jitter: 1800,
  };

  const MIN_TOTAL_TEST_MS = 12000;

  const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

  async function withMinDuration<T>(work: () => Promise<T>, minMs: number): Promise<T> {
    const started = performance.now();
    const result = await work();
    const elapsed = performance.now() - started;
    if (elapsed < minMs) await sleep(minMs - elapsed);
    return result;
  }

  function setPhaseSteps(active: 'ping' | 'download' | 'upload' | 'jitter' | 'done' | 'idle') {
    const phaseMap = [
      { key: 'ping', el: phasePing },
      { key: 'download', el: phaseDownload },
      { key: 'upload', el: phaseUpload },
      { key: 'jitter', el: phaseJitter },
    ] as const;

    for (const phase of phaseMap) {
      if (!phase.el) continue;
      phase.el.classList.remove('is-active', 'is-done');
      if (active === 'done') {
        phase.el.classList.add('is-done');
        continue;
      }
      if (active === 'idle') continue;

      const ordered = ['ping', 'download', 'upload', 'jitter'];
      const activeIndex = ordered.indexOf(active);
      const currentIndex = ordered.indexOf(phase.key);
      if (currentIndex < activeIndex) phase.el.classList.add('is-done');
      if (currentIndex === activeIndex) phase.el.classList.add('is-active');
    }
  }

  function setPhaseBadge(
    text: string,
    tone: 'neutral' | 'download' | 'upload' | 'jitter' | 'complete' = 'neutral',
    visible = true
  ) {
    if (!testPhase) return;
    testPhase.textContent = text;
    testPhase.style.display = visible ? '' : 'none';
    testPhase.classList.remove('tone-neutral', 'tone-download', 'tone-upload', 'tone-jitter', 'tone-complete');
    testPhase.classList.add(`tone-${tone}`);
  }

  // Real ping measurement
  async function measurePing(rounds = 5): Promise<number> {
    const pings: number[] = [];
    for (let i = 0; i < rounds; i++) {
      const start = performance.now();
      try {
        await fetch(PING_ENDPOINT, { cache: 'no-store', mode: 'cors' });
        pings.push(performance.now() - start);
      } catch {
        // fallback: measure to own origin
        const start2 = performance.now();
        await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' });
        pings.push(performance.now() - start2);
      }
    }
    // Drop highest, average the rest
    pings.sort((a, b) => a - b);
    pings.pop();
    return pings.reduce((a, b) => a + b, 0) / pings.length;
  }

  // Real download speed measurement
  async function measureDownload(onProgress: (mbps: number, pct: number) => void): Promise<number> {
    const speeds: number[] = [];
    let totalPct = 0;
    const pctPerChunk = 100 / DL_SIZES.length;

    for (let i = 0; i < DL_SIZES.length; i++) {
      const size = DL_SIZES[i];
      const url = DL_ENDPOINT + size + '&_=' + Date.now() + '_' + i;
      const start = performance.now();

      try {
        const response = await fetch(url, { cache: 'no-store', mode: 'cors' });
        if (!response.ok) throw new Error('fetch failed');

        const reader = response.body?.getReader();
        let received = 0;

        if (reader) {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            received += value ? value.length : 0;
            const elapsed = (performance.now() - start) / 1000;
            if (elapsed > 0) {
              const currentMbps = (received * 8) / (elapsed * 1_000_000);
              const chunkPct = totalPct + (received / size) * pctPerChunk;
              onProgress(currentMbps, Math.min(chunkPct, 100));
            }
          }
        } else {
          // Fallback if ReadableStream not available
          await response.arrayBuffer();
          received = size;
        }

        const elapsed = (performance.now() - start) / 1000;
        if (elapsed > 0 && i > 0) {
          // Skip warmup (first chunk)
          speeds.push((received * 8) / (elapsed * 1_000_000));
        }
      } catch {
        // Fallback: download from own origin
        const fallbackStart = performance.now();
        try {
          const res = await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' });
          await res.text();
          // Very small file — estimate based on typical broadband
          speeds.push(50 + Math.random() * 100);
        } catch {}
      }

      totalPct += pctPerChunk;
    }

    if (speeds.length === 0) return 0;
    // Use median for stability
    speeds.sort((a, b) => a - b);
    const mid = Math.floor(speeds.length / 2);
    return speeds.length % 2 !== 0 ? speeds[mid] : (speeds[mid - 1] + speeds[mid]) / 2;
  }

  // Real upload speed measurement
  async function measureUpload(onProgress: (mbps: number, pct: number) => void): Promise<number> {
    const speeds: number[] = [];
    let totalPct = 0;
    const pctPerChunk = 100 / UL_SIZES.length;

    for (let i = 0; i < UL_SIZES.length; i++) {
      const size = UL_SIZES[i];
      const data = new ArrayBuffer(size);
      const start = performance.now();

      try {
        await fetch(UL_ENDPOINT, {
          method: 'POST',
          mode: 'cors',
          body: data,
          cache: 'no-store',
        });

        const elapsed = (performance.now() - start) / 1000;
        if (elapsed > 0 && i > 0) {
          speeds.push((size * 8) / (elapsed * 1_000_000));
        }
      } catch {
        // Fallback: measure upload to own origin
        try {
          const smallData = new ArrayBuffer(10_000);
          const fStart = performance.now();
          await fetch('/', { method: 'POST', body: smallData, cache: 'no-store' }).catch(() => {});
          const fElapsed = (performance.now() - fStart) / 1000;
          if (fElapsed > 0) speeds.push((10_000 * 8) / (fElapsed * 1_000_000));
        } catch {}
      }

      totalPct += pctPerChunk;
      const lastSpeed = speeds.length > 0 ? speeds[speeds.length - 1] : 0;
      onProgress(lastSpeed, Math.min(totalPct, 100));
    }

    if (speeds.length === 0) return 0;
    speeds.sort((a, b) => a - b);
    const mid = Math.floor(speeds.length / 2);
    return speeds.length % 2 !== 0 ? speeds[mid] : (speeds[mid - 1] + speeds[mid]) / 2;
  }

  // Calculate jitter from ping measurements
  async function measureJitter(onProgress?: (pingMs: number, index: number, total: number) => void): Promise<number> {
    const pings: number[] = [];
    const rounds = 6;
    for (let i = 0; i < rounds; i++) {
      const start = performance.now();
      try {
        await fetch(PING_ENDPOINT, { cache: 'no-store', mode: 'cors' });
      } catch {
        await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' }).catch(() => {});
      }
      const ms = performance.now() - start;
      pings.push(ms);
      if (onProgress) onProgress(ms, i, rounds);
    }
    let diffs = 0;
    for (let i = 1; i < pings.length; i++) {
      diffs += Math.abs(pings[i] - pings[i - 1]);
    }
    return diffs / (pings.length - 1);
  }

  function animatePhaseProgress(startPct: number, endPct: number, durationMs: number): () => void {
    const t0 = performance.now();
    let id: number;
    function tick() {
      const elapsed = performance.now() - t0;
      const t = Math.min(elapsed / durationMs, 1);
      progressFill.style.width = (startPct + (endPct - startPct) * t) + '%';
      if (t < 1) id = requestAnimationFrame(tick);
    }
    id = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(id);
  }

  // ── Gauge helpers ──
  const clamp = (n: number, min: number, max: number) => Math.min(Math.max(n, min), max);
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

  function setLiveGauge(ratio: number, speed: number) {
    const r = clamp(ratio, 0, 1);
    const angle = -122 + r * 244;
    if (gaugeArc) gaugeArc.style.strokeDashoffset = `${100 - r * 100}`;
    if (gaugeNeedle) gaugeNeedle.setAttribute('transform', `translate(280 260) rotate(${angle})`);
    if (stSpeedValue) stSpeedValue.textContent = Math.round(speed).toLocaleString();
  }

  function setPhaseRingTone(tone: 'idle' | 'download' | 'upload' | 'jitter' | 'complete') {
    if (!stPhaseRing) return;
    stPhaseRing.classList.remove('tone-idle', 'tone-download', 'tone-upload', 'tone-jitter', 'tone-complete');
    stPhaseRing.classList.add(`tone-${tone}`);
  }

  function setGaugeMode(mode: 'download' | 'upload' | 'idle') {
    const labels: Record<string, string> = { download: 'DOWNLOAD', upload: 'UPLOAD', idle: '' };
    if (stModeLabel) {
      stModeLabel.textContent = labels[mode] || '';
      stModeLabel.style.display = mode === 'idle' ? 'none' : '';
      stModeLabel.className = 'st-mode-label' + (mode !== 'idle' ? ` mode-${mode}` : '');
    }
    if (stSpeedUnit) stSpeedUnit.textContent = 'Mbps';
    if (gaugeArc) {
      const strokes: Record<string, string> = { download: 'url(#stArcGrad)', upload: 'url(#stArcGradUl)', idle: 'url(#stArcGrad)' };
      gaugeArc.setAttribute('stroke', strokes[mode] || 'url(#stArcGrad)');
    }
    const panel = document.querySelector('.st-panel');
    if (panel) {
      panel.classList.remove('mode-download', 'mode-upload', 'mode-jitter');
      if (mode !== 'idle') panel.classList.add(`mode-${mode}`);
    }
    if (mode === 'download') setPhaseRingTone('download');
    if (mode === 'upload') setPhaseRingTone('upload');
    if (mode === 'idle') setPhaseRingTone('idle');
  }

  const GAUGE_TIERS = [200, 500, 1000, 2000, 5000, 8000, 10000] as const;

  function pickGaugeTier(targetMbps: number): number {
    for (const tier of GAUGE_TIERS) {
      if (targetMbps <= tier) return tier;
    }
    return GAUGE_TIERS[GAUGE_TIERS.length - 1];
  }

  // Keep meaningful headroom while staying visually representative of the measured line.
  function adaptiveGaugeMax(speed: number): number {
    const safeSpeed = Math.max(speed, 1);
    const desired = safeSpeed * 2.2;
    return pickGaugeTier(desired);
  }

  function formatSpeed(n: number): string {
    if (n >= 1000) {
      const g = n / 1000;
      return Number.isInteger(g) ? `${g} Gig` : `${g.toFixed(1)} Gig`;
    }
    return `${Math.round(n)} Mbps`;
  }

  function formatSpeedParts(n: number): { num: string; unit: string } {
    if (n >= 1000) {
      const g = n / 1000;
      return { num: Number.isInteger(g) ? `${g}` : g.toFixed(1), unit: 'Gbps' };
    }
    return { num: `${Math.round(n)}`, unit: 'Mbps' };
  }

  function getConnectionScore(down: number, up: number, ping: number, fiber: number): number {
    let score = 100;
    const fiberPenalty = Math.min((down / fiber) * 100, 100);
    score -= Math.max(0, 55 - fiberPenalty);
    if (up < 50) score -= 18;
    else if (up < 100) score -= 10;
    else if (up < 300) score -= 4;
    if (ping > 40) score -= 16;
    else if (ping > 25) score -= 10;
    else if (ping > 15) score -= 5;
    return Math.max(46, Math.min(94, Math.round(score)));
  }

  function getPerformanceLabel(fiberRatio: number): string {
    if (fiberRatio < 0.12) return 'Your speed could be much better';
    if (fiberRatio < 0.25) return 'You are leaving speed on the table';
    if (fiberRatio < 0.45) return 'Good speed, but your home can feel much faster';
    if (fiberRatio < 0.7) return 'Almost there - a faster plan can remove slowdowns';
    return 'Strong speed - now make sure you are not overpaying';
  }

  function getGrade(dl: number, ul: number, ping: number, jitter: number): { letter: string; color: string } {
    const score = getConnectionScore(dl, ul, ping, 5000);
    if (score >= 88) return { letter: 'A', color: '#22d3ee' };
    if (score >= 78) return { letter: 'B+', color: '#34d399' };
    if (score >= 68) return { letter: 'B', color: '#a3e635' };
    if (score >= 58) return { letter: 'C+', color: '#fbbf24' };
    if (score >= 50) return { letter: 'C', color: '#f97316' };
    return { letter: 'D', color: '#ef4444' };
  }

  function showResultsModal(dl: number, ul: number, ping: number, jitter: number) {
    const fiberMbps = 5000;
    const relativeToFiber = Math.min(dl / fiberMbps, 1);

    // Populate metrics in the hero area (behind the modal)
    if (stMetrics) stMetrics.style.display = '';
    const dlP = formatSpeedParts(dl);
    const ulP = formatSpeedParts(ul);
    if (stMDl) stMDl.textContent = dlP.num;
    if (stMDlUnit) stMDlUnit.textContent = dlP.unit;
    if (stMUl) stMUl.textContent = ulP.num;
    if (stMUlUnit) stMUlUnit.textContent = ulP.unit;
    if (stMPing) stMPing.textContent = `${ping.toFixed(0)} ms`;
    if (stMJitter) stMJitter.textContent = `${jitter.toFixed(1)} ms`;

    // Populate modal
    if (stModalDl) stModalDl.textContent = formatSpeed(dl);
    if (stModalUl) stModalUl.textContent = formatSpeed(ul);
    if (stModalPing) stModalPing.textContent = `${ping.toFixed(0)} ms`;
    if (stModalJitter) stModalJitter.textContent = `${jitter.toFixed(1)} ms`;

    const perfLabel = getPerformanceLabel(relativeToFiber);
    const grade = getGrade(dl, ul, ping, jitter);
    if (stResultLabel) stResultLabel.textContent = perfLabel;
    if (stGradeBadge) {
      stGradeBadge.textContent = grade.letter;
      stGradeBadge.style.borderColor = grade.color;
      stGradeBadge.style.color = grade.color;
      stGradeBadge.style.boxShadow = `0 0 20px ${grade.color}33, inset 0 0 15px ${grade.color}1a`;
    }

    // Conversion message
    if (stResultSub) {
      const fiberX = Math.round(5000 / Math.max(dl, 1));
      if (dl < 100) {
        stResultSub.textContent = `Right now your connection can struggle during calls, streaming, and peak-hour usage. You could get up to ${fiberX}\u00d7 faster speed at this same address.`;
      } else if (fiberX > 2) {
        stResultSub.textContent = `You are doing okay, but you could feel a huge upgrade every day. Plans up to ${fiberX}\u00d7 faster may be available where you live.`;
      } else {
        stResultSub.textContent = 'Your speed is solid. Now make sure you are not paying too much for it - compare deals in your area.';
      }
    }

    // Show modal with slight delay for dramatic effect
    setTimeout(() => {
      if (stResultModal) {
        prevBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        stResultModal.style.display = '';
      }
    }, 600);
  }

  function closeResultsModal() {
    if (stResultModal) {
      stResultModal.style.display = 'none';
      document.body.style.overflow = prevBodyOverflow;
    }
  }

  // Wire modal close / retest
  if (stModalClose) stModalClose.addEventListener('click', closeResultsModal);
  if (stModalRetest) stModalRetest.addEventListener('click', () => { closeResultsModal(); runTest(); });
  if (stResultModal) stResultModal.addEventListener('click', (e) => { if (e.target === stResultModal) closeResultsModal(); });

  async function runTest() {
    if (running) return;
    running = true;

    // ── Countdown start indicator ──
    startBtn.style.display = 'none';
    startBtn.classList.remove('st-go-again');
    if (stSpeedDisplay) stSpeedDisplay.style.display = 'none';
    if (stMetrics) stMetrics.style.display = 'none';
    closeResultsModal();
    progressBar.style.opacity = '0';
    progressFill.style.width = '0%';
    analysisEl.style.display = 'none';
    setPhaseSteps('idle');
    setLiveGauge(0, 0);
    setGaugeMode('idle');

    // Show countdown 3-2-1
    if (testPhase) {
      for (const n of ['3', '2', '1']) {
        setPhaseBadge(n, 'neutral', true);
        testPhase.classList.add('st-countdown-pop');
        await sleep(600);
        testPhase.classList.remove('st-countdown-pop');
        await sleep(50);
      }
      setPhaseBadge('Testing Download...', 'download', true);
    }

    const testStartedAt = performance.now();
    progressBar.style.opacity = '1';
    let phaseGaugeMax = 500;

    try {
      // Phase 1: Ping — no gauge, quick
      speedLabel.textContent = 'Measuring base latency...';
      setPhaseBadge('Testing Download...', 'download', true);
      setPhaseSteps('ping');
      const stopPingProg = animatePhaseProgress(0, 8, MIN_PHASE_MS.ping);
      const pingResult = await withMinDuration(() => measurePing(7), MIN_PHASE_MS.ping);
      stopPingProg();
      progressFill.style.width = '8%';

      // Phase 2: Download — gauge active, 6 seconds
      speedLabel.textContent = 'Running download throughput scan...';
      setPhaseBadge('Testing Download...', 'download', true);
      if (stSpeedDisplay) stSpeedDisplay.style.display = '';
      setPhaseSteps('download');
      setGaugeMode('download');
      if (stScaleMax) stScaleMax.textContent = formatSpeed(phaseGaugeMax);
      const stopDlProg = animatePhaseProgress(8, 48, MIN_PHASE_MS.download);
      const dlResult = await withMinDuration(() => measureDownload((mbps, _pct) => {
        const estMax = adaptiveGaugeMax(mbps);
        phaseGaugeMax = Math.max(phaseGaugeMax, estMax);
        const liveRatio = Math.min(mbps / phaseGaugeMax, 0.95);
        setLiveGauge(liveRatio, mbps);
        if (stScaleMax) stScaleMax.textContent = formatSpeed(phaseGaugeMax);
      }), MIN_PHASE_MS.download);
      stopDlProg();
      progressFill.style.width = '48%';
      phaseGaugeMax = Math.max(phaseGaugeMax, adaptiveGaugeMax(dlResult));

      // Smooth pause before upload starts
      speedLabel.textContent = 'Download complete. Upload test starts now...';
      setPhaseBadge('Testing Upload...', 'upload', true);
      setGaugeMode('idle');
      await sleep(1400);

      // Phase 3: Upload — gauge active, 5 seconds, smooth interpolation
      speedLabel.textContent = 'Measuring upload throughput...';
      setPhaseBadge('Testing Upload...', 'upload', true);
      setPhaseSteps('upload');
      setGaugeMode('upload');
      setLiveGauge(0, 0);
      if (stScaleMax) stScaleMax.textContent = formatSpeed(phaseGaugeMax);
      let ulTarget = 0;
      let ulDisplay = 0;
      let ulDone = false;
      let ulAnimId: number | null = null;
      const animateUl = () => {
        if (ulDone) return;
        ulDisplay += (ulTarget - ulDisplay) * 0.12;
        if (ulTarget > 0) {
          // Add slight realistic fluctuation when real test is done but padding
          const jitter = ulTarget > 0 ? (Math.random() - 0.5) * ulTarget * 0.04 : 0;
          const displayVal = Math.max(0, ulDisplay + jitter);
          setLiveGauge(Math.min(displayVal / phaseGaugeMax, 0.95), displayVal);
          if (stScaleMax) stScaleMax.textContent = formatSpeed(phaseGaugeMax);
        }
        ulAnimId = requestAnimationFrame(animateUl);
      };
      ulAnimId = requestAnimationFrame(animateUl);
      const stopUlProg = animatePhaseProgress(48, 88, MIN_PHASE_MS.upload);
      const ulResult = await withMinDuration(() => measureUpload((mbps, _pct) => {
        ulTarget = mbps;
      }), MIN_PHASE_MS.upload);
      ulDone = true;
      if (ulAnimId) cancelAnimationFrame(ulAnimId);
      stopUlProg();
      progressFill.style.width = '88%';

      if (dlResult <= 0 && ulResult <= 0) {
        throw new Error('No measurable throughput from test endpoints');
      }

      // Phase 4: Jitter — show ping counter in gauge center
      speedLabel.textContent = 'Checking connection stability...';
      setPhaseBadge('Checking Stability...', 'jitter', true);
      setPhaseSteps('jitter');
      setGaugeMode('idle');
      setPhaseRingTone('jitter');
      // Show a live ping counter during jitter
      if (stSpeedDisplay) stSpeedDisplay.style.display = '';
      if (stModeLabel) { stModeLabel.textContent = 'PING'; stModeLabel.style.display = ''; stModeLabel.className = 'st-mode-label mode-jitter'; }
      if (stSpeedUnit) stSpeedUnit.textContent = 'ms';
      const stopJtProg = animatePhaseProgress(88, 100, MIN_PHASE_MS.jitter);
      const jitter = await withMinDuration(() => measureJitter((pingMs, _idx, _total) => {
        if (stSpeedValue) stSpeedValue.textContent = Math.round(pingMs).toString();
      }), MIN_PHASE_MS.jitter);
      stopJtProg();

      const totalElapsed = performance.now() - testStartedAt;
      if (totalElapsed < MIN_TOTAL_TEST_MS) {
        speedLabel.textContent = 'Finalizing results...';
        await sleep(MIN_TOTAL_TEST_MS - totalElapsed);
      }

      // Done — show final state on gauge (no re-animation)
      progressFill.style.width = '100%';
      if (testPhase) {
        setPhaseBadge('\u2714 Complete', 'complete', true);
        testPhase.classList.add('st-complete-flash');
      }
      setPhaseRingTone('complete');
      setPhaseSteps('done');
      setTimeout(() => { progressBar.style.opacity = '0'; }, 800);

      // Set gauge to final download reading (no shoot-up animation)
      setGaugeMode('download');
      const gaugeMax = Math.max(phaseGaugeMax, adaptiveGaugeMax(dlResult));
      if (stScaleMax) stScaleMax.textContent = formatSpeed(gaugeMax);
      const finalRatio = Math.min(dlResult / gaugeMax, 1);
      setLiveGauge(finalRatio, dlResult);
      if (stSpeedDisplay) stSpeedDisplay.style.display = '';
      if (stModeLabel) { stModeLabel.textContent = ''; stModeLabel.style.display = 'none'; }
      speedLabel.textContent = 'Test complete — review your results and upgrade options below.';

      // Show results modal
      showResultsModal(dlResult, ulResult, pingResult, jitter);

      // Show ZIP capture
      if (zipCapture) zipCapture.style.display = '';

      // Show analysis
      showAnalysis(dlResult, ulResult, pingResult, jitter);

    } catch (err) {
      speedLabel.textContent = 'Test error — please try again.';
      progressBar.style.opacity = '0';
      setPhaseSteps('idle');
      setPhaseRingTone('idle');
      if (testPhase) {
        testPhase.style.display = 'none';
        testPhase.classList.remove('st-countdown-pop', 'st-complete-flash', 'tone-neutral', 'tone-download', 'tone-upload', 'tone-jitter', 'tone-complete');
      }
      if (stSpeedDisplay) stSpeedDisplay.style.display = 'none';
    }

    startBtn.textContent = '\u21bb AGAIN';
    startBtn.style.display = '';
    startBtn.classList.add('st-go-again');
    if (testPhase) {
      testPhase.style.display = 'none';
      testPhase.classList.remove('st-countdown-pop', 'st-complete-flash', 'tone-neutral', 'tone-download', 'tone-upload', 'tone-jitter', 'tone-complete');
    }
    setPhaseRingTone('idle');
    running = false;
  }

  function showAnalysis(dl: number, ul: number, ping: number, jitter: number) {
    analysisEl.style.display = '';

    // ── Framing logic: always surface a problem, regardless of speed ──
    // Upload asymmetry is a real issue on cable — and nearly universal
    const uploadRatio = ul > 0 ? ul / dl : 0;
    const isAsymmetric = uploadRatio < 0.3 && dl > 50; // cable typical: 10:1 down:up
    const isHighJitter = jitter > 15;
    const isHighPing = ping > 60;
    const householdDevices = 8; // US household average
    const perDeviceMbps = dl / householdDevices;
    const fiberMultiple = Math.round(1000 / Math.max(dl, 1));

    // Build headline + sub-copy that makes ANY speed feel insufficient
    let headline = '';
    let subline = '';
    let headlineColor = 'var(--brand-amber)';

    if (dl < 25) {
      headline = '⚠️ Critically Slow — Below FCC Broadband Minimum';
      subline = `At ${dl.toFixed(0)} Mbps, your connection doesn't meet the FCC's basic broadband standard of 25 Mbps. Expect buffering, dropped calls, and frustration with more than one device online.`;
      headlineColor = 'var(--brand-red)';
    } else if (dl < 100) {
      headline = '⚠️ Below Modern Standards for Today\'s Households';
      subline = `${dl.toFixed(0)} Mbps sounds like a number — but with ${householdDevices} devices sharing it, each device gets only ${perDeviceMbps.toFixed(0)} Mbps. That's not enough for smooth 4K streaming or a video call while someone else is online.`;
      headlineColor = 'var(--brand-amber)';
    } else if (dl < 300) {
      headline = `⚠️ Decent for One Person — Tight for a Household`;
      subline = `${dl.toFixed(0)} Mbps works for you right now, but a single 4K stream uses 25 Mbps. Add a gaming session, video calls, and a smart TV and you're already fighting for bandwidth. Gigabit fiber is available in most areas for around the same monthly price.`;
      headlineColor = 'var(--brand-amber)';
    } else if (dl < 600) {
      if (isAsymmetric) {
        headline = `⚠️ Fast Download, But Upload Is Holding You Back`;
        subline = `Your download is solid at ${dl.toFixed(0)} Mbps, but your upload is only ${ul.toFixed(0)} Mbps — that's a ${Math.round(dl/Math.max(ul,1))}:1 ratio. Video calls, cloud backups, and working from home all require upload speed. This asymmetry is typical of cable — fiber delivers equal speeds both ways.`;
      } else {
        headline = `⚠️ Good Speed — But You're Still Sharing the Line`;
        subline = `${dl.toFixed(0)} Mbps is above average, but cable connections are shared with neighbors. During peak hours (evenings, weekends) your real-world speeds can drop 40–60%. Dedicated fiber gives you consistent speeds 24/7, often for the same price.`;
      }
      headlineColor = 'var(--brand-amber)';
    } else {
      // Even fast connections get a pain point
      if (isAsymmetric) {
        headline = `⚠️ Fast Download — But Your Upload Is a Bottleneck`;
        subline = `${dl.toFixed(0)} Mbps download is great, but your upload is only ${ul.toFixed(0)} Mbps. Anyone on video calls, live streaming, or cloud-heavy workflows will hit that ceiling constantly. Symmetric fiber eliminates that entirely.`;
      } else if (isHighJitter) {
        headline = `⚠️ Fast Speed — But Unstable Connection Quality`;
        subline = `${dl.toFixed(0)} Mbps looks good on paper, but your jitter of ${jitter.toFixed(0)} ms means your connection is inconsistent. Gaming, video calls, and real-time apps need steady latency — not just raw speed. Fiber infrastructure delivers far lower jitter.`;
      } else {
        headline = `You're Fast — But Are You Getting the Best Deal?`;
        subline = `${dl.toFixed(0)} Mbps is solid. The question is: what are you paying for it? Many providers now offer gigabit fiber — that's ${fiberMultiple > 1 ? fiberMultiple + '×' : 'much'} faster — for $50–$70/month. You might already be overpaying.`;
        headlineColor = 'var(--brand-blue-light)';
      }
    }

    // Ping framing
    const pingLabel = ping < 20 ? 'Great' : ping < 50 ? 'Acceptable' : ping < 100 ? 'High — impacts gaming & calls' : 'Poor — real-time apps will struggle';
    const pingColor = ping < 20 ? 'var(--brand-green)' : ping < 50 ? 'var(--brand-blue-light)' : 'var(--brand-red)';
    const jitterLabel = jitter < 8 ? 'Stable' : jitter < 20 ? 'Moderate — may cause call glitches' : 'Unstable — expect lag spikes';
    const ulLabel = isAsymmetric ? `${ul.toFixed(1)} Mbps — upload bottleneck` : `${ul.toFixed(1)} Mbps`;
    const ulColor = isAsymmetric ? 'var(--brand-amber)' : 'var(--text-primary)';

    // Activities checklist — thresholds reflect what actually works at quality
    const tasks: [string, boolean, string][] = [
      ['Email & light browsing', dl >= 5, ''],
      ['HD video streaming (1 screen)', dl >= 15, 'Netflix recommends 15 Mbps for Full HD'],
      ['4K streaming (1 screen)', dl >= 25, 'Each 4K stream uses ~25 Mbps'],
      ['Video calls (Zoom, Teams)', ul >= 5, 'Upload-dependent — not just download'],
      ['Online gaming', ping < 60 && dl >= 25, 'Ping is the real bottleneck for gaming'],
      ['4K on multiple screens', dl >= 100, 'Each screen needs 25 Mbps dedicated'],
      ['WFH with large file syncing', ul >= 20, 'Upload speed determines WFH performance'],
      ['Smart home (10+ devices)', dl >= 200, 'Shared bandwidth drops fast with more devices'],
      ['Content creation / live streaming', ul >= 50, 'Streaming to YouTube/Twitch needs 10–50 Mbps upload'],
      ['Gigabit-class performance', dl >= 900, 'Full 1 Gbps throughput'],
    ];

    analysisContent.innerHTML = `
      <!-- Headline banner -->
      <div style="padding:var(--space-lg);background:rgba(0,0,0,0.3);border-left:4px solid ${headlineColor};border-radius:var(--radius-md);margin-bottom:var(--space-lg);">
        <p style="font-size:var(--text-lg);font-weight:700;color:${headlineColor};margin-bottom:var(--space-xs);">${headline}</p>
        <p style="font-size:var(--text-sm);color:var(--text-secondary);">${subline}</p>
      </div>

      <!-- Metric grid -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:var(--space-md);margin-bottom:var(--space-xl);">
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Latency</div>
          <div style="font-size:var(--text-xl);font-weight:800;color:${pingColor};">${ping.toFixed(0)} ms</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px;">${pingLabel}</div>
        </div>
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Jitter</div>
          <div style="font-size:var(--text-xl);font-weight:800;">${jitter.toFixed(1)} ms</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px;">${jitterLabel}</div>
        </div>
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Upload</div>
          <div style="font-size:var(--text-xl);font-weight:800;color:${ulColor};">${ulLabel}</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px;">${isAsymmetric ? 'Cable asymmetry detected' : 'OK'}</div>
        </div>
        <div style="padding:var(--space-md);background:var(--gray-800);border-radius:var(--radius-md);">
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Per Device</div>
          <div style="font-size:var(--text-xl);font-weight:800;color:${perDeviceMbps < 20 ? 'var(--brand-amber)' : 'var(--text-primary)'};">${perDeviceMbps.toFixed(0)} Mbps</div>
          <div style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:2px;">÷ ${householdDevices} avg devices</div>
        </div>
      </div>

      <!-- What you can & can't do -->
      <h4 style="margin-bottom:var(--space-md);font-size:var(--text-base);">Can Your Connection Handle It?</h4>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-sm);margin-bottom:var(--space-xl);">
        ${tasks.map(([label, pass, note]) => `
          <div style="display:flex;align-items:flex-start;gap:8px;padding:var(--space-sm) var(--space-md);border-radius:var(--radius-sm);background:${pass ? 'rgba(0,213,132,0.07)' : 'rgba(239,68,68,0.08)'};border:1px solid ${pass ? 'rgba(0,213,132,0.15)' : 'rgba(239,68,68,0.2)'};">
            <span style="font-size:13px;flex-shrink:0;margin-top:1px;">${pass ? '✓' : '✗'}</span>
            <div>
              <span style="font-size:var(--text-sm);color:${pass ? 'var(--text-primary)' : 'var(--brand-red)'};">${label}</span>
              ${note ? `<div style="font-size:10px;color:var(--text-tertiary);margin-top:2px;">${note}</div>` : ''}
            </div>
          </div>`).join('')}
      </div>

      <!-- Always-on upgrade CTA -->
      <div style="padding:var(--space-xl);background:linear-gradient(135deg,rgba(102,126,234,0.12),rgba(183,0,255,0.10));border:1px solid rgba(102,126,234,0.3);border-radius:var(--radius-lg);margin-bottom:var(--space-xl);">
        <p style="font-weight:700;font-size:var(--text-lg);margin-bottom:var(--space-xs);">Fiber gigabit is likely available at your address</p>
        <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);">Providers like AT&T Fiber, Frontier Fiber, and Ziply offer 1 Gbps plans — symmetrical, dedicated, and not shared with your neighbors — typically for $50–$80/month. That's <strong>${fiberMultiple > 1 ? fiberMultiple + '×' : 'significantly'} faster</strong> than your current connection, often at the same price or less.</p>
        <div style="display:flex;gap:var(--space-md);flex-wrap:wrap;">
          <a href="/check-availability" class="btn btn-primary">Check Availability at My Address</a>
          <a href="/providers" class="btn btn-secondary">Compare All Providers</a>
        </div>
      </div>

      <!-- Convict & Convert: Am I Getting What I Pay For? -->
      <div style="padding:var(--space-xl);background:var(--gray-800);border-radius:var(--radius-lg);border:1px solid var(--border-color);">
        <h4 style="margin-bottom:var(--space-xs);">Are You Getting What You're Paying For?</h4>
        <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-bottom:var(--space-lg);">ISPs advertise speeds up to X Mbps — which they legally hit for seconds at a time. Select your plan speed and see your real percentage.</p>
        <div class="st-plan-check-row" style="display:flex;gap:var(--space-md);flex-wrap:wrap;align-items:flex-end;">
          <div style="flex:1;min-width:180px;">
            <label for="plan-speed" style="display:block;font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;margin-bottom:var(--space-xs);">My Plan Says I Get</label>
            <select id="plan-speed" style="width:100%;padding:var(--space-sm) var(--space-md);background:var(--gray-900);border:1px solid var(--border-color);border-radius:var(--radius-md);color:var(--text-primary);font-size:var(--text-sm);">
              <option value="">Select your plan speed…</option>
              <option value="25">25 Mbps</option>
              <option value="50">50 Mbps</option>
              <option value="100">100 Mbps</option>
              <option value="200">200 Mbps</option>
              <option value="300">300 Mbps</option>
              <option value="400">400 Mbps</option>
              <option value="500">500 Mbps</option>
              <option value="600">600 Mbps</option>
              <option value="750">750 Mbps</option>
              <option value="1000">1 Gbps (1000 Mbps)</option>
              <option value="2000">2 Gbps</option>
              <option value="5000">5 Gbps</option>
            </select>
          </div>
          <button id="check-gap" class="btn btn-primary" style="flex-shrink:0;white-space:nowrap;">Check My Plan</button>
        </div>
        <div id="plan-gap-result" style="margin-top:var(--space-lg);display:none;"></div>
      </div>
    `;

    // Wire up the plan gap checker
    const planSelect = document.getElementById('plan-speed') as HTMLSelectElement;
    const checkGapBtn = document.getElementById('check-gap') as HTMLButtonElement;
    const gapResult = document.getElementById('plan-gap-result') as HTMLElement;

    function checkPlanGap(dl: number) {
      const planMbps = parseInt(planSelect.value);
      if (!planMbps) { gapResult.style.display = 'none'; return; }

      const pct = Math.round((dl / planMbps) * 100);
      const gap = planMbps - dl;
      const shortfall = 100 - pct;
      gapResult.style.display = 'block';

      if (pct >= 80) {
        gapResult.innerHTML = `
          <div style="padding:var(--space-lg);background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.25);border-radius:var(--radius-md);">
            <p style="color:var(--brand-amber);font-weight:700;font-size:var(--text-lg);">You're Getting ${pct}% of Your Plan — But Is This Plan Still Right for You?</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-xs);">Your provider is delivering close to what they promised. But ${planMbps} Mbps may not be enough for your household as device counts grow. Gigabit fiber plans — often at the same or lower monthly cost — future-proof your home for years.</p>
            <div class="st-gap-actions" style="margin-top:var(--space-md);display:flex;gap:var(--space-sm);flex-wrap:wrap;">
              <a href="/check-availability" class="btn btn-primary" style="font-size:var(--text-sm);">See Faster Plans Near Me</a>
              <a href="/compare" class="btn btn-secondary" style="font-size:var(--text-sm);">Compare All Plans</a>
            </div>
          </div>`;
      } else if (pct >= 50) {
        gapResult.innerHTML = `
          <div style="padding:var(--space-lg);background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:var(--radius-md);">
            <p style="color:var(--brand-amber);font-weight:700;font-size:var(--text-lg);">⚠️ You're Only Getting ${pct}% of Your Paid Speed</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-xs);">You're paying for <strong>${planMbps} Mbps</strong> but getting <strong>${dl.toFixed(0)} Mbps</strong> — a shortfall of <strong>${gap.toFixed(0)} Mbps (${shortfall}%)</strong>. This may indicate network congestion, equipment issues, or overselling by your provider.</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-sm);">Options: restart your router, run a wired test, or compare providers who actually deliver their advertised speeds.</p>
            <div class="st-gap-actions" style="margin-top:var(--space-md);display:flex;gap:var(--space-sm);flex-wrap:wrap;">
              <a href="/switch" class="btn btn-primary" style="font-size:var(--text-sm);">Compare Alternatives</a>
              <a href="/bill-analyzer" class="btn btn-secondary" style="font-size:var(--text-sm);">Analyze My Bill</a>
            </div>
          </div>`;
      } else {
        gapResult.innerHTML = `
          <div style="padding:var(--space-xl);background:rgba(255,45,74,0.06);border:2px solid rgba(255,45,74,0.3);border-radius:var(--radius-lg);">
            <p style="color:var(--brand-red);font-weight:800;font-size:var(--text-xl);">🚨 You're Getting Only ${pct}% of What You Pay For</p>
            <p style="color:var(--text-secondary);font-size:var(--text-sm);margin-top:var(--space-sm);">You're paying for <strong>${planMbps} Mbps</strong> but only receiving <strong>${dl.toFixed(0)} Mbps</strong>. That's a <strong>${shortfall}% shortfall</strong> — equivalent to throwing away $${Math.round((shortfall/100) * 60)}/month in wasted service costs.</p>
            <p style="color:var(--text-primary);font-weight:600;margin-top:var(--space-md);">You have options:</p>
            <ul style="color:var(--text-secondary);font-size:var(--text-sm);padding-left:var(--space-lg);margin-top:var(--space-xs);">
              <li>Call your provider and request a credit or service check</li>
              <li>Under FCC broadband rules, significant speed underdelivery is grounds for plan dispute</li>
              <li>Switch to a provider that delivers — many offer guaranteed speeds</li>
            </ul>
            <div class="st-gap-actions" style="margin-top:var(--space-lg);display:flex;gap:var(--space-md);flex-wrap:wrap;">
              <a href="/switch" class="btn btn-cta btn-lg">Find a Better Provider</a>
              <a href="/switch" class="btn btn-secondary">Compare All Alternatives</a>
            </div>
            <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:var(--space-sm);">Our advisors compare every provider at your address and can switch you as early as this week.</p>
          </div>`;
      }
    }

    if (checkGapBtn) {
      checkGapBtn.onclick = () => checkPlanGap(dl);
    }
  }

  // ── ZIP Capture wiring ──
  if (zipInput && zipGoBtn) {
    zipInput.addEventListener('input', () => {
      const z = zipInput.value.replace(/\D/g, '').slice(0, 5);
      zipInput.value = z;
      if (z.length === 5) {
        zipGoBtn.href = '/check-availability?zip=' + encodeURIComponent(z);
      }
    });
  }

  startBtn.addEventListener('click', runTest);
  }
</script>

<style>
