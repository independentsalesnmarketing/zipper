---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getAllProviders, getPartnerProviders, formatSpeed, formatPrice, getMinPrice, getMaxSpeed, getMaxUpload, getTypeLabel, MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel, generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';
import type { Provider } from '@lib/providers';

export function getStaticPaths() {
  const allProviders = getAllProviders();
  return allProviders.map(p => ({
    params: { provider: p.slug },
    props: { provider: p },
  }));
}

interface Props { provider: Provider; }
const { provider } = Astro.props;

const year = new Date().getFullYear();
const maxSpeed = getMaxSpeed(provider);
const maxUpload = getMaxUpload(provider);
const minPrice = getMinPrice(provider);
const partners = getPartnerProviders();
const isPartner = provider.isPartner;
const phone = isPartner ? provider.phone : MAIN_PHONE;
const phoneHref = formatPhoneForTel(phone);

// Find alternative providers (partners first)
const alternatives = getAllProviders()
  .filter(p => p.id !== provider.id)
  .sort((a, b) => {
    if (a.isPartner && !b.isPartner) return -1;
    if (!a.isPartner && b.isPartner) return 1;
    return b.rating - a.rating;
  })
  .slice(0, 8);

const faqs = [
  { question: `How accurate is the ${provider.name} speed test?`, answer: `Our speed test measures your actual connection speed using Cloudflare's global network of servers. It tests download speed, upload speed, ping latency, and jitter. For the most accurate results, connect via ethernet cable, close other apps, and run the test multiple times. Results reflect your current connection — not what ${provider.name} advertises.` },
  { question: `What speed should I expect from ${provider.name}?`, answer: `${provider.name} offers plans with speeds up to ${formatSpeed(maxSpeed)} download and ${formatSpeed(maxUpload)} upload. Your actual speeds depend on your plan, connection type, network congestion, equipment, and distance from the provider's infrastructure. If your speed test shows significantly less than your plan's advertised speed, contact ${provider.name} support or consider switching.` },
  { question: `Why is my ${provider.name} internet slow?`, answer: `Common causes include: network congestion during peak hours, outdated router/modem, too many connected devices, WiFi interference, or throttling. Try restarting your router, using a wired connection, or running the speed test at different times. If speeds are consistently below 80% of your plan's advertised speed, you may want to contact support or explore alternatives.` },
  { question: `How can I improve my ${provider.name} speed?`, answer: `1) Restart your modem and router. 2) Use ethernet instead of WiFi. 3) Position your router centrally. 4) Upgrade your router if it's more than 3 years old. 5) Reduce connected devices. 6) Check for firmware updates. 7) Contact ${provider.name} to verify you're on the right plan. 8) Consider upgrading your plan or switching providers if speeds remain poor.` },
  { question: `Is ${provider.name} speed good enough for ${maxSpeed >= 300 ? 'gaming and 4K streaming' : maxSpeed >= 100 ? 'working from home and streaming' : 'basic browsing and streaming'}?`, answer: `${maxSpeed >= 300 ? `Yes. ${provider.name}'s top plan offers ${formatSpeed(maxSpeed)}, which is excellent for competitive gaming, 4K streaming on multiple devices, large file downloads, and smart home devices.` : maxSpeed >= 100 ? `${provider.name} plans up to ${formatSpeed(maxSpeed)} are suitable for HD/4K streaming, video calls, and moderate work from home use. For heavy gaming or large households, you may want to explore faster options.` : `${provider.name} speeds up to ${formatSpeed(maxSpeed)} are suitable for basic browsing, email, and standard definition streaming. For HD streaming or work from home, you may want a faster plan or alternative provider.`}` },
];

const schemas = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://internet4all.com' },
    { name: 'Speed Test', url: 'https://internet4all.com/speed-test' },
    { name: `${provider.name} Speed Test`, url: `https://internet4all.com/speed-test/${provider.slug}` },
  ]),
  generateFAQSchema(faqs),
];
---
<Base
  title={`${provider.name} Speed Test — Check Your ${provider.name} Internet Speed (${year})`}
  description={`Free ${provider.name} speed test. Check your real download & upload speeds. ${provider.name} plans offer up to ${formatSpeed(maxSpeed)}. See if you're getting the speed you pay for.`}
  schema={schemas}
>
  <section class="section" style="padding-top: var(--space-xl);">
    <div class="container container--narrow">
      <Breadcrumb items={[
        { name: 'Speed Test', url: '/speed-test' },
        { name: `${provider.name} Speed Test` },
      ]} />

      <div class="text-center reveal">
        <h1>{provider.name} <span class="gradient-text">Speed Test</span></h1>
        <p class="hero-subtitle" style="max-width:560px;margin-inline:auto;">Test your {provider.name} internet speed. See if you're getting the download and upload speeds you're paying for.</p>
      </div>

      <!-- Speed Test UI -->
      <div class="card reveal" style="margin-top: var(--space-2xl); padding: var(--space-2xl); text-align: center;">
        <div id="speed-gauge" class="speed-gauge" style="--progress: 0%;">
          <div class="speed-value" id="speed-value">—</div>
        </div>
        <p id="speed-label" class="text-tertiary mt-md" style="font-size:var(--text-sm);">Click Start to test your {provider.name} speed</p>

        <div class="grid grid-3 mt-xl" style="gap:var(--space-xl);">
          <div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:var(--tracking-wide);">Download</div>
            <div id="dl-speed" class="speed-display" style="font-size:var(--text-2xl);margin-top:var(--space-xs);">—</div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Mbps</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:var(--tracking-wide);">Upload</div>
            <div id="ul-speed" class="speed-display" style="font-size:var(--text-2xl);margin-top:var(--space-xs);">—</div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);">Mbps</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);text-transform:uppercase;letter-spacing:var(--tracking-wide);">Ping</div>
            <div id="ping-val" class="speed-display" style="font-size:var(--text-2xl);margin-top:var(--space-xs);">—</div>
            <div style="font-size:var(--text-xs);color:var(--text-tertiary);">ms</div>
          </div>
        </div>

        <button id="start-test" class="btn btn-primary btn-lg mt-xl" style="min-width:200px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Start Speed Test
        </button>

        <div class="progress-bar mt-lg" style="opacity:0;" id="progress-bar">
          <div class="progress-fill" id="progress-fill" style="width:0%;"></div>
        </div>
      </div>

      <!-- Provider Speed Context -->
      <div class="card reveal" style="margin-top: var(--space-xl); padding: var(--space-xl);">
        <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-lg);">{provider.name} Advertised Speeds</h2>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-lg);">Compare your speed test results against {provider.name}'s plan speeds to see if you're getting what you pay for.</p>
        <div class="grid grid-3" style="gap: var(--space-md);">
          <div style="padding: var(--space-md); border-radius: var(--radius-md); background: rgba(0, 213, 132, 0.05); border: 1px solid rgba(0, 213, 132, 0.15);">
            <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase;">Max Download</div>
            <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--brand-green);">{formatSpeed(maxSpeed)}</div>
          </div>
          <div style="padding: var(--space-md); border-radius: var(--radius-md); background: rgba(0, 82, 255, 0.05); border: 1px solid rgba(0, 82, 255, 0.15);">
            <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase;">Max Upload</div>
            <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--brand-blue);">{formatSpeed(maxUpload)}</div>
          </div>
          <div style="padding: var(--space-md); border-radius: var(--radius-md); background: rgba(183, 0, 255, 0.05); border: 1px solid rgba(183, 0, 255, 0.15);">
            <div style="font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase;">Starting Price</div>
            <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--brand-purple);">{formatPrice(minPrice)}<span style="font-size: var(--text-sm); font-weight: 400;">/mo</span></div>
          </div>
        </div>

        <h3 style="font-size: var(--text-lg); margin-top: var(--space-xl); margin-bottom: var(--space-md);">{provider.name} Plans</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
            <thead>
              <tr style="border-bottom: 2px solid var(--border);">
                <th style="text-align: left; padding: var(--space-sm);">Plan</th>
                <th style="text-align: right; padding: var(--space-sm);">Download</th>
                <th style="text-align: right; padding: var(--space-sm);">Upload</th>
                <th style="text-align: right; padding: var(--space-sm);">Price</th>
              </tr>
            </thead>
            <tbody>
              {provider.plans.map(plan => (
                <tr style="border-bottom: 1px solid var(--border);">
                  <td style="padding: var(--space-sm);">{plan.name}</td>
                  <td style="text-align: right; padding: var(--space-sm); font-weight: 600;">{formatSpeed(plan.speed)}</td>
                  <td style="text-align: right; padding: var(--space-sm);">{formatSpeed(plan.uploadSpeed)}</td>
                  <td style="text-align: right; padding: var(--space-sm);">{formatPrice(plan.promoPrice || plan.price)}/mo</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Speed too slow CTA -->
      <div class="card reveal" style="margin-top: var(--space-xl); padding: var(--space-2xl); text-align: center; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.02);">
        <h3>Not Getting the {provider.name} Speeds You Expect?</h3>
        <p style="margin-top:var(--space-sm);max-width:500px;margin-inline:auto;color:var(--text-secondary);">If your speed test shows significantly less than what {provider.name} advertises, you may have better options available. Our experts can help you find a faster, more reliable provider.</p>
        <div class="flex gap-md justify-center flex-wrap" style="margin-top:var(--space-xl);">
          <a href={`tel:${phoneHref}`} class="btn btn-cta">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Call {phone}
          </a>
          <a href="/providers" class="btn btn-secondary">Compare All Providers</a>
        </div>
      </div>

      <!-- Alternatives -->
      <div class="reveal" style="margin-top: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">Alternatives to {provider.name}</h2>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-xl);">If your {provider.name} speeds aren't meeting your needs, here are other providers to consider:</p>
        <div class="grid grid-2" style="gap: var(--space-md);">
          {alternatives.map(alt => (
            <a href={`/provider/${alt.slug}`} class="card" style={`padding: var(--space-lg); text-decoration: none; display: flex; align-items: center; gap: var(--space-md); ${alt.isPartner ? 'border-color: rgba(0, 213, 132, 0.3);' : ''}`}>
              <div style="flex: 1;">
                <div style="display: flex; align-items: center; gap: var(--space-sm);">
                  <span style="font-weight: 700; color: var(--text-primary);">{alt.name}</span>
                  {alt.isPartner && <span style="font-size: var(--text-xs); color: var(--brand-green); font-weight: 600;">RECOMMENDED</span>}
                </div>
                <div style="font-size: var(--text-sm); color: var(--text-secondary); margin-top: var(--space-xs);">
                  Up to {formatSpeed(getMaxSpeed(alt))} | From {formatPrice(getMinPrice(alt))}/mo
                </div>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- FAQs -->
      <div class="reveal" style="margin-top: var(--space-3xl);">
        <h2 style="margin-bottom: var(--space-xl);">{provider.name} Speed Test FAQ</h2>
        {faqs.map(faq => (
          <details class="card" style="margin-bottom: var(--space-sm); padding: var(--space-lg);">
            <summary style="cursor: pointer; font-weight: 600;">{faq.question}</summary>
            <p style="margin-top: var(--space-md); color: var(--text-secondary); line-height: 1.7;">{faq.answer}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <StickyCallBar text={`${provider.name} speed not what you expected? Let us find you something better.`} />
</Base>

<script>
  const startBtn = document.getElementById('start-test') as HTMLButtonElement;
  const gauge = document.getElementById('speed-gauge') as HTMLElement;
  const speedValue = document.getElementById('speed-value') as HTMLElement;
  const speedLabel = document.getElementById('speed-label') as HTMLElement;
  const dlSpeed = document.getElementById('dl-speed') as HTMLElement;
  const ulSpeed = document.getElementById('ul-speed') as HTMLElement;
  const pingVal = document.getElementById('ping-val') as HTMLElement;
  const progressBar = document.getElementById('progress-bar') as HTMLElement;
  const progressFill = document.getElementById('progress-fill') as HTMLElement;

  let running = false;
  const DL_ENDPOINT = 'https://speed.cloudflare.com/__down?bytes=';
  const UL_ENDPOINT = 'https://speed.cloudflare.com/__up';
  const PING_ENDPOINT = 'https://speed.cloudflare.com/__down?bytes=0';
  const DL_SIZES = [100_000, 1_000_000, 5_000_000, 10_000_000, 25_000_000];
  const UL_SIZES = [100_000, 500_000, 1_000_000, 2_000_000];

  function animateValue(el: HTMLElement, target: number, duration: number, suffix = '') {
    const startVal = parseFloat(el.textContent || '0') || 0;
    const startTime = performance.now();
    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = startVal + (target - startVal) * eased;
      el.textContent = current.toFixed(1) + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  async function measurePing(rounds = 5): Promise<number> {
    const pings: number[] = [];
    for (let i = 0; i < rounds; i++) {
      const start = performance.now();
      try { await fetch(PING_ENDPOINT, { cache: 'no-store', mode: 'cors' }); pings.push(performance.now() - start); }
      catch { const s2 = performance.now(); await fetch('/robots.txt?_=' + Date.now(), { cache: 'no-store' }); pings.push(performance.now() - s2); }
    }
    pings.sort((a, b) => a - b);
    return pings.length > 2 ? pings.slice(1, -1).reduce((a, b) => a + b, 0) / (pings.length - 2) : pings[0];
  }

  async function measureDownload(): Promise<number> {
    const speeds: number[] = [];
    for (const size of DL_SIZES) {
      const start = performance.now();
      try {
        const res = await fetch(DL_ENDPOINT + size, { cache: 'no-store', mode: 'cors' });
        await res.arrayBuffer();
        const elapsed = (performance.now() - start) / 1000;
        const mbps = (size * 8) / (elapsed * 1_000_000);
        speeds.push(mbps);
        animateValue(dlSpeed, mbps, 300);
        gauge.style.setProperty('--progress', Math.min(mbps / 5, 100) + '%');
        animateValue(speedValue, mbps, 300);
      } catch { /* skip */ }
    }
    return speeds.length ? speeds.slice(-2).reduce((a, b) => a + b, 0) / Math.min(speeds.length, 2) : 0;
  }

  async function measureUpload(): Promise<number> {
    const speeds: number[] = [];
    for (const size of UL_SIZES) {
      const blob = new Blob([new ArrayBuffer(size)]);
      const start = performance.now();
      try {
        await fetch(UL_ENDPOINT, { method: 'POST', body: blob, mode: 'cors' });
        const elapsed = (performance.now() - start) / 1000;
        const mbps = (size * 8) / (elapsed * 1_000_000);
        speeds.push(mbps);
        animateValue(ulSpeed, mbps, 300);
      } catch { /* skip */ }
    }
    return speeds.length ? speeds.slice(-2).reduce((a, b) => a + b, 0) / Math.min(speeds.length, 2) : 0;
  }

  startBtn?.addEventListener('click', async () => {
    if (running) return;
    running = true;
    startBtn.disabled = true;
    startBtn.textContent = 'Testing...';
    progressBar.style.opacity = '1';

    speedLabel.textContent = 'Measuring ping...';
    progressFill.style.width = '10%';
    const ping = await measurePing();
    animateValue(pingVal, ping, 400);

    speedLabel.textContent = 'Measuring download speed...';
    progressFill.style.width = '30%';
    const dl = await measureDownload();
    progressFill.style.width = '60%';

    speedLabel.textContent = 'Measuring upload speed...';
    const ul = await measureUpload();
    progressFill.style.width = '100%';

    animateValue(dlSpeed, dl, 500);
    animateValue(ulSpeed, ul, 500);
    animateValue(pingVal, ping, 300);
    animateValue(speedValue, dl, 500);
    gauge.style.setProperty('--progress', Math.min(dl / 5, 100) + '%');

    speedLabel.textContent = 'Test complete!';
    startBtn.textContent = 'Test Again';
    startBtn.disabled = false;
    running = false;
  });
</script>
