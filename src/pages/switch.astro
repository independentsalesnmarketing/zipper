---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SearchBar from '@components/SearchBar.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice, MAIN_PHONE } from '@lib/providers';
import { generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const partners = getPartnerProviders().slice(0, 6);
const faqs = [
  { q: 'How do I switch internet providers without losing service?', a: 'Schedule your new service install first. Keep your old service active until the new one is working. Once confirmed, cancel the old provider and return their equipment. The whole process typically takes less than a week. Our team will walk you through each step—chat with us if you have questions.' },
  { q: 'Will I have to pay an early termination fee?', a: 'If you\'re under contract, possibly. However, many providers offer to buy out your contract when you switch. We\'ll check if your new provider offers a buyout when you sign up — potentially saving you hundreds.' },
  { q: 'Can I keep my email address if I switch?', a: 'Provider-issued emails (like @comcast.net) may be affected. We recommend switching to a free service like Gmail or Outlook before canceling. Your personal email addresses won\'t be affected.' },
  { q: 'Will I get a better deal by switching?', a: 'Almost always, yes. New customer promotions typically save 30-50% compared to the rate your current provider charges after your promo period ends. Our customers average $30/month in savings after switching.' },
  { q: 'What about my equipment?', a: 'Return your old provider\'s equipment (modem/router) within 30 days to avoid charges. Your new provider will supply their own equipment — or you can buy your own compatible modem/router to avoid rental fees.' },
];

const painPoints = [
  { icon: '🐌', title: 'Slow Speeds', desc: 'Buffering during Netflix? Pages loading slowly? Work calls dropping? You deserve better.' },
  { icon: '📉', title: 'Unreliable Connection', desc: 'Frequent outages and disconnects make everything harder. It shouldn\'t be this frustrating.' },
  { icon: '💸', title: 'Price Keeps Rising', desc: 'Your "introductory rate" is long gone. Now you\'re paying full price for the same service.' },
  { icon: '😤', title: 'Terrible Support', desc: 'Hours on hold, no resolution, empty promises. Your time is worth more than that.' },
];
---
<Base
  title="Switch Internet Providers — Better Speeds, Lower Prices, Zero Downtime"
  description="Tired of slow internet and rising prices? Switch to a better provider today. Compare options, get exclusive deals, and make the switch with zero downtime."
  schema={[
    generateBreadcrumbSchema([
      { name: 'Home', url: 'https://internet4all.com' },
      { name: 'Switch Provider', url: 'https://internet4all.com/switch' }
    ]),
    generateFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })))
  ]}
>
  <!-- Hero -->
  <section class="hero" style="padding-bottom:var(--space-xl);">
    <div class="container text-center">
      <Breadcrumb items={[{ name: 'Switch Provider' }]} />
      <div class="badge reveal" style="margin-bottom:var(--space-md);background:rgba(239,68,68,0.15);color:#f87171;">🔄 Time to Switch</div>
      <h1 class="reveal">Your Internet Sucks?<br/><span class="gradient-text">Let's Fix That Today.</span></h1>
      <p class="hero-subtitle reveal">Stop settling for slow speeds and bad service. We'll find you something better — often for less money.</p>
      <div class="flex justify-center reveal" style="margin-top:var(--space-xl);">
        <SearchBar placeholder="Enter your ZIP to see better options" size="large" />
      </div>
      <div class="reveal" style="margin-top:var(--space-md);display:flex;flex-direction:column;gap:var(--space-sm);align-items:center;">
        <a href="#get-connected" class="btn btn-primary" style="font-size:var(--text-lg);display:flex;align-items:center;gap:8px;white-space:nowrap;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v4"/></svg>
          Get Started Now
        </a>
        <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:0;">Free expert help. Connect in minutes.</p>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal">Sound <span class="gradient-text">Familiar?</span></h2>
      <div class="grid grid-2" style="margin-top:var(--space-xl);">
        {painPoints.map((p, i) => (
          <div class={`card reveal`} style={`transition-delay:${i * 80}ms;border-left:3px solid var(--brand-red);`}>
            <div class="flex items-center" style="gap:var(--space-md);margin-bottom:var(--space-sm);">
              <h4>{p.title}</h4>
            </div>
            <p style="font-size:var(--text-sm);">{p.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center reveal" style="margin-top:var(--space-xl);">
        <p style="font-size:var(--text-xl);font-weight:700;">You don't have to put up with it.</p>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-top:var(--space-xs);">Our average customer gets <strong style="color:var(--brand-green);">2x faster speeds</strong> and saves <strong style="color:var(--brand-green);">$30/month</strong> after switching.</p>
      </div>
    </div>
  </section>

  <!-- How Switching Works -->
  <section class="section">
    <div class="container">
      <h2 class="text-center reveal">Switching is <span class="gradient-text">Faster Than You Think</span></h2>
      <p class="text-center reveal" style="color:var(--text-secondary);margin-bottom:var(--space-xl);max-width:600px;margin-inline:auto;">We make it dead simple. Start online, finish in minutes. No hold times, no hassle.</p>
      <div class="grid grid-4" style="margin-top:var(--space-xl);">
        {[
          { step: '1', title: 'Check Availability', desc: 'Enter your address or ZIP. We\'ll show every available provider and plan instantly.' },
          { step: '2', title: 'Compare & Choose', desc: 'Side-by-side pricing, speeds, and reviews. Pick the plan that works for you.' },
          { step: '3', title: 'Sign Up Online', desc: 'Complete setup in minutes. No phone call needed. New service scheduled immediately.' },
          { step: '4', title: 'We Handled the Switching', desc: 'We guide you through canceling your old service. Your new internet just works.' },
        ].map((s, i) => (
          <div class={`card text-center reveal`} style={`transition-delay:${i * 80}ms;`}>
            <div style="width:48px;height:48px;border-radius:50%;background:var(--gradient-primary);display:grid;place-items:center;font-weight:800;margin:0 auto var(--space-md);">{s.step}</div>
            <h4 style="margin-bottom:var(--space-xs);">{s.title}</h4>
            <p style="font-size:var(--text-sm);">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Better Options -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal">Your <span class="gradient-text">Better Options</span></h2>
      <p class="text-center reveal" style="max-width:500px;margin:var(--space-sm) auto var(--space-xl);">New customer deals mean you'll likely pay less than what you're paying right now.</p>
      <div class="grid grid-3">
        {partners.map((p, i) => {
          const best = p.plans[0];
          const fastest = p.plans[p.plans.length - 1];
          return (
            <div class={`card reveal`} style={`transition-delay:${i * 70}ms;`}>
              <div style="margin-bottom:var(--space-md);">
                <h4>{p.name}</h4>
                <div style="font-size:var(--text-xs);color:var(--text-muted);">{p.types.join(' / ')}</div>
              </div>
              <div class="flex" style="gap:var(--space-lg);margin-bottom:var(--space-md);">
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">From</div>
                  <div style="font-weight:800;color:var(--brand-green);">{formatPrice(best.promoPrice || best.price)}/mo</div>
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Up to</div>
                  <div style="font-weight:800;">{formatSpeed(fastest.speed)}</div>
                </div>
              </div>
              <a href="#get-connected" class="btn btn-cta" style="width:100%;text-align:center;font-size:var(--text-sm);" data-signup-provider={p.slug}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v4"/></svg>
                Sign Up
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Savings Stat -->
  <section class="section">
    <div class="container">
      <div class="card gradient-border text-center" style="padding:var(--space-2xl);">
        <h2 class="reveal">Average Savings After Switching</h2>
        <div class="reveal" style="font-size:clamp(3rem,8vw,5rem);font-weight:900;background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:var(--space-md) 0;">$360/year</div>
        <p class="reveal" style="font-size:var(--text-base);max-width:480px;margin:0 auto;">That's $30/month back in your pocket — plus faster speeds, better reliability, and customer support that actually answers.</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section">
    <div class="container" style="max-width:700px;">
      <div class="card" style="padding:var(--space-2xl);text-align:center;background:linear-gradient(135deg,rgba(0,82,255,0.08),rgba(0,213,132,0.08));border:1px solid var(--brand-blue);">
        <h2 style="margin-bottom:var(--space-sm);">Ready to Switch?</h2>
        <p style="color:var(--text-secondary);margin-bottom:var(--space-lg);font-size:var(--text-base);">Start the switch today and stop overpaying for bad internet. Free expert help, no commitment.</p>
        <div style="display:flex;flex-direction:column;gap:var(--space-md);align-items:center;">
          <a href="#get-connected" class="btn btn-primary btn-lg" style="min-width:220px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:6px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v4"/></svg>
            Get Started Now
          </a>
          <a href={`tel:${MAIN_PHONE.replace(/[^0-9]/g, '')}`} class="btn btn-secondary btn-lg" style="min-width:220px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:6px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            Call {MAIN_PHONE}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:740px;">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">Switching <span class="gradient-text">FAQ</span></h2>
      <div class="faq-list">
        {faqs.map(f => (
          <div class="faq-item reveal">
            <button class="faq-question">{f.q}</button>
            <div class="faq-answer"><div class="faq-answer-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>



  <StickyCallBar text="Ready to switch? Get started now and save." />
</Base>
