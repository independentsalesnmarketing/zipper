---
import Base from '@layouts/Base.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import { getPartnerProviders, formatSpeed, formatPrice, getAllProviders, MAIN_PHONE } from '@lib/providers';
import { formatPhoneForTel, generateBreadcrumbSchema, generateFAQSchema } from '@lib/utils';

const phone = MAIN_PHONE;
const phoneHref = formatPhoneForTel(phone);
const year = new Date().getFullYear();

interface ProviderConfig {
  name: string;
  slug: string;
  avgMonthly: string;
  renewalRate: string;
  painPoints: string[];
  cancellationTip: string;
  etfNote: string;
}

const providerData: Record<string, ProviderConfig> = {
  'spectrum-alternatives': {
    name: 'Spectrum',
    slug: 'spectrum-alternatives',
    avgMonthly: '$79.99',
    renewalRate: '$109.99',
    painPoints: ['Price jumps $30+ after 12-month promo ends', 'Forced to rent modem at $7/mo', 'No rate-lock guarantee beyond promo period', 'Limited upload speeds on cable plans'],
    cancellationTip: 'Spectrum has no early termination fee — cancel any time. Return equipment in-store or by mail within 30 days to avoid a $200 unreturned equipment charge.',
    etfNote: 'No ETF — walk away whenever you want.',
  },
  'xfinity-alternatives': {
    name: 'Xfinity',
    slug: 'xfinity-alternatives',
    avgMonthly: '$84.99',
    renewalRate: '$119.99',
    painPoints: ['1.2 TB data cap with $10/50GB overage fees', 'Promotional rates expire after 12-24 months', 'Equipment rental fees stack up over time', 'Contract options carry significant ETFs'],
    cancellationTip: 'Return Xfinity equipment to an Xfinity store or use prepaid return shipping within 30 days of cancellation. Keep the tracking confirmation to protect yourself from unreturned equipment charges.',
    etfNote: 'Xfinity\'s 2-year contract carries a $230 ETF that prorates monthly. Month-to-month plans have no ETF.',
  },
  'comcast-alternatives': {
    name: 'Comcast / Xfinity',
    slug: 'comcast-alternatives',
    avgMonthly: '$84.99',
    renewalRate: '$119.99',
    painPoints: ['1.2 TB data cap with overage charges', 'Post-promo rate increases of 30-40%', 'Equipment fees and broadcast TV surcharges creep up your bill', 'Inconsistent customer service ratings'],
    cancellationTip: 'Return all Comcast equipment within 30 days. Request a cancellation confirmation number — always get it in writing to avoid being billed after disconnect.',
    etfNote: 'Comcast 2-year contracts carry up to $230 ETF. No ETF on month-to-month plans.',
  },
  'att-alternatives': {
    name: 'AT&T Internet',
    slug: 'att-alternatives',
    avgMonthly: '$75.00',
    renewalRate: '$100.00',
    painPoints: ['DSL speeds don\'t match advertised rates', 'Fiber availability is still limited', 'Wait times for installation can be 1-2 weeks', 'Price discounts tied to bundling phone or TV'],
    cancellationTip: 'AT&T no longer offers long-term internet contracts for residential plans — you can cancel anytime with no ETF on standard fiber/internet plans. Return equipment within 21 days to avoid charges.',
    etfNote: 'No ETF on most residential AT&T Internet plans.',
  },
  'cox-alternatives': {
    name: 'Cox Communications',
    slug: 'cox-alternatives',
    avgMonthly: '$89.99',
    renewalRate: '$119.99',
    painPoints: ['Data caps on all plans (1.25 TB) with $10/50 GB overage', 'Regional provider — limited to select markets', 'Price increase after promotional period is significant', 'Equipment rental fee of $10-14/mo'],
    cancellationTip: 'Cox has a 30-day cancellation window with no penalty if your rate changes. Return Cox equipment within 30 days of cancellation. Keep return receipt.',
    etfNote: 'Cox 1-year and 2-year contracts carry ETFs up to $120-240. Month-to-month has no ETF.',
  },
  'frontier-alternatives': {
    name: 'Frontier',
    slug: 'frontier-alternatives',
    avgMonthly: '$69.99',
    renewalRate: '$89.99',
    painPoints: ['DSL service in many areas is slow and aging', 'Fiber rollout taking years in some markets', 'Customer service inconsistency', 'DSL upload speeds are extremely limited'],
    cancellationTip: 'Frontier fiber plans have no contracts. DSL plans may have contract terms — check your agreement. Return any leased equipment within 30 days.',
    etfNote: 'No ETF on fiber plans. DSL contract terms vary.',
  },
};

export function getStaticPaths() {
  return [
    'spectrum-alternatives',
    'xfinity-alternatives',
    'comcast-alternatives',
    'att-alternatives',
    'cox-alternatives',
    'frontier-alternatives',
  ].map(slug => ({
    params: { provider: slug },
    props: { providerSlug: slug },
  }));
}

interface Props { providerSlug: string; }
const { providerSlug } = Astro.props;
const config = providerData[providerSlug];
const allPartners = getPartnerProviders();

// Filter out the provider being criticized (rough name match)
const alternatives = allPartners
  .filter(p => !p.name.toLowerCase().includes(config.name.toLowerCase().split(' ')[0].toLowerCase()))
  .slice(0, 6);

const faqs = [
  { q: `How do I cancel ${config.name}?`, a: `${config.cancellationTip} Call ${config.name} customer service or use their online cancellation portal. Have your account number ready. Note your cancellation confirmation number for records.` },
  { q: `What is ${config.name}'s early termination fee?`, a: config.etfNote },
  { q: `Will I lose service during the switch?`, a: 'If you plan ahead, no. Sign up with your new provider and schedule installation before your ${config.name} cancellation. Keep your old service active until the new one is confirmed working. There may be 1-7 days of overlap in billing, but you\'ll have uninterrupted connectivity.' },
  { q: `What happens to my ${config.name} email after I cancel?`, a: `${config.name} typically deactivates provider email addresses (e.g., @spectrum.net, @comcast.net) shortly after cancellation. Before switching, migrate important contacts and subscriptions to a free email service like Gmail or Outlook. This is the most common regret people have when switching.` },
  { q: 'What is the best alternative to ' + config.name + '?', a: `The best alternative depends on what's available at your address. Fiber options (AT&T Fiber, Verizon Fios, Frontier Fiber) offer the best performance. For no-contract flexibility, T-Mobile and Verizon 5G Home Internet are excellent. Call us at ${phone} and we'll compare every option at your specific address.` },
];
---
<Base
  title={`${config.name} Alternatives (${year}) — Switch From ${config.name} Today`}
  description={`Tired of ${config.name}? Compare the best ${config.name} alternatives in ${year}. See real prices, speeds, and savings vs. ${config.name}'s post-promo rates. Switch in minutes.`}
  schema={[
    generateBreadcrumbSchema([
      { name: 'Home', url: 'https://internet4all.com' },
      { name: 'Switch Provider', url: 'https://internet4all.com/switch' },
      { name: `${config.name} Alternatives`, url: `https://internet4all.com/switch/${config.slug}` },
    ]),
    generateFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })))
  ]}
>
  <!-- Hero -->
  <section class="hero" style="padding-bottom:var(--space-xl);">
    <div class="container text-center">
      <Breadcrumb items={[{ name: 'Switch Provider', href: '/switch' }, { name: `${config.name} Alternatives` }]} />
      <div class="badge reveal" style="margin-bottom:var(--space-md);background:rgba(255,45,74,0.12);color:var(--brand-red);">Switch & Save</div>
      <h1 class="reveal">Done With {config.name}?<br/><span class="gradient-text">Here Are Your Best Alternatives</span></h1>
      <p class="hero-subtitle reveal" style="max-width:640px;margin-inline:auto;">
        {config.name} charges <strong>{config.renewalRate}/mo</strong> after the promotional period ends. 
        Compare alternatives and get back to a fair rate — with better service.
      </p>
      <div class="reveal" style="margin-top:var(--space-xl);">
        <a href={phoneHref} class="btn btn-cta btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Call {phone} — Switch Today
        </a>
        <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:var(--space-xs);">Our agents compare every provider at your address and switch you same week.</p>
      </div>
    </div>
  </section>

  <!-- Why Leave: Pain Points -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container container--narrow">
      <h2 class="text-center reveal">Why People <span class="gradient-text">Leave {config.name}</span></h2>
      <div class="grid grid-2" style="margin-top:var(--space-xl);gap:var(--space-md);">
        {config.painPoints.map((pain, i) => (
          <div class="card reveal" style={`transition-delay:${i * 70}ms;padding:var(--space-lg);display:flex;gap:var(--space-sm);align-items:flex-start;`}>
            <span style="color:var(--brand-red);font-size:1.2rem;flex-shrink:0;">✗</span>
            <p style="margin:0;font-size:var(--text-sm);">{pain}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Price Comparison Block -->
  <section class="section">
    <div class="container container--narrow">
      <h2 class="text-center reveal">{config.name} vs. <span class="gradient-text">The Alternatives</span></h2>
      <div class="card reveal" style="margin-top:var(--space-xl);overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg-secondary);">
              <th style="padding:var(--space-md);text-align:left;font-size:var(--text-sm);">Provider</th>
              <th style="padding:var(--space-md);text-align:right;font-size:var(--text-sm);">Starting Rate</th>
              <th style="padding:var(--space-md);text-align:right;font-size:var(--text-sm);">After Promo</th>
              <th style="padding:var(--space-md);text-align:center;font-size:var(--text-sm);">Contract</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-top:2px solid rgba(255,45,74,0.3);background:rgba(255,45,74,0.04);">
              <td style="padding:var(--space-md);font-weight:600;">{config.name} <span style="font-size:var(--text-xs);color:var(--text-muted);">(current)</span></td>
              <td style="padding:var(--space-md);text-align:right;">{config.avgMonthly}</td>
              <td style="padding:var(--space-md);text-align:right;color:var(--brand-red);font-weight:700;">{config.renewalRate}</td>
              <td style="padding:var(--space-md);text-align:center;font-size:var(--text-xs);color:var(--text-muted);">Month-to-mo</td>
            </tr>
            {alternatives.slice(0, 5).map((p, i) => {
              const cheapest = p.plans.reduce((a, b) => (a.promoPrice || a.price) < (b.promoPrice || b.price) ? a : b);
              const full = p.plans.reduce((a, b) => a.price > b.price ? a : b);
              return (
                <tr style={`border-top:1px solid var(--border-color);${i % 2 === 0 ? '' : 'background:var(--bg-secondary);'}`}>
                  <td style="padding:var(--space-md);font-weight:600;">{p.name}</td>
                  <td style="padding:var(--space-md);text-align:right;color:var(--brand-green);font-weight:700;">{formatPrice(cheapest.promoPrice || cheapest.price)}</td>
                  <td style="padding:var(--space-md);text-align:right;font-size:var(--text-xs);color:var(--text-muted);">{formatPrice(full.price)}</td>
                  <td style="padding:var(--space-md);text-align:center;font-size:var(--text-xs);">{cheapest.contract}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:var(--space-sm);text-align:center;">Prices shown are promotional rates. Actual rates may vary by address. Call to confirm current pricing.</p>
    </div>
  </section>

  <!-- Alternative Provider Cards -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container">
      <h2 class="text-center reveal">Best {config.name} <span class="gradient-text">Alternatives Near You</span></h2>
      <p class="text-center reveal" style="max-width:560px;margin:var(--space-sm) auto var(--space-xl);">Call to check availability at your address and lock in new-customer pricing today.</p>
      <div class="grid grid-2">
        {alternatives.map((p, i) => {
          const best = p.plans[0];
          return (
            <div class={`card reveal`} style={`transition-delay:${i * 70}ms;`}>
              <div class="flex items-start" style="justify-content:space-between;gap:var(--space-md);margin-bottom:var(--space-md);">
                <div>
                  <h4 style="margin-bottom:4px;">{p.name}</h4>
                  <span style="font-size:var(--text-xs);color:var(--text-muted);">{p.types.join(' / ')}</span>
                </div>
                <div style="text-align:right;flex-shrink:0;">
                  <div style="font-size:var(--text-xs);color:var(--text-muted);">Starting at</div>
                  <div style="font-size:var(--text-2xl);font-weight:800;color:var(--brand-green);">{formatPrice(best.promoPrice || best.price)}<span style="font-size:var(--text-xs);font-weight:400;">/mo</span></div>
                </div>
              </div>
              <div class="flex" style="gap:var(--space-xs);flex-wrap:wrap;margin-bottom:var(--space-md);">
                <span class="badge">Up to {formatSpeed(p.plans[p.plans.length - 1].speed)}</span>
                <span class="badge">{best.contract}</span>
                <span class="badge">{best.dataCap}</span>
              </div>
              <a href={`tel:${p.phone.replace(/[^0-9]/g, '')}`} class="btn btn-call" style="width:100%;text-align:center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                Switch to {p.name} Today
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- How to Switch -->
  <section class="section">
    <div class="container container--narrow">
      <h2 class="text-center reveal">How to Switch From <span class="gradient-text">{config.name}</span></h2>
      <div class="grid grid-1" style="gap:var(--space-md);margin-top:var(--space-xl);">
        {[
          { n: '1', title: 'Check What\'s Available at Your Address', body: 'Enter your ZIP or call us. We\'ll show you every provider available and their current promotional rates. Takes 2 minutes.' },
          { n: '2', title: 'Pick a Plan and Schedule Installation', body: 'Choose your preferred alternative. We schedule the install for you — often same-week. Most cable providers do self-install, so there\'s no wait for a technician.' },
          { n: '3', title: 'Cancel ' + config.name + ' After Your New Service Is Active', body: config.cancellationTip + ' Keep your old service running until new internet is confirmed working — usually just a day or two of overlap.' },
          { n: '4', title: 'Return ' + config.name + ' Equipment', body: 'Return any leased equipment (modem, router, boxes) within 30 days of cancellation to avoid charges. Get a receipt confirming return.' },
        ].map((step, i) => (
          <div class="card reveal" style={`transition-delay:${i * 60}ms;display:flex;gap:var(--space-lg);`}>
            <div style="width:40px;height:40px;border-radius:50%;background:var(--gradient-primary);display:grid;place-items:center;font-weight:800;font-size:var(--text-lg);flex-shrink:0;">{step.n}</div>
            <div>
              <h4 style="margin-bottom:var(--space-xs);">{step.title}</h4>
              <p style="font-size:var(--text-sm);color:var(--text-secondary);margin:0;">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center reveal" style="margin-top:var(--space-2xl);">
        <a href={phoneHref} class="btn btn-cta btn-lg"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>Call {phone} — We Handle the Switch</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:740px;">
      <h2 class="text-center reveal" style="margin-bottom:var(--space-xl);">Switching From {config.name} <span class="gradient-text">FAQ</span></h2>
      <div class="faq-list">
        {faqs.map(f => (
          <div class="faq-item reveal">
            <button class="faq-question">{f.q}</button>
            <div class="faq-answer"><div class="faq-answer-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="section">
    <div class="container text-center">
      <h3 class="reveal" style="margin-bottom:var(--space-lg);">Looking for Other Provider Alternatives?</h3>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-sm);" class="reveal">
        <a href="/switch/spectrum-alternatives" class="btn btn-secondary" style="font-size:var(--text-sm);">Spectrum Alternatives</a>
        <a href="/switch/xfinity-alternatives" class="btn btn-secondary" style="font-size:var(--text-sm);">Xfinity Alternatives</a>
        <a href="/switch/att-alternatives" class="btn btn-secondary" style="font-size:var(--text-sm);">AT&T Alternatives</a>
        <a href="/switch/cox-alternatives" class="btn btn-secondary" style="font-size:var(--text-sm);">Cox Alternatives</a>
        <a href="/switch/frontier-alternatives" class="btn btn-secondary" style="font-size:var(--text-sm);">Frontier Alternatives</a>
      </div>
    </div>
  </section>

  <StickyCallBar text={`Switch from ${config.name} today — we compare every alternative at your address.`} />
</Base>
